\newlabel{tab:lobo_usa@cref}{{[table][8][]8}{[1][74][]75}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Southeast Asia: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. All five evaluated biomes show lift above 1; extreme lifts for Tropical Coniferous Forests (741$\times $) and Mangroves (49.5$\times $) are partially driven by near-zero positive rates (0.084\% and 0.016\% respectively).\relax }}{75}{table.caption.64}\protected@file@percent }
