\newlabel{fig:biome_breakdown_usa}{{21}{90}{United States biome-stratified performance (full production Random Forest model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. ROC-AUC is uniformly high across biomes (0.93--0.995) while Precision@1\% is uniformly suppressed by the near-zero national positive rate ($\approx $0.04\%), reflecting the base-rate effect rather than poor discrimination.\relax }{figure.caption.87}{}}
\newlabel{fig:biome_breakdown_usa@cref}{{[figure][21][]21}{[1][90][]90}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Southeast Asia biome-stratified performance (full production Random Forest model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. Tropical \& Subtropical Dry Broadleaf Forests and Temperate Conifer Forests achieve both high discrimination and high absolute precision (Precision@1\% of 0.877 and 1.0 respectively), driven by their substantially higher positive rates (1.07\% and 25\%).\relax }}{91}{figure.caption.88}\protected@file@percent }
\newlabel{fig:biome_breakdown_seasia}{{22}{91}{Southeast Asia biome-stratified performance (full production Random Forest model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. Tropical \& Subtropical Dry Broadleaf Forests and Temperate Conifer Forests achieve both high discrimination and high absolute precision (Precision@1\% of 0.877 and 1.0 respectively), driven by their substantially higher positive rates (1.07\% and 25\%).\relax }{figure.caption.88}{}}
\newlabel{fig:biome_breakdown_seasia@cref}{{[figure][22][]22}{[1][90][]91}}
