\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Per-biome LOBO ROC-AUC for the United States (LightGBM). The horizontal dashed line marks random-classifier performance (0.5). Four biomes had zero test-period designations (N/A) and are excluded. The mean across evaluable biomes is 0.510, reflecting the dominance of federal public-land tenure as a driver not captured by the available geospatial covariates.\relax }}{83}{figure.caption.75}\protected@file@percent }
\newlabel{fig:lobo_usa}{{11}{83}{Per-biome LOBO ROC-AUC for the United States (LightGBM). The horizontal dashed line marks random-classifier performance (0.5). Four biomes had zero test-period designations (N/A) and are excluded. The mean across evaluable biomes is 0.510, reflecting the dominance of federal public-land tenure as a driver not captured by the available geospatial covariates.\relax }{figure.caption.75}{}}
\newlabel{fig:lobo_usa@cref}{{[figure][11][]11}{[1][82][]83}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Per-biome LOBO ROC-AUC for Southeast Asia (LightGBM). The horizontal dashed line marks random-classifier performance (0.5). Three biomes with zero test-period designations are excluded. The high mean (0.883) reflects that pan-regional ecological gradients dominate PA siting across most biome types in the region.\relax }}{83}{figure.caption.76}\protected@file@percent }
\newlabel{fig:lobo_seasia}{{12}{83}{Per-biome LOBO ROC-AUC for Southeast Asia (LightGBM). The horizontal dashed line marks random-classifier performance (0.5). Three biomes with zero test-period designations are excluded. The high mean (0.883) reflects that pan-regional ecological gradients dominate PA siting across most biome types in the region.\relax }{figure.caption.76}{}}
\newlabel{fig:lobo_seasia@cref}{{[figure][12][]12}{[1][83][]83}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Forward projection for the United States under the 30$\times $30 scenario. Coloured clusters indicate high-probability pixels that would need to be designated to reach 30\% terrestrial protection by 2030. Designation is heavily concentrated in the arid West (BLM and National Forest lands) and the Pacific Northwest.\relax }}{84}{figure.caption.77}\protected@file@percent }
\newlabel{fig:forward_usa}{{13}{84}{Forward projection for the United States under the 30$\times $30 scenario. Coloured clusters indicate high-probability pixels that would need to be designated to reach 30\% terrestrial protection by 2030. Designation is heavily concentrated in the arid West (BLM and National Forest lands) and the Pacific Northwest.\relax }{figure.caption.77}{}}
\newlabel{fig:forward_usa@cref}{{[figure][13][]13}{[1][83][]84}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Forward projection for Southeast Asia under the 30$\times $30 scenario. The limited number of clusters (9 total) reflects the strong geographic concentration of high-probability pixels in large forested upland areas, particularly in Borneo and Sumatra.\relax }}{85}{figure.caption.78}\protected@file@percent }
\newlabel{fig:forward_seasia}{{14}{85}{Forward projection for Southeast Asia under the 30$\times $30 scenario. The limited number of clusters (9 total) reflects the strong geographic concentration of high-probability pixels in large forested upland areas, particularly in Borneo and Sumatra.\relax }{figure.caption.78}{}}
\newlabel{fig:forward_seasia@cref}{{[figure][14][]14}{[1][84][]85}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Predicted 5-year PA designation probability for the United States (LightGBM, deployment model). Higher probabilities concentrate in the arid West where Bureau of Land Management public land dominates. Note the compressed probability scale relative to South America, reflecting the 20$\times $ lower positive rate ($\approx $0.04\%).\relax }}{85}{figure.caption.79}\protected@file@percent }
\newlabel{fig:probmap_usa}{{15}{85}{Predicted 5-year PA designation probability for the United States (LightGBM, deployment model). Higher probabilities concentrate in the arid West where Bureau of Land Management public land dominates. Note the compressed probability scale relative to South America, reflecting the 20$\times $ lower positive rate ($\approx $0.04\%).\relax }{figure.caption.79}{}}
\newlabel{fig:probmap_usa@cref}{{[figure][15][]15}{[1][85][]85}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Predicted 5-year PA designation probability for Southeast Asia (LightGBM, deployment model). High-probability pixels cluster in the forested uplands of Borneo, Sumatra, and peninsular Malaysia, reflecting the strong elevation and canopy-cover signal in this region.\relax }}{86}{figure.caption.80}\protected@file@percent }
\newlabel{fig:probmap_seasia}{{16}{86}{Predicted 5-year PA designation probability for Southeast Asia (LightGBM, deployment model). High-probability pixels cluster in the forested uplands of Borneo, Sumatra, and peninsular Malaysia, reflecting the strong elevation and canopy-cover signal in this region.\relax }{figure.caption.80}{}}
\newlabel{fig:probmap_seasia@cref}{{[figure][16][]16}{[1][85][]86}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Hotspot zoom-ins for South America (LightGBM forward model, BAU scenario). Top row: predicted probability of designation by 2030 (same colour stretch as the continental map). Bottom row: BAU designation zone (red), with existing protected areas (2024) shown in green and country borders in grey. Left panel shows the Colombian Amazon cluster (C1), the highest-ranked BAU hotspot; right panel shows the central Chilean cluster (C5), illustrating the Bare/Other land-cover regime characteristic of Andean foothills designations. Both clusters illustrate the model's ability to identify spatially coherent designation pressure at sub-national scale.\relax }}{87}{figure.caption.81}\protected@file@percent }
\newlabel{fig:hotspot_sa}{{17}{87}{Hotspot zoom-ins for South America (LightGBM forward model, BAU scenario). Top row: predicted probability of designation by 2030 (same colour stretch as the continental map). Bottom row: BAU designation zone (red), with existing protected areas (2024) shown in green and country borders in grey. Left panel shows the Colombian Amazon cluster (C1), the highest-ranked BAU hotspot; right panel shows the central Chilean cluster (C5), illustrating the Bare/Other land-cover regime characteristic of Andean foothills designations. Both clusters illustrate the model's ability to identify spatially coherent designation pressure at sub-national scale.\relax }{figure.caption.81}{}}
\newlabel{fig:hotspot_sa@cref}{{[figure][17][]17}{[1][86][]87}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Cumulative gains chart for the South America LightGBM model (test period 2017--2019). The curve shows the fraction of all pixel-year positive observations captured as a function of the fraction of pixel-years scored, ranked by predicted probability. At top 1\% of pixels, the model captures approximately 66.8\% of positive pixel-years (Lift $66.8\times $; event-level coverage is 90.4\% because multi-year PAs contribute multiple pixel-years). The dashed diagonal represents a random scorer (no skill).\relax }}{88}{figure.caption.82}\protected@file@percent }
\newlabel{fig:cumgains_sa}{{18}{88}{Cumulative gains chart for the South America LightGBM model (test period 2017--2019). The curve shows the fraction of all pixel-year positive observations captured as a function of the fraction of pixel-years scored, ranked by predicted probability. At top 1\% of pixels, the model captures approximately 66.8\% of positive pixel-years (Lift $66.8\times $; event-level coverage is 90.4\% because multi-year PAs contribute multiple pixel-years). The dashed diagonal represents a random scorer (no skill).\relax }{figure.caption.82}{}}
\newlabel{fig:cumgains_sa@cref}{{[figure][18][]18}{[1][88][]88}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces SHAP dependence plot for \texttt  {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship confirms that pixels in globally significant biodiversity areas consistently attract designation regardless of other covariate values. Colour indicates the SHAP value of a secondary interacting feature.\relax }}{89}{figure.caption.83}\protected@file@percent }
\newlabel{fig:shap_dep_gsn}{{19}{89}{SHAP dependence plot for \texttt {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship confirms that pixels in globally significant biodiversity areas consistently attract designation regardless of other covariate values. Colour indicates the SHAP value of a secondary interacting feature.\relax }{figure.caption.83}{}}
\newlabel{fig:shap_dep_gsn@cref}{{[figure][19][]19}{[1][88][]89}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces SHAP dependence plot for \texttt  {policy\_b4} (WGI Rule of Law, country level). The monotone positive relationship indicates that stronger rule-of-law institutions are associated with higher designation probability across the continent — confirming governance quality as an independent predictor rather than a proxy for ecological value.\relax }}{89}{figure.caption.84}\protected@file@percent }
\newlabel{fig:shap_dep_pol}{{20}{89}{SHAP dependence plot for \texttt {policy\_b4} (WGI Rule of Law, country level). The monotone positive relationship indicates that stronger rule-of-law institutions are associated with higher designation probability across the continent — confirming governance quality as an independent predictor rather than a proxy for ecological value.\relax }{figure.caption.84}{}}
\newlabel{fig:shap_dep_pol@cref}{{[figure][20][]20}{[1][89][]89}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces SHAP dependence plot for \texttt  {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). Proximity to indigenous territories is associated with higher designation probability, consistent with co-management pathways and the overlap between indigenous territories and high-biodiversity areas in the Amazon.\relax }}{90}{figure.caption.85}\protected@file@percent }
\newlabel{fig:shap_dep_indigenous}{{21}{90}{SHAP dependence plot for \texttt {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). Proximity to indigenous territories is associated with higher designation probability, consistent with co-management pathways and the overlap between indigenous territories and high-biodiversity areas in the Amazon.\relax }{figure.caption.85}{}}
\newlabel{fig:shap_dep_indigenous@cref}{{[figure][21][]21}{[1][89][]90}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces SHAP dependence plot for \texttt  {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }}{90}{figure.caption.86}\protected@file@percent }
\newlabel{fig:shap_dep_clim}{{22}{90}{SHAP dependence plot for \texttt {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }{figure.caption.86}{}}
\newlabel{fig:shap_dep_clim@cref}{{[figure][22][]22}{[1][90][]90}}
