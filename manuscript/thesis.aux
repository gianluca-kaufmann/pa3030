\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces South America: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift = PR-AUC\,/\,positive rate; lift\,$=1$ equals a random classifier. Tropical \& Subtropical Coniferous Forests has zero test-period designations and is excluded from the mean. The mean lift is driven by Temperate Grasslands (843$\times $); median lift across the 10 evaluated biomes is 11$\times $.\relax }}{76}{table.caption.62}\protected@file@percent }
\newlabel{tab:lobo_sa}{{7}{76}{South America: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift = PR-AUC\,/\,positive rate; lift\,$=1$ equals a random classifier. Tropical \& Subtropical Coniferous Forests has zero test-period designations and is excluded from the mean. The mean lift is driven by Temperate Grasslands (843$\times $); median lift across the 10 evaluated biomes is 11$\times $.\relax }{table.caption.62}{}}
\newlabel{tab:lobo_sa@cref}{{[table][7][]7}{[1][76][]76}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces United States: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. Three of five evaluated folds fall at or below lift\nobreakspace  {}$= 1$; the Temperate Broadleaf \& Mixed Forests exception (12.5$\times $) and Temperate Grasslands exception (3.9$\times $) are driven by near-zero positive rates (0.006\% and 0.002\%), not strong absolute PR-AUC; all folds remain at PR-AUC\nobreakspace  {}$< 0.002$.\relax }}{77}{table.caption.63}\protected@file@percent }
\newlabel{tab:lobo_usa}{{8}{77}{United States: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift~$=1$ equals a random classifier. Three of five evaluated folds fall at or below lift~$= 1$; the Temperate Broadleaf \& Mixed Forests exception (12.5$\times $) and Temperate Grasslands exception (3.9$\times $) are driven by near-zero positive rates (0.006\% and 0.002\%), not strong absolute PR-AUC; all folds remain at PR-AUC~$< 0.002$.\relax }{table.caption.63}{}}
\newlabel{tab:lobo_usa@cref}{{[table][8][]8}{[1][76][]77}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Southeast Asia: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. All five evaluated biomes show lift above 1; extreme lifts for Tropical Coniferous Forests (741$\times $) and Mangroves (49.5$\times $) are partially driven by near-zero positive rates (0.084\% and 0.016\% respectively).\relax }}{77}{table.caption.64}\protected@file@percent }
\newlabel{tab:lobo_seasia}{{9}{77}{Southeast Asia: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift~$=1$ equals a random classifier. All five evaluated biomes show lift above 1; extreme lifts for Tropical Coniferous Forests (741$\times $) and Mangroves (49.5$\times $) are partially driven by near-zero positive rates (0.084\% and 0.016\% respectively).\relax }{table.caption.64}{}}
