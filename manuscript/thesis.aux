\newlabel{app:shap_dep@cref}{{[section][7][]G}{[1][88][]88}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces SHAP dependence plot for \texttt  {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship confirms that pixels in globally significant biodiversity areas consistently attract designation regardless of other covariate values. Colour indicates the SHAP value of a secondary interacting feature.\relax }}{89}{figure.caption.76}\protected@file@percent }
\newlabel{fig:shap_dep_gsn}{{22}{89}{SHAP dependence plot for \texttt {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship confirms that pixels in globally significant biodiversity areas consistently attract designation regardless of other covariate values. Colour indicates the SHAP value of a secondary interacting feature.\relax }{figure.caption.76}{}}
\newlabel{fig:shap_dep_gsn@cref}{{[figure][22][]22}{[1][88][]89}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces SHAP dependence plot for \texttt  {policy\_b4} (WGI Rule of Law, country level). The monotone positive relationship indicates that stronger rule-of-law institutions are associated with higher designation probability across the continent, confirming governance quality as an independent predictor rather than a proxy for ecological value.\relax }}{89}{figure.caption.77}\protected@file@percent }
\newlabel{fig:shap_dep_pol}{{23}{89}{SHAP dependence plot for \texttt {policy\_b4} (WGI Rule of Law, country level). The monotone positive relationship indicates that stronger rule-of-law institutions are associated with higher designation probability across the continent, confirming governance quality as an independent predictor rather than a proxy for ecological value.\relax }{figure.caption.77}{}}
\newlabel{fig:shap_dep_pol@cref}{{[figure][23][]23}{[1][89][]89}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces SHAP dependence plot for \texttt  {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). Proximity to indigenous territories is associated with higher designation probability, consistent with co-management pathways and the overlap between indigenous territories and high-biodiversity areas in the Amazon.\relax }}{90}{figure.caption.78}\protected@file@percent }
\newlabel{fig:shap_dep_indigenous}{{24}{90}{SHAP dependence plot for \texttt {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). Proximity to indigenous territories is associated with higher designation probability, consistent with co-management pathways and the overlap between indigenous territories and high-biodiversity areas in the Amazon.\relax }{figure.caption.78}{}}
\newlabel{fig:shap_dep_indigenous@cref}{{[figure][24][]24}{[1][89][]90}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces SHAP dependence plot for \texttt  {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }}{90}{figure.caption.79}\protected@file@percent }
\newlabel{fig:shap_dep_clim}{{25}{90}{SHAP dependence plot for \texttt {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }{figure.caption.79}{}}
\newlabel{fig:shap_dep_clim@cref}{{[figure][25][]25}{[1][90][]90}}
