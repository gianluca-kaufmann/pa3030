\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Per-biome LOBO PR-AUC for the United States (LightGBM, test set 2017--2019). Biomes with zero test-period designations are excluded. LOBO PR-AUC values are near zero across all biomes, reflecting that the USA model relies on federal public-land tenure patterns that do not transfer across biome boundaries.\relax }}{84}{figure.caption.68}\protected@file@percent }
\newlabel{fig:lobo_usa}{{14}{84}{Per-biome LOBO PR-AUC for the United States (LightGBM, test set 2017--2019). Biomes with zero test-period designations are excluded. LOBO PR-AUC values are near zero across all biomes, reflecting that the USA model relies on federal public-land tenure patterns that do not transfer across biome boundaries.\relax }{figure.caption.68}{}}
\newlabel{fig:lobo_usa@cref}{{[figure][14][]14}{[1][83][]84}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Per-biome LOBO PR-AUC for Southeast Asia (LightGBM, test set 2017--2019). Biomes with zero test-period designations are excluded. The mean LOBO PR-AUC is 0.169, indicating that pan-regional ecological gradients provide moderate out-of-distribution generalisation across biome types in the region.\relax }}{84}{figure.caption.69}\protected@file@percent }
\newlabel{fig:lobo_seasia}{{15}{84}{Per-biome LOBO PR-AUC for Southeast Asia (LightGBM, test set 2017--2019). Biomes with zero test-period designations are excluded. The mean LOBO PR-AUC is 0.169, indicating that pan-regional ecological gradients provide moderate out-of-distribution generalisation across biome types in the region.\relax }{figure.caption.69}{}}
