\newlabel{fig:shap_dep_gsn}{{23a}{92}{SHAP dependence plot for \texttt {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship shows that pixels in globally significant biodiversity areas carry a higher marginal SHAP contribution towards designation, on average across the model's feature interactions. Colour indicates the SHAP value of a secondary interacting feature.\relax }{figure.caption.81}{}}
\newlabel{fig:shap_dep_gsn@cref}{{[subfigure][1][23]23a}{[1][91][]92}}
\newlabel{sub@fig:shap_dep_gsn}{{a}{92}{SHAP dependence plot for \texttt {GSN\_b2\_smooth16} (GSN high-biodiversity indicator, $16 \times 16$ km neighbourhood mean). The positive relationship shows that pixels in globally significant biodiversity areas carry a higher marginal SHAP contribution towards designation, on average across the model's feature interactions. Colour indicates the SHAP value of a secondary interacting feature.\relax }{figure.caption.81}{}}
\newlabel{sub@fig:shap_dep_gsn@cref}{{[subfigure][1][23]23a}{[1][91][]92}}
\newlabel{fig:shap_dep_pol}{{23b}{92}{SHAP dependence plot for \texttt {policy\_b4} (WGI Rule of Law, country level). The relationship is positively sloped --- stronger rule of law increases SHAP --- and the continental mean SHAP is $+0.129$ (78.5\% of observations positive), indicating that governance is an enabling condition for PA designation across most of South America.\relax }{figure.caption.81}{}}
\newlabel{fig:shap_dep_pol@cref}{{[subfigure][2][23]23b}{[1][91][]92}}
\newlabel{sub@fig:shap_dep_pol}{{b}{92}{SHAP dependence plot for \texttt {policy\_b4} (WGI Rule of Law, country level). The relationship is positively sloped --- stronger rule of law increases SHAP --- and the continental mean SHAP is $+0.129$ (78.5\% of observations positive), indicating that governance is an enabling condition for PA designation across most of South America.\relax }{figure.caption.81}{}}
\newlabel{sub@fig:shap_dep_pol@cref}{{[subfigure][2][23]23b}{[1][91][]92}}
\newlabel{fig:shap_dep_indigenous}{{23c}{92}{SHAP dependence plot for \texttt {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). The effect is mixed: proximity to indigenous territories raises designation probability in co-management contexts (Amazonia), while greater distance acts as an economic-remoteness signal elsewhere, yielding near-neutral mean SHAP overall.\relax }{figure.caption.81}{}}
\newlabel{fig:shap_dep_indigenous@cref}{{[subfigure][3][23]23c}{[1][91][]92}}
\newlabel{sub@fig:shap_dep_indigenous}{{c}{92}{SHAP dependence plot for \texttt {dist\_indigenous} (distance to nearest indigenous or community-managed land, km). The effect is mixed: proximity to indigenous territories raises designation probability in co-management contexts (Amazonia), while greater distance acts as an economic-remoteness signal elsewhere, yielding near-neutral mean SHAP overall.\relax }{figure.caption.81}{}}
\newlabel{sub@fig:shap_dep_indigenous@cref}{{[subfigure][3][23]23c}{[1][91][]92}}
\newlabel{fig:shap_dep_clim}{{23d}{92}{SHAP dependence plot for \texttt {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }{figure.caption.81}{}}
\newlabel{fig:shap_dep_clim@cref}{{[subfigure][4][23]23d}{[1][91][]92}}
\newlabel{sub@fig:shap_dep_clim}{{d}{92}{SHAP dependence plot for \texttt {WorldClim\_b14} (precipitation of the driest month, mm). The positive SHAP at low and high extremes reflects the model's use of climate envelope information: both hyper-arid and wet-season-dominated regimes exhibit distinctive spatial designation patterns.\relax }{figure.caption.81}{}}
\newlabel{sub@fig:shap_dep_clim@cref}{{[subfigure][4][23]23d}{[1][91][]92}}
