\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces South America: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift = PR-AUC\,/\,positive rate; lift\,$=1$ equals a random classifier. Tropical \& Subtropical Coniferous Forests has zero test-period designations and is excluded from the mean. The mean lift is driven by Temperate Grasslands (843$\times $); median lift across the 10 evaluated biomes is 11$\times $. \emph  {Note: LOBO jobs were not re-run after the final model fix; values are preliminary and directional.}\relax }}{78}{table.caption.71}\protected@file@percent }
\newlabel{tab:lobo_sa}{{7}{78}{South America: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift = PR-AUC\,/\,positive rate; lift\,$=1$ equals a random classifier. Tropical \& Subtropical Coniferous Forests has zero test-period designations and is excluded from the mean. The mean lift is driven by Temperate Grasslands (843$\times $); median lift across the 10 evaluated biomes is 11$\times $. \emph {Note: LOBO jobs were not re-run after the final model fix; values are preliminary and directional.}\relax }{table.caption.71}{}}
\newlabel{tab:lobo_sa@cref}{{[table][7][]7}{[1][78][]78}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces United States: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. Three of five evaluated folds fall at or below lift\nobreakspace  {}$= 1$; the Temperate Broadleaf \& Mixed Forests exception (12.5$\times $) and Temperate Grasslands exception (3.9$\times $) are driven by near-zero positive rates (0.006\% and 0.002\%), not strong absolute PR-AUC; all folds remain at PR-AUC\nobreakspace  {}$< 0.002$.\relax }}{79}{table.caption.72}\protected@file@percent }
\newlabel{tab:lobo_usa}{{8}{79}{United States: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift~$=1$ equals a random classifier. Three of five evaluated folds fall at or below lift~$= 1$; the Temperate Broadleaf \& Mixed Forests exception (12.5$\times $) and Temperate Grasslands exception (3.9$\times $) are driven by near-zero positive rates (0.006\% and 0.002\%), not strong absolute PR-AUC; all folds remain at PR-AUC~$< 0.002$.\relax }{table.caption.72}{}}
\newlabel{tab:lobo_usa@cref}{{[table][8][]8}{[1][78][]79}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Southeast Asia: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. All five evaluated biomes show lift above 1; extreme lifts for Tropical Coniferous Forests (741$\times $) and Mangroves (49.5$\times $) are partially driven by near-zero positive rates (0.084\% and 0.016\% respectively).\relax }}{79}{table.caption.73}\protected@file@percent }
\newlabel{tab:lobo_seasia}{{9}{79}{Southeast Asia: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift~$=1$ equals a random classifier. All five evaluated biomes show lift above 1; extreme lifts for Tropical Coniferous Forests (741$\times $) and Mangroves (49.5$\times $) are partially driven by near-zero positive rates (0.084\% and 0.016\% respectively).\relax }{table.caption.73}{}}
\newlabel{tab:lobo_seasia@cref}{{[table][9][]9}{[1][79][]79}}
