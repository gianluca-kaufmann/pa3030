\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces United States biome-stratified performance (full production LightGBM model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. ROC-AUC is uniformly high across biomes (0.93--0.995) while Precision@1\% is uniformly suppressed by the near-zero national positive rate ($\approx $0.04\%), reflecting the base-rate effect rather than poor discrimination.\relax }}{92}{figure.caption.89}\protected@file@percent }
\newlabel{fig:biome_breakdown_usa}{{21}{92}{United States biome-stratified performance (full production LightGBM model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. ROC-AUC is uniformly high across biomes (0.93--0.995) while Precision@1\% is uniformly suppressed by the near-zero national positive rate ($\approx $0.04\%), reflecting the base-rate effect rather than poor discrimination.\relax }{figure.caption.89}{}}
\newlabel{fig:biome_breakdown_usa@cref}{{[figure][21][]21}{[1][91][]92}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Southeast Asia biome-stratified performance (full production LightGBM model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. Tropical \& Subtropical Dry Broadleaf Forests and Temperate Conifer Forests achieve both high discrimination and high absolute precision (Precision@1\% of 0.877 and 1.0 respectively), driven by their substantially higher positive rates (1.07\% and 25\%).\relax }}{92}{figure.caption.90}\protected@file@percent }
\newlabel{fig:biome_breakdown_seasia}{{22}{92}{Southeast Asia biome-stratified performance (full production LightGBM model, test set 2017--2019). Each biome is evaluated using scores from the model trained on all biomes simultaneously. Tropical \& Subtropical Dry Broadleaf Forests and Temperate Conifer Forests achieve both high discrimination and high absolute precision (Precision@1\% of 0.877 and 1.0 respectively), driven by their substantially higher positive rates (1.07\% and 25\%).\relax }{figure.caption.90}{}}
\newlabel{fig:biome_breakdown_seasia@cref}{{[figure][22][]22}{[1][92][]92}}
