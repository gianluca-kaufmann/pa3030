\newlabel{tab:lobo_sa}{{7}{74}{South America: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift = PR-AUC\,/\,positive rate; lift\,$=1$ equals a random classifier. Tropical \& Subtropical Coniferous Forests has zero test-period designations and is excluded from the mean. The mean lift is driven by Temperate Grasslands (843$\times $); median lift across the 10 evaluated biomes is 11$\times $.\relax }{table.caption.62}{}}
\newlabel{tab:lobo_sa@cref}{{[table][7][]7}{[1][74][]74}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces United States: Per-biome LOBO PR-AUC and PR-AUC lift (LightGBM, test set 2017--2019). Lift\nobreakspace  {}$=1$ equals a random classifier. Three of five evaluated folds fall at or below lift\nobreakspace  {}$= 1$; the Temperate Broadleaf \& Mixed Forests exception (12.5$\times $) and Temperate Grasslands exception (3.9$\times $) are driven by near-zero positive rates (0.006\% and 0.002\%), not strong absolute PR-AUC; all folds remain at PR-AUC\nobreakspace  {}$< 0.002$.\relax }}{75}{table.caption.63}\protected@file@percent }
