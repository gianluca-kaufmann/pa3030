\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces South America LightGBM risk map: top 1\% of predicted pixels (Recall@1\% = 77.4\%, Precision@1\% = 79.8\%). \textbf  {Blue}: correctly predicted, with the pixel in the top-1\% risk zone \emph  {and} PA established within the five-year prediction window (true positive). \textbf  {Gold}: predicted high-risk but no PA established within the window (unconfirmed prediction). \textbf  {Red}: PA established within the window but pixel not in the top-1\% zone (model miss). \textbf  {Grey}: pixels already protected before the test period (excluded from the risk set). The observed category covers all PA designations within the five-year prediction horizon (up to 2024 for 2019 test rows), consistent with the \texttt  {transition\_01\_win5} label used for all benchmark metrics. Pixel markers are slightly enlarged for print legibility.\relax }}{43}{figure.caption.46}\protected@file@percent }
\newlabel{fig:riskmap_sa_top1}{{5}{43}{South America LightGBM risk map: top 1\% of predicted pixels (Recall@1\% = 77.4\%, Precision@1\% = 79.8\%). \textbf {Blue}: correctly predicted, with the pixel in the top-1\% risk zone \emph {and} PA established within the five-year prediction window (true positive). \textbf {Gold}: predicted high-risk but no PA established within the window (unconfirmed prediction). \textbf {Red}: PA established within the window but pixel not in the top-1\% zone (model miss). \textbf {Grey}: pixels already protected before the test period (excluded from the risk set). The observed category covers all PA designations within the five-year prediction horizon (up to 2024 for 2019 test rows), consistent with the \texttt {transition\_01\_win5} label used for all benchmark metrics. Pixel markers are slightly enlarged for print legibility.\relax }{figure.caption.46}{}}
\newlabel{fig:riskmap_sa_top1@cref}{{[figure][5][]5}{[1][42][]43}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Continuous calibrated transition probabilities from the South America LightGBM model. Each pixel is coloured by its predicted five-year designation probability (square-root stretch from the 25th to the 98th percentile; dark purple = low probability, yellow = high probability). Grey pixels are existing protected areas excluded from the risk set. Probabilities reflect covariate values at the end of the test period.\relax }}{44}{figure.caption.47}\protected@file@percent }
\newlabel{fig:probmap_sa}{{6}{44}{Continuous calibrated transition probabilities from the South America LightGBM model. Each pixel is coloured by its predicted five-year designation probability (square-root stretch from the 25th to the 98th percentile; dark purple = low probability, yellow = high probability). Grey pixels are existing protected areas excluded from the risk set. Probabilities reflect covariate values at the end of the test period.\relax }{figure.caption.47}{}}
