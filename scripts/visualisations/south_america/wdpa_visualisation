#!/usr/bin/env python3
"""
WDPA protected areas visualization for South America (2013-2024).

Inputs:
- GeoTIFF rasters in `data/south_america/ready/WDPA`, named `WDPA_SA_1km_<year>.tif` with binary protection masks.

Process:
- Loads annual protected area rasters, computes coverage statistics, and generates yearly maps, temporal comparisons, and summary plots.

Outputs:
- PNG figures saved to `outputs/south_america/figures/WDPA_vis`.
"""

import numpy as np
import rasterio
import matplotlib.pyplot as plt
from pathlib import Path
import warnings
from matplotlib.colors import ListedColormap

warnings.filterwarnings('ignore')

# Set up paths
PROJECT_ROOT = Path(__file__).resolve().parents[3]
data_dir = PROJECT_ROOT / "data"
# Region-scoped WDPA directory (data/south_america/ready/WDPA)
wdpa_dir = data_dir / "south_america" / "ready" / "WDPA"
output_dir = PROJECT_ROOT / "outputs" / "south_america" / "figures" / "WDPA_vis"
output_dir.mkdir(parents=True, exist_ok=True)

# Years to process
YEARS = range(2000, 2025)

# Color scheme for protected areas
PROTECTED_COLOR = '#2E8B57'  # Sea Green
UNPROTECTED_COLOR = '#F5F5F5'  # Light Gray
BOUNDARY_COLOR = '#000000'  # Black

def load_wdpa_data():
    """Load the WDPA protected area coverage data for all years"""
    print("Loading WDPA protected area coverage data for all years...")
    
    all_data = {}
    
    for year in YEARS:
        wdpa_file = wdpa_dir / f"WDPA_SA_1km_{year}.tif"
        
        if not wdpa_file.exists():
            print(f"   Warning: File not found: {wdpa_file.name}")
            continue
            
        try:
            with rasterio.open(wdpa_file) as src:
                data = src.read()
                
                # WDPA data is single band binary (0 or 1)
                protected_pixels = np.sum(data == 1)
                total_pixels = np.sum(~np.isnan(data))
                protected_percentage = (protected_pixels / total_pixels * 100) if total_pixels > 0 else 0
                
                print(f"   {year}: Shape: {data.shape}, Protected pixels: {protected_pixels:,} ({protected_percentage:.2f}%)")
                
                all_data[year] = {
                    'data': data[0],  # Single band data
                    'src': src,
                    'file_path': wdpa_file,
                    'protected_pixels': protected_pixels,
                    'protected_percentage': protected_percentage
                }
                
        except Exception as e:
            print(f"   Error loading {year}: {e}")
            continue
    
    if not all_data:
        print("   No data loaded successfully")
        return None
    
    print(f"   Successfully loaded {len(all_data)} years")
    return all_data

def create_protected_area_maps(all_data):
    """Create protected area maps for each year"""
    if all_data is None:
        return
    
    print("Creating protected area maps for each year...")
    
    # Create custom colormap for protected areas
    colors = [UNPROTECTED_COLOR, PROTECTED_COLOR]
    cmap = ListedColormap(colors)
    
    for year, data_info in all_data.items():
        data = data_info['data']
        protected_percentage = data_info['protected_percentage']
        
        # Create figure
        fig, ax = plt.subplots(figsize=(12, 10))
        
        # Create visualization
        im = ax.imshow(data, cmap=cmap, aspect='auto', vmin=0, vmax=1)
        
        # Set title with statistics
        ax.set_title(f'Protected Areas Coverage - South America {year}\n'
                    f'Protected Area: {protected_percentage:.2f}% of total land area', 
                    fontsize=14, fontweight='bold', pad=20)
        
        # Add colorbar with custom labels
        cbar = plt.colorbar(im, ax=ax, shrink=0.8, ticks=[0, 1])
        cbar.set_ticklabels(['Not Protected', 'Protected'])
        cbar.set_label('Protection Status', rotation=270, labelpad=20, fontsize=12)
        
        # Remove axis labels for cleaner look
        ax.set_xticks([])
        ax.set_yticks([])
        
        # Add statistics text box
        stats_text = f'Protected Pixels: {data_info["protected_pixels"]:,}\n'
        stats_text += f'Percentage: {protected_percentage:.2f}%\n'
        stats_text += f'Resolution: 1km'
        
        ax.text(0.02, 0.98, stats_text, transform=ax.transAxes, 
                fontsize=10, verticalalignment='top',
                bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))
        
        plt.tight_layout()
        
        # Save the plot
        output_file = output_dir / f"wdpa_coverage_sa_{year}.png"
        plt.savefig(output_file, dpi=300, bbox_inches='tight')
        print(f"   Saved: {output_file.name}")
        
        plt.close()  # Close to free memory

def create_temporal_comparison(all_data):
    """Create temporal comparison of protected area coverage"""
    if all_data is None or len(all_data) < 2:
        return
    
    print("Creating temporal comparison...")
    
    # Extract protected area percentages over time
    years = sorted(all_data.keys())
    percentages = [all_data[year]['protected_percentage'] for year in years]
    pixel_counts = [all_data[year]['protected_pixels'] for year in years]
    
    # Create figure with two subplots
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))
    fig.suptitle('Protected Area Coverage Evolution in South America (2013-2024)', 
                fontsize=16, fontweight='bold')
    
    # Plot 1: Protected area percentage over time
    ax1.plot(years, percentages, marker='o', linewidth=3, markersize=8,
             color=PROTECTED_COLOR, markerfacecolor='white', markeredgewidth=2)
    ax1.set_title('Protected Area Percentage Over Time', fontweight='bold', fontsize=14)
    ax1.set_xlabel('Year', fontsize=12)
    ax1.set_ylabel('Protected Area (%)', fontsize=12)
    ax1.grid(True, alpha=0.3)
    ax1.set_xticks(years)
    
    # Add value labels on points
    for year, value in zip(years, percentages):
        ax1.annotate(f'{value:.2f}%', (year, value), 
                    textcoords="offset points", xytext=(0,10), ha='center', fontsize=10)
    
    # Plot 2: Protected pixel counts over time
    ax2.plot(years, pixel_counts, marker='s', linewidth=3, markersize=8,
             color='#8B4513', markerfacecolor='white', markeredgewidth=2)
    ax2.set_title('Protected Pixel Count Over Time', fontweight='bold', fontsize=14)
    ax2.set_xlabel('Year', fontsize=12)
    ax2.set_ylabel('Protected Pixels', fontsize=12)
    ax2.grid(True, alpha=0.3)
    ax2.set_xticks(years)
    
    # Format y-axis to show millions
    ax2.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'{x/1e6:.1f}M'))
    
    # Add value labels on points
    for year, value in zip(years, pixel_counts):
        ax2.annotate(f'{value/1e6:.1f}M', (year, value), 
                    textcoords="offset points", xytext=(0,10), ha='center', fontsize=10)
    
    plt.tight_layout()
    
    # Save the plot
    output_file = output_dir / "wdpa_temporal_comparison.png"
    plt.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f"   Saved: {output_file.name}")
    
    plt.show()

def create_change_analysis(all_data):
    """Create analysis of protected area changes between years"""
    if all_data is None or len(all_data) < 2:
        return
    
    print("Creating change analysis...")
    
    years = sorted(all_data.keys())
    
    # Calculate year-to-year changes
    changes = []
    for i in range(1, len(years)):
        prev_year = years[i-1]
        curr_year = years[i]
        
        prev_pct = all_data[prev_year]['protected_percentage']
        curr_pct = all_data[curr_year]['protected_percentage']
        change = curr_pct - prev_pct
        
        changes.append({
            'year': curr_year,
            'change_pct': change,
            'prev_pct': prev_pct,
            'curr_pct': curr_pct
        })
    
    # Create figure
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))
    fig.suptitle('Protected Area Change Analysis (2013-2024)', 
                fontsize=16, fontweight='bold')
    
    # Plot 1: Year-to-year percentage changes
    change_years = [c['year'] for c in changes]
    change_values = [c['change_pct'] for c in changes]
    
    colors = ['green' if x > 0 else 'red' for x in change_values]
    bars = ax1.bar(change_years, change_values, color=colors, alpha=0.7, edgecolor='black')
    
    ax1.set_title('Year-to-Year Change in Protected Area Percentage', fontweight='bold')
    ax1.set_xlabel('Year', fontsize=12)
    ax1.set_ylabel('Change in Protected Area (%)', fontsize=12)
    ax1.grid(True, alpha=0.3)
    ax1.axhline(y=0, color='black', linestyle='-', linewidth=0.5)
    
    # Add value labels on bars
    for bar, value in zip(bars, change_values):
        height = bar.get_height()
        ax1.annotate(f'{value:+.3f}%', 
                    xy=(bar.get_x() + bar.get_width()/2, height),
                    xytext=(0, 3 if height > 0 else -15), 
                    textcoords="offset points", ha='center', va='bottom' if height > 0 else 'top')
    
    # Plot 2: Cumulative growth
    cumulative_growth = [all_data[year]['protected_percentage'] - all_data[years[0]]['protected_percentage'] 
                        for year in years]
    
    ax2.plot(years, cumulative_growth, marker='o', linewidth=3, markersize=8,
             color=PROTECTED_COLOR, markerfacecolor='white', markeredgewidth=2)
    ax2.set_title('Cumulative Growth Since 2013', fontweight='bold')
    ax2.set_xlabel('Year', fontsize=12)
    ax2.set_ylabel('Cumulative Change (%)', fontsize=12)
    ax2.grid(True, alpha=0.3)
    ax2.axhline(y=0, color='black', linestyle='--', linewidth=0.5)
    
    # Add value labels on points
    for year, value in zip(years, cumulative_growth):
        ax2.annotate(f'{value:+.2f}%', (year, value), 
                    textcoords="offset points", xytext=(0,10), ha='center', fontsize=10)
    
    plt.tight_layout()
    
    # Save the plot
    output_file = output_dir / "wdpa_change_analysis.png"
    plt.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f"   Saved: {output_file.name}")
    
    plt.show()

def create_summary_statistics(all_data):
    """Create summary statistics across all years"""
    if all_data is None:
        return
    
    print("Creating summary statistics...")
    
    # Extract statistics
    years = sorted(all_data.keys())
    percentages = [all_data[year]['protected_percentage'] for year in years]
    pixel_counts = [all_data[year]['protected_pixels'] for year in years]
    
    # Calculate summary statistics
    stats = {
        'mean_pct': np.mean(percentages),
        'std_pct': np.std(percentages),
        'min_pct': np.min(percentages),
        'max_pct': np.max(percentages),
        'total_change_pct': percentages[-1] - percentages[0],
        'mean_pixels': np.mean(pixel_counts),
        'total_change_pixels': pixel_counts[-1] - pixel_counts[0]
    }
    
    # Create figure
    fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(16, 12))
    fig.suptitle('WDPA Protected Areas - Summary Statistics (2013-2024)', 
                fontsize=16, fontweight='bold')
    
    # Plot 1: Protected area percentage distribution
    ax1.hist(percentages, bins=8, color=PROTECTED_COLOR, alpha=0.7, edgecolor='black')
    ax1.axvline(stats['mean_pct'], color='red', linestyle='--', linewidth=2, label=f"Mean: {stats['mean_pct']:.2f}%")
    ax1.set_title('Distribution of Protected Area Percentages', fontweight='bold')
    ax1.set_xlabel('Protected Area (%)', fontsize=12)
    ax1.set_ylabel('Frequency', fontsize=12)
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # Plot 2: Protected pixel count distribution
    ax2.hist(pixel_counts, bins=8, color='#8B4513', alpha=0.7, edgecolor='black')
    ax2.axvline(stats['mean_pixels'], color='red', linestyle='--', linewidth=2, 
               label=f"Mean: {stats['mean_pixels']/1e6:.1f}M pixels")
    ax2.set_title('Distribution of Protected Pixel Counts', fontweight='bold')
    ax2.set_xlabel('Protected Pixels', fontsize=12)
    ax2.set_ylabel('Frequency', fontsize=12)
    ax2.legend()
    ax2.grid(True, alpha=0.3)
    ax2.xaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'{x/1e6:.1f}M'))
    
    # Plot 3: Summary statistics table
    ax3.axis('off')
    stats_text = f"""
    Protected Area Coverage Statistics (2013-2024)
    
    Mean Coverage: {stats['mean_pct']:.2f}% ± {stats['std_pct']:.2f}%
    Range: {stats['min_pct']:.2f}% - {stats['max_pct']:.2f}%
    Total Change: {stats['total_change_pct']:+.2f}%
    
    Mean Protected Pixels: {stats['mean_pixels']/1e6:.1f}M
    Total Pixel Change: {stats['total_change_pixels']/1e6:+.1f}M
    
    Years Analyzed: {len(years)}
    Time Period: {years[0]} - {years[-1]}
    """
    
    ax3.text(0.1, 0.9, stats_text, transform=ax3.transAxes, fontsize=12,
             verticalalignment='top', fontfamily='monospace',
             bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.8))
    
    # Plot 4: Trend analysis
    from scipy import stats as scipy_stats
    slope, intercept, r_value, p_value, std_err = scipy_stats.linregress(years, percentages)
    
    ax4.plot(years, percentages, 'o-', color=PROTECTED_COLOR, linewidth=2, markersize=6, label='Data')
    ax4.plot(years, [slope*year + intercept for year in years], '--', color='red', linewidth=2, 
             label=f'Trend: {slope:.4f}%/year (R²={r_value**2:.3f})')
    ax4.set_title('Protected Area Trend Analysis', fontweight='bold')
    ax4.set_xlabel('Year', fontsize=12)
    ax4.set_ylabel('Protected Area (%)', fontsize=12)
    ax4.legend()
    ax4.grid(True, alpha=0.3)
    
    plt.tight_layout()
    
    # Save the plot
    output_file = output_dir / "wdpa_summary_statistics.png"
    plt.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f"   Saved: {output_file.name}")
    
    plt.show()

def create_pa_coverage_chart(all_data):
    """Single-panel publication-quality chart: cumulative PA coverage (%) 2000-2030.

    Historical data (2000-2024) from WDPA rasters, then three scenario projections
    (BAU, Moderate, 30x30) extend to 2030.  Scenario parameters are read from
    pathway_summary.json.

    This is the thesis figure referenced at §5.3 (Descriptive Statistics).
    """
    import json

    if all_data is None or len(all_data) < 2:
        return

    print("Creating single-panel PA coverage chart with scenario projections...")

    # ── Historical series ────────────────────────────────────────────────────
    years = sorted(all_data.keys())
    percentages = [all_data[year]['protected_percentage'] for year in years]

    # ── Scenario data from pathway_summary.json ──────────────────────────────
    pathway_json = (
        PROJECT_ROOT / "outputs" / "south_america" / "results" /
        "forward" / "pathway" / "pathway_summary.json"
    )

    # Align the plotted historical series with the equal-area 2024 coverage
    # baseline used in the thesis text and pathway tables. The annual raster series
    # provides the trend; the pathway summary provides the area-corrected level.
    cov_2024 = all_data.get(2024, all_data[years[-1]])["protected_percentage"]

    bau_rate_pct_yr   = 0.061    # % per year (from region_milestone)
    moderate_target   = 27.7831  # %
    target_30x30      = 30.0
    proj_years = list(range(2024, 2031))  # 2024 to 2030

    if pathway_json.exists():
        with open(pathway_json) as fh:
            pj = json.load(fh)
        milestone = pj.get("region_milestone", [{}])[0]

        def _as_pct(value, fallback):
            """Accept either fraction (0-1) or percent (0-100)."""
            try:
                v = float(value)
            except Exception:
                v = float(fallback)
            return v * 100.0 if v <= 1.0 else v

        bau_rate_pct_yr = float(milestone.get("bau_annual_rate_pct_yr", bau_rate_pct_yr))
        moderate_target = _as_pct(pj.get("moderate_target_pct", moderate_target), moderate_target)
        area_cov_2024 = _as_pct(
            pj.get("coverage_pct_2024", milestone.get("current_pct_2024", cov_2024)),
            cov_2024,
        )
        if cov_2024 > 0:
            scale = area_cov_2024 / cov_2024
            percentages = [p * scale for p in percentages]
            cov_2024 = area_cov_2024

    def _linear(start, end, years_list):
        n = len(years_list) - 1
        return [start + (end - start) * i / n for i in range(len(years_list))]

    bau_end   = cov_2024 + bau_rate_pct_yr * (2030 - 2024)
    bau_proj  = _linear(cov_2024, bau_end, proj_years)
    mod_proj  = _linear(cov_2024, moderate_target, proj_years)
    t30_proj  = _linear(cov_2024, target_30x30, proj_years)

    # ── Plot ─────────────────────────────────────────────────────────────────
    fig, ax = plt.subplots(figsize=(8, 4.2))

    # Historical line
    ax.plot(years, percentages,
            color=PROTECTED_COLOR, linewidth=2.2, marker='o',
            markersize=3.5, markerfacecolor='white', markeredgewidth=1.5,
            zorder=4, label='Historical (WDPA)')

    # Vertical separator at 2024
    ax.axvline(2024, color='#888888', linewidth=0.8, linestyle=':', zorder=2)
    ax.text(2024.1, 1.5, 'Projection\n2025–2030', fontsize=7.5,
            color='#888888', va='bottom')

    # Scenario projections (dashed lines from 2024)
    ax.plot(proj_years, t30_proj, color='#CC2222', linewidth=1.8,
            linestyle='--', zorder=3, label='30×30 scenario')
    ax.plot(proj_years, mod_proj, color='#E08214', linewidth=1.8,
            linestyle='--', zorder=3, label='Moderate scenario')
    ax.plot(proj_years, bau_proj, color='#5E8FA2', linewidth=1.6,
            linestyle='--', zorder=3, label='BAU scenario')

    # 30x30 target reference line (horizontal)
    ax.axhline(30, color='#CC2222', linewidth=0.7, linestyle=':',
               alpha=0.5, zorder=2)
    ax.text(2029.5, 30.2, '30%', fontsize=7.5, color='#CC2222',
            ha='right', va='bottom')

    ax.set_xlim(years[0] - 0.5, 2030.5)
    ax.set_ylim(0, 32)
    ax.set_xlabel('Year', fontsize=11)
    ax.set_ylabel('Protected area (% of land)', fontsize=11)
    ax.set_xticks([2000, 2005, 2010, 2015, 2020, 2024, 2027, 2030])
    ax.grid(True, alpha=0.2, linestyle='--', linewidth=0.5)
    ax.legend(fontsize=8.5, framealpha=0.88, loc='upper left')
    ax.tick_params(labelsize=9.5)

    # Annotate start (2000) — placed above the data point to avoid overlap
    ax.annotate(f'{percentages[0]:.1f}%', (years[0], percentages[0]),
                textcoords='offset points', xytext=(4, 8),
                fontsize=8, color=PROTECTED_COLOR, fontweight='bold')
    # Annotate 2024 observed
    ax.annotate(f'{percentages[-1]:.1f}%', (years[-1], percentages[-1]),
                textcoords='offset points', xytext=(-32, 7),
                fontsize=8, color=PROTECTED_COLOR, fontweight='bold')

    plt.tight_layout()

    output_file = output_dir / 'sa_pa_coverage_pct.pdf'
    plt.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f'   Saved: {output_file.name}')
    plt.close()

    # Return scenario parameters so the dual chart can reuse them
    return {
        'years': years,
        'percentages': percentages,
        'cov_2024': cov_2024,
        'bau_rate_pct_yr': bau_rate_pct_yr,
        'moderate_target': moderate_target,
        'target_30x30': target_30x30,
        'proj_years': proj_years,
        'bau_proj': bau_proj,
        'mod_proj': mod_proj,
        't30_proj': t30_proj,
    }


def create_pa_coverage_dual_chart(all_data):
    """Two-panel figure: cumulative PA coverage (left) + annual new designation rate (right).

    Saved as sa_pa_coverage_dual.pdf for the thesis Figure 6 (§5.5.1).
    The left panel is identical to create_pa_coverage_chart; the right panel shows
    annual change in coverage (percentage points / yr) derived from successive WDPA
    rasters, revealing the rapid-designation phase (2000–2013), plateau, and post-2018
    contraction.
    """
    import json

    if all_data is None or len(all_data) < 2:
        return

    print("Creating dual-panel PA coverage chart...")

    # ── Historical series ──────────────────────────────────────────────────────
    years = sorted(all_data.keys())
    percentages = [all_data[year]['protected_percentage'] for year in years]

    # ── Scenario parameters (reuse logic from single-panel version) ────────────
    pathway_json = (
        PROJECT_ROOT / "outputs" / "south_america" / "results" /
        "forward" / "pathway" / "pathway_summary.json"
    )
    cov_2024 = all_data.get(2024, all_data[years[-1]])["protected_percentage"]
    bau_rate_pct_yr = 0.061
    moderate_target = 27.7831
    target_30x30    = 30.0
    proj_years      = list(range(2024, 2031))
    total_land_km2   = None

    if pathway_json.exists():
        with open(pathway_json) as fh:
            pj = json.load(fh)
        milestone = pj.get("region_milestone", [{}])[0]

        def _as_pct(value, fallback):
            try:
                v = float(value)
            except Exception:
                v = float(fallback)
            return v * 100.0 if v <= 1.0 else v

        bau_rate_pct_yr = float(milestone.get("bau_annual_rate_pct_yr", bau_rate_pct_yr))
        moderate_target = _as_pct(pj.get("moderate_target_pct", moderate_target), moderate_target)
        area_cov_2024 = _as_pct(
            pj.get("coverage_pct_2024", milestone.get("current_pct_2024", cov_2024)),
            cov_2024,
        )
        if cov_2024 > 0:
            scale = area_cov_2024 / cov_2024
            percentages = [p * scale for p in percentages]
            cov_2024 = area_cov_2024
        try:
            total_land_km2 = float(pj.get("total_land_km2"))
        except Exception:
            total_land_km2 = None

    def _linear(start, end, years_list):
        n = len(years_list) - 1
        return [start + (end - start) * i / n for i in range(len(years_list))]

    bau_end  = cov_2024 + bau_rate_pct_yr * (2030 - 2024)
    bau_proj = _linear(cov_2024, bau_end, proj_years)
    mod_proj = _linear(cov_2024, moderate_target, proj_years)
    t30_proj = _linear(cov_2024, target_30x30, proj_years)

    # ── Annual new designation rate (pp / yr) ─────────────────────────────────
    # Computed as the year-on-year change in cumulative coverage percentage.
    # We need total land area to convert pp to km².
    total_pixels = None
    first_year = years[0]
    wdpa_file = PROJECT_ROOT / "data" / "south_america" / "ready" / "WDPA" / f"WDPA_SA_1km_{first_year}.tif"
    if wdpa_file.exists():
        import rasterio as _rio
        with _rio.open(wdpa_file) as src:
            data = src.read(1)
            total_pixels = int(np.sum(~np.isnan(data)))

    annual_years = years[1:]            # 2001–2024
    annual_delta_pp = [percentages[i] - percentages[i - 1] for i in range(1, len(years))]

    if total_land_km2 is not None:
        annual_km2 = [d / 100.0 * total_land_km2 for d in annual_delta_pp]
        right_ylabel = 'New designations (km²/yr)'
        right_values = annual_km2
        right_fmt    = lambda v: f'{v / 1000:.0f}k'
    elif total_pixels is not None:
        # Fallback only: approximate 1 pixel ≈ 1 km².
        annual_km2 = [d / 100.0 * total_pixels for d in annual_delta_pp]
        right_ylabel = 'New designations (km²/yr)'
        right_values = annual_km2
        right_fmt    = lambda v: f'{v / 1000:.0f}k'
    else:
        right_ylabel = 'New designations (pp/yr)'
        right_values = annual_delta_pp
        right_fmt    = lambda v: f'{v:.3f}'

    # ── Layout ────────────────────────────────────────────────────────────────
    fig, (ax_left, ax_right) = plt.subplots(1, 2, figsize=(13, 4.2))

    # ── Left panel: cumulative coverage ───────────────────────────────────────
    ax_left.plot(years, percentages,
                 color=PROTECTED_COLOR, linewidth=2.2, marker='o',
                 markersize=3.5, markerfacecolor='white', markeredgewidth=1.5,
                 zorder=4, label='Historical (WDPA)')
    ax_left.axvline(2024, color='#888888', linewidth=0.8, linestyle=':', zorder=2)
    ax_left.text(2024.1, 1.5, 'Projection\n2025–2030', fontsize=7.5,
                 color='#888888', va='bottom')
    ax_left.plot(proj_years, t30_proj, color='#CC2222', linewidth=1.8,
                 linestyle='--', zorder=3, label='30×30 scenario')
    ax_left.plot(proj_years, mod_proj, color='#E08214', linewidth=1.8,
                 linestyle='--', zorder=3, label='Moderate scenario')
    ax_left.plot(proj_years, bau_proj, color='#5E8FA2', linewidth=1.6,
                 linestyle='--', zorder=3, label='BAU scenario')
    ax_left.axhline(30, color='#CC2222', linewidth=0.7, linestyle=':',
                    alpha=0.5, zorder=2)
    ax_left.text(2029.5, 30.2, '30%', fontsize=7.5, color='#CC2222',
                 ha='right', va='bottom')
    ax_left.set_xlim(years[0] - 0.5, 2030.5)
    ax_left.set_ylim(0, 32)
    ax_left.set_xlabel('Year', fontsize=11)
    ax_left.set_ylabel('Protected area (% of land)', fontsize=11)
    ax_left.set_xticks([2000, 2005, 2010, 2015, 2020, 2024, 2027, 2030])
    ax_left.grid(True, alpha=0.2, linestyle='--', linewidth=0.5)
    ax_left.legend(fontsize=8.5, framealpha=0.88, loc='upper left')
    ax_left.tick_params(labelsize=9.5)
    ax_left.annotate(f'{percentages[0]:.1f}%', (years[0], percentages[0]),
                     textcoords='offset points', xytext=(4, 8),
                     fontsize=8, color=PROTECTED_COLOR, fontweight='bold')
    ax_left.annotate(f'{percentages[-1]:.1f}%', (years[-1], percentages[-1]),
                     textcoords='offset points', xytext=(-32, 7),
                     fontsize=8, color=PROTECTED_COLOR, fontweight='bold')
    ax_left.set_title('(a) Cumulative PA coverage', fontsize=10.5, fontweight='bold', pad=6)

    # ── Right panel: annual new designation rate ───────────────────────────────
    bar_colors = ['#CC2222' if v < 0 else PROTECTED_COLOR for v in right_values]
    ax_right.bar(annual_years, right_values, color=bar_colors, alpha=0.78,
                 width=0.8, zorder=3)
    ax_right.axhline(0, color='black', linewidth=0.6, zorder=4)
    # Mark Bolsonaro period (2019–2022)
    ax_right.axvspan(2018.5, 2022.5, color='#E08214', alpha=0.12, zorder=1,
                     label='2019–2022 (policy shock)')
    ax_right.legend(fontsize=8, framealpha=0.85, loc='upper right')
    ax_right.set_xlabel('Year', fontsize=11)
    ax_right.set_ylabel(right_ylabel, fontsize=11)
    ax_right.set_xticks([2001, 2005, 2010, 2015, 2019, 2024])
    ax_right.grid(True, axis='y', alpha=0.2, linestyle='--', linewidth=0.5)
    ax_right.tick_params(labelsize=9.5)
    ax_right.set_title('(b) Annual new designations', fontsize=10.5, fontweight='bold', pad=6)

    plt.tight_layout()

    output_file = output_dir / 'sa_pa_coverage_dual.pdf'
    plt.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f'   Saved: {output_file.name}')
    plt.close()


