#!/usr/bin/env python3
"""
HNTL nighttime lights visualisation for the USA (2000-2020).

Inputs:
    - GeoTIFF rasters in ``data/usa/ready/HNTL``, named
      ``HNTL_USA_1km_<year>.tif`` for years 2000-2020.

Process:
    - Loads annual HNTL radiance rasters, computes shared statistics, and
      generates overview, change, and temporal visualisations.

Outputs:
    - PNG figures saved to ``outputs/usa/figures/HNTL_vis``.
"""

import numpy as np
import rasterio
import matplotlib.pyplot as plt
from pathlib import Path
import warnings

warnings.filterwarnings("ignore")

# Paths
PROJECT_ROOT = Path(__file__).resolve().parents[3]
HNTL_DIR = PROJECT_ROOT / "data" / "usa" / "ready" / "HNTL"
OUTPUT_DIR = PROJECT_ROOT / "outputs" / "usa" / "figures" / "HNTL_vis"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

YEARS = list(range(2000, 2021))
HNTL_COLORMAP = "plasma"
HNTL_COLOR = "#FFD700"


def load_hntl_data():
    """Load all available HNTL yearly rasters."""
    print("Loading HNTL nighttime lights data...")
    all_data = {}

    for year in YEARS:
        path = HNTL_DIR / f"HNTL_USA_1km_{year}.tif"
        if not path.exists():
            print(f"  Warning: {path.name} not found")
            continue

        with rasterio.open(path) as src:
            data = src.read(1)

        print(f"  {year}: shape={data.shape}, valid={np.sum(~np.isnan(data)):,}")
        all_data[year] = data

    if not all_data:
        print("  No data loaded.")
        return None

    print(f"  Loaded {len(all_data)} years")
    return all_data


def create_overview_maps(all_data):
    """Create an overview map for each year."""
    print("Creating per-year overview maps...")

    # Global 95th percentile for consistent colour scaling
    all_valid = np.concatenate([d[~np.isnan(d)] for d in all_data.values()])
    vmax = float(np.percentile(all_valid, 95))

    for year, data in all_data.items():
        fig, ax = plt.subplots(figsize=(14, 8))

        valid = data[~np.isnan(data)]
        mean_v = float(np.mean(valid))
        max_v = float(np.max(valid))
        p95 = float(np.percentile(valid, 95))

        im = ax.imshow(data, cmap=HNTL_COLORMAP, vmin=0, vmax=vmax,
                       interpolation="nearest")
        ax.set_title(f"HNTL Nighttime Lights — USA {year}\n"
                     f"Mean: {mean_v:.3f}  Max: {max_v:.3f}  95th%: {p95:.3f}",
                     fontsize=13, fontweight="bold")
        ax.set_axis_off()
        cbar = plt.colorbar(im, ax=ax, shrink=0.7)
        cbar.set_label("Avg Radiance (nW/cm\u00b2/sr)", rotation=270, labelpad=15)

        plt.tight_layout()
        out = OUTPUT_DIR / f"hntl_usa_{year}_overview.png"
        plt.savefig(out, dpi=300, bbox_inches="tight")
        plt.close()
        print(f"  Saved: {out.name}")


def create_temporal_comparison(all_data):
    """Plot temporal trends (mean, max, std, total radiance)."""
    if len(all_data) < 2:
        return

    print("Creating temporal comparison...")
    years = sorted(all_data.keys())
    stats = {y: {
        "mean": float(np.nanmean(d)),
        "max": float(np.nanmax(d)),
        "std": float(np.nanstd(d)),
        "total": float(np.nansum(d)),
    } for y, d in all_data.items()}

    fig, axes = plt.subplots(2, 2, figsize=(16, 10))
    fig.suptitle("HNTL Nighttime Lights — Temporal Trends (USA)",
                 fontsize=15, fontweight="bold")

    metrics = [
        ("mean", "Mean Radiance", HNTL_COLOR, "o"),
        ("max", "Max Radiance", "red", "s"),
        ("std", "Std Deviation", "green", "^"),
        ("total", "Total Radiance", "purple", "d"),
    ]

    for ax, (key, label, color, marker) in zip(axes.flatten(), metrics):
        vals = [stats[y][key] for y in years]
        ax.plot(years, vals, marker=marker, linewidth=2, markersize=6, color=color)
        ax.set_title(label, fontweight="bold")
        ax.set_xlabel("Year")
        ax.set_ylabel(label)
        ax.grid(True, alpha=0.3)

    plt.tight_layout()
    out = OUTPUT_DIR / "hntl_usa_temporal_comparison.png"
    plt.savefig(out, dpi=300, bbox_inches="tight")
    plt.close()
    print(f"  Saved: {out.name}")


def create_change_detection(all_data):
    """Compare first and last year available."""
    if len(all_data) < 2:
        return

    print("Creating change detection...")
    first_yr = min(all_data)
    last_yr = max(all_data)
    first = all_data[first_yr]
    last = all_data[last_yr]
    change = last - first

    # Consistent vmax for radiance panels
    all_valid = np.concatenate([first[~np.isnan(first)], last[~np.isnan(last)]])
    rad_vmax = float(np.percentile(all_valid, 95))
    chg_valid = change[~np.isnan(change)]
    chg_vmax = float(np.percentile(np.abs(chg_valid), 95))

    fig, axes = plt.subplots(1, 3, figsize=(20, 7))
    fig.suptitle(f"HNTL Change Detection ({first_yr} \u2192 {last_yr}) — USA",
                 fontsize=15, fontweight="bold")

    im1 = axes[0].imshow(first, cmap=HNTL_COLORMAP, vmin=0, vmax=rad_vmax,
                          interpolation="nearest")
    axes[0].set_title(f"{first_yr}", fontweight="bold")
    axes[0].set_axis_off()
    plt.colorbar(im1, ax=axes[0], shrink=0.7)

    im2 = axes[1].imshow(last, cmap=HNTL_COLORMAP, vmin=0, vmax=rad_vmax,
                          interpolation="nearest")
    axes[1].set_title(f"{last_yr}", fontweight="bold")
    axes[1].set_axis_off()
    plt.colorbar(im2, ax=axes[1], shrink=0.7)

    im3 = axes[2].imshow(change, cmap="RdBu_r", vmin=-chg_vmax, vmax=chg_vmax,
                          interpolation="nearest")
    axes[2].set_title(f"Change ({last_yr}\u2013{first_yr})", fontweight="bold")
    axes[2].set_axis_off()
    plt.colorbar(im3, ax=axes[2], shrink=0.7)

    plt.tight_layout()
    out = OUTPUT_DIR / f"hntl_usa_change_{first_yr}_{last_yr}.png"
    plt.savefig(out, dpi=300, bbox_inches="tight")
    plt.close()
    print(f"  Saved: {out.name}")


def main():
    print("HNTL Nighttime Lights Visualisation — USA")
    print("=" * 60)

    all_data = load_hntl_data()
    if all_data is None:
        print("No data. Exiting.")
        return

    create_overview_maps(all_data)
    create_temporal_comparison(all_data)
    create_change_detection(all_data)

    print("\nVisualisation complete!")


if __name__ == "__main__":
    main()
