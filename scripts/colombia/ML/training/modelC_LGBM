    train_paths: list[Path],
    val_paths: list[Path],
    feature_cols: list,
    target_col: str,
    train_years: tuple[int, int],
    val_years: tuple[int, int],
    fold_idx: int,
    best_params: Dict[str, Any],
    use_wandb: bool,
) -> Dict[str, Any]:
    """
    Train and evaluate a single CV fold.
    
    Returns:
        Dictionary containing fold metrics and metadata
    """
    print(f"\n{'='*70}")
    print(f"CV FOLD {fold_idx + 1}/{len(CV_FOLDS)}")
    print(f"Train: {train_years[0]}-{train_years[1]} → Val: {val_years[0]}-{val_years[1]}")
    print(f"{'='*70}")
    
    # Load train data
    X_train, y_train, train_years_array, train_pos, train_neg, train_years_list = load_numpy_arrays_from_multiple_files(
        train_paths, feature_cols, target_col, f"Fold {fold_idx+1} Train", year_range=train_years
    )
    n_train_samples = len(X_train)
    
    # Load val data (filter to LAST_LABEL_YEAR to avoid right-censored labels)
    val_year_range = (val_years[0], min(val_years[1], LAST_LABEL_YEAR))
    X_val, y_val, val_years_array, val_pos, val_neg, val_years_list = load_numpy_arrays_from_multiple_files(
        val_paths, feature_cols, target_col, f"Fold {fold_idx+1} Val", year_range=val_year_range
    )
    n_val_samples = len(X_val)
    
    print(f"\nFold {fold_idx+1}: Train {n_train_samples:,} samples, Val {n_val_samples:,} samples (val years {val_year_range[0]}-{val_year_range[1]}, capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})")
    
    # Compute sample weights for training data (time-based weighting)
    # Weight range is always based on full dataset: 2000 (weight 0.5) to 2014 (weight 1.0)
    train_weights = compute_year_weights(train_years_array, min_year=2000, max_year=2014)
    print(f"  Training sample weights: min={train_weights.min():.3f}, max={train_weights.max():.3f}, mean={train_weights.mean():.3f}")
    
    # Use scale_pos_weight from best_params
    scale_pos_weight = best_params.get("scale_pos_weight", None)
    
    # Train model
    train_params = best_params.copy()
    num_boost_round_val = train_params.pop("num_boost_round", train_params.pop("n_estimators", 3000))
    train_params.pop("n_estimators", None)
    train_params["is_unbalance"] = False
    
    print(f"  Creating datasets...")
    train_dataset = lgb.Dataset(X_train, label=y_train, weight=train_weights, free_raw_data=True)
    del X_train, y_train, train_years_array, train_weights; gc.collect()
    
    val_dataset = lgb.Dataset(X_val, label=y_val, free_raw_data=True, reference=train_dataset)
    
    print(f"  Training...")
    train_start = time.time()
    lgb_model = lgb.train(
        train_params,
        train_dataset,
        num_boost_round=num_boost_round_val,
        valid_sets=[val_dataset],
        valid_names=["val"],
        callbacks=[lgb.early_stopping(500), lgb.log_evaluation(100)]
    )
    train_time = time.time() - train_start
    best_iteration = lgb_model.best_iteration
    
    del train_dataset, val_dataset; gc.collect()
    
    # Evaluate on validation set
    val_start = time.time()
    y_val_proba = lgb_model.predict(X_val, num_iteration=best_iteration if best_iteration else None)
    val_time = time.time() - val_start
    
    fold_metrics = compute_metrics(y_val, y_val_proba)
    
    print(f"\nFold {fold_idx+1} Validation: ROC-AUC {fold_metrics['roc_auc']:.4f}, "
          f"PR-AUC {fold_metrics['pr_auc']:.4f}, "
          f"P@1% {fold_metrics['precision_at_1pct']:.4f}, "
          f"P@5% {fold_metrics['precision_at_5pct']:.4f}, "
          f"P@10% {fold_metrics['precision_at_10pct']:.4f}")
    
    if use_wandb:
        wandb.log({
            **{f"cv_fold_{fold_idx+1}/{k}": v for k, v in fold_metrics.items()},
            f"cv_fold_{fold_idx+1}/n_train": int(n_train_samples),
            f"cv_fold_{fold_idx+1}/n_val": int(n_val_samples),
            f"cv_fold_{fold_idx+1}/train_time_seconds": train_time,
            f"cv_fold_{fold_idx+1}/val_time_seconds": val_time,
        })
    
    # Clean up
    del X_val, y_val, val_years_array, y_val_proba, lgb_model; gc.collect()
    
    return {
        "fold_idx": fold_idx,
        "train_years": list(train_years),
        "val_years": list(val_years),
        "n_train_samples": int(n_train_samples),
        "n_val_samples": int(n_val_samples),
        "train_positives": int(train_pos),
        "train_negatives": int(train_neg),
        "val_positives": int(val_pos),
        "val_negatives": int(val_neg),
        "train_time_seconds": train_time,
        "val_time_seconds": val_time,
        "best_iteration": int(best_iteration) if best_iteration is not None else None,
        "metrics": fold_metrics,
    }


def aggregate_cv_metrics(cv_results: list[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Aggregate metrics across CV folds.
    Computes mean and std for all metrics.
    """
    metrics_keys = cv_results[0]["metrics"].keys()
    
    aggregated = {}
    for key in metrics_keys:
        values = [fold["metrics"][key] for fold in cv_results]
        aggregated[f"{key}_mean"] = float(np.mean(values))
        aggregated[f"{key}_std"] = float(np.std(values))
        aggregated[f"{key}_values"] = values  # Store individual fold values
    
    # Also aggregate sample sizes
    aggregated["n_train_mean"] = float(np.mean([fold.get("n_train_samples", fold["train_positives"] + fold["train_negatives"]) for fold in cv_results]))
    aggregated["n_val_mean"] = float(np.mean([fold.get("n_val_samples", fold["val_positives"] + fold["val_negatives"]) for fold in cv_results]))
    
    return aggregated


def phase1_training(
    train_path: Path, val_path: Path, params_path: Optional[Path], feature_cols: list, keep_cols_train: list,
    best_params: Dict[str, Any], timestamp: str, model_dir: Path, output_dir: Path, use_wandb: bool, target_col: str,
) -> tuple[Path, Dict[str, Any], Dict[str, Any], float, float, int, int, int, Dict[str, Any], Dict[str, Any]]:
    """
    Phase 1: Training with temporal cross-validation.
    
    Steps:
    1. Run temporal CV folds to assess model stability
    2. Train final model on full train+val data (2000-2017)
    3. Evaluate final model on val set (2015-2017) for consistency check
    
    Returns:
        Tuple including CV results as additional element
    """
    print("\n" + "="*70 + "\nPHASE 1: TRAINING WITH TEMPORAL CROSS-VALIDATION\n" + "="*70)
    report_memory_usage("start of Phase 1")
    
    # =============================================================================
    # STEP A: TEMPORAL CROSS-VALIDATION
    # =============================================================================
    print("\n" + "="*70 + "\nSTEP A: TEMPORAL CROSS-VALIDATION\n" + "="*70)
    
    # For CV, we need data from both train and val files (2000-2017)
    # Each fold will filter the appropriate year ranges
    cv_train_paths = [train_path, val_path]  # Both files contain data needed for CV
    cv_val_paths = [train_path, val_path]    # Same, we filter by year_range
    
    cv_results = []
    for fold_idx, (train_years, val_years) in enumerate(CV_FOLDS):
        fold_result = train_single_cv_fold(
            cv_train_paths, cv_val_paths, feature_cols, target_col,
            train_years, val_years, fold_idx, best_params, use_wandb
        )
        cv_results.append(fold_result)
        gc.collect()
    
    # Aggregate CV metrics
    cv_aggregated = aggregate_cv_metrics(cv_results)
    
    print("\n" + "="*70)
    print("TEMPORAL CV RESULTS (Aggregated)")
    print("="*70)
    print(f"ROC-AUC: {cv_aggregated['roc_auc_mean']:.4f} ± {cv_aggregated['roc_auc_std']:.4f}")
    print(f"PR-AUC:  {cv_aggregated['pr_auc_mean']:.4f} ± {cv_aggregated['pr_auc_std']:.4f}")
    print(f"P@1%:    {cv_aggregated['precision_at_1pct_mean']:.4f} ± {cv_aggregated['precision_at_1pct_std']:.4f}")
    print(f"P@5%:    {cv_aggregated['precision_at_5pct_mean']:.4f} ± {cv_aggregated['precision_at_5pct_std']:.4f}")
    print(f"P@10%:   {cv_aggregated['precision_at_10pct_mean']:.4f} ± {cv_aggregated['precision_at_10pct_std']:.4f}")
    print(f"Lift@1%: {cv_aggregated['lift_at_1pct_mean']:.2f} ± {cv_aggregated['lift_at_1pct_std']:.2f}")
    print(f"Lift@5%: {cv_aggregated['lift_at_5pct_mean']:.2f} ± {cv_aggregated['lift_at_5pct_std']:.2f}")
    print(f"Lift@10%: {cv_aggregated['lift_at_10pct_mean']:.2f} ± {cv_aggregated['lift_at_10pct_std']:.2f}")
    print("="*70)
    
    if use_wandb:
        wandb.log({
            **{f"cv_aggregated/{k}": v for k, v in cv_aggregated.items() if not k.endswith("_values")}
        })
    
    # =============================================================================
    # STEP B: FINAL MODEL TRAINING (Full train+val: 2000-2017)
    # =============================================================================
    print("\n" + "="*70 + "\nSTEP B: FINAL MODEL TRAINING\n" + "="*70)
    print(f"Training final model on full dataset: {TRAIN_YEARS[0]}-{VAL_YEARS[1]}")
    report_memory_usage("before final model training")
    
    # Load full training data (2000-2017) from both files
    print(f"\nLoading full training data ({TRAIN_YEARS[0]}-{VAL_YEARS[1]})...")
    X_train_full, y_train_full, train_years_array_full, train_pos_full, train_neg_full, train_years_full = load_numpy_arrays_from_multiple_files(
        [train_path, val_path], feature_cols, target_col, "full_train", 
        year_range=(TRAIN_YEARS[0], VAL_YEARS[1])
    )
    n_train_full = len(y_train_full)
    
    # Load validation data for final evaluation (2015-2017)
    # Filter to LAST_LABEL_YEAR to avoid right-censored labels
    val_year_range = (VAL_YEARS[0], min(VAL_YEARS[1], LAST_LABEL_YEAR))
    print(f"\nLoading validation data ({val_year_range[0]}-{val_year_range[1]}) (capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})...")
    X_val, y_val, val_years_array, val_pos, val_neg, val_years = load_numpy_arrays_two_pass(
        val_path, feature_cols, target_col, "val_colombia_win5.parquet", year_range=val_year_range)
    
    train_stats = {
        "n_train": n_train_full,
        "train_positives": int(train_pos_full),
        "train_negatives": int(train_neg_full),
        "train_positive_pct": float(train_pos_full / max(n_train_full, 1) * 100.0),
        "train_years": f"{train_years_full[0]}-{train_years_full[-1]}",
    }
    report_memory_usage("after loading final data")
    
    print(f"\nFinal model training: train ({TRAIN_YEARS[0]}-{VAL_YEARS[1]}): {len(X_train_full):,} rows, "
          f"val ({VAL_YEARS[0]}-{VAL_YEARS[1]}): {len(X_val):,} rows")
    
    # Compute sample weights for training data (time-based weighting)
    # Weight range is always based on full dataset: 2000 (weight 0.5) to 2014 (weight 1.0)
    # For years beyond 2014 (2015-2017), they get weight 1.0 (clipped)
    train_weights = compute_year_weights(train_years_array_full, min_year=2000, max_year=2014)
    print(f"  Training sample weights: min={train_weights.min():.3f}, max={train_weights.max():.3f}, mean={train_weights.mean():.3f}")
    
    # Use scale_pos_weight from best_params
    scale_pos_weight = best_params.get("scale_pos_weight", None)
    
    if scale_pos_weight is not None:
        print(f"\nImbalance: scale_pos_weight {scale_pos_weight:.6f} (from JSON params)")
    else:
        print(f"\nImbalance: scale_pos_weight not specified in params")
    
    best_params["is_unbalance"] = False
    imbalance_info = {
        "neg": int(train_neg_full),
        "pos": int(train_pos_full),
        "scale_pos_weight": float(scale_pos_weight) if scale_pos_weight is not None else None
    }
    if use_wandb:
        wandb.log({
            "final_model/imbalance/scale_pos_weight": float(scale_pos_weight),
            "final_model/sample_weights/min": float(train_weights.min()),
            "final_model/sample_weights/max": float(train_weights.max()),
            "final_model/sample_weights/mean": float(train_weights.mean()),
        })
    
    print(f"\nTraining final model on {len(X_train_full):,} samples...")
    report_memory_usage("before final training")
    train_start = time.time()
    train_params = best_params.copy()
    num_boost_round_val = train_params.pop("num_boost_round", train_params.pop("n_estimators", 3000))
    train_params.pop("n_estimators", None)
    
    print(f"  Creating datasets...")
    train_dataset = lgb.Dataset(X_train_full, label=y_train_full, weight=train_weights, free_raw_data=True)
    del X_train_full, y_train_full, train_years_array_full, train_weights; gc.collect()
    report_memory_usage("after train dataset creation")
    
    print(f"  Creating validation dataset...")
    val_dataset = lgb.Dataset(X_val, label=y_val, free_raw_data=True, reference=train_dataset)
    report_memory_usage("after val dataset creation")
    
    print(f"  Starting training...")
    lgb_model = lgb.train(
        train_params,
        train_dataset,
        num_boost_round=num_boost_round_val,
        valid_sets=[val_dataset],
        valid_names=["val"],
        callbacks=[lgb.early_stopping(500), lgb.log_evaluation(100)]
    )
    train_time = time.time() - train_start
    best_iteration = lgb_model.best_iteration
    print(f"\nTraining done in {train_time:.1f}s. Best iteration: {best_iteration if best_iteration else 'N/A'}")
    
    del train_dataset, val_dataset; gc.collect()
    
    val_start = time.time()
    y_val_proba = lgb_model.predict(X_val, num_iteration=best_iteration if best_iteration else None)
    val_time = time.time() - val_start
    validation_metrics = compute_metrics(y_val, y_val_proba)
    print(f"\nFinal Model Validation: ROC-AUC {validation_metrics['roc_auc']:.4f}, PR-AUC {validation_metrics['pr_auc']:.4f}, "
          f"P@1% {validation_metrics['precision_at_1pct']:.4f}, P@5% {validation_metrics['precision_at_5pct']:.4f}, "
          f"P@10% {validation_metrics['precision_at_10pct']:.4f}")
    
    if use_wandb:
        wandb.log({
            **{f"final_model/val/{k}": v for k, v in validation_metrics.items()},
            "final_model/val/n_samples": int(len(y_val)),
            "final_model/val/n_positives": int(np.sum(y_val)),
            "final_model/val/time_seconds": val_time
        })
    
    del X_val, y_val, val_years_array, y_val_proba; gc.collect()
    
    model_path = model_dir / f"modelC_lgbm_win5_{timestamp}.pkl"
    with open(model_path, 'wb') as f:
        pickle.dump(lgb_model, f)
    print(f"Final model saved: {model_path}")
    gc.collect()
    
    if use_wandb:
        wandb.log({
            "final_model/data/n_features": len(feature_cols),
            "final_model/data/n_train": train_stats["n_train"],
            "final_model/data/train_positives": train_stats["train_positives"],
