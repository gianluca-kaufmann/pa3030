    output_file = output_dir / f"modelC_lgbm_win5_{timestamp}.txt"
    tee = Tee(output_file)
    sys.stdout = tee
    try:
        main(timestamp)
    finally:
        sys.stdout = tee.stdout
        tee.close()
        print(f"\nOutput saved to: {output_file}")

