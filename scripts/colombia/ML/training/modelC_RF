def load_best_params(params_path: Optional[Path]) -> tuple[Dict[str, Any], Any]:
    """Load and merge parameters from JSON with safe defaults for Random Forest.
    Supports both flat JSON (direct param dict) and nested JSON (with 'fixed_params' and 'best_params' keys).
    Treats JSON params as primary, guardrails only fill missing keys.
    If params_path is None, returns default manual hyperparameters."""
    if params_path is None:
        # Use default manual hyperparameters when JSON file is not found
        print("  rf_best_params.json not found, using default manual hyperparameters")
        guardrail_params = {
            "n_estimators": 1000,
            "max_depth": 20,
            "min_samples_split": 20,
            "min_samples_leaf": 10,
            "max_features": "sqrt",
            "bootstrap": True,
            "class_weight": "balanced_subsample",
            "n_jobs": get_n_jobs()
        }
        final_params = {**guardrail_params}
        return final_params, None
    
    with open(params_path, 'r') as f:
        params_data = json.load(f)
    
    # Support both flat and nested JSON formats
    if isinstance(params_data, dict) and ('fixed_params' in params_data or 'best_params' in params_data):
        # Nested format: {fixed_params: {...}, best_params: {...}, ...}
        json_fixed = params_data.get('fixed_params', {})
        json_best = params_data.get('best_params', {}).copy()
        final_params = {**json_fixed, **json_best}
        best_score = params_data.get('best_val_score', params_data.get('best_cv_score', None))
    else:
        # Flat format: direct parameter dictionary
        final_params = params_data.copy() if isinstance(params_data, dict) else {}
        best_score = None
    
    # Guardrails: only fill missing keys, don't overwrite existing ones
    guardrail_params = {
        "n_estimators": 1000,
        "max_depth": 20,
        "min_samples_split": 20,
        "min_samples_leaf": 10,
        "max_features": "sqrt",
        "bootstrap": True,
        "class_weight": "balanced_subsample",
        "n_jobs": get_n_jobs()
    }
    
    # Only add guardrail params if key is missing
    for key, value in guardrail_params.items():
        if key not in final_params:
            final_params[key] = value
    
    # Ensure class_weight defaults to balanced_subsample if not specified
    if "class_weight" not in final_params:
        final_params["class_weight"] = "balanced_subsample"
    
    return final_params, best_score


def load_numpy_arrays_two_pass(
    df_path: Path, 
    feature_cols: list, 
    target_col: str, 
    name: str = "",
    batch_size: int = BATCH_SIZE,
    year_range: Optional[tuple[int, int]] = None
) -> tuple[np.ndarray, np.ndarray, np.ndarray, int, int, list]:
    """
    Two-pass NumPy loader: bypasses Pandas to minimize memory overhead.
    
    Pass 1: Count rows (after dropna on target and optional year filtering).
    Pass 2: Pre-allocate float32 arrays and stream data directly into them.
    
    Args:
        year_range: Optional tuple (min_year, max_year) to filter data. Inclusive on both ends.
    
    Returns:
        X: Feature matrix (n_samples, n_features) as float32
        y: Target vector (n_samples,) as int8
        years_array: Array of years (n_samples,) as int32
        pos: Number of positive samples
        neg: Number of negative samples
        years: Sorted list of unique years
    """
    year_filter_str = f" (years {year_range[0]}-{year_range[1]})" if year_range else ""
    print(f"\nLoading {name or df_path.name}{year_filter_str} (two-pass NumPy loader)...")
    load_start = time.time()
    essential_cols = feature_cols + [target_col, 'year', 'WDPA_prev']
    
    # Pass 1: Count rows
    print(f"  Pass 1: Counting rows...")
    parquet_file = pq.ParquetFile(df_path)
    n_samples = 0
    years_set = set()
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols, use_threads=True):
            # Convert batch to numpy arrays directly (bypass pandas)
            batch_table = batch
            # Use PyArrow null handling
            null_mask = batch_table[target_col].is_null().to_numpy(zero_copy_only=False)
            valid_mask = ~null_mask
            if not valid_mask.any():
                continue
            
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            wdpa_prev_array = batch_table['WDPA_prev'].to_numpy(zero_copy_only=False)
            
            target_valid = target_array[valid_mask]
            year_valid = year_array[valid_mask]
            wdpa_prev_valid = wdpa_prev_array[valid_mask]
            
            # Apply risk-set filter: WDPA_prev == 0 (exclude already protected pixels)
            risk_set_mask = (wdpa_prev_valid == 0)
            target_valid = target_valid[risk_set_mask]
            year_valid = year_valid[risk_set_mask]
            
            # Apply year filter if specified
            if year_range is not None:
                year_mask = (year_valid >= year_range[0]) & (year_valid <= year_range[1])
                target_valid = target_valid[year_mask]
                year_valid = year_valid[year_mask]
            
            if len(target_valid) == 0:
                continue
            
            n_samples += len(target_valid)
            years_set.update(year_valid.tolist())
            
            del batch_table, target_array, year_array, wdpa_prev_array, target_valid, year_valid, batch
    finally:
        del parquet_file
        gc.collect()
    
    print(f"  Found {n_samples:,} samples")
    
    if n_samples == 0:
        raise ValueError(f"No samples found in {name or df_path.name}{year_filter_str}")
    
    # Pass 2: Pre-allocate arrays and fill directly
    print(f"  Pass 2: Pre-allocating arrays ({n_samples:,} samples, {len(feature_cols)} features)...")
    X = np.empty((n_samples, len(feature_cols)), dtype=np.float32)
    y = np.empty(n_samples, dtype=np.int8)
    years_array = np.empty(n_samples, dtype=np.int32)
    
    parquet_file = pq.ParquetFile(df_path)
    idx_offset = 0
    batch_num = 0
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols, use_threads=True):
            batch_num += 1
            batch_table = batch
            
            # Use PyArrow null handling
            null_mask = batch_table[target_col].is_null().to_numpy(zero_copy_only=False)
            valid_mask = ~null_mask
            if not valid_mask.any():
                del batch_table, batch
                continue
            
            # Extract arrays directly from PyArrow
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            wdpa_prev_array = batch_table['WDPA_prev'].to_numpy(zero_copy_only=False)
            
            target_valid = target_array[valid_mask]
            year_valid = year_array[valid_mask]
            wdpa_prev_valid = wdpa_prev_array[valid_mask]
            
            # Apply risk-set filter: WDPA_prev == 0 (exclude already protected pixels)
            risk_set_mask = (wdpa_prev_valid == 0)
            if not risk_set_mask.any():
                del batch_table, target_array, year_array, wdpa_prev_array, batch
                continue
            target_valid = target_valid[risk_set_mask]
            year_valid = year_valid[risk_set_mask]
            
            # Apply year filter if specified
            if year_range is not None:
                year_mask = (year_valid >= year_range[0]) & (year_valid <= year_range[1])
                if not year_mask.any():
                    del batch_table, target_array, year_array, wdpa_prev_array, batch
                    continue
                target_valid = target_valid[year_mask]
                year_valid = year_valid[year_mask]
                
                # Build final mask: map risk_set_mask and year_mask (applied to valid data) back to original indices
                final_mask = valid_mask.copy()
                risk_set_mask_mapped = np.zeros_like(valid_mask)
                risk_set_mask_mapped[valid_mask] = risk_set_mask
                final_mask = final_mask & risk_set_mask_mapped
                year_mask_mapped = np.zeros_like(final_mask)
                year_mask_mapped[final_mask] = year_mask
                final_mask = final_mask & year_mask_mapped
                
                # Convert feature columns in bulk using pure PyArrow→NumPy path (no pandas)
                feature_table = batch_table.select(feature_cols)
                X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            else:
                # Build final mask: map risk_set_mask back to original indices
                final_mask = valid_mask.copy()
                risk_set_mask_mapped = np.zeros_like(valid_mask)
                risk_set_mask_mapped[valid_mask] = risk_set_mask
                final_mask = final_mask & risk_set_mask_mapped
                
                # Convert feature columns in bulk using pure PyArrow→NumPy path (no pandas, no year filter)
                feature_table = batch_table.select(feature_cols)
                X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            y_batch = (target_valid > 0).astype(np.int8)
            
            # Insert directly into pre-allocated arrays
            batch_size_actual = len(y_batch)
            X[idx_offset:idx_offset + batch_size_actual, :] = X_batch
            y[idx_offset:idx_offset + batch_size_actual] = y_batch
            years_array[idx_offset:idx_offset + batch_size_actual] = year_valid.astype(np.int32)
            idx_offset += batch_size_actual
            
            del batch_table, target_array, year_array, wdpa_prev_array, target_valid, year_valid
            del feature_table, X_batch, y_batch, batch
            
            if batch_num % 25 == 0:
                gc.collect()
            
            if batch_num % 10 == 0:
                print(f"  {batch_num} batches, {idx_offset:,}/{n_samples:,} samples loaded")
                report_memory_usage(f"load batch {batch_num}")
    finally:
        del parquet_file
        gc.collect()
    
    if idx_offset != n_samples:
        raise ValueError(f"Mismatch: expected {n_samples:,} samples but loaded {idx_offset:,}")
    
    # Compute stats
    pos = int(y.sum())
    neg = int((y == 0).sum())
    years = sorted(years_set)
    
    load_time = time.time() - load_start
    mem_gb = (X.nbytes + y.nbytes + years_array.nbytes) / 1024**3
    print(f"  Loaded {n_samples:,} rows in {load_time:.1f}s ({mem_gb:.2f} GB)")
    print(f"  {neg:,} neg, {pos:,} pos, ratio 1:{neg/max(pos,1):.1f}, years {years[0]}-{years[-1]}")
    
    return X, y, years_array, pos, neg, years


