try:
    from imblearn.ensemble import BalancedRandomForestClassifier
except ImportError:
    raise RuntimeError(
        "imblearn is required for BRF. Install imbalanced-learn in the environment."
    )


class Tee:
    """Write to both stdout/stderr and a file."""

    def __init__(self, file_path: Path, original_stream):
        self.file = open(file_path, "a", encoding="utf-8")  # Append mode to capture both stdout and stderr
        self.original_stream = original_stream

    def write(self, text: str) -> None:
        self.original_stream.write(text)
        self.original_stream.flush()
        self.file.write(text)
        self.file.flush()

    def flush(self) -> None:
        self.original_stream.flush()
        self.file.flush()

    def close(self) -> None:
        self.file.close()


