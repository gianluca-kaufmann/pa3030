def get_n_jobs() -> int:
    """Get number of jobs from SLURM_CPUS_PER_TASK, returning -1 on missing/invalid values."""
    try:
        cpus = os.environ.get("SLURM_CPUS_PER_TASK")
        if cpus is None:
            return -1
        return int(cpus)
    except (ValueError, TypeError):
        return -1


