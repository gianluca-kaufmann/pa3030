def convert_numpy_types(obj: Any) -> Any:
    """Recursively convert NumPy types to native Python types for JSON serialization."""
    if isinstance(
        obj,
        (
            np.integer,
            np.int_,
            np.intc,
            np.intp,
            np.int8,
            np.int16,
            np.int32,
            np.int64,
            np.uint8,
            np.uint16,
            np.uint32,
            np.uint64,
        ),
    ):
        return int(obj)
    elif isinstance(obj, (np.floating, np.float_, np.float16, np.float32, np.float64)):
        return float(obj)
    elif isinstance(obj, np.bool_):
        return bool(obj)
    elif isinstance(obj, np.ndarray):
        return obj.tolist()
    elif isinstance(obj, dict):
        return {key: convert_numpy_types(value) for key, value in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [convert_numpy_types(item) for item in obj]
    elif obj is None or isinstance(obj, (str, int, float, bool)):
        return obj
    else:
        try:
            if hasattr(obj, "item"):
                return obj.item()
            else:
                return obj
        except (ValueError, TypeError, AttributeError):
            return str(obj)


def get_feature_columns(df: pd.DataFrame) -> list:
    """Get valid feature columns, excluding identifiers and leakage columns.
    
    Includes both numeric and boolean feature columns.
    """
    numeric_cols = df.select_dtypes(include=["number"]).columns.tolist()
    bool_cols = df.select_dtypes(include=["bool"]).columns.tolist()
    candidate_cols = numeric_cols + [c for c in bool_cols if c not in numeric_cols]
    exclude_lower = {c.lower() for c in EXCLUDE_COLS}
    feature_cols = [col for col in candidate_cols if col.lower() not in exclude_lower]
    return feature_cols


def compute_temporal_weights(years: np.ndarray, min_year: int, max_year: int) -> np.ndarray:
    """
    Compute temporal sample weights linearly scaled from 0.5 at min_year to 1.0 at max_year.
    
    Args:
        years: Array of year values
        min_year: Minimum year (weight = 0.5)
        max_year: Maximum year (weight = 1.0)
    
    Returns:
        Array of weights, capped within [0.5, 1.0]
    """
    years = np.asarray(years, dtype=float)
    # Linear scaling: weight = 0.5 + 0.5 * (year - min_year) / (max_year - min_year)
    if max_year == min_year:
        # Edge case: all years are the same
        weights = np.full_like(years, 1.0)
    else:
        weights = 0.5 + 0.5 * (years - min_year) / (max_year - min_year)
    # Cap weights within [0.5, 1.0]
    weights = np.clip(weights, 0.5, 1.0)
    return weights


def resolve_tuning_parquet() -> Path:
    """Locate modelC_tuning_colombia.parquet (prefer $SCRATCH if present)."""
    repo_root = Path(__file__).resolve().parents[4]
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        # Check data/ml/tuning location on scratch (standard location from modelC_sample)
        candidates.append(scratch_root / "data/ml/tuning/modelC_tuning_colombia.parquet")
        # Also check outputs/Results/tuning (if modelC_sample wrote it there)
        candidates.append(scratch_root / "outputs/Results/tuning/modelC_tuning_colombia.parquet")
    candidates.append(repo_root / "data/ml/tuning/modelC_tuning_colombia.parquet")
    candidates.append(repo_root / "outputs/Results/tuning/modelC_tuning_colombia.parquet")

    for cand in candidates:
        if cand.exists():
            return cand

    # Provide detailed error message with all checked paths
    error_msg = "modelC_tuning_colombia.parquet not found in expected locations.\n"
    error_msg += "\nChecked locations:\n"
    for cand in candidates:
        error_msg += f"  - {cand}\n"
    if scratch_root:
        error_msg += f"\nSCRATCH root: {scratch_root}\n"
    error_msg += f"Repository root: {repo_root}\n"
    raise FileNotFoundError(error_msg)


