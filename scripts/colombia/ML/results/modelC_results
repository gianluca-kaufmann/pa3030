def check_calibration_status(parquet_path: Path, available_columns: list) -> None:
    """Check if the parquet file contains calibrated predictions and print status.
    
    Args:
        parquet_path: Path to the parquet file
        available_columns: List of available column names in the parquet file
    """
    # Check for calibration indicators
    has_uncalibrated_col = 'y_pred_proba_uncalibrated' in available_columns
    has_calibrated_col = 'y_pred_proba_calibrated' in available_columns
    filename_has_calibrated = 'calibrated' in parquet_path.name.lower()
    
    # Determine calibration status
    if has_uncalibrated_col and has_calibrated_col:
        # This is definitely a calibrated file
        print(f"\n{'='*70}")
        print("CALIBRATION STATUS: CALIBRATED")
        print(f"{'='*70}")
        print(f"  File contains both 'y_pred_proba_uncalibrated' and 'y_pred_proba_calibrated' columns")
        print(f"  Using calibrated probabilities (y_pred_proba = calibrated values)")
        print(f"{'='*70}\n")
    elif filename_has_calibrated:
        # Filename suggests calibrated but columns don't confirm
        print(f"\n{'!'*70}")
        print("WARNING: Filename suggests calibrated predictions, but calibration columns not found")
        print(f"{'!'*70}")
        print(f"  Filename: {parquet_path.name}")
        print(f"  Expected columns: 'y_pred_proba_uncalibrated', 'y_pred_proba_calibrated'")
        print(f"  Available columns: {', '.join(available_columns)}")
        print(f"  Proceeding with available 'y_pred_proba' column")
        print(f"{'!'*70}\n")
    else:
        # No calibration indicators - uncalibrated
        print(f"\n{'!'*70}")
        print("WARNING: You are plotting UNCALIBRATED probabilities")
        print(f"{'!'*70}")
        print(f"  File: {parquet_path.name}")
        print(f"  No calibration metadata found (no 'y_pred_proba_uncalibrated'/'y_pred_proba_calibrated' columns)")
        print(f"  For calibrated results, use: modelC_<model_type>_win5_scored_calibrated_*.parquet")
        print(f"{'!'*70}\n")


def load_scored_parquet(parquet_path: Path) -> pd.DataFrame:
    """Load scored parquet file with only needed columns using pyarrow.
    
    Reads: y_true, y_pred_proba, x, y (with column name resolution)
    Optionally reads: wdpa_b1 (protected area coverage as of end of 2017)
    Also reads: year, row, col if available (needed for joining with WDPA data)
    """
    print(f"Reading parquet file: {parquet_path}")
    pfile = pq.ParquetFile(parquet_path)
    
    # Read schema to get available columns
    # ParquetSchema doesn't have field() method, use schema_arrow to get Arrow schema
    arrow_schema = pfile.schema_arrow
    available_columns = arrow_schema.names
    print(f"  Available columns: {available_columns}")
    
    # Check calibration status
    check_calibration_status(parquet_path, available_columns)
    
    # Map required logical fields with fallbacks
    field_mappings = {
        'y_true': ['y_true', 'transition_01_win5', 'transition_01'],
        'y_pred_proba': ['y_pred_proba', 'pred_proba', 'score', 'p_pred', 'proba'],
        'x': ['x', 'lon', 'longitude'],
        'y': ['y', 'lat', 'latitude']
    }
    
    # Optional fields: protected area coverage, and metadata for joining
    wdpa_col = None
    for candidate in ['wdpa_b1', 'WDPA_b1']:
        if candidate in available_columns:
            wdpa_col = candidate
            print(f"  Found protected area column: '{wdpa_col}'")
            break
    
    # Optional metadata columns for joining with original test data
    optional_metadata_cols = []
    for col in ['year', 'row', 'col']:
        if col in available_columns:
            optional_metadata_cols.append(col)
            print(f"  Found metadata column: '{col}'")
    
    # Resolve column names
    resolved_columns = {}
    missing_fields = []
    
    for logical_name, candidates in field_mappings.items():
        found = None
        for candidate in candidates:
            if candidate in available_columns:
                found = candidate
                break
        if found:
            resolved_columns[logical_name] = found
            print(f"  Resolved '{logical_name}' -> '{found}'")
        else:
            missing_fields.append((logical_name, candidates))
    
    # Check for missing fields
    if missing_fields:
        error_msg = "ERROR: Required columns not found in parquet file.\n\n"
        error_msg += "Missing fields:\n"
        for logical_name, candidates in missing_fields:
            error_msg += f"  - {logical_name} (tried: {', '.join(candidates)})\n"
        error_msg += f"\nAvailable columns: {', '.join(available_columns)}\n"
        error_msg += "\nPlease ensure the parquet file contains one of the expected column names."
        raise ValueError(error_msg)
    
    # Read all row groups with resolved column names (plus optional wdpa_b1 and metadata)
    columns_to_read = list(resolved_columns.values()) + optional_metadata_cols
    if wdpa_col:
        columns_to_read.append(wdpa_col)
    
    all_data = []
    num_row_groups = pfile.metadata.num_row_groups
    print(f"  Reading {num_row_groups} row groups...")
    
    for rg_idx in range(num_row_groups):
        table = pfile.read_row_group(rg_idx, columns=columns_to_read)
        df = table.to_pandas()
        all_data.append(df)
    
    result = pd.concat(all_data, ignore_index=True)
    
    # Rename columns to standard names
    rename_dict = {v: k for k, v in resolved_columns.items()}
    result = result.rename(columns=rename_dict)
    
    # Rename wdpa column to standard name if present
    if wdpa_col:
        result = result.rename(columns={wdpa_col: 'wdpa_b1'})
    
    print(f"  Loaded {len(result):,} rows")
    print(f"  Final columns: {list(result.columns)}")
    
    return result


def detect_and_reproject_coordinates(df: pd.DataFrame) -> pd.DataFrame:
    """Detect coordinate CRS and reproject to EPSG:4326 if needed.
    
    Detects if coordinates are in EPSG:3857 (Web Mercator) based on large values,
    and reprojects to EPSG:4326 (WGS84) for visualization.
    
    Returns DataFrame with reprojected x/y coordinates in EPSG:4326.
    """
    print("\nDetecting coordinate CRS...")
    
    # Sample to check coordinate ranges
    n_rows = len(df)
    if n_rows > 100000:
        sample_df = df.sample(n=100000, random_state=42)
    else:
        sample_df = df
    
    x_abs_max = sample_df['x'].abs().max()
    y_abs_max = sample_df['y'].abs().max()
    
    print(f"  x range: [{df['x'].min():.2f}, {df['x'].max():.2f}]")
    print(f"  y range: [{df['y'].min():.2f}, {df['y'].max():.2f}]")
    
    # If coordinates have large absolute values (>1000), likely Web Mercator (EPSG:3857)
    # WGS84 coordinates are small (lon: -180 to 180, lat: -90 to 90)
    if x_abs_max > 1000 or y_abs_max > 1000:
        print("  Detected EPSG:3857 (Web Mercator) coordinates")
        print("  Reprojecting to EPSG:4326 (WGS84)...")
        
        # Create GeoDataFrame with Web Mercator CRS
        geometry = [Point(xy) for xy in zip(df['x'], df['y'])]
        gdf = gpd.GeoDataFrame(df, geometry=geometry, crs='EPSG:3857')
        
        # Reproject to WGS84
        gdf = gdf.to_crs('EPSG:4326')
        
        # Update x/y columns with reprojected coordinates
        df = df.copy()
        df['x'] = gdf.geometry.x.values
        df['y'] = gdf.geometry.y.values
        
        print(f"  Reprojected x range: [{df['x'].min():.2f}, {df['x'].max():.2f}]")
        print(f"  Reprojected y range: [{df['y'].min():.2f}, {df['y'].max():.2f}]")
    else:
        print("  Coordinates appear to be in EPSG:4326 (WGS84) already")
    
    return df


def validate_coordinates(df: pd.DataFrame) -> None:
    """Validate that x/y coordinates look like Colombia lon/lat.
    
    Checks that x in [-85,-65] and y in [-5,15] for at least 99% of rows.
    Assumes coordinates are already in EPSG:4326.
    """
    print("\nValidating coordinates...")
    
    # Sample if too large (for performance)
    n_rows = len(df)
    if n_rows > 100000:
        print(f"  Sampling 100,000 rows from {n_rows:,} for validation...")
        sample_df = df.sample(n=100000, random_state=42)
    else:
        sample_df = df
    
    # Check longitude (x) range: Colombia is roughly [-85, -65]
    x_valid = (sample_df['x'] >= -85) & (sample_df['x'] <= -65)
    x_valid_pct = x_valid.sum() / len(sample_df) * 100
    
    # Check latitude (y) range: Colombia is roughly [-5, 15]
    y_valid = (sample_df['y'] >= -5) & (sample_df['y'] <= 15)
    y_valid_pct = y_valid.sum() / len(sample_df) * 100
    
    print(f"  x (lon) in [-85, -65]: {x_valid_pct:.2f}%")
    print(f"  y (lat) in [-5, 15]: {y_valid_pct:.2f}%")
    
    # Both must be valid for at least 99% of rows
    both_valid = x_valid & y_valid
    both_valid_pct = both_valid.sum() / len(sample_df) * 100
    
    if both_valid_pct < 99.0:
        x_range = (df['x'].min(), df['x'].max())
        y_range = (df['y'].min(), df['y'].max())
        error_msg = (
            f"ERROR: x/y coordinates do not look like Colombia lon/lat after reprojection.\n\n"
            f"Expected: x in [-85, -65], y in [-5, 15] (EPSG:4326)\n"
            f"Found: x in [{x_range[0]:.2f}, {x_range[1]:.2f}], "
            f"y in [{y_range[0]:.2f}, {y_range[1]:.2f}]\n"
            f"Only {both_valid_pct:.2f}% of coordinates are in expected ranges.\n\n"
            f"Please check that coordinates represent Colombia region."
        )
        raise ValueError(error_msg)
    
    print(f"  Coordinate validation passed ({both_valid_pct:.2f}% in expected ranges)")


def create_metrics_table(metrics_data: Dict[str, Any], output_dir: Path, model_type: str) -> None:
    """Create metrics table in CSV and LaTeX formats."""
    print("\n" + "=" * 70)
    print("CREATING METRICS TABLE")
    print("=" * 70)
    
    # Try test_performance first, then fall back to metrics, then empty dict
    test_perf = metrics_data.get("test_performance", {})
    if not test_perf:
        test_perf = metrics_data.get("metrics", {})
    
    # Extract metrics
    metrics_dict = {
        "Metric": [
            "ROC AUC",
            "PR AUC",
            "Precision @ 1%",
            "Precision @ 5%",
            "Precision @ 10%",
            "Baseline Rate",
            "Lift @ 1%",
            "Lift @ 5%",
            "Lift @ 10%"
        ],
        "Value": [
            test_perf.get("roc_auc", np.nan),
            test_perf.get("pr_auc", np.nan),
            test_perf.get("precision_at_1pct", np.nan),
            test_perf.get("precision_at_5pct", np.nan),
            test_perf.get("precision_at_10pct", np.nan),
            test_perf.get("baseline_rate", np.nan),
            test_perf.get("lift_at_1pct", np.nan),
            test_perf.get("lift_at_5pct", np.nan),
            test_perf.get("lift_at_10pct", np.nan)
        ]
    }
    
    df = pd.DataFrame(metrics_dict)
    
    # Format values for display
    def format_value(val):
        if pd.isna(val):
            return "N/A"
        if isinstance(val, (int, float)):
            if abs(val) < 0.01:
                return f"{val:.6f}"
            elif abs(val) < 1:
                return f"{val:.4f}"
            elif abs(val) < 100:
                return f"{val:.2f}"
            else:
                return f"{val:.1f}"
        return str(val)
    
    df['Value'] = df['Value'].apply(format_value)
    
    # Save CSV
    csv_path = output_dir / f"modelC_{model_type}_metrics_table.csv"
    df.to_csv(csv_path, index=False)
    print(f"\nSaved CSV: {csv_path}")
    
    # Create LaTeX table
    latex_path = output_dir / f"modelC_{model_type}_metrics_table.tex"
    with open(latex_path, 'w') as f:
        f.write("\\begin{table}[h]\n")
        f.write("\\centering\n")
        f.write("\\begin{tabular}{lr}\n")
        f.write("\\toprule\n")
        f.write("Metric & Value \\\\\n")
        f.write("\\midrule\n")
        
        for _, row in df.iterrows():
            metric = row['Metric'].replace('@', '@')
            value = row['Value']
            # Escape special LaTeX characters
            metric = metric.replace('_', '\\_')
            f.write(f"{metric} & {value} \\\\\n")
        
        f.write("\\bottomrule\n")
        f.write("\\end{tabular}\n")
        f.write(f"\\caption{{Model C ({model_type.upper()}) Performance Metrics}}\n")
        f.write(f"\\label{{tab:modelc_{model_type}_metrics}}\n")
        f.write("\\end{table}\n")
    
    print(f"Saved LaTeX: {latex_path}")


def create_pr_curve(df: pd.DataFrame, metrics_data: Dict[str, Any], output_dir: Path, model_type: str) -> None:
    """Create Precision-Recall curve with baseline prevalence."""
    print("\n" + "=" * 70)
    print("CREATING PRECISION-RECALL CURVE")
    print("=" * 70)
    
    y_true = df['y_true'].values
    y_pred_proba = df['y_pred_proba'].values
    
    # Compute PR curve
    precision, recall, thresholds = precision_recall_curve(y_true, y_pred_proba)
    pr_auc = average_precision_score(y_true, y_pred_proba)
    
    # Get baseline prevalence - try test_performance first, then metrics, then compute from df
    test_perf = metrics_data.get("test_performance", {})
    if not test_perf:
        test_perf = metrics_data.get("metrics", {})
    baseline_rate = test_perf.get("baseline_rate", np.mean(y_true))
    
    print(f"  PR AUC: {pr_auc:.4f}")
    print(f"  Baseline prevalence: {baseline_rate:.6f}")
    
    # Create figure
    fig, ax = plt.subplots(figsize=PR_CURVE_FIGSIZE)
    
    # Plot PR curve
    ax.plot(recall, precision, linewidth=2, label=f'Model (AP = {pr_auc:.4f})')
    
    # Plot baseline (horizontal line at baseline rate)
    ax.axhline(y=baseline_rate, color='r', linestyle='--', linewidth=2, 
               label=f'Baseline (prevalence = {baseline_rate:.6f})')
    
    ax.set_xlabel('Recall', fontsize=FONTSIZE_LABEL)
    ax.set_ylabel('Precision', fontsize=FONTSIZE_LABEL)
    ax.set_title(f'Model C ({model_type.upper()}) Precision-Recall Curve', fontsize=FONTSIZE_TITLE, fontweight='bold')
    ax.legend(loc='best', fontsize=FONTSIZE_LEGEND)
    ax.grid(True, alpha=0.3)
    ax.set_xlim([0, 1])
    ax.set_ylim([0, 1])
    
    plt.tight_layout()
    
    # Save PNG
    png_path = output_dir / f"modelC_{model_type}_pr_curve.png"
    plt.savefig(png_path, dpi=PR_CURVE_DPI, bbox_inches='tight')
    print(f"\nSaved PNG: {png_path}")
    
    # Save PDF
    pdf_path = output_dir / f"modelC_{model_type}_pr_curve.pdf"
    plt.savefig(pdf_path, dpi=PR_CURVE_DPI, bbox_inches='tight')
    print(f"Saved PDF: {pdf_path}")
    
    plt.close()


def get_colombia_boundary(country_boundary_path: Optional[Path] = None) -> gpd.GeoDataFrame:
    """Get Colombia boundary from file or download from Natural Earth."""
    if country_boundary_path and country_boundary_path.exists():
        print(f"Loading Colombia boundary from: {country_boundary_path}")
        gdf = gpd.read_file(country_boundary_path)
        # Filter to Colombia if multiple countries
        if 'NAME' in gdf.columns:
            gdf = gdf[gdf['NAME'] == 'Colombia']
        elif 'NAME_EN' in gdf.columns:
            gdf = gdf[gdf['NAME_EN'] == 'Colombia']
        elif 'ADMIN' in gdf.columns:
            gdf = gdf[gdf['ADMIN'] == 'Colombia']
        elif 'ISO_A3' in gdf.columns:
            gdf = gdf[gdf['ISO_A3'] == 'COL']
        elif 'iso_a3' in gdf.columns:
            gdf = gdf[gdf['iso_a3'] == 'COL']
        return gdf
    else:
        print("Loading Colombia boundary from Natural Earth...")
        try:
            # Try to load Natural Earth dataset
            # Method 1: Use geopandas built-in dataset
            try:
                world = gpd.read_file(gpd.datasets.get_path('naturalearth_lowres'))
            except (AttributeError, ValueError):
                # Method 2: Try alternative dataset name
                try:
                    world = gpd.read_file(gpd.datasets.get_path('naturalearth'))
                except (AttributeError, ValueError):
                    # Method 3: Direct URL download
                    import urllib.request
                    import tempfile
                    url = "https://naciscdn.org/naturalearth/110m/cultural/ne_110m_admin_0_countries.zip"
                    with tempfile.NamedTemporaryFile(delete=False, suffix='.zip') as tmp:
                        urllib.request.urlretrieve(url, tmp.name)
                        import zipfile
                        import shutil
                        extract_dir = tempfile.mkdtemp()
                        with zipfile.ZipFile(tmp.name, 'r') as zip_ref:
                            zip_ref.extractall(extract_dir)
                        # Find the shapefile
                        shp_files = list(Path(extract_dir).glob('*.shp'))
                        if shp_files:
                            world = gpd.read_file(shp_files[0])
                        else:
                            raise ValueError("Could not find shapefile in downloaded zip")
                        os.unlink(tmp.name)
                        shutil.rmtree(extract_dir)
            
            # Filter to Colombia
            colombia = None
            if 'iso_a3' in world.columns:
                colombia = world[world['iso_a3'] == 'COL'].copy()
            elif 'ISO_A3' in world.columns:
                colombia = world[world['ISO_A3'] == 'COL'].copy()
            elif 'NAME' in world.columns:
                colombia = world[world['NAME'] == 'Colombia'].copy()
            elif 'NAME_EN' in world.columns:
                colombia = world[world['NAME_EN'] == 'Colombia'].copy()
            elif 'ADMIN' in world.columns:
                colombia = world[world['ADMIN'] == 'Colombia'].copy()
            
            if colombia is None or len(colombia) == 0:
                raise ValueError("Could not find Colombia in Natural Earth dataset")
            
            print(f"  Found Colombia boundary with {len(colombia)} feature(s)")
            return colombia
        except Exception as e:
            print(f"  Error loading from Natural Earth: {e}")
            print("  Attempting alternative download method...")
            # Alternative: try direct GeoJSON URL
            try:
                import urllib.request
                import tempfile
                url = "https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson"
                with tempfile.NamedTemporaryFile(delete=False, suffix='.geojson') as tmp:
                    urllib.request.urlretrieve(url, tmp.name)
                    world = gpd.read_file(tmp.name)
                    if 'name' in world.columns:
                        colombia = world[world['name'] == 'Colombia'].copy()
                    elif 'NAME' in world.columns:
                        colombia = world[world['NAME'] == 'Colombia'].copy()
                    os.unlink(tmp.name)
                    if colombia is not None and len(colombia) > 0:
                        print(f"  Found Colombia boundary via alternative method")
                        return colombia
            except Exception as e2:
                print(f"  Alternative download also failed: {e2}")
            
            raise RuntimeError(
                "Could not load Colombia boundary. Please provide --country_boundary path "
                "or ensure internet connection for Natural Earth download."
            )


def load_wdpa_from_test_parquet(test_parquet_path: Optional[Path]) -> Optional[pd.DataFrame]:
    """Load WDPA_b1 data from original test parquet file for joining with scored data.
    
    This is needed because transition_01_win5 (y_true) is a 5-year lookahead target that doesn't
    mark the actual year of establishment. For example, a pixel established in 2018 will have
    y_true=1 only for years before 2018, not for 2018 itself. By loading WDPA_b1 from the
    original test data, we can correctly identify pixels that were actually established in each year.
    
    Returns DataFrame with columns: row, col, year, x, y, WDPA_b1 (or None if file not found/not available)
    Includes x, y coordinates as fallback for joining when row/col are missing in scored data.
    """
    if test_parquet_path is None or not test_parquet_path.exists():
        return None
    
    print(f"\nLoading WDPA data from original test parquet: {test_parquet_path}")
    try:
        pfile = pq.ParquetFile(test_parquet_path)
        available_columns = pfile.schema_arrow.names
        
        # Check for WDPA column
        wdpa_col = None
        for candidate in ['WDPA_b1', 'wdpa_b1']:
            if candidate in available_columns:
                wdpa_col = candidate
                break
        
        if wdpa_col is None:
            print(f"  WARNING: WDPA column not found in test parquet. Available columns: {available_columns}")
            return None
        
        # Check for required join columns - try row/col first, then x/y as fallback
        has_row_col = 'row' in available_columns and 'col' in available_columns
        has_xy = 'x' in available_columns and 'y' in available_columns
        
        if not has_row_col and not has_xy:
            print(f"  WARNING: Missing required join columns. Need either (row, col) or (x, y)")
            print(f"  Available columns: {available_columns}")
            return None
        
        if 'year' not in available_columns:
            print(f"  WARNING: Missing 'year' column for joining")
            return None
        
        # Build list of columns to read
        required_cols = ['year', wdpa_col]
        if has_row_col:
            required_cols.extend(['row', 'col'])
        if has_xy:
            required_cols.extend(['x', 'y'])
        
        # Read data
        all_data = []
        num_row_groups = pfile.metadata.num_row_groups
        print(f"  Reading {num_row_groups} row groups...")
        
        for rg_idx in range(num_row_groups):
            table = pfile.read_row_group(rg_idx, columns=required_cols)
            df = table.to_pandas()
            all_data.append(df)
        
        result = pd.concat(all_data, ignore_index=True)
        
        # Standardize column name
        if wdpa_col != 'WDPA_b1':
            result = result.rename(columns={wdpa_col: 'WDPA_b1'})
        
        # Fill NaN with 0 and convert to int
        result['WDPA_b1'] = result['WDPA_b1'].fillna(0).astype(int)
        
        # Identify pixels established in test period (2018-2019)
        # WDPA_b1 is cumulative (protected by that year), so we identify establishments by:
        # - WDPA_b1=1 in 2018 or 2019 AND WDPA_b1=0 in 2017 (or earlier)
        # Create a flag for pixels established in 2018-2019 that can be joined to all years
        print(f"  Identifying pixels established in test period (2018-2019)...")
        
        # Get unique identifier for each pixel (row/col or x/y)
        if has_row_col:
            pixel_id_cols = ['row', 'col']
        else:
            pixel_id_cols = ['x', 'y']
        
        # Sort by pixel and year
        result = result.sort_values(pixel_id_cols + ['year'])
        
        # For each pixel, check if it was established in 2018 or 2019
        # Establishment = WDPA_b1=1 in 2018/2019 AND WDPA_b1=0 in 2017 (or no 2017 data)
        establishments = []
        
        for pixel_id, pixel_data in result.groupby(pixel_id_cols):
            pixel_data = pixel_data.sort_values('year')
            
            # Get WDPA status for relevant years
            wdpa_2017 = pixel_data[pixel_data['year'] == 2017]['WDPA_b1'].values
            wdpa_2018 = pixel_data[pixel_data['year'] == 2018]['WDPA_b1'].values
            wdpa_2019 = pixel_data[pixel_data['year'] == 2019]['WDPA_b1'].values
            
            # Check if established in 2018: WDPA_b1=1 in 2018 AND (WDPA_b1=0 in 2017 OR no 2017 data)
            established_2018 = False
            if len(wdpa_2018) > 0 and wdpa_2018[0] == 1:
                if len(wdpa_2017) == 0 or wdpa_2017[0] == 0:
                    established_2018 = True
            
            # Check if established in 2019: WDPA_b1=1 in 2019 AND WDPA_b1=0 in 2018 (or no 2018 data)
            established_2019 = False
            if len(wdpa_2019) > 0 and wdpa_2019[0] == 1:
                if len(wdpa_2018) == 0 or wdpa_2018[0] == 0:
                    established_2019 = True
            
            # If established in either 2018 or 2019, mark this pixel
            if established_2018 or established_2019:
                # pixel_id is a tuple from groupby, convert to dict
                if has_row_col:
                    establishments.append({'row': pixel_id[0], 'col': pixel_id[1]})
                else:
                    establishments.append({'x': pixel_id[0], 'y': pixel_id[1]})
        
        # Create establishment flag DataFrame
        if establishments:
            estab_df = pd.DataFrame(establishments)
            estab_df['established_2018_2019'] = 1
            print(f"  Found {len(estab_df):,} pixels established in 2018-2019")
        else:
            # Create empty DataFrame with correct columns
            if has_row_col:
                estab_df = pd.DataFrame(columns=['row', 'col', 'established_2018_2019'])
            else:
                estab_df = pd.DataFrame(columns=['x', 'y', 'established_2018_2019'])
            print(f"  WARNING: No pixels found established in 2018-2019")
        
        # Merge establishment flag back into result
        # This adds the flag to all years for each pixel
        result = result.merge(estab_df, on=pixel_id_cols, how='left')
        result['established_2018_2019'] = result['established_2018_2019'].fillna(0).astype(int)
        
        print(f"  Loaded {len(result):,} rows with WDPA data")
        print(f"  Years: {sorted(result['year'].unique())}")
        print(f"  Protected pixels (WDPA_b1=1): {(result['WDPA_b1'] == 1).sum():,}")
        print(f"  Pixels with establishment flag: {(result['established_2018_2019'] == 1).sum():,}")
        if has_row_col:
            print(f"  Join method: row/col/year (with establishment flag)")
        elif has_xy:
            print(f"  Join method: x/y/year (with establishment flag)")
        
        return result
    
    except Exception as e:
        print(f"  WARNING: Failed to load WDPA data from test parquet: {e}")
        return None


def points_to_raster(x: np.ndarray, y: np.ndarray, values: np.ndarray, 
                     target_resolution: Optional[float] = None) -> tuple[np.ndarray, tuple]:
    """Convert point data to a raster grid for pixel-perfect visualization.
    
    Uses histogram-based binning for maximum precision and performance.
    For 1 km resolution at Colombia latitude (~4-12°N), approximately 0.009 degrees.
    
    Args:
        x: Longitude coordinates
        y: Latitude coordinates  
        values: Values to rasterize
        target_resolution: Target resolution in degrees. If None, auto-detects from data.
    
    Returns:
        Tuple of (raster_array, extent) where extent is (xmin, xmax, ymin, ymax)
        Raster array has shape (nrows, ncols) and may contain NaN for empty cells
    """
    # Calculate bounds
    x_min, x_max = x.min(), x.max()
    y_min, y_max = y.min(), y.max()
    
    # Determine grid resolution
    if target_resolution is None:
        # For 1 km resolution at Colombia latitude, ~0.009 degrees
        # Estimate from data: use median of non-zero coordinate differences
        sample_size = min(50000, len(x))
        sample_idx = np.random.choice(len(x), sample_size, replace=False)
        x_sample = np.sort(x[sample_idx])
        y_sample = np.sort(y[sample_idx])
        
        # Find smallest non-zero differences (these represent grid resolution)
        x_diffs = np.diff(x_sample)
        x_diffs = x_diffs[x_diffs > 1e-10]
        y_diffs = np.diff(y_sample)
        y_diffs = y_diffs[y_diffs > 1e-10]
        
        if len(x_diffs) > 100 and len(y_diffs) > 100:
            # Use 10th percentile of differences as resolution estimate
            x_res = np.percentile(x_diffs[x_diffs < np.percentile(x_diffs, 25)], 10)
            y_res = np.percentile(y_diffs[y_diffs < np.percentile(y_diffs, 25)], 10)
        else:
            # Fallback: use 1 km equivalent (~0.009 degrees)
            x_res = 0.009
            y_res = 0.009
    else:
        x_res = target_resolution
        y_res = target_resolution
    
    # Ensure resolution is reasonable (not too fine, not too coarse)
    x_res = max(x_res, (x_max - x_min) / 10000)  # Minimum: 10000 cells
    x_res = min(x_res, (x_max - x_min) / 100)    # Maximum: 100 cells
    y_res = max(y_res, (y_max - y_min) / 10000)
    y_res = min(y_res, (y_max - y_min) / 100)
    
    # Create grid edges
    # Extend slightly beyond bounds to ensure all points are included
    padding = max(x_res, y_res) * 0.1
    x_edges = np.arange(x_min - padding, x_max + padding + x_res, x_res)
    y_edges = np.arange(y_min - padding, y_max + padding + y_res, y_res)
    
    # Calculate grid dimensions
    ncols = len(x_edges) - 1
    nrows = len(y_edges) - 1
    
    # Use histogram2d to bin points and get indices, then aggregate values
    # This is more efficient than griddata for large datasets
    x_idx = np.digitize(x, x_edges) - 1
    y_idx = np.digitize(y, y_edges) - 1
    
    # Clip indices to valid range
    x_idx = np.clip(x_idx, 0, ncols - 1)
    y_idx = np.clip(y_idx, 0, nrows - 1)
    
    # Create raster array
    raster = np.full((nrows, ncols), np.nan, dtype=np.float32)
    
    # For points that map to the same grid cell, use the mean value
    # Use pandas for efficient grouping
    df_grid = pd.DataFrame({
        'x_idx': x_idx,
        'y_idx': y_idx,
        'value': values
    })
    grid_agg = df_grid.groupby(['y_idx', 'x_idx'])['value'].mean().reset_index()
    
    # Fill raster array
    raster[grid_agg['y_idx'].values, grid_agg['x_idx'].values] = grid_agg['value'].values
    
    # Flip raster vertically because imshow with origin='upper' expects row 0 at top (highest y)
    # Currently, y_idx=0 corresponds to y_min (lowest), but we want it at the bottom
    # So we need to flip the array so that row 0 corresponds to y_max (highest)
    raster = np.flipud(raster)
    
    # Define extent for imshow (left, right, bottom, top)
    # Use the actual edge coordinates
    extent = (x_edges[0], x_edges[-1], y_edges[0], y_edges[-1])
    
    return raster, extent


def create_risk_map(df: pd.DataFrame, country_boundary_path: Optional[Path], output_dir: Path, model_type: str, metrics_data: Optional[Dict[str, Any]] = None, test_parquet_path: Optional[Path] = None) -> None:
    """Create risk map showing Colombia boundary, top-1% predicted pixels, and observed positives.
    
    Uses distinct colors for three categories:
    - Yellow: Predicted high-risk only (not observed)
    - Blue: Observed positives only (not predicted as high-risk)
    - Orange: Overlap (predicted high-risk AND observed)
    
    Observed positives are identified as pixels where WDPA_b1=1 (actually established in that year)
    OR y_true=1 (from 5-year lookahead target). This ensures pixels established in 2018 are
    correctly shown even though transition_01_win5 doesn't mark the actual year of establishment.
    
    Optionally shows existing protected areas (as of end of 2017) if wdpa_b1 column is present.
    """
    print("\n" + "=" * 70)
    print("CREATING RISK MAP")
    print("=" * 70)
    
    # Get Colombia boundary
    colombia_gdf = get_colombia_boundary(country_boundary_path)
    
    # Ensure CRS is set (assume EPSG:4326 if not set)
    if colombia_gdf.crs is None:
        colombia_gdf.set_crs('EPSG:4326', inplace=True)
    
    print(f"  Colombia boundary CRS: {colombia_gdf.crs}")
    print(f"  Colombia boundary bounds: {colombia_gdf.total_bounds}")
    
    # Create GeoDataFrame from predictions
    geometry = [Point(xy) for xy in zip(df['x'], df['y'])]
    gdf = gpd.GeoDataFrame(df, geometry=geometry, crs='EPSG:4326')
    
    print(f"  Prediction points: {len(gdf):,}")
    print(f"  Prediction bounds: {gdf.total_bounds}")
    
    # Check if protected area data is available
    has_wdpa = 'wdpa_b1' in df.columns
    if has_wdpa:
        # Fill NaN with 0 (not protected) and convert to boolean
        wdpa_values = df['wdpa_b1'].fillna(0)
        # Handle both integer and float types
        wdpa_values = wdpa_values.astype(float)
        protected_count = (wdpa_values == 1).sum()
        print(f"  Protected area coverage (as of end 2017): {protected_count:,} pixels ({protected_count/len(df)*100:.2f}%)")
        print(f"  wdpa_b1 value range: [{wdpa_values.min()}, {wdpa_values.max()}], unique values: {sorted(wdpa_values.unique())[:10]}")
        gdf['is_protected'] = (wdpa_values == 1).values
    else:
        print("  Note: wdpa_b1 column not found - protected areas will not be shown")
        print(f"  Available columns: {list(df.columns)}")
        gdf['is_protected'] = False
    
    # Load WDPA data from original test parquet if available
    # This is needed to correctly identify pixels that were established in each year
    # (since transition_01_win5 is a 5-year lookahead target, it doesn't mark the actual year of establishment)
    wdpa_test_df = load_wdpa_from_test_parquet(test_parquet_path)
    
    # Join WDPA establishment flag if available
    # This is critical for correctly identifying pixels established in 2018-2019,
    # since transition_01_win5 (y_true) is a 5-year lookahead target that doesn't mark
    # the actual year of establishment. We join on pixel identifier (not year) so the
    # flag applies to all years for each pixel.
    if wdpa_test_df is not None and 'established_2018_2019' in wdpa_test_df.columns:
        print(f"\n  Joining WDPA establishment flag from original test parquet...")
        
        # Extract establishment flag for each pixel (join on pixel identifier, not year)
        # This ensures the flag applies to all years for each pixel
        if all(col in df.columns for col in ['row', 'col']) and all(col in wdpa_test_df.columns for col in ['row', 'col']):
            print(f"  Using row/col join method (pixel-level, not year-specific)...")
            estab_flag_df = wdpa_test_df[['row', 'col', 'established_2018_2019']].drop_duplicates()
            df = df.merge(estab_flag_df, on=['row', 'col'], how='left')
            join_method = "row/col"
        elif all(col in df.columns for col in ['x', 'y']) and all(col in wdpa_test_df.columns for col in ['x', 'y']):
            print(f"  Using x/y join method (pixel-level, not year-specific)...")
            # Round coordinates to avoid floating point precision issues
            df_rounded = df.copy()
            df_rounded['x_rounded'] = df_rounded['x'].round(6)
            df_rounded['y_rounded'] = df_rounded['y'].round(6)
            
            estab_flag_df = wdpa_test_df[['x', 'y', 'established_2018_2019']].copy()
            estab_flag_df['x_rounded'] = estab_flag_df['x'].round(6)
            estab_flag_df['y_rounded'] = estab_flag_df['y'].round(6)
            estab_flag_df = estab_flag_df[['x_rounded', 'y_rounded', 'established_2018_2019']].drop_duplicates()
            
            df_rounded = df_rounded.merge(estab_flag_df, on=['x_rounded', 'y_rounded'], how='left')
            df_rounded = df_rounded.drop(columns=['x_rounded', 'y_rounded'])
            df = df_rounded
            join_method = "x/y"
        else:
            missing_cols_df = [col for col in ['row', 'col', 'x', 'y'] if col not in df.columns]
            missing_cols_wdpa = [col for col in ['row', 'col', 'x', 'y'] if col not in wdpa_test_df.columns]
            print(f"  WARNING: Cannot join WDPA establishment flag - missing required columns")
            print(f"  Missing in scored data: {missing_cols_df}")
            print(f"  Missing in test data: {missing_cols_wdpa}")
            print(f"  Available columns in scored data: {list(df.columns)}")
            df['established_2018_2019'] = 0
            join_method = None
        
        if join_method is not None:
            df['established_2018_2019'] = df['established_2018_2019'].fillna(0).astype(int)
            df['WDPA_b1_actual'] = df['established_2018_2019']
            print(f"  Joined WDPA establishment flag using {join_method}: {(df['WDPA_b1_actual'] == 1).sum():,} pixels established in 2018-2019")
    else:
        if wdpa_test_df is None:
            print(f"  WARNING: WDPA test data not available - using y_true only for observed positives")
        else:
            print(f"  WARNING: Establishment flag not found in WDPA test data - using y_true only for observed positives")
        df['WDPA_b1_actual'] = 0
    
    # Calculate top-1% threshold
    top1pct_threshold = np.percentile(df['y_pred_proba'], 99)
    print(f"  Top-1% threshold: {top1pct_threshold:.6f}")
    
    # Identify categories
    # Use WDPA_b1_actual = 1 OR y_true = 1 as indicator of observed positives
    # This fixes the issue where pixels established in 2018 have y_true=0 (due to 5-year lookahead logic)
    # but should still be shown as observed positives
    gdf['is_top1pct'] = df['y_pred_proba'] >= top1pct_threshold
    gdf['is_positive'] = (df['y_true'] == 1) | (df['WDPA_b1_actual'] == 1)
    
    # Log statistics
    y_true_positives = (df['y_true'] == 1).sum()
    wdpa_positives = (df['WDPA_b1_actual'] == 1).sum()
    combined_positives = gdf['is_positive'].sum()
    print(f"  Observed PA establishments: y_true={y_true_positives:,}, WDPA_b1_actual={wdpa_positives:,}, combined={combined_positives:,}")
    print(f"  Note: Combined uses WDPA_b1_actual=1 OR y_true=1 to correctly identify pixels established in each year")
    
    # Create three distinct categories
    gdf['category'] = 'none'
    gdf.loc[gdf['is_top1pct'] & ~gdf['is_positive'], 'category'] = 'predicted_only'
    gdf.loc[~gdf['is_top1pct'] & gdf['is_positive'], 'category'] = 'observed_only'
    gdf.loc[gdf['is_top1pct'] & gdf['is_positive'], 'category'] = 'overlap'
    
    # Count pixels in each category
    predicted_only_count = (gdf['category'] == 'predicted_only').sum()
    observed_only_count = (gdf['category'] == 'observed_only').sum()
    overlap_count = (gdf['category'] == 'overlap').sum()
    
    print(f"  Predicted high-risk only: {predicted_only_count:,}")
    print(f"  Observed PA establishments only: {observed_only_count:,}")
    print(f"  Overlap (predicted + observed PA): {overlap_count:,}")
    
    # Create categorical raster: convert category names to numeric codes
    # 0 = none, 1 = predicted_only, 2 = observed_only, 3 = overlap, 4 = protected
    category_codes = {
        'none': 0,
        'predicted_only': 1,
        'observed_only': 2,
        'overlap': 3
    }
    gdf['category_code'] = gdf['category'].map(category_codes)
    
    # Handle protected areas separately - they overlay on top
    if has_wdpa:
        # Protected areas get code 4, but we'll handle them as a separate overlay
        pass
    
    # Extract time period information from metrics or use defaults
    # Based on modelC_LGBM: test period is 2018-2019, predictions are for 5-year lookahead (2018-2024)
    time_period = "2018-2019"
    prediction_horizon = "5-year lookahead (2018-2024)"
    
    if metrics_data:
        # Try to extract time period from metadata
        metadata = metrics_data.get("metadata", {})
        test_year_range = metadata.get("test_year_range")
        if test_year_range and isinstance(test_year_range, list) and len(test_year_range) == 2:
            time_period = f"{test_year_range[0]}-{test_year_range[1]}"
        elif "test_years" in metadata:
            test_years = metadata["test_years"]
            if isinstance(test_years, (list, tuple)) and len(test_years) == 2:
                time_period = f"{test_years[0]}-{test_years[1]}"
        
        # Get lookahead years if available
        lookahead = metadata.get("lookahead_years", 5)
        if isinstance(lookahead, int) and test_year_range:
            pred_end = test_year_range[1] + lookahead
            prediction_horizon = f"{lookahead}-year lookahead ({test_year_range[0]}-{pred_end})"
    
    # Convert to raster for pixel-perfect visualization
    print(f"  Converting {len(gdf):,} points to raster grid...")
    
    # Create main category raster
    category_raster, extent = points_to_raster(
        gdf.geometry.x.values,
        gdf.geometry.y.values,
        gdf['category_code'].values,
        target_resolution=MAP_RESOLUTION
    )
    print(f"  Category raster shape: {category_raster.shape}, extent: {extent}")
    print(f"  Valid (non-NaN) pixels: {np.sum(~np.isnan(category_raster)):,}")
    
    # Create protected areas raster if available (using same grid structure)
    protected_raster = None
    if has_wdpa:
        protected_mask = gdf['is_protected'].values
        if protected_mask.sum() > 0:
            # Create protected areas raster using same grid as category raster
            protected_raster, protected_extent = points_to_raster(
                gdf.geometry.x.values,
                gdf.geometry.y.values,
                protected_mask.astype(float),  # Convert boolean to float for rasterization
                target_resolution=MAP_RESOLUTION
            )
            # Ensure extent matches (should be the same, but verify)
            if protected_extent != extent:
                print(f"  WARNING: Protected areas extent differs from category extent")
                print(f"    Category extent: {extent}")
                print(f"    Protected extent: {protected_extent}")
            # Convert to boolean mask (values > 0.5)
            protected_raster = (protected_raster > 0.5).astype(float)
            protected_raster[protected_raster == 0] = np.nan  # Set non-protected to NaN for masking
            print(f"  Protected areas raster created with {np.sum(~np.isnan(protected_raster)):,} pixels")
    
    # Create figure
    fig, ax = plt.subplots(figsize=MAP_FIGSIZE)
    
    # Plot Colombia boundary
    colombia_gdf.plot(ax=ax, color='white', edgecolor='none', linewidth=1.5, zorder=1)
    
    # Define colors for each category using standardized color scheme
    from matplotlib.colors import ListedColormap, BoundaryNorm
    
    # Use standardized colors from constants
    category_colors_rgba = {
        0: RISK_MAP_COLORS['none'],  # none - darkest purple
        1: RISK_MAP_COLORS['predicted_only'],  # predicted_only - blue-green
        2: RISK_MAP_COLORS['observed_only'],  # observed_only - bright cyan
        3: RISK_MAP_COLORS['overlap']  # overlap - bright red
    }
    
    # Convert to hex for legend (take only RGB, ignore alpha)
    def rgba_to_hex(rgba):
        """Convert RGBA tuple to hex color string."""
        r, g, b = int(rgba[0] * 255), int(rgba[1] * 255), int(rgba[2] * 255)
        return f'#{r:02x}{g:02x}{b:02x}'
    
    category_colors_hex = {
        0: rgba_to_hex(category_colors_rgba[0]),
        1: rgba_to_hex(category_colors_rgba[1]),
        2: rgba_to_hex(category_colors_rgba[2]),
        3: rgba_to_hex(category_colors_rgba[3])
    }
    
    # Create colormap and normalization (excluding background for main plot)
    # Background will be plotted separately with transparency
    colors_list_no_bg = [category_colors_rgba[i] for i in range(1, 4)]  # Skip category 0
    cmap_cat = ListedColormap(colors_list_no_bg)
    bounds = [0.5, 1.5, 2.5, 3.5]  # Adjusted bounds for categories 1, 2, 3
    norm_cat = BoundaryNorm(bounds, cmap_cat.N)
    
    # Create separate raster for background (category 0) with transparency
    background_raster = np.where(category_raster == 0, 1, np.nan)
    background_raster_masked = np.ma.masked_where(np.isnan(background_raster), background_raster)
    
    # Plot background separately with very low alpha (barely visible)
    if not background_raster_masked.mask.all():
        ax.imshow(background_raster_masked,
                 extent=extent,
                 cmap=ListedColormap([category_colors_rgba[0]]),  # Single color for background
                 vmin=0, vmax=1,
                 origin='upper',
                 interpolation='nearest',
                 aspect='equal',
                 alpha=RISK_MAP_ALPHA_BACKGROUND,
                 zorder=1)
    
    # Plot main category raster (categories 1, 2, 3) with full opacity
    # Create a masked array that excludes background pixels (category 0)
    category_raster_no_bg = np.where(category_raster == 0, np.nan, category_raster)
