#!/usr/bin/env python3

"""
Sampling script for modelC tuning sample (Colombia dataset).

Rules
-----
- Keep all positives (transition_01_win5 == 1)
- Cap total negatives at ~300,000 (sample uniformly across years)
- Target total tuning size ≈ 350k–400k rows
- Year 2000 excluded to avoid treating existing PAs as transitions
- Output: data/ml/tuning/modelC_tuning_colombia.parquet

Notes
-----
- Uniform sampling across years ensures balanced temporal distribution
- Random sampling for simplicity (no hard negatives)
- Used by both Random Forest and LightGBM hyperparameter tuning scripts
- Uses 5-year lookahead target (transition_01_win5) from merged_panel_colombia_final_win5.parquet
"""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

import duckdb
import wandb

# Configuration
RANDOM_STATE = 42
MAX_TOTAL_NEGATIVES = 300_000  # Cap total negatives at ~300k
WANDB_PROJECT = "ml-preprocessing"


def resolve_input() -> Path:
    """Locate merged_panel_colombia_final_win5.parquet (prefer $SCRATCH if present)."""
    repo_root = Path(__file__).resolve().parents[4]
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        # Check outputs/Results first (standard Euler location from colombia_features script)
        candidates.append(scratch_root / "outputs/Results/merged_panel_colombia_final_win5.parquet")
        # Also check data/ml location
        candidates.append(scratch_root / "data/ml/merged_panel_colombia_final_win5.parquet")
    candidates.append(repo_root / "outputs/Results/merged_panel_colombia_final_win5.parquet")
    candidates.append(repo_root / "data/ml/merged_panel_colombia_final_win5.parquet")

    for cand in candidates:
        if cand.exists():
            return cand

    # Provide detailed error message with all checked paths
    error_msg = "merged_panel_colombia_final_win5.parquet not found in expected locations.\n"
    error_msg += "\nChecked locations:\n"
    for cand in candidates:
        error_msg += f"  - {cand}\n"
    if scratch_root:
        error_msg += f"\nSCRATCH root: {scratch_root}\n"
    error_msg += f"Repository root: {repo_root}\n"
    raise FileNotFoundError(error_msg)


def configure_duckdb(con: duckdb.DuckDBPyConnection) -> None:
    """Apply sensible local/Euler defaults."""
    is_euler = bool(os.environ.get("SCRATCH"))
    slurm_cpus = int(os.environ.get("SLURM_CPUS_PER_TASK", "0"))
    num_threads = slurm_cpus if slurm_cpus > 0 else (48 if is_euler else 4)

    # Match DuckDB memory to Slurm allocation when present
    slurm_mem_per_cpu_mb = os.environ.get("SLURM_MEM_PER_CPU")
    if slurm_mem_per_cpu_mb and slurm_cpus:
        total_mem_mb = int(slurm_mem_per_cpu_mb) * slurm_cpus
        memory_limit_gb = max(1, total_mem_mb // 1024)
    else:
        memory_limit_gb = 128 if is_euler else 16

    con.execute(f"SET threads={num_threads}")
    con.execute("SET preserve_insertion_order=false")
    con.execute(f"SET memory_limit='{memory_limit_gb}GB'")

    temp_dir = os.environ.get("SCRATCH") or (Path(__file__).parent / "temp")
    # Ensure temp directory exists (DuckDB won't create parent directories)
    if isinstance(temp_dir, str):
        temp_dir = Path(temp_dir)
    temp_dir.mkdir(parents=True, exist_ok=True)
    duckdb_temp_dir = temp_dir / "duckdb_temp"
    duckdb_temp_dir.mkdir(parents=True, exist_ok=True)
    temp_dir_sql = str(duckdb_temp_dir).replace("'", "''")
    con.execute(f"SET temp_directory='{temp_dir_sql}'")

    if is_euler:
        con.execute("PRAGMA max_temp_directory_size='200GB'")

    print(f"DuckDB configured: {num_threads} threads, {memory_limit_gb}GB memory")
    print(f"Running on: {'Euler cluster' if is_euler else 'local machine'}")


def log_year_counts(con: duckdb.DuckDBPyConnection, parquet_path: Path, label: str, use_wandb: bool = False) -> None:
    """Log per-year counts and ratios."""
    escaped = str(parquet_path).replace("'", "''")
    rows = con.execute(
        f"""
        SELECT
            year,
            SUM(transition_01_win5) AS positives,
            SUM(CASE WHEN transition_01_win5 = 0 THEN 1 ELSE 0 END) AS negatives,
            COUNT(*) AS total,
            CASE WHEN COUNT(*) > 0 THEN SUM(transition_01_win5)::DOUBLE / COUNT(*) ELSE 0 END AS pos_ratio,
            CASE WHEN SUM(transition_01_win5) > 0 
                 THEN SUM(CASE WHEN transition_01_win5 = 0 THEN 1 ELSE 0 END)::DOUBLE / SUM(transition_01_win5)
                 ELSE 0 END AS neg_pos_ratio
        FROM read_parquet('{escaped}')
        GROUP BY year
        ORDER BY year
        """
    ).fetchall()

    print(f"\n{label} per-year counts:")
    for year, pos, neg, total, pos_ratio, neg_pos_ratio in rows:
        print(f"  {year}: total={total:,} pos={pos:,} neg={neg:,} | pos_ratio={pos_ratio:.5f} neg/pos={neg_pos_ratio:.1f}")

    if use_wandb:
        wandb.log({f"{label.lower().replace(' ', '_')}/per_year_transition_01_win5": [
            dict(year=y, positives=p, negatives=n, total=t, pos_ratio=r, neg_pos_ratio=npr) 
            for y, p, n, t, r, npr in rows
        ]})


def main() -> None:
    start_time = time.time()

    wandb_api_key = os.environ.get("WANDB_API_KEY")
    wandb_entity = os.environ.get("WANDB_ENTITY")
    if not wandb_api_key:
        print("Warning: WANDB_API_KEY not found in environment")
    if not wandb_entity:
        print("Warning: WANDB_ENTITY not found in environment (will use default)")
    
    use_wandb = False
    try:
        print("Initializing Weights & Biases...")
        wandb.init(
            project=WANDB_PROJECT,
            entity=wandb_entity,
            name=f"modelC_sample_{time.strftime('%Y%m%d_%H%M%S')}",
            config={
                "random_state": RANDOM_STATE,
                "max_total_negatives": MAX_TOTAL_NEGATIVES,
                "sampling_method": "uniform_across_years",
                "exclude_year": 2000,
            },
        )
        use_wandb = True
        print("W&B connected\n")
    except Exception as err:
        print(f"W&B initialization failed: {err}\n")

    repo_root = Path(__file__).resolve().parents[4]
    input_path = resolve_input()
    
    # Determine output location: prefer data/ml/tuning on scratch, else relative to input
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None
    if scratch_root is not None:
        # Use standard ML data location on scratch
        base_dir = scratch_root / "data/ml"
    else:
        # Use repo location
        base_dir = repo_root / "data/ml"
    
    tuning_dir = base_dir / "tuning"
    tuning_dir.mkdir(parents=True, exist_ok=True)
    output_path = tuning_dir / "modelC_tuning_colombia.parquet"

    print(f"\nInput: {input_path}")
    print(f"Output: {output_path}")
    print(f"Target: Keep all positives, cap negatives at {MAX_TOTAL_NEGATIVES:,}")

    con = duckdb.connect()
    configure_duckdb(con)

    escaped_in = str(input_path).replace("'", "''")
    escaped_out = str(output_path).replace("'", "''")

    try:
        # Sample SQL: Keep all positives, cap total negatives at MAX_TOTAL_NEGATIVES (uniform across years)
        sample_sql = f"""
        COPY (
            WITH base AS (
                SELECT *
                FROM read_parquet('{escaped_in}')
                WHERE year != 2000
            ),
            year_counts AS (
                SELECT
                    year,
                    SUM(transition_01_win5) AS pos_count,
                    SUM(CASE WHEN transition_01_win5 = 0 THEN 1 ELSE 0 END) AS neg_count
                FROM base
                GROUP BY year
            ),
            num_years AS (
                SELECT COUNT(*) AS n_years FROM year_counts
            ),
            -- Calculate per-year negative quota: distribute MAX_TOTAL_NEGATIVES uniformly across years
            -- Each year gets: min(neg_count, MAX_TOTAL_NEGATIVES / num_years)
            neg_budget AS (
                SELECT
                    yc.year,
                    yc.pos_count,
                    yc.neg_count,
                    LEAST(
                        yc.neg_count,
                        CAST(ROUND({MAX_TOTAL_NEGATIVES}::DOUBLE / ny.n_years) AS BIGINT)
                    ) AS year_neg_budget
                FROM year_counts yc
                CROSS JOIN num_years ny
            ),
            positives AS (
                -- Keep all positives (no sampling)
                SELECT * FROM base WHERE transition_01_win5 = 1
            ),
            -- Prepare negative pool with per-year budgets and random ordering
            neg_candidates AS (
                SELECT
                    b.*,
                    nb.year_neg_budget,
                    random() AS u
                FROM base b
                INNER JOIN neg_budget nb ON b.year = nb.year
                WHERE b.transition_01_win5 = 0 AND nb.year_neg_budget > 0
            ),
            -- Rank negatives randomly within each year
            ranked_negs AS (
                SELECT
                    *,
                    ROW_NUMBER() OVER (
                        PARTITION BY year
                        ORDER BY u
                    ) AS neg_rank
                FROM neg_candidates
            ),
            -- Sample negatives up to budget per year
            sampled_negs AS (
                SELECT * EXCLUDE (
                    year_neg_budget,
                    u,
                    neg_rank
                )
                FROM ranked_negs
                WHERE neg_rank <= year_neg_budget
            )
            SELECT * FROM positives
            UNION ALL
            SELECT * FROM sampled_negs
        )
        TO '{escaped_out}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating ModelC RF tuning sample...")
        print(f"  All positives kept; negatives capped at {MAX_TOTAL_NEGATIVES:,} total (uniform across years)")
        
        # Set random seed for reproducible sampling
        seed_value = RANDOM_STATE / 100.0
        con.execute(f"SELECT setseed({seed_value})")
        
        sample_start = time.time()
        con.execute(sample_sql)
        print(f"Sample written in {time.time() - sample_start:.1f}s")

        # Log counts
        log_year_counts(con, output_path, "TUNING_SAMPLE", use_wandb)

        # Check total rows
        total_rows = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_out}')"
        ).fetchone()[0]
        
        print(f"\nTotal rows: {total_rows:,}")
        
        # Check per-year distribution
        print(f"\nPer-year distribution:")
        year_stats = con.execute(
            f"""
            SELECT
                year,
                SUM(transition_01_win5) AS pos_count,
                SUM(CASE WHEN transition_01_win5 = 0 THEN 1 ELSE 0 END) AS neg_count
            FROM read_parquet('{escaped_out}')
            GROUP BY year
            ORDER BY year
            """
        ).fetchall()
        
        for year, pos, neg in year_stats:
            print(f"  {year}: pos={pos:,} neg={neg:,} total={pos+neg:,}")
        
        # Overall statistics
        overall_stats = con.execute(
            f"""
            SELECT
                SUM(transition_01_win5) AS total_pos,
                SUM(CASE WHEN transition_01_win5 = 0 THEN 1 ELSE 0 END) AS total_neg
            FROM read_parquet('{escaped_out}')
            """
        ).fetchone()
        total_pos, total_neg = overall_stats
        neg_pos_ratio = total_neg / total_pos if total_pos > 0 else 1.0
        
        print(f"\nOverall class balance:")
        print(f"  Positives: {total_pos:,}")
        print(f"  Negatives: {total_neg:,} (capped at {MAX_TOTAL_NEGATIVES:,})")
        print(f"  Ratio (neg/pos): {neg_pos_ratio:.2f}")
        print(f"  Total size: {total_pos + total_neg:,} rows")

        if use_wandb:
            wandb.log({
                "sample/total_rows": total_rows,
                "sample/total_positives": total_pos,
                "sample/total_negatives": total_neg,
                "sample/neg_pos_ratio": neg_pos_ratio,
                "sample/max_total_negatives": MAX_TOTAL_NEGATIVES,
                "timing/total_seconds": time.time() - start_time,
            })
        
        print(f"\nDone. Total time: {time.time() - start_time:.1f}s")

    except Exception as e:
        error_msg = f"{type(e).__name__}: {e}"
        print(f"\nERROR: {error_msg}")
        if use_wandb:
            wandb.log({"status": "failed", "error": error_msg})
        raise
    finally:
        if use_wandb:
            wandb.finish()


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"\nScript failed: {e}", file=sys.stderr)
        sys.exit(1)

