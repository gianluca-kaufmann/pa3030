def get_south_america_boundary(region_boundary_path: Optional[Path] = None) -> gpd.GeoDataFrame:
    """Get South America boundary from file or download from URL.
    
    Strategy:
    1. Use provided path if available
    2. Try common local file locations (GeoJSON/GPKG)
    3. Fallback to URL download
    4. Ensure CRS is normalized to EPSG:4326
    """
    south_america_iso_codes = ['ARG', 'BOL', 'BRA', 'CHL', 'COL', 'ECU', 'GUF', 'GUY', 
                               'PRY', 'PER', 'SUR', 'URY', 'VEN']
    
    # Strategy 1: Use provided path
    if region_boundary_path and region_boundary_path.exists():
        print(f"Loading South America boundary from: {region_boundary_path}")
        gdf = gpd.read_file(region_boundary_path)
    else:
        # Strategy 2: Try common local file locations
        repo_root = get_repo_root()
        local_candidates = [
            repo_root / "data" / "boundaries" / "south_america.geojson",
            repo_root / "data" / "boundaries" / "south_america.gpkg",
            repo_root / "data" / "boundaries" / "south_america.shp",
            repo_root / "data" / "ready" / "boundaries" / "south_america.geojson",
            repo_root / "data" / "ready" / "boundaries" / "south_america.gpkg",
        ]
        
        gdf = None
        for candidate in local_candidates:
            if candidate.exists():
                print(f"Loading South America boundary from local file: {candidate}")
                try:
                    gdf = gpd.read_file(candidate)
                    break
                except Exception as e:
                    print(f"  Failed to load {candidate}: {e}")
                    continue
        
        # Strategy 3: Fallback to URL download
        if gdf is None:
            print("Loading South America boundary from URL...")
            import urllib.request
            import tempfile
            import zipfile
            import shutil
            
            urls = [
                "https://naciscdn.org/naturalearth/110m/cultural/ne_110m_admin_0_countries.zip",
                "https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson",
            ]
            
            for url in urls:
                try:
                    with tempfile.NamedTemporaryFile(delete=False, suffix='.zip' if url.endswith('.zip') else '.geojson') as tmp:
                        urllib.request.urlretrieve(url, tmp.name)
                        
                        if url.endswith('.zip'):
                            extract_dir = tempfile.mkdtemp()
                            try:
                                with zipfile.ZipFile(tmp.name, 'r') as zip_ref:
                                    zip_ref.extractall(extract_dir)
                                shp_files = list(Path(extract_dir).glob('*.shp'))
                                if shp_files:
                                    gdf = gpd.read_file(shp_files[0])
                                else:
                                    raise ValueError("Could not find shapefile in downloaded zip")
                            finally:
                                os.unlink(tmp.name)
                                shutil.rmtree(extract_dir)
                        else:
                            gdf = gpd.read_file(tmp.name)
                            os.unlink(tmp.name)
                    
                    if gdf is not None and not gdf.empty:
                        print(f"  Successfully loaded from {url}")
                        break
                except Exception as e:
                    print(f"  Failed to load from {url}: {e}")
                    continue
            
            if gdf is None or gdf.empty:
                raise RuntimeError(
                    "Could not load South America boundary. Please provide --region_boundary path "
                    "or ensure internet connection for URL download."
                )
    
    # Filter to South American countries
    if 'iso_a3' in gdf.columns:
        south_america = gdf[gdf['iso_a3'].isin(south_america_iso_codes)].copy()
    elif 'ISO_A3' in gdf.columns:
        south_america = gdf[gdf['ISO_A3'].isin(south_america_iso_codes)].copy()
    elif 'name' in gdf.columns:
        sa_names = ['Argentina', 'Bolivia', 'Brazil', 'Chile', 'Colombia', 'Ecuador',
                   'French Guiana', 'Guyana', 'Paraguay', 'Peru', 'Suriname', 
                   'Uruguay', 'Venezuela']
        south_america = gdf[gdf['name'].isin(sa_names)].copy()
    else:
        # If no filtering column found, assume single region file
        south_america = gdf.copy()
    
    if south_america is None or len(south_america) == 0:
        raise ValueError("Could not find South America countries in boundary dataset")
    
    # Ensure CRS is normalized to EPSG:4326
    if south_america.crs is None:
        print("  Warning: No CRS defined, assuming EPSG:4326")
        south_america = south_america.set_crs('EPSG:4326', allow_override=True)
    elif south_america.crs.to_string() != 'EPSG:4326':
        print(f"  Reprojecting from {south_america.crs} to EPSG:4326...")
        south_america = south_america.to_crs('EPSG:4326')
    
    print(f"  Found South America boundary with {len(south_america)} feature(s) in EPSG:4326")
    return south_america


def derive_test_years(metrics_data: Optional[Dict[str, Any]] = None, 
                      parquet_path: Optional[Path] = None,
                      test_parquet_path: Optional[Path] = None) -> list:
    """Derive test years, prioritizing the original test parquet.
    
    Priority:
    1. Read unique years from the `year` column of `test_parquet_path`
    2. Use `metadata.test_year_range` or `metadata.test_years` from metrics
    3. Fallback to [2018, 2019] **only** if the test parquet is missing or unusable
    
    Args:
        metrics_data: Parsed metrics JSON (may contain `metadata` field)
        parquet_path: Kept for backward compatibility (no longer used for year inference)
        test_parquet_path: Path to original test parquet (preferred source of test years)
    
    Returns:
        List of test years (e.g., [2018, 2019])
    """
    # ------------------------------------------------------------------
    # 1) Prefer deriving years directly from the original test parquet
    # ------------------------------------------------------------------
    parquet_unusable = False
    if test_parquet_path is None or not test_parquet_path.exists():
        parquet_unusable = True
    else:
        try:
            pfile = pq.ParquetFile(test_parquet_path)
            if 'year' in pfile.schema_arrow.names:
                years_set = set()
                num_row_groups = pfile.metadata.num_row_groups
                for rg_idx in range(num_row_groups):
                    try:
                        table = pfile.read_row_group(rg_idx, columns=['year'])
                        df = table.to_pandas()
                        years_set.update(df['year'].dropna().unique())
                    except Exception:
                        continue
                if years_set:
                    years = sorted(int(y) for y in years_set if pd.notna(y))
                    if years:
                        print(f"  Derived test years from test parquet: {years}")
                        return years
                else:
                    # No usable years in the parquet; treat as unusable for deriving years
                    parquet_unusable = True
            else:
                # Missing `year` column; treat as unusable for deriving years
                parquet_unusable = True
        except Exception:
            # Any I/O or decoding issue: consider the parquet unusable for year inference
            parquet_unusable = True
    
    # ------------------------------------------------------------------
    # 2) Fall back to metrics metadata
    # ------------------------------------------------------------------
    if metrics_data:
        metadata = metrics_data.get("metadata", {})
        test_year_range = metadata.get("test_year_range")
        if test_year_range and isinstance(test_year_range, list) and len(test_year_range) == 2:
            test_years = list(range(int(test_year_range[0]), int(test_year_range[1]) + 1))
            print(f"  Derived test years from metadata.test_year_range: {test_years}")
            return test_years
        
        test_years_meta = metadata.get("test_years")
        if test_years_meta and isinstance(test_years_meta, (list, tuple)):
            test_years = [int(y) for y in test_years_meta]
            print(f"  Derived test years from metadata.test_years: {test_years}")
            return test_years
    
    # ------------------------------------------------------------------
    # 3) Final fallback – only when test parquet is missing/unusable
    #    No WARNING printed to keep logs thesis-clean.
    # ------------------------------------------------------------------
    if parquet_unusable:
        return [2018, 2019]
    
    # In the extremely unlikely case that the parquet exists and is readable
    # but provided no usable years and no metadata is available, still return
    # a sensible default without emitting warnings.
    return [2018, 2019]


def load_wdpa_from_test_parquet(test_parquet_path: Optional[Path], test_years: list) -> Optional[pd.DataFrame]:
    """Load WDPA_b1 and WDPA_prev data from original test parquet file for joining with scored data.
    
    This is needed because transition_01_win5 (y_true) is a 5-year lookahead target that doesn't
    mark the actual year of establishment. For example, a pixel established in 2018 will have
    y_true=1 only for years before 2018, not for 2018 itself. By loading WDPA_b1 from the
    original test data, we can correctly identify pixels that were actually established in each year.
    
    Also loads WDPA_prev to distinguish between:
    - Already protected areas (WDPA_prev=1): Protected in previous year, defines risk set boundary
    - Newly protected areas (WDPA_prev=0, WDPA_b1=1): Became protected during test period
    
    Returns DataFrame with columns: row, col, year, x, y, WDPA_b1, WDPA_prev (or None if file not found/not available)
    Includes x, y coordinates as fallback for joining when row/col are missing in scored data.
    """
    if test_parquet_path is None or not test_parquet_path.exists():
        return None
    
    print(f"\nLoading WDPA data from original test parquet: {test_parquet_path}")
    try:
        pfile = pq.ParquetFile(test_parquet_path)
        available_columns = pfile.schema_arrow.names
        
        # Check for WDPA_b1 column
        wdpa_col = None
        for candidate in ['WDPA_b1', 'wdpa_b1']:
            if candidate in available_columns:
                wdpa_col = candidate
                break
        
        if wdpa_col is None:
            print(f"  WARNING: WDPA column not found in test parquet. Available columns: {available_columns}")
            return None
        
        # Check for WDPA_prev column (optional, for two-layer protection visualization)
        wdpa_prev_col = None
        for candidate in ['WDPA_prev', 'wdpa_prev']:
            if candidate in available_columns:
                wdpa_prev_col = candidate
                break
        
        if wdpa_prev_col is not None:
            print(f"  Found WDPA_prev column: '{wdpa_prev_col}' (enables temporal protection visualization)")
        else:
            print(f"  Note: WDPA_prev column not found (single-layer protection visualization only)")
        
        # Check for required join columns - try row/col first, then x/y as fallback
        has_row_col = 'row' in available_columns and 'col' in available_columns
        has_xy = 'x' in available_columns and 'y' in available_columns
        
        if not has_row_col and not has_xy:
            print(f"  WARNING: Missing required join columns. Need either (row, col) or (x, y)")
            print(f"  Available columns: {available_columns}")
            return None
        
        if 'year' not in available_columns:
            print(f"  WARNING: Missing 'year' column for joining")
            return None
        
        # Build list of columns to read
        required_cols = ['year', wdpa_col]
        if wdpa_prev_col is not None:
            required_cols.append(wdpa_prev_col)
        if has_row_col:
            required_cols.extend(['row', 'col'])
        if has_xy:
            required_cols.extend(['x', 'y'])
        
        # Read data
        all_data = []
        num_row_groups = pfile.metadata.num_row_groups
        print(f"  Reading {num_row_groups} row groups...")
        
        for rg_idx in range(num_row_groups):
            table = pfile.read_row_group(rg_idx, columns=required_cols)
            df = table.to_pandas()
            all_data.append(df)
        
        result = pd.concat(all_data, ignore_index=True)
        
        # Standardize column names
        if wdpa_col != 'WDPA_b1':
            result = result.rename(columns={wdpa_col: 'WDPA_b1'})
        if wdpa_prev_col is not None and wdpa_prev_col != 'WDPA_prev':
            result = result.rename(columns={wdpa_prev_col: 'WDPA_prev'})
        
        # Fill NaN with 0 and convert to int
        result['WDPA_b1'] = result['WDPA_b1'].fillna(0).astype(int)
        if 'WDPA_prev' in result.columns:
            result['WDPA_prev'] = result['WDPA_prev'].fillna(0).astype(int)
        
        # Identify pixels established in test period using VECTORIZED approach
        # WDPA_b1 is cumulative (protected by that year), so we identify establishments by:
        # - WDPA_b1=1 in test years AND WDPA_b1=0 in previous year
        # Create a flag for pixels established in test period that can be joined to all years
        test_year_str = f"{min(test_years)}-{max(test_years)}"
        print(f"  Identifying pixels established in test period ({test_year_str}) using vectorized approach...")
        
        # Get unique identifier for each pixel (row/col or x/y)
        if has_row_col:
            pixel_id_cols = ['row', 'col']
        else:
            pixel_id_cols = ['x', 'y']
        
        # Sort by pixel and year for vectorized shift operation
        result = result.sort_values(pixel_id_cols + ['year'])
        
        # VECTORIZED: Use shift() to compare WDPA_b1 with previous year for same pixel
        # Group by pixel and shift WDPA_b1 to get previous year's status
        result['WDPA_b1_prev_year'] = result.groupby(pixel_id_cols)['WDPA_b1'].shift(1).fillna(0).astype(int)
        
        # Identify newly protected pixels: WDPA_b1=1 AND WDPA_b1_prev_year=0
        # Filter to only test years for robustness
        result['newly_protected_in_test'] = (
            (result['year'].isin(test_years)) & 
            (result['WDPA_b1'] == 1) & 
            (result['WDPA_b1_prev_year'] == 0)
        ).astype(int)
        
        # Create pixel-level flag: a pixel is "established in test period" if it was newly protected in ANY test year
        estab_df = result.groupby(pixel_id_cols)['newly_protected_in_test'].max().reset_index()
        estab_df = estab_df[estab_df['newly_protected_in_test'] == 1].copy()
        estab_df['established_in_test_period'] = 1
        estab_df = estab_df[pixel_id_cols + ['established_in_test_period']]
        
        if len(estab_df) > 0:
            print(f"  Found {len(estab_df):,} pixels established in test period ({test_year_str})")
        else:
            print(f"  WARNING: No pixels found established in test period ({test_year_str})")
            # Create empty DataFrame with correct columns
            estab_df = pd.DataFrame(columns=pixel_id_cols + ['established_in_test_period'])
        
        # Create pixel-level flag for newly protected in test period (for visualization)
        newly_protected_pixel_flag = result.groupby(pixel_id_cols)['newly_protected_in_test'].max().reset_index()
        newly_protected_pixel_flag = newly_protected_pixel_flag[newly_protected_pixel_flag['newly_protected_in_test'] == 1].copy()
        newly_protected_pixel_flag['newly_protected_in_test_period'] = 1
        newly_protected_pixel_flag = newly_protected_pixel_flag[pixel_id_cols + ['newly_protected_in_test_period']]
        
        # Merge both flags back into result
        result = result.merge(estab_df, on=pixel_id_cols, how='left')
        result['established_in_test_period'] = result['established_in_test_period'].fillna(0).astype(int)
        
        result = result.merge(newly_protected_pixel_flag, on=pixel_id_cols, how='left')
        result['newly_protected_in_test_period'] = result['newly_protected_in_test_period'].fillna(0).astype(int)
        
        # Clean up temporary column
        result = result.drop(columns=['WDPA_b1_prev_year', 'newly_protected_in_test'])
        
        print(f"  Loaded {len(result):,} rows with WDPA data")
        print(f"  Years: {sorted(result['year'].unique())}")
        print(f"  Protected pixels (WDPA_b1=1): {(result['WDPA_b1'] == 1).sum():,}")
        print(f"  Pixels with establishment flag: {(result['established_in_test_period'] == 1).sum():,}")
        
        # Report on temporal protection dynamics if WDPA_prev available
        if 'WDPA_prev' in result.columns:
            already_protected = ((result['WDPA_prev'] == 1) & (result['WDPA_b1'] == 1)).sum()
            newly_protected = ((result['WDPA_prev'] == 0) & (result['WDPA_b1'] == 1)).sum()
            print(f"  Temporal protection analysis:")
            print(f"    - Already protected (WDPA_prev=1): {already_protected:,}")
            print(f"    - Newly protected (WDPA_prev=0, WDPA_b1=1): {newly_protected:,}")
            print(f"    → Two-layer protection visualization will be used")
        
        if has_row_col:
            print(f"  Join method: row/col/year (with establishment flag)")
        elif has_xy:
            print(f"  Join method: x/y/year (with establishment flag)")
        
        return result
    
    except Exception as e:
        print(f"  WARNING: Failed to load WDPA data from test parquet: {e}")
        return None


def points_to_raster(x: np.ndarray, y: np.ndarray, values: np.ndarray, 
                     target_resolution: Optional[float] = None) -> tuple[np.ndarray, tuple]:
    """Convert point data to a raster grid for pixel-perfect visualization.
    
    Uses histogram-based binning for maximum precision and performance.
    Works with any coordinate system (degrees, meters, etc.).
    For 1 km resolution in degrees: ~0.009 degrees. For meters: 1000.0 meters.
    
    Args:
        x: X coordinates (longitude in degrees, or easting in meters, etc.)
        y: Y coordinates (latitude in degrees, or northing in meters, etc.)
        values: Values to rasterize
        target_resolution: Target resolution in same units as coordinates. If None, auto-detects from data.
    
    Returns:
        Tuple of (raster_array, extent) where extent is (xmin, xmax, ymin, ymax)
        Raster array has shape (nrows, ncols) and may contain NaN for empty cells
    """
    # Calculate bounds
    x_min, x_max = x.min(), x.max()
    y_min, y_max = y.min(), y.max()
    
    # Determine grid resolution
    if target_resolution is None:
        # For 1 km resolution, ~0.009 degrees
        # Estimate from data: use median of non-zero coordinate differences
        sample_size = min(50000, len(x))
        sample_idx = np.random.choice(len(x), sample_size, replace=False)
        x_sample = np.sort(x[sample_idx])
        y_sample = np.sort(y[sample_idx])
        
        # Find smallest non-zero differences (these represent grid resolution)
        x_diffs = np.diff(x_sample)
        x_diffs = x_diffs[x_diffs > 1e-10]
        y_diffs = np.diff(y_sample)
        y_diffs = y_diffs[y_diffs > 1e-10]
        
        if len(x_diffs) > 100 and len(y_diffs) > 100:
            # Use 10th percentile of differences as resolution estimate
            x_res = np.percentile(x_diffs[x_diffs < np.percentile(x_diffs, 25)], 10)
            y_res = np.percentile(y_diffs[y_diffs < np.percentile(y_diffs, 25)], 10)
        else:
            # Fallback: use 1 km equivalent (~0.009 degrees)
            x_res = 0.009
            y_res = 0.009
    else:
        x_res = target_resolution
        y_res = target_resolution
    
    # Ensure resolution is reasonable (not too fine, not too coarse)
    x_res = max(x_res, (x_max - x_min) / 10000)  # Minimum: 10000 cells
    x_res = min(x_res, (x_max - x_min) / 100)    # Maximum: 100 cells
    y_res = max(y_res, (y_max - y_min) / 10000)
    y_res = min(y_res, (y_max - y_min) / 100)
    
    # Create grid edges
    # Extend slightly beyond bounds to ensure all points are included
    padding = max(x_res, y_res) * 0.1
    x_edges = np.arange(x_min - padding, x_max + padding + x_res, x_res)
    y_edges = np.arange(y_min - padding, y_max + padding + y_res, y_res)
    
    # Calculate grid dimensions
    ncols = len(x_edges) - 1
    nrows = len(y_edges) - 1
    
    # Use histogram2d to bin points and get indices, then aggregate values
    # This is more efficient than griddata for large datasets
    x_idx = np.digitize(x, x_edges) - 1
    y_idx = np.digitize(y, y_edges) - 1
    
    # Clip indices to valid range
    x_idx = np.clip(x_idx, 0, ncols - 1)
    y_idx = np.clip(y_idx, 0, nrows - 1)
    
    # Create raster array
    raster = np.full((nrows, ncols), np.nan, dtype=np.float32)
    
    # For points that map to the same grid cell, use the mean value
    # Use pandas for efficient grouping
    df_grid = pd.DataFrame({
        'x_idx': x_idx,
        'y_idx': y_idx,
        'value': values
    })
    grid_agg = df_grid.groupby(['y_idx', 'x_idx'])['value'].mean().reset_index()
    
    # Fill raster array
    raster[grid_agg['y_idx'].values, grid_agg['x_idx'].values] = grid_agg['value'].values
    
    # Flip raster vertically because imshow with origin='upper' expects row 0 at top (highest y)
    # Currently, y_idx=0 corresponds to y_min (lowest), but we want it at the bottom
    # So we need to flip the array so that row 0 corresponds to y_max (highest)
    raster = np.flipud(raster)
    
    # Define extent for imshow (left, right, bottom, top)
    # Use the actual edge coordinates
    extent = (x_edges[0], x_edges[-1], y_edges[0], y_edges[-1])
    
    return raster, extent


def create_risk_map(
    df: pd.DataFrame,
    region_boundary_path: Optional[Path],
    output_dir: Path,
    model_type: str,
    metrics_data: Optional[Dict[str, Any]] = None,
    test_parquet_path: Optional[Path] = None,
    test_years: Optional[Sequence[int]] = None,
) -> None:
    """Create risk map showing South America boundary, top-1% predicted pixels, and observed positives.
    
    Uses distinct colors for three categories:
    - Yellow: Predicted high-risk only (not observed)
    - Blue: Observed positives only (not predicted as high-risk)
    - Orange: Overlap (predicted high-risk AND observed)
    
    Observed positives are identified as pixels where WDPA_b1=1 (actually established in that year)
    OR y_true=1 (from 5-year lookahead target). This ensures pixels established in 2018 are
    correctly shown even though transition_01_win5 doesn't mark the actual year of establishment.
    
    Optionally shows existing protected areas (as of end of 2017) if wdpa_b1 column is present.

    Args:
        df: Scored prediction DataFrame.
        region_boundary_path: Optional path to South America boundary.
        output_dir: Directory where figures will be written.
        model_type: Model name (rf, lgbm, brf).
        metrics_data: Optional metrics/metadata dictionary.
        test_parquet_path: Path to original test parquet (e.g. *test_win5.parquet*).
        test_years: Explicit list of test years. If not provided, they will be
            derived from `test_parquet_path` (and, if needed, from metadata)
            using `derive_test_years`.
    """
    print("\n" + "=" * 70)
    print("CREATING RISK MAP")
    print("=" * 70)
    
    # Get South America boundary
    sa_gdf = get_south_america_boundary(region_boundary_path)
    
    # Ensure CRS is set (assume EPSG:4326 if not set)
    if sa_gdf.crs is None:
        sa_gdf.set_crs('EPSG:4326', inplace=True)
    
    print(f"  South America boundary CRS: {sa_gdf.crs}")
    print(f"  South America boundary bounds: {sa_gdf.total_bounds}")
    
    # Create GeoDataFrame from predictions
    geometry = [Point(xy) for xy in zip(df['x'], df['y'])]
    gdf = gpd.GeoDataFrame(df, geometry=geometry, crs='EPSG:4326')
    
    print(f"  Prediction points: {len(gdf):,}")
    print(f"  Prediction bounds: {gdf.total_bounds}")
    
    # Check if protected area data is available
    has_wdpa = 'wdpa_b1' in df.columns
    if has_wdpa:
        # Fill NaN with 0 (not protected) and convert to boolean
        wdpa_values = df['wdpa_b1'].fillna(0)
        # Handle both integer and float types
        wdpa_values = wdpa_values.astype(float)
        protected_count = (wdpa_values == 1).sum()
        print(f"  Protected area coverage (as of end 2017): {protected_count:,} pixels ({protected_count/len(df)*100:.2f}%)")
        print(f"  wdpa_b1 value range: [{wdpa_values.min()}, {wdpa_values.max()}], unique values: {sorted(wdpa_values.unique())[:10]}")
        gdf['is_protected'] = (wdpa_values == 1).values
    else:
        print("  Note: wdpa_b1 column not found - protected areas will not be shown")
        print(f"  Available columns: {list(df.columns)}")
        gdf['is_protected'] = False
    
    # Load WDPA data from original test parquet if available
    # This is needed to correctly identify pixels that were established in each year
    # (since transition_01_win5 is a 5-year lookahead target, it doesn't mark the actual year of establishment)
    # Prefer explicitly provided test years; otherwise derive them from the test parquet
    if test_years is None or len(test_years) == 0:
        test_years = derive_test_years(metrics_data, None, test_parquet_path)
    wdpa_test_df = load_wdpa_from_test_parquet(test_parquet_path, test_years)
    
    # Join WDPA data from test parquet if available
    # This includes:
    # 1. Establishment flag for correctly identifying pixels established in 2018-2019
    # 2. WDPA_prev for two-layer protection visualization (temporal dynamics)
    # 3. newly_protected_in_test_period for test-year-specific protection layer
    wdpa_join_method: Optional[str] = None
    wdpa_has_b1_actual: bool = False
    wdpa_has_established_flag: bool = False
    
    if wdpa_test_df is not None:
        print(f"\n  {'='*70}")
        print(f"  WDPA DATA LOADED SUCCESSFULLY FROM TEST PARQUET")
        print(f"  {'='*70}")
        
        # Determine which columns to join
        join_cols = ['row', 'col'] if 'row' in wdpa_test_df.columns else ['x', 'y']
        data_cols_to_join = []
        
        if 'established_2018_2019' in wdpa_test_df.columns:
            data_cols_to_join.append('established_2018_2019')
            print(f"  Will join: established_2018_2019 (for observed positives)")
        if 'established_in_test_period' in wdpa_test_df.columns:
            data_cols_to_join.append('established_in_test_period')
            print(f"  Will join: established_in_test_period (for observed positives aggregated over test years)")
        if 'newly_protected_in_test_period' in wdpa_test_df.columns:
            data_cols_to_join.append('newly_protected_in_test_period')
            print(f"  Will join: newly_protected_in_test_period (for test-year-specific protection layer)")
        if 'WDPA_prev' in wdpa_test_df.columns:
            data_cols_to_join.append('WDPA_prev')
            print(f"  Will join: WDPA_prev (for temporal protection visualization)")
        if 'WDPA_b1' in wdpa_test_df.columns and 'wdpa_b1' not in df.columns:
            data_cols_to_join.append('WDPA_b1')
            print(f"  Will join: WDPA_b1 (for current protection status)")
        
        if not data_cols_to_join:
            print(f"  WARNING: No relevant columns found to join")
            df['established_2018_2019'] = 0
            df['WDPA_b1_actual'] = 0
            join_method = None
        elif all(col in df.columns for col in ['row', 'col']) and all(col in wdpa_test_df.columns for col in ['row', 'col']):
            print(f"  Using row/col join method (pixel-level, not year-specific)...")
            select_cols = ['row', 'col'] + data_cols_to_join
            join_df = wdpa_test_df[select_cols].drop_duplicates(subset=['row', 'col'])
            df = df.merge(join_df, on=['row', 'col'], how='left', suffixes=('', '_test'))
            join_method = "row/col"
        elif all(col in df.columns for col in ['x', 'y']) and all(col in wdpa_test_df.columns for col in ['x', 'y']):
            print(f"  Using x/y join method (pixel-level, not year-specific)...")
            # Round coordinates to avoid floating point precision issues
            df_rounded = df.copy()
            df_rounded['x_rounded'] = df_rounded['x'].round(6)
            df_rounded['y_rounded'] = df_rounded['y'].round(6)
            
            select_cols = ['x', 'y'] + data_cols_to_join
            join_df = wdpa_test_df[select_cols].copy()
            join_df['x_rounded'] = join_df['x'].round(6)
            join_df['y_rounded'] = join_df['y'].round(6)
            join_df = join_df[['x_rounded', 'y_rounded'] + data_cols_to_join].drop_duplicates(subset=['x_rounded', 'y_rounded'])
            
            df_rounded = df_rounded.merge(join_df, on=['x_rounded', 'y_rounded'], how='left', suffixes=('', '_test'))
            df_rounded = df_rounded.drop(columns=['x_rounded', 'y_rounded'])
            df = df_rounded
            join_method = "x/y"
        else:
            missing_cols_df = [col for col in ['row', 'col', 'x', 'y'] if col not in df.columns]
            missing_cols_wdpa = [col for col in ['row', 'col', 'x', 'y'] if col not in wdpa_test_df.columns]
            print(f"  WARNING: Cannot join WDPA data - missing required columns")
            print(f"  Missing in scored data: {missing_cols_df}")
            print(f"  Missing in test data: {missing_cols_wdpa}")
            print(f"  Available columns in scored data: {list(df.columns)}")
            df['established_2018_2019'] = 0
            df['WDPA_b1_actual'] = 0
            join_method = None
        
        if join_method is not None:
            # Fill NaN and standardize dtypes for joined columns
            if 'established_2018_2019' in df.columns:
                df['established_2018_2019'] = df['established_2018_2019'].fillna(0).astype(int)
                df['WDPA_b1_actual'] = df['established_2018_2019']
                wdpa_has_b1_actual = True
                print(f"  Joined establishment flag using {join_method}: {(df['WDPA_b1_actual'] == 1).sum():,} pixels")
            else:
                df['established_2018_2019'] = 0
                df['WDPA_b1_actual'] = 0
            
            if 'WDPA_prev' in df.columns:
                df['WDPA_prev'] = df['WDPA_prev'].fillna(0).astype(int)
                print(f"  Joined WDPA_prev using {join_method}: {(df['WDPA_prev'] == 1).sum():,} pixels already protected")
            
            if 'newly_protected_in_test_period' in df.columns:
                df['newly_protected_in_test_period'] = df['newly_protected_in_test_period'].fillna(0).astype(int)
                print(f"  Joined newly_protected_in_test_period using {join_method}: {(df['newly_protected_in_test_period'] == 1).sum():,} pixels")
            
            if 'WDPA_b1_test' in df.columns:
                # Rename if we got it from test parquet with suffix
                df['wdpa_b1'] = df['WDPA_b1_test'].fillna(0).astype(int)
                df = df.drop(columns=['WDPA_b1_test'])
            
            if 'established_in_test_period' in df.columns:
                df['established_in_test_period'] = df['established_in_test_period'].fillna(0).astype(int)
                wdpa_has_established_flag = True
                print(f"  Joined established_in_test_period using {join_method}: {(df['established_in_test_period'] == 1).sum():,} pixels")
        else:
            df['established_2018_2019'] = 0
            df['WDPA_b1_actual'] = 0
        wdpa_join_method = join_method
    else:
        print(f"\n  {'!'*70}")
        print(f"  WARNING: WDPA ESTABLISHMENT DATA NOT LOADED")
        print(f"  {'!'*70}")
        if wdpa_test_df is None:
            print(f"  Reason: WDPA test data file not available or failed to load")
            print(f"  Impact: Using y_true only for observed positives (may undercount establishments)")
            print(f"  Expected file: test_win5.parquet in data/ml/ or outputs/Results/")
        else:
            print(f"  Reason: Establishment flag 'established_2018_2019' not found in WDPA test data")
            print(f"  Available columns in WDPA test data: {list(wdpa_test_df.columns)}")
        print(f"  Impact: Using y_true only for observed positives (may undercount establishments)")
        print(f"  {'!'*70}")
        df['WDPA_b1_actual'] = 0
    
    # Calculate top-1% threshold
    top1pct_threshold = np.percentile(df['y_pred_proba'], 99)
    print(f"  Top-1% threshold: {top1pct_threshold:.6f}")
    
    # Identify categories
    # Use WDPA_b1_actual = 1 OR y_true = 1 as indicator of observed positives when
    # WDPA_b1-based establishment data was successfully joined. Otherwise, fall back
    # to the aggregated establishment flag (established_in_test_period) if available,
    # and finally to y_true only.
    gdf['is_top1pct'] = df['y_pred_proba'] >= top1pct_threshold
    
    if wdpa_has_b1_actual and 'WDPA_b1_actual' in df.columns:
        observed_flag = (df['WDPA_b1_actual'] == 1)
    elif wdpa_has_established_flag and 'established_in_test_period' in df.columns:
        observed_flag = (df['established_in_test_period'] == 1)
    else:
        observed_flag = (df['y_true'] == 1)
    
    gdf['is_positive'] = (df['y_true'] == 1) | observed_flag
    
    # Log statistics
    y_true_positives = (df['y_true'] == 1).sum()
    combined_positives = gdf['is_positive'].sum()
    
    if wdpa_has_b1_actual and 'WDPA_b1_actual' in df.columns:
        wdpa_positives = (df['WDPA_b1_actual'] == 1).sum()
        print(f"  Observed PA establishments: y_true={y_true_positives:,}, WDPA_b1_actual={wdpa_positives:,}, combined={combined_positives:,}")
        print(f"  Note: Combined uses WDPA_b1_actual=1 OR y_true=1 to correctly identify pixels established in each year")
    elif wdpa_has_established_flag and 'established_in_test_period' in df.columns:
        estab_positives = (df['established_in_test_period'] == 1).sum()
        print(f"  Observed PA establishments: y_true={y_true_positives:,}, established_in_test_period={estab_positives:,}, combined={combined_positives:,}")
        print(f"  Note: Combined uses established_in_test_period=1 OR y_true=1 to identify pixels established in the test period")
    else:
        print(f"  Observed PA establishments (y_true only): y_true={y_true_positives:,}, combined={combined_positives:,}")
    
    # Create three distinct categories
    gdf['category'] = 'none'
    gdf.loc[gdf['is_top1pct'] & ~gdf['is_positive'], 'category'] = 'predicted_only'
    gdf.loc[~gdf['is_top1pct'] & gdf['is_positive'], 'category'] = 'observed_only'
    gdf.loc[gdf['is_top1pct'] & gdf['is_positive'], 'category'] = 'overlap'
    
    # Count pixels in each category
    predicted_only_count = (gdf['category'] == 'predicted_only').sum()
    observed_only_count = (gdf['category'] == 'observed_only').sum()
    overlap_count = (gdf['category'] == 'overlap').sum()
    
    print(f"  Predicted high-risk only: {predicted_only_count:,}")
    print(f"  Observed PA establishments only: {observed_only_count:,}")
    print(f"  Overlap (predicted + observed PA): {overlap_count:,}")
    
    # Create categorical raster: convert category names to numeric codes
    # 0 = none, 1 = predicted_only, 2 = observed_only, 3 = overlap, 4 = protected
    category_codes = {
        'none': 0,
        'predicted_only': 1,
        'observed_only': 2,
        'overlap': 3
    }
    gdf['category_code'] = gdf['category'].map(category_codes)
    
    # Handle protected areas separately - they overlay on top
    if has_wdpa:
        # Protected areas get code 4, but we'll handle them as a separate overlay
        pass
    
    # Extract time period information from metrics or use defaults
    # Based on model1_LGBM: test period is 2018-2019, predictions are for 5-year lookahead (2018-2024)
    time_period = "2018-2019"
    prediction_horizon = "5-year lookahead (2018-2024)"
    
    if metrics_data:
        # Try to extract time period from metadata
        metadata = metrics_data.get("metadata", {})
        test_year_range = metadata.get("test_year_range")
        if test_year_range and isinstance(test_year_range, list) and len(test_year_range) == 2:
            time_period = f"{test_year_range[0]}-{test_year_range[1]}"
        elif "test_years" in metadata:
            test_years = metadata["test_years"]
            if isinstance(test_years, (list, tuple)) and len(test_years) == 2:
                time_period = f"{test_years[0]}-{test_years[1]}"
        
        # Get lookahead years if available
        lookahead = metadata.get("lookahead_years", 5)
        if isinstance(lookahead, int) and test_year_range:
            pred_end = test_year_range[1] + lookahead
            prediction_horizon = f"{lookahead}-year lookahead ({test_year_range[0]}-{pred_end})"
    
    # Filter coordinate outliers before rasterization
    print(f"  Filtering coordinate outliers...")
    initial_count = len(df)
    df = df[(df['x'] >= -85) & (df['x'] <= -30) & (df['y'] >= -60) & (df['y'] <= 15)]
    filtered_count = len(df)
    if initial_count != filtered_count:
        print(f"  Filtered out {initial_count - filtered_count:,} coordinate outliers ({initial_count:,} -> {filtered_count:,})")
    
    # Update gdf to match filtered df (keep geometry and derived columns in sync)
    gdf = gdf[gdf.index.isin(df.index)].copy()
    
    # Reproject to EPSG:3857 (Web Mercator) for proper aspect ratio
    # This ensures 1 meter is drawn the same length in both directions
    print(f"  Reprojecting to EPSG:3857 (Web Mercator) for proper aspect ratio...")
    sa_gdf_proj = sa_gdf.to_crs('EPSG:3857')
    gdf_proj = gdf.to_crs('EPSG:3857')
    print(f"  Reprojected bounds: {gdf_proj.total_bounds}")
    
    # Convert to raster for pixel-perfect visualization
    # Use ~1 km resolution in meters (1000 m)
    print(f"  Converting {len(gdf_proj):,} points to raster grid...")
    
    # Create main category raster
    category_raster, extent = points_to_raster(
        gdf_proj.geometry.x.values,
        gdf_proj.geometry.y.values,
        gdf['category_code'].values,  # Use original gdf for category codes (index-aligned)
        target_resolution=1000.0  # ~1 km resolution in meters
    )
    print(f"  Category raster shape: {category_raster.shape}, extent: {extent}")
    print(f"  Valid (non-NaN) pixels: {np.sum(~np.isnan(category_raster)):,}")
    
    # Create protection rasters if available (using same grid structure)
    # Two-layer approach: already protected (WDPA_prev=1) vs. newly protected (WDPA_prev=0, WDPA_b1=1)
    protected_prev_raster = None
    newly_protected_raster = None
    has_wdpa_prev = 'WDPA_prev' in df.columns
    
    if has_wdpa_prev:
        # TWO-LAYER PROTECTION VISUALIZATION
        print(f"  Creating two-layer protection visualization...")
        
        # Layer 1: Already protected areas (WDPA_prev=1) - darker green
        protected_prev_mask = (df['WDPA_prev'] == 1).values
        if protected_prev_mask.sum() > 0:
            protected_prev_raster, _ = points_to_raster(
                gdf_proj.geometry.x.values,
                gdf_proj.geometry.y.values,
                protected_prev_mask.astype(float),
                target_resolution=1000.0
            )
            protected_prev_raster = (protected_prev_raster > 0.5).astype(float)
            protected_prev_raster[protected_prev_raster == 0] = np.nan
            print(f"    - Already protected (WDPA_prev=1): {np.sum(~np.isnan(protected_prev_raster)):,} pixels")
        
        # Layer 2: Newly protected areas in TEST YEARS ONLY (WDPA_prev=0 AND WDPA_b1=1 in 2018-2019) - lighter green
        # Use the flag created during WDPA loading to ensure robustness (only test years)
        if 'newly_protected_in_test_period' in df.columns:
            newly_protected_mask = (df['newly_protected_in_test_period'] == 1).values
            if newly_protected_mask.sum() > 0:
                newly_protected_raster, _ = points_to_raster(
                    gdf_proj.geometry.x.values,
                    gdf_proj.geometry.y.values,
                    newly_protected_mask.astype(float),
                    target_resolution=1000.0
                )
                newly_protected_raster = (newly_protected_raster > 0.5).astype(float)
                newly_protected_raster[newly_protected_raster == 0] = np.nan
                print(f"    - Newly protected in test period (2018-2019): {np.sum(~np.isnan(newly_protected_raster)):,} pixels")
        else:
            # Fallback: check WDPA_prev=0 AND WDPA_b1=1 (but warn it's not filtered to test years)
            has_b1 = 'wdpa_b1' in df.columns or 'WDPA_b1' in df.columns
            if has_b1:
                b1_col = 'wdpa_b1' if 'wdpa_b1' in df.columns else 'WDPA_b1'
                newly_protected_mask = ((df['WDPA_prev'] == 0) & (df[b1_col] == 1)).values
                if newly_protected_mask.sum() > 0:
                    print(f"    WARNING: Using fallback newly protected detection (not filtered to test years)")
                    newly_protected_raster, _ = points_to_raster(
                        gdf_proj.geometry.x.values,
                        gdf_proj.geometry.y.values,
                        newly_protected_mask.astype(float),
                        target_resolution=1000.0
                    )
                    newly_protected_raster = (newly_protected_raster > 0.5).astype(float)
                    newly_protected_raster[newly_protected_raster == 0] = np.nan
                    print(f"    - Newly protected (fallback): {np.sum(~np.isnan(newly_protected_raster)):,} pixels")
        
    elif has_wdpa:
        # FALLBACK: Single-layer protection visualization (original behavior)
        print(f"  Creating single-layer protection visualization (WDPA_prev not available)...")
        protected_mask = gdf['is_protected'].values
        if protected_mask.sum() > 0:
            protected_prev_raster, protected_extent = points_to_raster(
                gdf_proj.geometry.x.values,
                gdf_proj.geometry.y.values,
                protected_mask.astype(float),
                target_resolution=1000.0
            )
            if protected_extent != extent:
                print(f"  WARNING: Protected areas extent differs from category extent")
            protected_prev_raster = (protected_prev_raster > 0.5).astype(float)
            protected_prev_raster[protected_prev_raster == 0] = np.nan
            print(f"  Protected areas raster created with {np.sum(~np.isnan(protected_prev_raster)):,} pixels")
    
    # Create figure with aspect ratio matching geographic bounds (projected) to avoid squishing
    sa_bounds_proj = sa_gdf_proj.total_bounds  # (minx, miny, maxx, maxy) in meters
    sa_width = sa_bounds_proj[2] - sa_bounds_proj[0]
    sa_height = sa_bounds_proj[3] - sa_bounds_proj[1]
    # Guard against degenerate bounds
    if sa_width <= 0 or sa_height <= 0:
        fig, ax = plt.subplots(figsize=(14, 11))
    else:
        geo_aspect = sa_height / sa_width
        base_width = 10
        fig_height = base_width * geo_aspect
        fig, ax = plt.subplots(figsize=(base_width, fig_height))
    
    # Plot South America boundary (reprojected)
    sa_gdf_proj.plot(ax=ax, color='white', edgecolor='none', linewidth=1.5, zorder=1)
    
    # Define colors for each category using constants
    from matplotlib.colors import ListedColormap, BoundaryNorm
    
    category_colors_rgba = {
        0: RISK_MAP_COLORS['none'],
        1: RISK_MAP_COLORS['predicted_only'],
        2: RISK_MAP_COLORS['observed_only'],
