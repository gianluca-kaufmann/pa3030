    fig, ax = plt.subplots(figsize=(fig_width, fig_height))
    
    # Plot South America boundary (reprojected)
    sa_gdf_proj.plot(ax=ax, color='white', edgecolor='none', linewidth=1.5, zorder=1)
    
    # Plot probability raster with pixel-perfect rendering
    # Use 'plasma' colormap for a visually pleasing gradient (dark purple -> yellow)
    # interpolation='nearest' ensures no smoothing - pixel-perfect rendering
    # Values are normalized to [0, 1] so full colormap is used
    im = ax.imshow(raster, 
                   extent=extent, 
                   cmap='plasma', 
                   vmin=0, vmax=1,  # Normalized values, so use [0, 1] range
                   origin='upper',  # Match geographic convention (north at top)
                   interpolation='nearest',  # No smoothing - pixel perfect
                   aspect='equal',
                   zorder=2)
    
    # Add colorbar with custom formatter to show actual probability values
    cbar = plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    cbar.set_label('Predicted Probability', 
                   fontsize=12, rotation=270, labelpad=20)
    
    # Set colorbar ticks with text labels instead of numeric values
    tick_positions = [0.0, 1.0]
    tick_labels = ['Low probability', 'High probability']
    cbar.set_ticks(tick_positions)
    cbar.set_ticklabels(tick_labels)
    cbar.ax.tick_params(labelsize=10)
    
    # Styling
    ax.set_xlabel('Easting (m, EPSG:3857)', fontsize=12)
    ax.set_ylabel('Northing (m, EPSG:3857)', fontsize=12)
    
    # Check if calibrated probabilities were used
    calibration_note = ""
    if 'y_pred_proba_calibrated' in df.columns or 'calibrated' in str(output_dir).lower():
        calibration_note = " (Calibrated Probabilities)"
    
    ax.set_title(f'Model 1 Probability Map{calibration_note}', 
                 fontsize=15, fontweight='bold', pad=15)
    
    # Add description text box explaining what the map shows
    description_text = (f"Continuous predicted probability\n"
                       f"of PA establishment.\n"
                       f"Warmer colors (yellow) = higher.\n"
                       f"Based on {time_period} observations,\n"
                       f"predicting {prediction_horizon}.")
    ax.text(0.98, 0.98, description_text, transform=ax.transAxes, fontsize=8,
           verticalalignment='top', horizontalalignment='right',
           bbox=dict(boxstyle='round', facecolor='lightblue', 
