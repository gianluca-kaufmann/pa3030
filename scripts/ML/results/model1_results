def get_repo_root() -> Path:
    """Get repository root directory.
    
    Checks environment variables first, then searches upward for README.md.
    """
    # Check environment variable first
    env_root = os.environ.get("PROJECT_ROOT") or os.environ.get("REPO_ROOT")
    if env_root:
        return Path(env_root).resolve()
    
    # Search upward from script location for README.md
    script_dir = Path(__file__).resolve().parent
    current = script_dir
    for _ in range(10):  # Limit search depth
        if (current / "README.md").exists():
            return current
        parent = current.parent
        if parent == current:  # Reached filesystem root
            break
        current = parent
    
    # If not found, raise an error
    raise RuntimeError(
        f"Repository root not found. Searched upward from {script_dir} for README.md.\n"
        "Set PROJECT_ROOT or REPO_ROOT environment variable, or ensure README.md exists in repo root."
    )


def resolve_parquet_file(filename: str, split_version: str = 'main') -> Path:
    """Locate parquet file using $SCRATCH-first path resolution (same as training scripts).
    
    Checks locations in order:
    1. $SCRATCH/data/ml/{split}/
    2. $SCRATCH/data/ml/
    3. $SCRATCH/outputs/Results/{split}/
    4. repo/data/ml/{split}/
    5. repo/data/ml/
    6. repo/outputs/Results/{split}/
    7. repo/outputs/Results/
    
    Args:
        filename: Name of the parquet file (e.g., 'test_win5.parquet')
        split_version: Split version ('main' or 'robustness')
    
    Returns:
        Path to the found parquet file
    
    Raises:
        FileNotFoundError: If file not found in any expected location
    """
    repo_root = get_repo_root()
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None
    
    candidates = []
    if scratch_root is not None:
        # Check $SCRATCH locations first (same order as training scripts)
        # Order: $SCRATCH/data/ml/{split}/, then $SCRATCH/data/ml/, then $SCRATCH/outputs/Results/{split}/
        candidates.append(scratch_root / f"data/ml/{split_version}/{filename}")
        candidates.append(scratch_root / f"data/ml/{filename}")
        candidates.append(scratch_root / f"outputs/Results/{split_version}/{filename}")
    # Check repo locations (fallback)
    candidates.append(repo_root / f"data/ml/{split_version}/{filename}")
    candidates.append(repo_root / f"data/ml/{filename}")
    candidates.append(repo_root / f"outputs/Results/{split_version}/{filename}")
    candidates.append(repo_root / f"outputs/Results/{filename}")
    
    for cand in candidates:
        if cand.exists():
            return cand
    
    # Provide detailed error message with all checked paths
    error_msg = f"{filename} not found in expected locations.\n"
    error_msg += "\nChecked locations (in order):\n"
    for i, cand in enumerate(candidates, 1):
        exists = "✓" if cand.exists() else "✗"
        error_msg += f"  {i}. {exists} {cand}\n"
    if scratch_root:
        error_msg += f"\nSCRATCH root: {scratch_root}\n"
    error_msg += f"Repository root: {repo_root}\n"
    error_msg += f"Split version: {split_version}\n"
    raise FileNotFoundError(error_msg)


