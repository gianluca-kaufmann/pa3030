#!/usr/bin/env python3

"""
Sampling script for model1 training/earlystop/test splits with 5-year lookahead target.

Rules
-----
TRAIN_EARLY (2001–2014):
  - Keep all positives (transition_01 = 1)
  - Sample negatives per year at TARGET_NEG_POS_RATIO (e.g., 400:1)
  - Negatives split 50/50: hard negatives (closest to WDPA) + random negatives
  - Year 2000 excluded to avoid treating existing PAs as transitions
  - Result: positive rate ~0.25% (realistic for conservation risk modeling)

EARLYSTOP (2015–2017):
  - Full risk set (no sampling)
  - Used only for early stopping during CV, not for evaluation

TEST (2018–2019):
  - Full risk set (no sampling)
  - Right-censored at max_year - 5 to ensure 5-year lookahead window

5-Year Lookahead Target:
  - Compute first_transition_year per (row, col) as min(year) where transition_01==1
  - Add transition_01_win5: for each row at year t, set to 1 if first_transition_year exists 
    AND t < first_transition_year <= t+5, else 0
  - Filter to year <= max_year-5 to handle right-censoring

Notes
-----
- No MAX_TRAIN_ROWS cap to avoid artificially inflating positive rate
- Target neg/pos ratio maintains realistic class balance similar to earlystop/test
- Hard negative sampling focuses on areas near protected areas (most informative)
- Right-censoring: max_year is computed from data and rows with year > max_year-5 are excluded
"""

from __future__ import annotations

import json
import math
import os
import sys
import time
from pathlib import Path

import duckdb
import wandb

# Configuration
RANDOM_STATE = 42
# Split configuration
TRAIN_EARLY_YEARS = (2001, 2014)   # Sampled train with hard negatives (2000 excluded)
EARLYSTOP_YEARS = (2015, 2017)     # Full earlystop (for CV early stopping only)
TEST_YEARS = (2018, 2019)          # Full test (right-censored for 5-year lookahead)
LOOKAHEAD_YEARS = 5                # Number of years to look ahead for target
WANDB_PROJECT = "ml-training-preprocessing"

# Hard negative sampling configuration
TARGET_NEG_POS_RATIO = 400  # Target ratio of negatives to positives per year (keeps pos rate ~0.25%)
DIST_WDPA_DECAY = 5.0  # Decay constant (km) for exponential weighting: exp(-dist_wdpa / k)
# Note: No MAX_TRAIN_ROWS cap - we control size via TARGET_NEG_POS_RATIO to avoid inflating positive rate


def resolve_input() -> Path:
    """Locate merged_panel_final.parquet (prefer $SCRATCH if present)."""
    repo_root = Path(__file__).resolve().parents[3]
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        candidates.append(scratch_root / "data/ml/merged_panel_final.parquet")
    candidates.append(repo_root / "data/ml/merged_panel_final.parquet")

    for cand in candidates:
        if cand.exists():
            return cand

    raise FileNotFoundError("merged_panel_final.parquet not found in expected locations")


def configure_duckdb(con: duckdb.DuckDBPyConnection) -> None:
    """Apply sensible local/Euler defaults."""
    is_euler = bool(os.environ.get("SCRATCH"))
    slurm_cpus = int(os.environ.get("SLURM_CPUS_PER_TASK", "0"))
    num_threads = slurm_cpus if slurm_cpus > 0 else (48 if is_euler else 4)

    # Match DuckDB memory to Slurm allocation when present
    slurm_mem_per_cpu_mb = os.environ.get("SLURM_MEM_PER_CPU")
    if slurm_mem_per_cpu_mb and slurm_cpus:
        total_mem_mb = int(slurm_mem_per_cpu_mb) * slurm_cpus
        memory_limit_gb = max(1, total_mem_mb // 1024)
    else:
        memory_limit_gb = 128 if is_euler else 16

    con.execute(f"SET threads={num_threads}")
    con.execute("SET preserve_insertion_order=false")
    con.execute(f"SET memory_limit='{memory_limit_gb}GB'")

    temp_dir = os.environ.get("SCRATCH") or (Path(__file__).parent / "temp")
    # Ensure temp directory exists (DuckDB won't create parent directories)
    if isinstance(temp_dir, str):
        temp_dir = Path(temp_dir)
    temp_dir.mkdir(parents=True, exist_ok=True)
    # Create duckdb_temp subdirectory
    duckdb_temp_dir = temp_dir / "duckdb_temp"
    duckdb_temp_dir.mkdir(parents=True, exist_ok=True)
    temp_dir_sql = str(temp_dir).replace("'", "''")
    con.execute(f"SET temp_directory='{temp_dir_sql}/duckdb_temp'")

    if is_euler:
        con.execute("PRAGMA max_temp_directory_size='200GB'")

    print(f"DuckDB configured: {num_threads} threads, {memory_limit_gb}GB memory")
    print(f"Running on: {'Euler cluster' if is_euler else 'local machine'}")


def log_year_counts(con: duckdb.DuckDBPyConnection, parquet_path: Path, label: str, target_col: str = "transition_01", use_wandb: bool = False) -> None:
    escaped = str(parquet_path).replace("'", "''")
    rows = con.execute(
        f"""
        SELECT
            year,
            SUM({target_col}) AS positives,
            SUM(CASE WHEN {target_col} = 0 THEN 1 ELSE 0 END) AS negatives,
            COUNT(*) AS total,
            CASE WHEN COUNT(*) > 0 THEN SUM({target_col})::DOUBLE / COUNT(*) ELSE 0 END AS pos_ratio,
            CASE WHEN SUM({target_col}) > 0 
                 THEN SUM(CASE WHEN {target_col} = 0 THEN 1 ELSE 0 END)::DOUBLE / SUM({target_col})
                 ELSE 0 END AS neg_pos_ratio
        FROM read_parquet('{escaped}')
        GROUP BY year
        ORDER BY year
        """
    ).fetchall()

    print(f"\n{label} per-year counts (target: {target_col}):")
    for year, pos, neg, total, pos_ratio, neg_pos_ratio in rows:
        print(f"  {year}: total={total:,} pos={pos:,} neg={neg:,} | pos_ratio={pos_ratio:.5f} neg/pos={neg_pos_ratio:.1f}")

    if use_wandb:
        wandb.log({f"{label.lower().replace(' ', '_')}/per_year_{target_col}": [
            dict(year=y, positives=p, negatives=n, total=t, pos_ratio=r, neg_pos_ratio=npr) 
            for y, p, n, t, r, npr in rows
        ]})


def main() -> None:
    start_time = time.time()

    wandb_api_key = os.environ.get("WANDB_API_KEY")
    wandb_entity = os.environ.get("WANDB_ENTITY")
    if not wandb_api_key:
        print("Warning: WANDB_API_KEY not found in environment")
    if not wandb_entity:
        print("Warning: WANDB_ENTITY not found in environment (will use default)")
    
    use_wandb = False
    try:
        print("Initializing Weights & Biases...")
        wandb.init(
            project=WANDB_PROJECT,
            entity=wandb_entity,
            name=f"model1_preprocessing_win5_{time.strftime('%Y%m%d_%H%M%S')}",
            config={
                "random_state": RANDOM_STATE,
                "train_early_years": TRAIN_EARLY_YEARS,
                "earlystop_years": EARLYSTOP_YEARS,
                "test_years": TEST_YEARS,
                "lookahead_years": LOOKAHEAD_YEARS,
                "target_neg_pos_ratio": TARGET_NEG_POS_RATIO,
                "dist_wdpa_decay": DIST_WDPA_DECAY,
                "sampling_method": "per_year_hard_negatives_fixed_ratio_win5",
            },
        )
        use_wandb = True
        print("W&B connected\n")
    except Exception as err:
        print(f"W&B initialization failed: {err}\n")

    input_path = resolve_input()
    base_dir = input_path.parent
    
    # Output paths for win5 files
    merged_win5_out = base_dir / "merged_panel_final_win5.parquet"
    train_early_out = base_dir / "train_early_sampled.parquet"
    earlystop_out = base_dir / "earlystop_full.parquet"
    test_out = base_dir / "test_full.parquet"

    print(f"\nInput: {input_path}")
    print(f"Merged WIN5 output: {merged_win5_out}")
    print(f"TRAIN_EARLY (sampled) output: {train_early_out}")
    print(f"EARLYSTOP output: {earlystop_out}")
    print(f"TEST_FULL output: {test_out}")

    con = duckdb.connect()
    configure_duckdb(con)

    escaped_in = str(input_path).replace("'", "''")
    escaped_merged_win5 = str(merged_win5_out).replace("'", "''")
    escaped_train_early = str(train_early_out).replace("'", "''")
    escaped_test = str(test_out).replace("'", "''")
    escaped_earlystop = str(earlystop_out).replace("'", "''")

    try:
        print("\n" + "="*70)
        print("STEP 1: Computing first_transition_year per (row, col)")
        print("="*70)
        
        # Step 1: Compute first_transition_year per (row, col)
        first_transition_sql = f"""
        CREATE OR REPLACE TEMP TABLE first_transitions AS
        SELECT
            row,
            col,
            MIN(year) AS first_transition_year
        FROM read_parquet('{escaped_in}')
        WHERE transition_01 = 1
        GROUP BY row, col
        """
        
        step1_start = time.time()
        con.execute(first_transition_sql)
        n_transitions = con.execute("SELECT COUNT(*) FROM first_transitions").fetchone()[0]
        print(f"  Found {n_transitions:,} (row, col) pairs with transitions")
        print(f"  Completed in {time.time() - step1_start:.1f}s")
        
        print("\n" + "="*70)
        print("STEP 2: Computing max_year and applying right-censoring")
        print("="*70)
        
        # Step 2: Get max_year from data
        max_year_result = con.execute(f"SELECT MAX(year) FROM read_parquet('{escaped_in}')").fetchone()
        max_year = max_year_result[0] if max_year_result else 2024
        cutoff_year = max_year - LOOKAHEAD_YEARS
        
        print(f"  Max year in data: {max_year}")
        print(f"  Cutoff year (max_year - {LOOKAHEAD_YEARS}): {cutoff_year}")
        print(f"  Filtering to year <= {cutoff_year}")
        
        print("\n" + "="*70)
        print("STEP 3: Creating merged panel with transition_01_win5")
        print("="*70)
        
        # Step 3: Create merged panel with transition_01_win5
        # For each row at year t, set transition_01_win5 = 1 if first_transition_year exists 
        # AND t < first_transition_year <= t+5, else 0
        merged_win5_sql = f"""
        COPY (
            SELECT
                d.*,
                CASE 
                    WHEN ft.first_transition_year IS NOT NULL 
                         AND d.year < ft.first_transition_year 
                         AND ft.first_transition_year <= d.year + {LOOKAHEAD_YEARS}
                    THEN 1
                    ELSE 0
                END AS transition_01_win5
            FROM read_parquet('{escaped_in}') d
            LEFT JOIN first_transitions ft
                ON d.row = ft.row AND d.col = ft.col
            WHERE d.year <= {cutoff_year}
        )
        TO '{escaped_merged_win5}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """
        
        step3_start = time.time()
        con.execute(merged_win5_sql)
        print(f"  Merged panel with win5 target written in {time.time() - step3_start:.1f}s")
        
        # Log counts for merged win5
        log_year_counts(con, merged_win5_out, "MERGED_WIN5", "transition_01_win5", use_wandb)
        
        print("\n" + "="*70)
        print("COMPARISON: transition_01 vs transition_01_win5")
        print("="*70)
        
        # Compare total positives
        comparison_stats = con.execute(
            f"""
            SELECT
                SUM(transition_01) AS total_pos_original,
                SUM(transition_01_win5) AS total_pos_win5,
                COUNT(DISTINCT CASE WHEN transition_01 = 1 THEN (row::BIGINT<<32) + col END) AS distinct_rc_original,
                COUNT(DISTINCT CASE WHEN transition_01_win5 = 1 THEN (row::BIGINT<<32) + col END) AS distinct_rc_win5
            FROM read_parquet('{escaped_merged_win5}')
            """
        ).fetchone()
        
        total_pos_original, total_pos_win5, distinct_rc_original, distinct_rc_win5 = comparison_stats
        
        print(f"\nTotal positives:")
        print(f"  transition_01:        {total_pos_original:,}")
        print(f"  transition_01_win5:   {total_pos_win5:,}")
        if total_pos_original > 0:
            ratio = total_pos_win5 / total_pos_original
            print(f"  Ratio (win5/original): {ratio:.3f}x")
            if total_pos_win5 <= total_pos_original:
                print(f"  WARNING: win5 positives ({total_pos_win5:,}) <= original ({total_pos_original:,})")
            else:
                print(f"  win5 has more positives (expected)")
        
        print(f"\nDistinct (row,col) with positives:")
        print(f"  transition_01:        {distinct_rc_original:,}")
        print(f"  transition_01_win5:   {distinct_rc_win5:,}")
        if distinct_rc_original > 0:
            ratio_rc = distinct_rc_win5 / distinct_rc_original
            print(f"  Ratio (win5/original): {ratio_rc:.3f}x")
            if distinct_rc_win5 <= distinct_rc_original:
                print(f"  WARNING: win5 distinct (row,col) ({distinct_rc_win5:,}) <= original ({distinct_rc_original:,})")
            else:
                print(f"  win5 has more distinct (row,col) with positives (expected)")
        
        if use_wandb:
            wandb.log({
                "comparison/total_pos_original": int(total_pos_original),
                "comparison/total_pos_win5": int(total_pos_win5),
                "comparison/total_pos_ratio": float(total_pos_win5 / total_pos_original) if total_pos_original > 0 else 0.0,
                "comparison/distinct_rc_original": int(distinct_rc_original),
                "comparison/distinct_rc_win5": int(distinct_rc_win5),
                "comparison/distinct_rc_ratio": float(distinct_rc_win5 / distinct_rc_original) if distinct_rc_original > 0 else 0.0,
            })
        
        print("\n" + "="*70)
        print("STEP 4: Creating temporal splits")
        print("="*70)
        
        # TRAIN_EARLY: positives + hard negatives per year (2001–2014)
        # Keep all positives, sample negatives per year at TARGET_NEG_POS_RATIO
        # 50% hard negatives (close to WDPA), 50% random from remainder
        train_early_sql = f"""
        COPY (
            WITH base AS (
                SELECT
                    *
                FROM read_parquet('{escaped_merged_win5}')
                WHERE year BETWEEN {TRAIN_EARLY_YEARS[0]} AND {TRAIN_EARLY_YEARS[1]}
            ),
            year_counts AS (
                SELECT
                    year,
                    SUM(transition_01) AS pos_count,
                    SUM(CASE WHEN transition_01 = 0 THEN 1 ELSE 0 END) AS neg_count
                FROM base
                GROUP BY year
            ),
            -- Per-year negative budgets: pos_count * TARGET_NEG_POS_RATIO
            -- Include ALL years, even if pos_count = 0 or neg_count = 0 (budget will be 0)
            neg_budget AS (
                SELECT
                    yc.year,
                    yc.pos_count,
                    yc.neg_count,
                    CASE 
                        WHEN yc.pos_count > 0 AND yc.neg_count > 0 THEN
                            LEAST(
                                CAST(ROUND(yc.pos_count * {TARGET_NEG_POS_RATIO}) AS BIGINT),
                                yc.neg_count
                            )
                        ELSE 0
                    END AS year_neg_budget
                FROM year_counts yc
            ),
            positives AS (
                -- Keep all positives (no sampling)
                SELECT * FROM base WHERE transition_01 = 1
            ),
            -- Prepare negative pool with per-year budgets
            -- Use INNER JOIN - all years are now in neg_budget (even if budget is 0)
            neg_candidates AS (
                SELECT
                    b.*,
                    nb.year_neg_budget,
                    -- Split the yearly negative budget into 50% hard and 50% random
                    CAST(FLOOR(nb.year_neg_budget / 2.0) AS BIGINT) AS hard_budget,
                    nb.year_neg_budget - CAST(FLOOR(nb.year_neg_budget / 2.0) AS BIGINT) AS rand_budget,
                    COALESCE(b.dist_wdpa, 100.0) AS dist_for_rank,
                    random() AS u
                FROM base b
                INNER JOIN neg_budget nb ON b.year = nb.year
                WHERE b.transition_01 = 0 AND nb.year_neg_budget > 0
            ),
            -- Rank for hard negatives: by distance to WDPA (closest first), tie-broken by u
            ranked_for_hard AS (
                SELECT
                    *,
                    ROW_NUMBER() OVER (
                        PARTITION BY year
                        ORDER BY dist_for_rank ASC, u
                    ) AS dist_rank
                FROM neg_candidates
            ),
            -- First half of the budget: hard negatives close to WDPA
            hard_negs AS (
                SELECT * EXCLUDE (
                    year_neg_budget,
                    hard_budget,
                    rand_budget,
                    dist_for_rank,
                    u,
                    dist_rank
                )
                FROM ranked_for_hard
                WHERE dist_rank <= hard_budget
            ),
            -- Leftover pool for random selection (excludes hard negatives)
            leftover_pool AS (
                SELECT *
                FROM ranked_for_hard
                WHERE dist_rank > hard_budget
            ),
            ranked_leftover AS (
                SELECT
                    *,
                    ROW_NUMBER() OVER (
                        PARTITION BY year
                        ORDER BY u
                    ) AS leftover_rand_rank
                FROM leftover_pool
            ),
            -- Second half of the budget: random negatives from leftover pool
            random_negs AS (
                SELECT * EXCLUDE (
                    year_neg_budget,
                    hard_budget,
                    rand_budget,
                    dist_for_rank,
                    u,
                    dist_rank,
                    leftover_rand_rank
                )
                FROM ranked_leftover
                WHERE leftover_rand_rank <= rand_budget
            )
            SELECT * FROM positives
            UNION ALL
            SELECT * FROM hard_negs
            UNION ALL
            SELECT * FROM random_negs
        )
        TO '{escaped_train_early}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating TRAIN_EARLY split ({TRAIN_EARLY_YEARS[0]}–{TRAIN_EARLY_YEARS[1]}) with per-year negative sampling...")
        print(f"  All positives are kept; negatives sampled at {TARGET_NEG_POS_RATIO}:1 ratio per year")
        print(f"  Negatives: 50% closest to WDPA (hard), 50% random from remainder")
        print(f"  Year 2000 excluded to avoid treating existing PAs as transitions")
        # Set random seed for reproducible sampling
        seed_value = RANDOM_STATE / 100.0
        con.execute(f"SELECT setseed({seed_value})")
        train_early_start = time.time()
        con.execute(train_early_sql)
        print(f"TRAIN_EARLY written in {time.time() - train_early_start:.1f}s")

        # EARLYSTOP: full risk set 2015–2017 (for early stopping during CV only, not evaluation)
        earlystop_sql = f"""
        COPY (
            SELECT
                *
            FROM read_parquet('{escaped_merged_win5}')
            WHERE year BETWEEN {EARLYSTOP_YEARS[0]} AND {EARLYSTOP_YEARS[1]}
        )
        TO '{escaped_earlystop}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating EARLYSTOP split ({EARLYSTOP_YEARS[0]}–{EARLYSTOP_YEARS[1]}, for early stopping during CV only)...")
        earlystop_start = time.time()
        con.execute(earlystop_sql)
        print(f"EARLYSTOP written in {time.time() - earlystop_start:.1f}s")

        # TEST_FULL: full risk set 2018–2019 (right-censored)
        test_sql = f"""
        COPY (
            SELECT
                *
            FROM read_parquet('{escaped_merged_win5}')
            WHERE year BETWEEN {TEST_YEARS[0]} AND {TEST_YEARS[1]}
        )
        TO '{escaped_test}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating TEST_FULL split ({TEST_YEARS[0]}–{TEST_YEARS[1]}, full risk set, right-censored)...")
        test_start = time.time()
        con.execute(test_sql)
        print(f"TEST written in {time.time() - test_start:.1f}s")

        # Log counts for both original and win5 targets
        print("\n" + "="*70)
        print("PER-YEAR STATISTICS")
        print("="*70)
        log_year_counts(con, train_early_out, "TRAIN_EARLY", "transition_01", use_wandb)
        log_year_counts(con, train_early_out, "TRAIN_EARLY", "transition_01_win5", use_wandb)
        # EARLYSTOP stats logged for information, but EARLYSTOP is only used for early stopping during CV, not evaluation
        log_year_counts(con, earlystop_out, "EARLYSTOP", "transition_01", use_wandb)
        log_year_counts(con, earlystop_out, "EARLYSTOP", "transition_01_win5", use_wandb)
        log_year_counts(con, test_out, "TEST_FULL", "transition_01", use_wandb)
        log_year_counts(con, test_out, "TEST_FULL", "transition_01_win5", use_wandb)

        # Check total rows and achieved ratios
        total_train_early_rows = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_train_early}')"
        ).fetchone()[0]
        
        print(f"\nTotal TRAIN_EARLY rows: {total_train_early_rows:,}")
        
        # Check per-year achieved neg/pos ratios vs target
        print(f"\nChecking achieved neg/pos ratios vs target ({TARGET_NEG_POS_RATIO}:1)...")
        achieved_ratios = con.execute(
            f"""
            SELECT
                year,
                SUM(transition_01) AS pos_count,
                SUM(CASE WHEN transition_01 = 0 THEN 1 ELSE 0 END) AS neg_count,
                CASE WHEN SUM(transition_01) > 0 
                     THEN SUM(CASE WHEN transition_01 = 0 THEN 1 ELSE 0 END)::DOUBLE / SUM(transition_01)
                     ELSE 0 END AS achieved_ratio
            FROM read_parquet('{escaped_train_early}')
            GROUP BY year
            ORDER BY year
            """
        ).fetchall()
        
        for year, pos, neg, achieved in achieved_ratios:
            status = "" if abs(achieved - TARGET_NEG_POS_RATIO) / TARGET_NEG_POS_RATIO < 0.05 else ""
            print(f"  {status} {year}: achieved {achieved:.1f}:1 (target {TARGET_NEG_POS_RATIO}:1) | pos={pos:,} neg={neg:,}")
        
        # Compute scale_pos_weight from TRAIN_EARLY only: sqrt(n_neg / n_pos)
        train_stats = con.execute(
            f"""
            SELECT
                SUM(transition_01) AS total_pos,
                SUM(CASE WHEN transition_01 = 0 THEN 1 ELSE 0 END) AS total_neg
            FROM read_parquet('{escaped_train_early}')
            """
        ).fetchone()
        total_pos, total_neg = train_stats
        neg_pos_ratio = total_neg / total_pos if total_pos > 0 else 1.0
        scale_pos_weight = math.sqrt(neg_pos_ratio) if neg_pos_ratio > 0 else 1.0
        
        print(f"\nTRAIN_EARLY class balance:")
        print(f"  Positives: {total_pos:,}")
        print(f"  Negatives: {total_neg:,}")
        print(f"  Ratio (neg/pos): {neg_pos_ratio:.2f}")
        print(f"  scale_pos_weight for LightGBM: {scale_pos_weight:.6f} (sqrt of ratio)")
        
        # Save scale_pos_weight to metadata file for use in training
        metadata_path = base_dir / "train_early_metadata.json"
        metadata = {
            "scale_pos_weight": scale_pos_weight,
            "total_positives": int(total_pos),
            "total_negatives": int(total_neg),
            "neg_pos_ratio": float(neg_pos_ratio),
            "computed_from": "train_early_sampled.parquet"
        }
        with open(metadata_path, 'w') as f:
            json.dump(metadata, f, indent=2)
        print(f"  Metadata saved to: {metadata_path}")

        total_test = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_test}')"
        ).fetchone()[0]

        total_earlystop = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_earlystop}')"
        ).fetchone()[0]

        if use_wandb:
            wandb.log(
                {
                    "train_early/rows": total_train_early_rows,
                    "train_early/positives": total_pos,
                    "train_early/negatives": total_neg,
                    "train_early/scale_pos_weight": scale_pos_weight,
                    "train_early/target_neg_pos_ratio": TARGET_NEG_POS_RATIO,
                    "train_early/achieved_neg_pos_ratio": neg_pos_ratio,
                    "earlystop/rows": total_earlystop,
                    "test_full/rows": total_test,
                    "lookahead_years": LOOKAHEAD_YEARS,
                    "cutoff_year": cutoff_year,
                    "max_year": max_year,
                    "timing/total_seconds": time.time() - start_time,
                }
            )

        print("\nDone.")

    except Exception as e:
        error_msg = f"{type(e).__name__}: {e}"
        print(f"\nERROR: {error_msg}")
        if use_wandb:
            wandb.log({"status": "failed", "error": error_msg})
        raise
    finally:
        if use_wandb:
            wandb.finish()


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"\nScript failed: {e}", file=sys.stderr)
