def load_best_params(params_path: Optional[Path]) -> tuple[Dict[str, Any], Any]:
    """Load and merge parameters: FIXED_PARAMS → json_fixed_params → best_params → guardrails.
    If params_path is None, returns default manual hyperparameters."""
    if params_path is None:
        # Use default manual hyperparameters when JSON file is not found
        print("  lgbm_best_params.json not found, using default manual hyperparameters")
        guardrail_params = {"max_depth": 8, "num_leaves": 255, "min_child_samples": 50, "subsample": 0.7,
                           "subsample_freq": 1, "colsample_bytree": 0.7, "learning_rate": 0.03, "n_estimators": 3000,
                           "reg_alpha": 1.0, "reg_lambda": 1.0, "metric": "average_precision", "n_jobs": get_n_jobs(), "verbose": -1}
        final_params = {**FIXED_PARAMS, **guardrail_params}
        return final_params, None
    
    with open(params_path, 'r') as f:
        params_data = json.load(f)
    final_params = {**FIXED_PARAMS, **params_data.get('fixed_params', {}), **params_data.get('best_params', {})}
    guardrail_params = {"max_depth": 8, "num_leaves": 255, "min_child_samples": 50, "subsample": 0.7,
                       "subsample_freq": 1, "colsample_bytree": 0.7, "learning_rate": 0.03, "n_estimators": 3000,
                       "reg_alpha": 1.0, "reg_lambda": 1.0, "metric": "average_precision", "n_jobs": get_n_jobs(), "verbose": -1}
    final_params.update(guardrail_params)
    return final_params, params_data.get('best_cv_score', None)


def downcast_numeric_dtypes(df: pd.DataFrame) -> None:
    """Downcast numeric dtypes to reduce memory usage (in-place)."""
    for col in df.select_dtypes(include=['float64']).columns:
        df[col] = df[col].astype('float32', copy=False)
    for col in df.select_dtypes(include=['int64']).columns:
        df[col] = df[col].astype('int32', copy=False)


def load_numpy_arrays_two_pass(
    df_path: Path, 
    feature_cols: list, 
    target_col: str, 
    year_filter, 
    name: str = "",
    batch_size: int = BATCH_SIZE
) -> tuple[np.ndarray, np.ndarray, np.ndarray, int, int, list]:
    """
    Two-pass NumPy loader: bypasses Pandas to minimize memory overhead.
    
    Pass 1: Count rows matching filter (after dropna on target).
    Pass 2: Pre-allocate float32 arrays and stream data directly into them.
    
    Returns:
        X: Feature matrix (n_samples, n_features) as float32
        y: Target vector (n_samples,) as int8
        years_array: Array of years (n_samples,) as int32
        pos: Number of positive samples
        neg: Number of negative samples
        years: Sorted list of unique years
    """
    print(f"\nLoading {name or df_path.name} (two-pass NumPy loader)...")
    load_start = time.time()
    essential_cols = feature_cols + [target_col, 'year']
    
    # Pass 1: Count rows matching filter
    print(f"  Pass 1: Counting rows matching filter...")
    parquet_file = pq.ParquetFile(df_path)
    n_samples = 0
    years_set = set()
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols):
            # Convert batch to numpy arrays directly (bypass pandas)
            batch_table = batch
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            
            # Filter out NaN in target
            valid_mask = ~np.isnan(target_array)
            if not valid_mask.any():
                continue
            
            target_valid = target_array[valid_mask]
            year_valid = year_array[valid_mask]
            
            # Apply year filter (works directly on numpy arrays)
            year_mask = year_filter(year_valid)
            n_samples += int(year_mask.sum())
            years_set.update(year_valid[year_mask].tolist())
            
            del batch_table, target_array, year_array, target_valid, year_valid, batch
    finally:
        del parquet_file
        gc.collect()
    
    print(f"  Found {n_samples:,} samples matching filter")
    
    if n_samples == 0:
        raise ValueError(f"No samples found matching filter in {name or df_path.name}")
    
    # Pass 2: Pre-allocate arrays and fill directly
    print(f"  Pass 2: Pre-allocating arrays ({n_samples:,} samples, {len(feature_cols)} features)...")
    X = np.empty((n_samples, len(feature_cols)), dtype=np.float32)
    y = np.empty(n_samples, dtype=np.int8)
    years_array = np.empty(n_samples, dtype=np.int32)
    
    parquet_file = pq.ParquetFile(df_path)
    idx_offset = 0
    batch_num = 0
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols):
            batch_num += 1
            batch_table = batch
            
            # Extract arrays directly from PyArrow
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            
            # Filter out NaN in target
            valid_mask = ~np.isnan(target_array)
            if not valid_mask.any():
                del batch_table, target_array, year_array, batch
                continue
            
            target_valid = target_array[valid_mask]
            year_valid = year_array[valid_mask]
            
            # Apply year filter (works directly on numpy arrays)
            year_mask = year_filter(year_valid)
            if not year_mask.any():
                del batch_table, target_array, year_array, target_valid, year_valid, batch
                continue
            
            # Extract filtered data
            target_filtered = target_valid[year_mask]
            year_filtered = year_valid[year_mask]
            
            # Extract feature columns in bulk: convert all feature columns at once
            # Build final mask: map year_mask (applied to valid data) back to original indices
            final_mask = valid_mask.copy()
            final_mask[valid_mask] = year_mask  # Map year_mask back to positions where valid_mask is True
            
            # Convert feature columns in bulk using pure PyArrow→NumPy path (no pandas)
            feature_table = batch_table.select(feature_cols)
            X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            y_batch = (target_filtered > 0).astype(np.int8)
            
            # Insert directly into pre-allocated arrays
            batch_size_actual = len(y_batch)
            X[idx_offset:idx_offset + batch_size_actual, :] = X_batch
            y[idx_offset:idx_offset + batch_size_actual] = y_batch
            years_array[idx_offset:idx_offset + batch_size_actual] = year_filtered.astype(np.int32)
            idx_offset += batch_size_actual
            
            del batch_table, target_array, year_array, target_valid, year_valid, target_filtered, year_filtered
            del feature_table, X_batch, y_batch, batch
            
            if batch_num % 25 == 0:
                gc.collect()
            
            if batch_num % 10 == 0:
                print(f"  {batch_num} batches, {idx_offset:,}/{n_samples:,} samples loaded")
                report_memory_usage(f"load batch {batch_num}")
    finally:
        del parquet_file
        gc.collect()
    
    if idx_offset != n_samples:
        raise ValueError(f"Mismatch: expected {n_samples:,} samples but loaded {idx_offset:,}")
    
    # Compute stats
    pos = int(y.sum())
    neg = int((y == 0).sum())
    years = sorted(years_set)
    
    load_time = time.time() - load_start
    mem_gb = (X.nbytes + y.nbytes + years_array.nbytes) / 1024**3
    print(f"  Loaded {n_samples:,} rows in {load_time:.1f}s ({mem_gb:.2f} GB)")
    print(f"  {neg:,} neg, {pos:,} pos, ratio 1:{neg/max(pos,1):.1f}, years {years[0]}-{years[-1]}")
    
    return X, y, years_array, pos, neg, years


def compute_year_weights(years: np.ndarray, min_year: int = 2001, max_year: int = 2014, 
                         min_weight: float = 0.5, max_weight: float = 1.0) -> np.ndarray:
    """
    Compute sample weights based on year.
    Linear interpolation: min_year -> min_weight, max_year -> max_weight.
    
    Args:
        years: Array of years
        min_year: Earliest year (gets min_weight)
        max_year: Latest year (gets max_weight)
        min_weight: Weight for min_year (default 0.5)
        max_weight: Weight for max_year (default 1.0)
    
    Returns:
        Array of weights (float32)
    """
    # Guard against division by zero when min_year == max_year
    if max_year == min_year:
        return np.full(len(years), max_weight, dtype=np.float32)
    
    # Normalize years to [0, 1] range
    years_normalized = (years - min_year) / (max_year - min_year)
    # Clip to [0, 1] in case of out-of-range years
    years_normalized = np.clip(years_normalized, 0.0, 1.0)
    # Linear interpolation
    weights = min_weight + years_normalized * (max_weight - min_weight)
    return weights.astype(np.float32)


def load_numpy_arrays_from_multiple_files(
    df_paths: list[Path],
    feature_cols: list,
    target_col: str,
    name: str = "",
    batch_size: int = BATCH_SIZE,
    year_range: Optional[tuple[int, int]] = None
) -> tuple[np.ndarray, np.ndarray, np.ndarray, int, int, list]:
    """
    Load data from multiple parquet files with optional year filtering.
    Combines data from all files and filters by year_range if specified.
    
    Args:
        df_paths: List of paths to parquet files to load from
        year_range: Optional tuple (min_year, max_year) to filter data. Inclusive on both ends.
    
    Returns:
        X: Feature matrix (n_samples, n_features) as float32
        y: Target vector (n_samples,) as int8
        years_array: Array of years (n_samples,) as int32
        pos: Number of positive samples
        neg: Number of negative samples
        years: Sorted list of unique years
    """
    year_filter_str = f" (years {year_range[0]}-{year_range[1]})" if year_range else ""
    print(f"\nLoading from {len(df_paths)} files{year_filter_str} (two-pass NumPy loader)...")
    load_start = time.time()
    essential_cols = feature_cols + [target_col, 'year']
    
    # Pass 1: Count rows across all files
    print(f"  Pass 1: Counting rows...")
    n_samples = 0
    years_set = set()
    
    for file_idx, df_path in enumerate(df_paths):
        parquet_file = pq.ParquetFile(df_path)
        try:
            for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols):
                batch_table = batch
                target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
                year_array = batch_table['year'].to_numpy(zero_copy_only=False)
                
                # Filter out NaN in target
                valid_mask = ~np.isnan(target_array)
                if not valid_mask.any():
                    continue
                
                target_valid = target_array[valid_mask]
                year_valid = year_array[valid_mask]
                
                if year_range is not None:
                    year_mask = (year_valid >= year_range[0]) & (year_valid <= year_range[1])
                    target_valid = target_valid[year_mask]
                    year_valid = year_valid[year_mask]
                
                if len(target_valid) == 0:
                    continue
                
                n_samples += len(target_valid)
                years_set.update(year_valid.tolist())
                
                del batch_table, target_array, year_array, target_valid, year_valid, batch
        finally:
            del parquet_file
            gc.collect()
    
    print(f"  Found {n_samples:,} samples")
    
    if n_samples == 0:
        raise ValueError(f"No samples found in files{year_filter_str}")
    
    # Pass 2: Pre-allocate arrays and fill from all files
    print(f"  Pass 2: Pre-allocating arrays ({n_samples:,} samples, {len(feature_cols)} features)...")
    X = np.empty((n_samples, len(feature_cols)), dtype=np.float32)
    y = np.empty(n_samples, dtype=np.int8)
    years_array = np.empty(n_samples, dtype=np.int32)
    idx_offset = 0
    batch_num = 0
    
    for file_idx, df_path in enumerate(df_paths):
        parquet_file = pq.ParquetFile(df_path)
        try:
            for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols):
                batch_num += 1
                batch_table = batch
                
                target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
                year_array = batch_table['year'].to_numpy(zero_copy_only=False)
                
                # Filter out NaN in target
                valid_mask = ~np.isnan(target_array)
                if not valid_mask.any():
                    del batch_table, batch
                    continue
                
                target_valid = target_array[valid_mask]
                year_valid = year_array[valid_mask]
                
                if year_range is not None:
                    year_mask = (year_valid >= year_range[0]) & (year_valid <= year_range[1])
                    if not year_mask.any():
                        del batch_table, target_array, year_array, batch
                        continue
                    target_valid = target_valid[year_mask]
                    year_valid = year_valid[year_mask]
                    
                    # Build final mask: valid AND passes year filter
                    final_mask = valid_mask.copy()
                    final_mask[valid_mask] = year_mask
                    
                    # Convert feature columns in bulk using pure PyArrow→NumPy path (no pandas)
                    feature_table = batch_table.select(feature_cols)
                    X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
                else:
                    # Convert feature columns in bulk using pure PyArrow→NumPy path (no pandas, no year filter)
                    feature_table = batch_table.select(feature_cols)
                    X_batch = extract_features_pyarrow_to_numpy(feature_table, valid_mask)
                y_batch = (target_valid > 0).astype(np.int8)
                
                batch_size_actual = len(y_batch)
                X[idx_offset:idx_offset + batch_size_actual, :] = X_batch
                y[idx_offset:idx_offset + batch_size_actual] = y_batch
                years_array[idx_offset:idx_offset + batch_size_actual] = year_valid.astype(np.int32)
                idx_offset += batch_size_actual
                
                del batch_table, target_array, year_array, target_valid, year_valid
                del feature_table, X_batch, y_batch, batch
                
                if batch_num % 25 == 0:
                    gc.collect()
                
                if batch_num % 10 == 0:
                    print(f"  {batch_num} batches, {idx_offset:,}/{n_samples:,} samples loaded")
                    report_memory_usage(f"load batch {batch_num}")
        finally:
            del parquet_file
            gc.collect()
    
    if idx_offset != n_samples:
        raise ValueError(f"Mismatch: expected {n_samples:,} samples but loaded {idx_offset:,}")
    
    pos = int(y.sum())
    neg = int((y == 0).sum())
    years = sorted(years_set)
    
    load_time = time.time() - load_start
    mem_gb = (X.nbytes + y.nbytes + years_array.nbytes) / 1024**3
    print(f"  Loaded {n_samples:,} rows in {load_time:.1f}s ({mem_gb:.2f} GB)")
    print(f"  {neg:,} neg, {pos:,} pos, ratio 1:{neg/max(pos,1):.1f}, years {years[0]}-{years[-1]}")
    
    return X, y, years_array, pos, neg, years


def load_test_data_one_pass(
    test_path: Path,
    feature_cols: list,
    target_col: str,
    keep_cols_test: list,
    year_range: tuple[int, int],
    calibrated_model: CalibratedLGBMWrapper,
    output_path: Path,
    batch_size: int = BATCH_SIZE
) -> tuple[np.ndarray, np.ndarray, int, int, list]:
    """
    One-pass streaming loader for test data.
    Collects batches, concatenates, writes scored results, and returns metrics arrays.
    
    Returns:
        y_test: Target array (n_samples,) as int8
        y_proba: Calibrated probabilities (n_samples,) as float32
        test_pos: Number of positive samples
        test_neg: Number of negative samples
        test_years: Sorted list of unique years
    """
    print(f"  Loading test data (one-pass streaming, years {year_range[0]}-{year_range[1]})...")
    
    batches_y_test = []
    batches_y_proba = []
    test_years_set = set()
    test_pos = test_neg = 0
    batch_num = 0
    
    writer = None
    parquet_file = pq.ParquetFile(test_path)
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=keep_cols_test):
            batch_num += 1
            batch_table = batch
            
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            
            # Filter out NaN in target
            valid_mask = ~np.isnan(target_array)
            if not valid_mask.any():
                del batch_table, target_array, year_array, batch
                continue
            
            # Filter by year range
            year_mask = (year_array >= year_range[0]) & (year_array <= year_range[1])
            final_mask = valid_mask & year_mask
            if not final_mask.any():
                del batch_table, target_array, year_array, batch
                continue
            
            # Extract target
            target_valid = target_array[final_mask]
            y_batch = (target_valid > 0).astype(np.int8)
            
            # Extract feature columns in bulk using pure PyArrow→NumPy path (no pandas)
            feature_table = batch_table.select(feature_cols)
            X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            
            # Get predictions from calibrated model
            y_proba_batch = calibrated_model.predict_proba(X_batch)[:, 1].astype(np.float32)
            
            batches_y_test.append(y_batch)
            batches_y_proba.append(y_proba_batch)
            
            test_pos += int(y_batch.sum())
            test_neg += int((y_batch == 0).sum())
            test_years_set.update(year_array[final_mask].tolist())
            
            # Extract metadata for writing results
            row_array = batch_table['row'].to_numpy(zero_copy_only=False)[final_mask]
            col_array = batch_table['col'].to_numpy(zero_copy_only=False)[final_mask]
            year_array_valid = year_array[final_mask]
            
            result_arrays = {
                'row': row_array.astype(np.int32),
                'col': col_array.astype(np.int32),
                'year': year_array_valid.astype(np.int32),
                'y_true': y_batch,
                'y_pred_proba': y_proba_batch
            }
            
            # Add optional x, y coordinates if present
            for coord_col in ['x', 'y']:
                if coord_col in batch_table.column_names:
                    coord_array = batch_table[coord_col].to_numpy(zero_copy_only=False)[final_mask]
                    result_arrays[coord_col] = coord_array.astype(np.float32)
            
            result_table = pa.table(result_arrays)
            
            if writer is None:
                writer = pq.ParquetWriter(output_path, result_table.schema)
                print(f"Writing to {output_path}")
            writer.write_table(result_table)
            
            del batch_table, target_array, target_valid, feature_table, X_batch, y_batch, y_proba_batch
            del row_array, col_array, year_array, year_array_valid, result_arrays, result_table, batch
            
            if batch_num % 25 == 0:
                gc.collect()
            
            if batch_num % 10 == 0:
                print(f"  {batch_num} batches processed")
                report_memory_usage(f"test batch {batch_num}")
    finally:
        if writer is not None:
            writer.close()
        del parquet_file
        gc.collect()
    
    # Concatenate all batches
    print(f"  Concatenating {len(batches_y_test)} batches...")
    y_test = np.concatenate(batches_y_test, axis=0).astype(np.int8)
    y_proba = np.concatenate(batches_y_proba, axis=0).astype(np.float32)
    
    test_years = sorted(test_years_set)
    print(f"  Loaded {len(y_test):,} test samples")
    
    return y_test, y_proba, test_pos, test_neg, test_years


def load_calibration_data_one_pass(
    df_path: Path,
    feature_cols: list,
    target_col: str,
    year_range: tuple[int, int],
    lgb_model: lgb.Booster,
    num_iteration: int,
    batch_size: int = BATCH_SIZE
) -> tuple[np.ndarray, np.ndarray]:
    """
    One-pass streaming loader for calibration data.
    Collects batches, concatenates, and returns y_true and y_pred.
    
    Returns:
        y_true: Target array (n_samples,) as int8
        y_pred: Uncalibrated predictions (n_samples,) as float32
    """
    print(f"  Loading calibration data (one-pass streaming, years {year_range[0]}-{year_range[1]})...")
    essential_cols = feature_cols + [target_col, 'year']
    
    batches_y_true = []
    batches_y_pred = []
    
    parquet_file = pq.ParquetFile(df_path)
    batch_num = 0
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=essential_cols):
            batch_num += 1
            batch_table = batch
            
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            
            # Filter out NaN in target
            valid_mask = ~np.isnan(target_array)
            if not valid_mask.any():
                del batch_table, target_array, year_array, batch
                continue
            
            # Filter to calibration years only
            year_mask = (year_array >= year_range[0]) & (year_array <= year_range[1])
            final_mask = valid_mask & year_mask
            if not final_mask.any():
                del batch_table, target_array, year_array, batch
                continue
            
            # Extract target
            target_filtered = target_array[final_mask]
            y_batch = (target_filtered > 0).astype(np.int8)
            
            # Extract feature columns in bulk using pure PyArrow→NumPy path (no pandas)
            feature_table = batch_table.select(feature_cols)
            X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            
            # Get uncalibrated predictions
            y_pred_batch = lgb_model.predict(X_batch, num_iteration=num_iteration).astype(np.float32)
            
            batches_y_true.append(y_batch)
            batches_y_pred.append(y_pred_batch)
            
            del batch_table, target_array, year_array, target_filtered, feature_table, X_batch, y_batch, y_pred_batch, batch
            
            if batch_num % 25 == 0:
                gc.collect()
            
            if batch_num % 10 == 0:
                print(f"  {batch_num} batches processed")
                report_memory_usage(f"calibration batch {batch_num}")
    finally:
        del parquet_file
        gc.collect()
    
    # Concatenate all batches
    print(f"  Concatenating {len(batches_y_true)} batches...")
    y_true = np.concatenate(batches_y_true, axis=0).astype(np.int8)
    y_pred = np.concatenate(batches_y_pred, axis=0).astype(np.float32)
    
    print(f"  Loaded {len(y_true):,} calibration samples")
    return y_true, y_pred


def compute_metrics(y_true: np.ndarray, y_proba: np.ndarray) -> Dict[str, float]:
    """Compute all validation/test metrics."""
    roc_auc = roc_auc_score(y_true, y_proba)
    pr_auc = average_precision_score(y_true, y_proba)
    baseline_rate = y_true.mean()
    prec_at_k = {k: compute_precision_at_k(y_true, y_proba, k) for k in [1, 5, 10]}
    return {"roc_auc": float(roc_auc), "pr_auc": float(pr_auc), "precision_at_1pct": float(prec_at_k[1]),
            "precision_at_5pct": float(prec_at_k[5]), "precision_at_10pct": float(prec_at_k[10]),
            "baseline_rate": float(baseline_rate),
            "lift_at_1pct": float(prec_at_k[1] / baseline_rate) if baseline_rate > 0 else 0,
            "lift_at_5pct": float(prec_at_k[5] / baseline_rate) if baseline_rate > 0 else 0,
            "lift_at_10pct": float(prec_at_k[10] / baseline_rate) if baseline_rate > 0 else 0}


