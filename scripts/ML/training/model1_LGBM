def check_year_overlap(train_years: tuple[int, int], eval_years: tuple[int, int], eval_name: str) -> bool:
    """
    Check if evaluation years overlap with training years.
    Returns True if there's overlap, False otherwise.
    """
    train_start, train_end = train_years
    eval_start, eval_end = eval_years
    
    # Check for overlap: eval years should be strictly after training years
    if eval_start <= train_end:
        print(f"\n{'!'*70}")
        print(f"WARNING: {eval_name} years ({eval_start}-{eval_end}) OVERLAP with training years ({train_start}-{train_end})!")
        print(f"  Evaluation years must be strictly after training years to avoid data leakage.")
        print(f"  SKIPPING {eval_name} evaluation for this fold.")
        print(f"{'!'*70}\n")
        return True
    return False


def train_single_cv_fold(
    train_paths: list[Path],
    earlystop_paths: list[Path],
    feature_cols: list,
    target_col: str,
    train_years: tuple[int, int],
    earlystop_years: tuple[int, int],
    fold_idx: int,
    best_params: Dict[str, Any],
    use_wandb: bool,
) -> Dict[str, Any]:
    """
    Train and evaluate a single CV fold.
    Earlystop is used ONLY for early stopping, NOT for metric reporting.
    
    Returns:
        Dictionary containing fold metrics and metadata
    """
    print(f"\n{'='*70}")
    print(f"CV FOLD {fold_idx + 1}/{len(CV_FOLDS)}")
    print(f"Train: {train_years[0]}-{train_years[1]} → Earlystop: {earlystop_years[0]}-{earlystop_years[1]}")
    print(f"{'='*70}")
    
    # Check for year overlap
    earlystop_year_range = (earlystop_years[0], min(earlystop_years[1], LAST_LABEL_YEAR))
    if check_year_overlap(train_years, earlystop_year_range, f"Fold {fold_idx+1} Earlystop"):
        # Skip this fold if overlap detected
        return {
            "fold_idx": fold_idx,
            "train_years": list(train_years),
            "earlystop_years": list(earlystop_years),
            "skipped": True,
            "skip_reason": "year_overlap",
        }
    
    # Load train data
    X_train, y_train, train_years_array, train_pos, train_neg, train_years_list = load_numpy_arrays_from_multiple_files(
        train_paths, feature_cols, target_col, f"Fold {fold_idx+1} Train", year_range=train_years
    )
    n_train_samples = len(X_train)
    
    # Load earlystop data (filter to LAST_LABEL_YEAR to avoid right-censored labels)
    X_earlystop, y_earlystop, earlystop_years_array, earlystop_pos, earlystop_neg, earlystop_years_list = load_numpy_arrays_from_multiple_files(
        earlystop_paths, feature_cols, target_col, f"Fold {fold_idx+1} Earlystop", year_range=earlystop_year_range
    )
    n_earlystop_samples = len(X_earlystop)
    
    print(f"\nFold {fold_idx+1}: Train {n_train_samples:,} samples, Earlystop {n_earlystop_samples:,} samples (earlystop years {earlystop_year_range[0]}-{earlystop_year_range[1]}, capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})")
    print(f"  NOTE: Earlystop used ONLY for early stopping, NOT for metric reporting.")
    
    # Compute sample weights for training data (time-based weighting)
    # Weight range: MIN_YEAR (weight 0.5) to train_years[1] (weight 1.0)
    train_weights = compute_year_weights(train_years_array, min_year=MIN_YEAR, max_year=train_years[1])
    print(f"  Training sample weights: min={train_weights.min():.3f}, max={train_weights.max():.3f}, mean={train_weights.mean():.3f}")
    
    # Compute scale_pos_weight from training data: scale_pos_weight = n_neg / n_pos
    scale_pos_weight = train_neg / max(train_pos, 1)
    print(f"  Computed scale_pos_weight from training data: {scale_pos_weight:.6f} = {train_neg:,} / {train_pos:,}")
    
    # Train model
    num_boost_round_earlystop = best_params.get("num_boost_round", best_params.get("n_estimators", 3000))
    train_params = {**best_params, "is_unbalance": False}
    train_params.pop("num_boost_round", None)
    train_params.pop("n_estimators", None)
    # Override scale_pos_weight with computed value right before training
    train_params["scale_pos_weight"] = scale_pos_weight
    
    # Add memory-efficient LightGBM parameters
    train_params['force_col_wise'] = True  # More memory efficient for many features
    train_params['max_bin'] = 255  # Reduce memory usage
    train_params['two_round'] = True  # Reduce peak memory during histogram building
    train_params['num_threads'] = get_n_jobs()  # Use SLURM_CPUS_PER_TASK if available
    
    print(f"  Creating datasets...")
    train_dataset = lgb.Dataset(X_train, label=y_train, weight=train_weights, free_raw_data=True)
    del X_train, y_train, train_years_array, train_weights; gc.collect()
    
    earlystop_dataset = lgb.Dataset(X_earlystop, label=y_earlystop, free_raw_data=True, reference=train_dataset)
    
    print(f"  Training...")
    train_start = time.time()
    lgb_model = lgb.train(
        train_params,
        train_dataset,
        num_boost_round=num_boost_round_earlystop,
        valid_sets=[earlystop_dataset],
        valid_names=["earlystop"],
        callbacks=[lgb.early_stopping(500), lgb.log_evaluation(100)]
    )
    train_time = time.time() - train_start
    best_iteration = lgb_model.best_iteration
    
    del train_dataset, earlystop_dataset; gc.collect()
    del X_earlystop, y_earlystop, earlystop_years_array, lgb_model; gc.collect()
    
    if use_wandb:
        wandb.log({
            f"cv_fold_{fold_idx+1}/n_train": int(n_train_samples),
            f"cv_fold_{fold_idx+1}/n_earlystop": int(n_earlystop_samples),
            f"cv_fold_{fold_idx+1}/train_time_seconds": train_time,
            f"cv_fold_{fold_idx+1}/best_iteration": int(best_iteration) if best_iteration is not None else None,
        })
    
    return {
        "fold_idx": fold_idx,
        "train_years": list(train_years),
        "earlystop_years": list(earlystop_years),
        "n_train_samples": int(n_train_samples),
        "n_earlystop_samples": int(n_earlystop_samples),
        "train_positives": int(train_pos),
        "train_negatives": int(train_neg),
        "earlystop_positives": int(earlystop_pos),
        "earlystop_negatives": int(earlystop_neg),
        "train_time_seconds": train_time,
        "best_iteration": int(best_iteration) if best_iteration is not None else None,
    }


def aggregate_cv_metrics(cv_results: list[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Aggregate metrics across CV folds.
    Only aggregates training metadata (no validation/earlystop metrics).
    """
    aggregated = {}
    
    # Filter out skipped folds
    valid_folds = [fold for fold in cv_results if not fold.get("skipped", False)]
    
    if not valid_folds:
        return aggregated
    
    # Aggregate sample sizes
    aggregated["n_train_mean"] = float(np.mean([fold.get("n_train_samples", fold.get("train_positives", 0) + fold.get("train_negatives", 0)) for fold in valid_folds]))
    aggregated["n_earlystop_mean"] = float(np.mean([fold.get("n_earlystop_samples", fold.get("earlystop_positives", 0) + fold.get("earlystop_negatives", 0)) for fold in valid_folds]))
    
    # NO earlystop metrics aggregated - earlystop is used ONLY for early stopping
    
    return aggregated


def phase1_training(
    train_path: Path, earlystop_path: Path, params_path: Optional[Path], feature_cols: list, keep_cols_train: list,
    best_params: Dict[str, Any], timestamp: str, model_dir: Path, output_dir: Path, use_wandb: bool, target_col: str,
    cv_mode: str = "fold3",
) -> tuple[Path, Dict[str, Any], Dict[str, Any], float, float, int, int, int, Dict[str, Any], Dict[str, Any]]:
    """
    Phase 1: Training with temporal cross-validation.
    
    Steps:
    1. Run temporal CV folds to assess model stability (earlystop used only for early stopping, no metrics)
    2. Train final model on TRAIN_EARLY data (2001-2014, capped at LAST_LABEL_YEAR) with no early stopping
    3. Fit isotonic calibration on earlystop calibration predictions (2016-2017, capped at LAST_LABEL_YEAR)
    
    Returns:
        Tuple including CV results as additional element
    """
    print("\n" + "="*70 + "\nPHASE 1: TRAINING WITH TEMPORAL CROSS-VALIDATION\n" + "="*70)
    report_memory_usage("start of Phase 1")
    
    # =============================================================================
    # STEP A: TEMPORAL CROSS-VALIDATION
    # =============================================================================
    print("\n" + "="*70 + "\nSTEP A: TEMPORAL CROSS-VALIDATION\n" + "="*70)
    print(f"CV Mode: {cv_mode}")
    
    cv_results = []
    
    if cv_mode == "none":
        print("  Skipping CV (cv_mode=none)")
        # Use default best_iteration from params
        chosen_iteration = best_params.get("num_boost_round", best_params.get("n_estimators", 3000))
        print(f"  Using default best_iteration from params: {chosen_iteration}")
        cv_aggregated = {}
        best_iterations = []
        train_rows_per_fold = []
        fold3_best_iteration = None
        cv_results = []
    else:
        # For CV, we need data from both train and earlystop files
        # Each fold will filter the appropriate year ranges
        cv_train_paths = [train_path]  # Train file contains data needed for CV
        
        # Try to resolve a full (unsampled) file for earlystop years <= 2014
        full_train_file = resolve_full_train_file()
        
        # Determine which folds to run
        if cv_mode == "fold3":
            folds_to_run = [2]  # Only fold 3 (0-indexed: 2)
            print(f"  Running only fold 3 ({MIN_YEAR}-2014 -> 2015)")
        elif cv_mode == "full":
            folds_to_run = list(range(len(CV_FOLDS)))  # All folds
            print(f"  Running all {len(CV_FOLDS)} folds")
        else:
            raise ValueError(f"Invalid cv_mode: {cv_mode}. Must be one of: full, fold3, none")
        
        for fold_idx in folds_to_run:
            train_years, earlystop_years = CV_FOLDS[fold_idx]
            
            # For folds where earlystop years are <= 2014, prefer full (unsampled) file
            earlystop_year_max = min(earlystop_years[1], LAST_LABEL_YEAR)
            if earlystop_year_max <= 2014 and full_train_file is not None:
                # Use full file for earlystop years <= 2014
                cv_earlystop_paths = [full_train_file]
                print(f"  Fold {fold_idx+1}: Using full (unsampled) file for earlystop years {earlystop_years[0]}-{earlystop_year_max}")
            elif earlystop_year_max <= 2014:
                # No full file available, use sampled file with warning
                cv_earlystop_paths = [train_path]
                print(f"\n{'!'*70}")
                print(f"WARNING: Fold {fold_idx+1} earlystop years ({earlystop_years[0]}-{earlystop_year_max}) are <= 2014,")
                print(f"  but no full (unsampled) parquet file found. Using sampled train_early_sampled.parquet.")
                print(f"  This may bias chosen_iteration due to sampled distribution.")
                print(f"{'!'*70}\n")
            else:
                # Earlystop years > 2014, use both train and earlystop files
                cv_earlystop_paths = [train_path, earlystop_path]
            
            fold_result = train_single_cv_fold(
                cv_train_paths, cv_earlystop_paths, feature_cols, target_col,
                train_years, earlystop_years, fold_idx, best_params, use_wandb
            )
            cv_results.append(fold_result)
            gc.collect()
        
        # Aggregate CV metrics (no metrics computed on earlystop sets)
        cv_aggregated = aggregate_cv_metrics(cv_results)
        
        # Extract best_iterations and train_rows for each fold (skip folds that were skipped due to overlap)
        best_iterations = [fold["best_iteration"] for fold in cv_results if fold.get("best_iteration") is not None and not fold.get("skipped", False)]
        train_rows_per_fold = [fold["n_train_samples"] for fold in cv_results if not fold.get("skipped", False)]
        
        # Extract fold3's best_iteration (fold index 2) - skip if fold was skipped
        fold3_best_iteration = None
        for fold_result in cv_results:
            if (fold_result.get("fold_idx") == 2 and 
                fold_result.get("best_iteration") is not None and 
                not fold_result.get("skipped", False)):
                fold3_best_iteration = fold_result["best_iteration"]
                break
        
        # Calculate chosen_iteration based on cv_mode
        if cv_mode == "full":
            if best_iterations and train_rows_per_fold:
                # Weighted average: sum(iter_i * n_i) / sum(n_i) * 1.05
                weighted_sum = sum(iter_i * n_i for iter_i, n_i in zip(best_iterations, train_rows_per_fold))
                total_rows = sum(train_rows_per_fold)
                chosen_iteration = int(np.round(weighted_sum / total_rows * 1.05))
                print(f"\nCV best_iterations: {best_iterations}")
                print(f"CV train_rows_per_fold: {train_rows_per_fold}")
                print(f"Weighted average (before 1.05x): {weighted_sum / total_rows:.2f}")
                print(f"Chosen iteration (weighted avg * 1.05): {chosen_iteration}")
                
                # Apply max constraint with fold3_best_iteration
                if fold3_best_iteration is not None:
                    chosen_iteration = max(chosen_iteration, fold3_best_iteration)
                    print(f"After max with fold3_best_iteration ({fold3_best_iteration}): {chosen_iteration}")
            else:
                # Fallback: use default if no best_iteration found (e.g., all folds skipped)
                skipped_count = len([f for f in cv_results if f.get("skipped", False)])
                if skipped_count > 0:
                    print(f"\nWarning: {skipped_count} fold(s) skipped due to year overlap. No best_iteration found in remaining folds.")
                else:
                    print(f"\nWarning: No best_iteration found in CV folds.")
                chosen_iteration = best_params.get("num_boost_round", best_params.get("n_estimators", 3000))
                print(f"  Using default iteration from params: {chosen_iteration}")
        elif cv_mode == "fold3":
            if fold3_best_iteration is not None:
                chosen_iteration = fold3_best_iteration
                print(f"\nUsing fold3_best_iteration: {chosen_iteration}")
            else:
                # Fallback: use default if fold3 best_iteration not found (e.g., fold3 was skipped)
                fold3_result = next((f for f in cv_results if f.get("fold_idx") == 2), None)
                if fold3_result and fold3_result.get("skipped", False):
                    print(f"\nWarning: Fold 3 was skipped due to year overlap. fold3_best_iteration not available.")
                else:
                    print(f"\nWarning: fold3_best_iteration not found.")
                chosen_iteration = best_params.get("num_boost_round", best_params.get("n_estimators", 3000))
                print(f"  Using default iteration from params: {chosen_iteration}")
        else:
            # Fallback for any other mode
            chosen_iteration = best_params.get("num_boost_round", best_params.get("n_estimators", 3000))
            print(f"\nWarning: Unknown cv_mode, using default: {chosen_iteration}")
    
    print("\n" + "="*70)
    print("TEMPORAL CV RESULTS (Aggregated)")
    print("="*70)
    print(f"CV Mode: {cv_mode}")
    if cv_mode != "none":
        print(f"Chosen iteration (for final model): {chosen_iteration}")
        # Report number of skipped folds
        skipped_folds = [fold for fold in cv_results if fold.get("skipped", False)]
        if skipped_folds:
            print(f"  WARNING: {len(skipped_folds)} fold(s) skipped due to year overlap")
    else:
        print(f"Chosen iteration (from params): {chosen_iteration}")
    
    # NO earlystop metrics displayed - earlystop is used ONLY for early stopping, not for evaluation
    
    print("="*70)
    
    if use_wandb:
        wandb.log({
            **{f"cv_aggregated/{k}": v for k, v in cv_aggregated.items() if not k.endswith("_values")}
        })
    
    # =============================================================================
    # STEP B: FINAL MODEL TRAINING (TRAIN_EARLY: 2001-2014)
    # =============================================================================
    print("\n" + "="*70 + "\nSTEP B: FINAL MODEL TRAINING\n" + "="*70)
    print(f"Training final model on TRAIN_EARLY dataset: {TRAIN_YEARS[0]}-{TRAIN_YEARS[1]}")
    report_memory_usage("before final model training")
    
    # Load TRAIN_EARLY data (2001-2014, capped at LAST_LABEL_YEAR)
    print(f"\nLoading TRAIN_EARLY data ({TRAIN_YEARS[0]}-{TRAIN_YEARS[1]}, capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})...")
    X_train_full, y_train_full, train_years_array_full, train_pos_full, train_neg_full, train_years_full = load_numpy_arrays_two_pass(
        train_path, feature_cols, target_col, lambda y: (y >= TRAIN_YEARS[0]) & (y <= min(TRAIN_YEARS[1], LAST_LABEL_YEAR)), "train_early_sampled.parquet")
    n_train_full = len(y_train_full)
    
    train_stats = {
        "n_train": n_train_full,
        "train_positives": int(train_pos_full),
        "train_negatives": int(train_neg_full),
        "train_positive_pct": float(train_pos_full / max(n_train_full, 1) * 100.0),
        "train_years": f"{train_years_full[0]}-{train_years_full[-1]}",
    }
    report_memory_usage("after loading final data")
    
    print(f"\nFinal model training: train ({TRAIN_YEARS[0]}-{TRAIN_YEARS[1]}): {len(X_train_full):,} rows")
    print(f"Final training: no earlystop/val; num_boost_round fixed from CV to avoid leakage.")
    
    # Compute sample weights for training data (time-based weighting)
    # Weight range: MIN_YEAR (weight 0.5) to TRAIN_YEARS[1] (weight 1.0)
    train_weights = compute_year_weights(train_years_array_full, min_year=MIN_YEAR, max_year=TRAIN_YEARS[1])
    print(f"  Training sample weights: min={train_weights.min():.3f}, max={train_weights.max():.3f}, mean={train_weights.mean():.3f}")
    
    # Compute scale_pos_weight from training data: scale_pos_weight = n_neg / n_pos
    scale_pos_weight = train_neg_full / max(train_pos_full, 1)
    print(f"\nImbalance: Computed scale_pos_weight from training data: {scale_pos_weight:.6f} = {train_neg_full:,} / {train_pos_full:,}")
    
    imbalance_info = {
        "neg": int(train_neg_full),
        "pos": int(train_pos_full),
        "scale_pos_weight": float(scale_pos_weight)
    }
    if use_wandb:
        wandb.log({
            "final_model/imbalance/scale_pos_weight": float(scale_pos_weight),
            "final_model/sample_weights/min": float(train_weights.min()),
            "final_model/sample_weights/max": float(train_weights.max()),
            "final_model/sample_weights/mean": float(train_weights.mean()),
        })
    
    print(f"\nTraining final model on {len(X_train_full):,} samples...")
    report_memory_usage("before final training")
    train_start = time.time()
    train_params = {**best_params, "is_unbalance": False}
    train_params.pop("num_boost_round", None)
    train_params.pop("n_estimators", None)
    # Override scale_pos_weight with computed value right before training
    train_params["scale_pos_weight"] = scale_pos_weight
    
    # Add memory-efficient LightGBM parameters
    train_params['force_col_wise'] = True  # More memory efficient for many features
    train_params['max_bin'] = 255  # Reduce memory usage
    train_params['two_round'] = True  # Reduce peak memory during histogram building
    train_params['num_threads'] = get_n_jobs()  # Use SLURM_CPUS_PER_TASK if available
    
    print(f"  Creating dataset...")
    train_dataset = lgb.Dataset(X_train_full, label=y_train_full, weight=train_weights, free_raw_data=True)
    del X_train_full, y_train_full, train_years_array_full, train_weights; gc.collect()
    report_memory_usage("after train dataset creation")
    
    print(f"  Starting training with num_boost_round={chosen_iteration} (fixed from CV, no validation set/early stopping)...")
    lgb_model = lgb.train(
        train_params,
        train_dataset,
        num_boost_round=chosen_iteration,
        callbacks=[lgb.log_evaluation(100)]
    )
    train_time = time.time() - train_start
    print(f"\nTraining done in {train_time:.1f}s. Used {chosen_iteration} iterations (chosen based on CV)")
    
    del train_dataset; gc.collect()
    
    model_path = model_dir / f"model1_lgbm_win5_{timestamp}.pkl"
    with open(model_path, 'wb') as f:
        pickle.dump(lgb_model, f)
    print(f"Final model saved: {model_path}")
    gc.collect()
    
    # =============================================================================
    # STEP C: FITTING ISOTONIC CALIBRATION ON EARLYSTOP CALIBRATION YEARS
    # =============================================================================
    # Fit isotonic calibration on earlystop calibration predictions (one-pass streaming)
    print(f"\n" + "="*70 + "\nSTEP C: FITTING ISOTONIC CALIBRATION ON EARLYSTOP CALIBRATION YEARS\n" + "="*70)
    print(f"Calibration years: {VAL_CALIBRATION_YEARS[0]}-{min(VAL_CALIBRATION_YEARS[1], LAST_LABEL_YEAR)} (capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})")
    cal_start = time.time()
    
    cal_year_range = (VAL_CALIBRATION_YEARS[0], min(VAL_CALIBRATION_YEARS[1], LAST_LABEL_YEAR))
    
    # Use one-pass streaming loader
    y_true_cal, y_pred_cal = load_calibration_data_one_pass(
        earlystop_path, feature_cols, target_col, cal_year_range, lgb_model, chosen_iteration
    )
    
    if len(y_true_cal) == 0:
        raise ValueError(f"No samples found in earlystop calibration years {cal_year_range[0]}-{cal_year_range[1]}")
    
    print(f"  Calibrating on {len(y_true_cal):,} earlystop calibration samples...")
    report_memory_usage("before calibration fit")
    
    # Fit isotonic regression directly on collected predictions
    isotonic_reg = IsotonicRegression(out_of_bounds='clip', y_min=0.0, y_max=1.0)
    isotonic_reg.fit(y_pred_cal, y_true_cal)
    
    # Create a wrapper that applies isotonic calibration
    calibrated_model = CalibratedLGBMWrapper(lgb_model, isotonic_reg)
    cal_time = time.time() - cal_start
    print(f"  Calibration done in {cal_time:.1f}s")
    
    calibrated_model_path = model_dir / f"model1_lgbm_win5_calibrated_{timestamp}.pkl"
    with open(calibrated_model_path, 'wb') as f:
        pickle.dump(calibrated_model, f)
    print(f"  Calibrated model saved: {calibrated_model_path}")
    
    del y_true_cal, y_pred_cal, isotonic_reg; gc.collect()
    report_memory_usage("after calibration")
    
    if use_wandb:
        wandb.log({
            "final_model/data/n_features": len(feature_cols),
            "final_model/data/n_train": train_stats["n_train"],
            "final_model/data/train_positives": train_stats["train_positives"],
            "final_model/data/train_negatives": train_stats["train_negatives"],
            "final_model/data/train_positive_pct": train_stats["train_positive_pct"],
            "final_model/training/train_time_seconds": train_time,
            "final_model/training/train_time_minutes": train_time / 60,
            "final_model/training/final_num_boost_round": chosen_iteration,
            "final_model/training/chosen_iteration": chosen_iteration,
            "calibration/time_seconds": cal_time
        })
    
    print("Phase 1 completed.")
    cv_info = {
        "cv_mode": cv_mode,
        "folds": cv_results,
        "aggregated": cv_aggregated,
        "cv_best_iterations": best_iterations,
        "cv_train_rows_per_fold": train_rows_per_fold,
        "fold3_best_iteration": int(fold3_best_iteration) if fold3_best_iteration is not None else None,
        "final_num_boost_round": chosen_iteration,
        "chosen_iteration": chosen_iteration  # Alias for backward compatibility
    }
    # Return None for validation_metrics - earlystop is not used for evaluation
    return (calibrated_model_path, None, train_stats, train_time, 0.0, train_pos_full, train_neg_full, n_train_full, imbalance_info, cv_info)


def phase2_testing(
    test_path: Path, model_path: Path, feature_cols: list, keep_cols_test: list, timestamp: str, output_dir: Path,
    use_wandb: bool, target_col: str, validation_metrics: Dict[str, Any], train_stats: Dict[str, Any],
    train_time: float, earlystop_time: float, train_pos: int, train_neg: int, n_train_full: int,
    best_params: Dict[str, Any], start_time: float, imbalance_info: Dict[str, Any], cv_info: Dict[str, Any],
) -> None:
    """Phase 2: Testing - loads test in batches, loads calibrated model, evaluates."""
    print("\n" + "="*70 + "\nPHASE 2: TESTING\n" + "="*70)
    report_memory_usage("start of Phase 2")
    
    # Check for year overlap between training and test
    final_train_years = TRAIN_YEARS  # Training period: 2001-2014
    test_year_range = (TEST_START, min(TEST_END, LAST_LABEL_YEAR))
    
    if check_year_overlap(final_train_years, test_year_range, "Test"):
        print("\n" + "="*70)
        print("ERROR: Cannot proceed with testing due to year overlap.")
        print("="*70)
        raise ValueError("Test years overlap with training years. Cannot evaluate.")
    
    print(f"\nLoading calibrated model from {model_path}")
    with open(model_path, 'rb') as f:
        calibrated_model = pickle.load(f)
    report_memory_usage("after loading model")
    
    print(f"Processing test (one-pass streaming)...")
    print(f"Test year range: {test_year_range[0]}-{test_year_range[1]} (capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})")
    
    scored_path = output_dir / f"model1_lgbm_win5_scored_{timestamp}.parquet"
    pred_start = time.time()
    
    # Use one-pass streaming loader
    y_test, y_proba, test_pos, test_neg, test_years = load_test_data_one_pass(
        test_path, feature_cols, target_col, keep_cols_test, test_year_range, calibrated_model, scored_path
    )
    
    n_test_total = len(y_test)
    if n_test_total == 0:
        raise ValueError("No test samples found")
    
    pred_time = time.time() - pred_start
    print(f"Completed test processing in {pred_time:.1f}s, {n_test_total:,} rows")
    report_memory_usage("after all predictions")
    
    print(f"\nTest set: {test_neg:,} neg, {test_pos:,} pos, ratio 1:{test_neg/max(test_pos,1):.1f}, years {test_years[0]}-{test_years[-1]}")
    
    if use_wandb:
        wandb.log({"data/n_test": int(n_test_total), "data/test_positives": test_pos, "data/test_negatives": test_neg,
                  "data/test_positive_pct": test_pos/n_test_total*100})
    
    test_metrics = compute_metrics(y_test, y_proba)
    baseline_rate = test_metrics['baseline_rate']
    prec_at_k = {k: test_metrics[f'precision_at_{k}pct'] for k in [1, 5, 10]}
    print(f"\nTest metrics (using calibrated probabilities): ROC-AUC {test_metrics['roc_auc']:.4f}, PR-AUC {test_metrics['pr_auc']:.4f}")
    for k in [1, 5, 10]:
        n_top_k = max(1, int(len(y_test) * k / 100))
        n_protected = int(n_top_k * prec_at_k[k])
        print(f"  P@{k}%: {prec_at_k[k]:.4f} ({n_protected:,}/{n_top_k:,}), lift {test_metrics[f'lift_at_{k}pct']:.2f}x")
    
    if use_wandb:
        wandb.log({**{f"test/{k}": v for k, v in test_metrics.items()}})
    
    # Get feature importance from the underlying LightGBM model
    # The calibrated model wraps the original model, so we need to access it
    try:
        # Check if it's our custom CalibratedLGBMWrapper
        if hasattr(calibrated_model, 'booster'):
            underlying_model = calibrated_model.booster
        # Fallback for sklearn CalibratedClassifierCV (if used elsewhere)
        elif hasattr(calibrated_model, 'calibrated_classifiers_'):
            underlying_model = calibrated_model.calibrated_classifiers_[0].estimator.booster
        else:
            raise AttributeError("Unknown calibrated model type")
        feature_importance = pd.DataFrame({'feature': feature_cols, 'importance': underlying_model.feature_importance()}).sort_values('importance', ascending=False).head(20)
        print("\nTop 20 features:\n" + feature_importance.to_string(index=False))
    except (AttributeError, IndexError) as e:
        print(f"\nWarning: Could not extract feature importance from calibrated model: {e}")
        feature_importance = pd.DataFrame({'feature': feature_cols, 'importance': [0] * len(feature_cols)}).head(20)
    
    # Free test data after metrics computation
    del y_test, y_proba; gc.collect()
    
    metrics = {"metadata": {"timestamp": timestamp, "model": "LightGBM", "task": "transition_01_win5_prediction",
                           "target_column": TARGET_COL,
                           "lookahead_years": LOOKAHEAD_YEARS,
                           "random_state": RANDOM_STATE, "n_features": len(feature_cols), "features": feature_cols,
                           "calibration": "isotonic", "calibration_method": "IsotonicRegression (batched collection)",
                           "calibration_data": f"earlystop_calibration ({VAL_CALIBRATION_YEARS[0]}-{min(VAL_CALIBRATION_YEARS[1], LAST_LABEL_YEAR)}, streamed in batches, capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})", "test_probabilities": "calibrated",
                           "cv_mode": cv_info.get("cv_mode", "full")},
              "data": {"n_train_full": n_train_full, "n_test": int(n_test_total), "train_positives": train_pos,
                      "train_negatives": train_neg, "test_positives": test_pos, "test_negatives": test_neg},
              "temporal_split": {"method": "strict_temporal_split", "train_years": list(TRAIN_YEARS),
                                "earlystop_years": list(EARLYSTOP_YEARS), "test_years": list(TEST_YEARS)},
              "cross_validation": cv_info,
              "model_parameters": best_params,
              "imbalance_handling": {"method": "scale_pos_weight", "is_unbalance": False,
                                    "scale_pos_weight": imbalance_info.get("scale_pos_weight"),
                                    "neg": imbalance_info.get("neg"), "pos": imbalance_info.get("pos")},
              "test_performance": test_metrics, "feature_importance": feature_importance.head(20).to_dict('records'),
              "timing": {"train_seconds": train_time,
                        "prediction_seconds": pred_time, "total_seconds": time.time() - start_time}}
    metrics = convert_numpy_types(metrics)
    metrics_path = output_dir / f"model1_lgbm_win5_metrics_{timestamp}.json"
    with open(metrics_path, 'w') as f:
        json.dump(metrics, f, indent=2)
    print(f"\nMetrics saved: {metrics_path}")
    del calibrated_model; gc.collect()
    
    total_time = time.time() - start_time
    cv_mode = cv_info.get("cv_mode", "full")
    print("\n" + "="*70 + "\nSUMMARY\n" + "="*70)
    print(f"Model: LightGBM (with isotonic calibration), {len(feature_cols)} features")
    print(f"\nTemporal Cross-Validation (CV Mode: {cv_mode}):")
    if cv_mode != "none":
        n_folds_run = len([f for f in cv_info.get("folds", []) if not f.get("skipped", False)])
        n_folds_skipped = len([f for f in cv_info.get("folds", []) if f.get("skipped", False)])
        print(f"  Folds run: {n_folds_run}")
        if n_folds_skipped > 0:
            print(f"  Folds skipped (year overlap): {n_folds_skipped}")
    print(f"  Final num_boost_round (chosen): {cv_info.get('final_num_boost_round', 'N/A')}")
    if cv_info.get('fold3_best_iteration') is not None:
        print(f"  Fold3 best_iteration: {cv_info.get('fold3_best_iteration')}")
    
    # NO earlystop/validation metrics displayed - only CV metadata and test metrics
    
    print(f"\nTest ({TEST_YEARS[0]}-{TEST_YEARS[1]}, {n_test_total:,} samples, {test_pos/n_test_total*100:.3f}% pos, calibrated probabilities): ROC-AUC {test_metrics['roc_auc']:.4f}, PR-AUC {test_metrics['pr_auc']:.4f}")
    print(f"  P@1%: {prec_at_k[1]:.4f} ({test_metrics['lift_at_1pct']:.1f}x), P@5%: {prec_at_k[5]:.4f} ({test_metrics['lift_at_5pct']:.1f}x), P@10%: {prec_at_k[10]:.4f} ({test_metrics['lift_at_10pct']:.1f}x)")
    print(f"\nTimings: train {train_time:.1f}s, pred {pred_time:.1f}s, total {total_time:.1f}s ({total_time/60:.1f}m)")
    print("="*70 + "\nDone.")
    
    if use_wandb:
        wandb.log({"summary/total_time_seconds": total_time, "summary/total_time_minutes": total_time / 60, "status": "success"})
        wandb.finish()


def main(cv_mode: str = "fold3") -> None:
    start_time = time.time()
    repo_root = Path(__file__).resolve().parents[3]
    train_path = resolve_parquet_file("train_early_sampled.parquet")
    earlystop_path = resolve_parquet_file("earlystop_full.parquet")
    test_path = resolve_parquet_file("test_full.parquet")
    params_path = resolve_best_params_json()
    output_dir = repo_root / "outputs/Results/ml_models"
    output_dir.mkdir(parents=True, exist_ok=True)
    model_dir = repo_root / "data/ml/models"
    model_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    
    use_wandb = False
    try:
        wandb.init(project="ml-training-transitions", entity=os.environ.get("WANDB_ENTITY"), name=f"model1_lgbm_win5_{timestamp}",
                  config={"model": "LightGBM", "task": "transition_01_win5_prediction", "target_column": TARGET_COL,
                         "lookahead_years": LOOKAHEAD_YEARS, "random_state": RANDOM_STATE,
                         "temporal_split": {"train_years": list(TRAIN_YEARS), "earlystop_years": list(EARLYSTOP_YEARS),
                                           "test_years": list(TEST_YEARS)}, "cv_mode": cv_mode})
        use_wandb = True
        print("W&B connected")
    except Exception as err:
        print(f"W&B failed: {err}")
    
    print("="*70 + "\nLGBM TRANSITION MODEL (5-YEAR LOOKAHEAD)\n" + "="*70)
    print(f"Train: {train_path}\nEarlystop: {earlystop_path}\nTest: {test_path}\nParams: {params_path if params_path else 'Using default manual hyperparameters'}\nOutput: {output_dir}")
    print(f"\nConfiguration:")
    print(f"  WDPA_LAST_YEAR: {WDPA_LAST_YEAR}")
    print(f"  LOOKAHEAD_YEARS: {LOOKAHEAD_YEARS}")
    print(f"  LAST_LABEL_YEAR: {LAST_LABEL_YEAR} (WDPA_LAST_YEAR - LOOKAHEAD_YEARS)")
    print(f"  All splits (train/earlystop/calibration/test) filtered to years <= {LAST_LABEL_YEAR} to avoid right-censored labels")
    
    best_params, best_cv_score = load_best_params(params_path)
    if params_path:
        print(f"\nLoaded params from {params_path}")
        if best_cv_score:
            print(f"Best CV score: {best_cv_score:.4f}")
    else:
        print(f"\nUsing default manual hyperparameters (lgbm_best_params.json not found)")
    
    all_cols_train = pq.ParquetFile(train_path).schema_arrow.names
    all_cols_test = pq.ParquetFile(test_path).schema_arrow.names
    target_col = TARGET_COL
    # Build feature columns from PyArrow schema only (avoid loading full parquet into pandas)
    schema = pq.ParquetFile(train_path).schema_arrow
    numeric_cols = [
        name
        for name, field in zip(schema.names, schema)
        if pa.types.is_integer(field.type) or pa.types.is_floating(field.type)
    ]
    # Exclude target and coordinates from features (year is excluded)
    feature_cols = [c for c in numeric_cols if c not in EXCLUDE_COLS]
    required_cols = [target_col, 'year', 'row', 'col']
    optional_cols = [col for col in ['x', 'y'] if col in all_cols_train]
    keep_cols_train = feature_cols + required_cols + optional_cols
    keep_cols_test = feature_cols + required_cols + [col for col in ['x', 'y'] if col in all_cols_test]
    print(f"Selected {len(feature_cols)} features, loading {len(keep_cols_train)} cols from train, {len(keep_cols_test)} from test")
    
    (model_path, validation_metrics, train_stats, train_time, earlystop_time, train_pos, train_neg, n_train_full, imbalance_info, cv_info) = phase1_training(
        train_path, earlystop_path, params_path, feature_cols, keep_cols_train, best_params, timestamp, model_dir, output_dir, use_wandb, target_col, cv_mode=cv_mode)
    
    phase2_testing(test_path, model_path, feature_cols, keep_cols_test, timestamp, output_dir, use_wandb, target_col,
                  validation_metrics, train_stats, train_time, earlystop_time, train_pos, train_neg, n_train_full,
                  best_params, start_time, imbalance_info, cv_info)


