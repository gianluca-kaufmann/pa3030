#!/usr/bin/env python3
"""
Fix malformed EngineeringCRS metadata in South America ready rasters.

Why:
    Some rasters can carry CRS metadata like:
        EngineeringCRS "WGS 84 / Pseudo-Mercator" (Unknown engineering datum)
    which breaks rasterio/PROJ coordinate-operation lookup on Euler.

What this does:
    - Recursively scans GeoTIFFs under the target directory.
    - Detects offending CRS metadata strings.
    - Rewrites CRS metadata to EPSG:3857 (metadata-only fix; no reprojection).

Default target:
    $SCRATCH/data/south_america/ready   (if SCRATCH is set)
    otherwise:
    <repo>/data/south_america/ready
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path

import numpy as np
import rasterio
from rasterio.crs import CRS
from rasterio.warp import transform as warp_transform


def get_default_root() -> Path:
    script_dir = Path(__file__).resolve().parent
    project_root = script_dir.parents[3]
    if "SCRATCH" in os.environ:
        return Path(os.environ["SCRATCH"]) / "data" / "south_america" / "ready"
    return project_root / "data" / "south_america" / "ready"


def crs_text(crs_obj) -> str:
    if crs_obj is None:
        return ""
    text = str(crs_obj)
    try:
        text += " " + crs_obj.to_json()
    except Exception:
        pass
    return text


def is_aligned_to_reference(src, ref_shape, ref_transform, ref_crs) -> bool:
    return (
        src.shape == ref_shape
        and src.crs == ref_crs
        and np.allclose(tuple(src.transform), tuple(ref_transform), atol=1e-6)
    )


def fails_transform_to_3857(src_crs, target_crs) -> tuple[bool, str]:
    if src_crs is None:
        return True, "source CRS is None"
    try:
        warp_transform(src_crs, target_crs, [0.0], [0.0])
        return False, ""
    except Exception as e:
        return True, str(e)


def main() -> None:
    parser = argparse.ArgumentParser(description="Fix malformed EngineeringCRS metadata to EPSG:3857.")
    parser.add_argument(
        "--root",
        type=Path,
        default=get_default_root(),
        help="Root directory to scan (default: $SCRATCH/data/south_america/ready or local data path).",
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Apply fixes in-place. Without this flag, runs as dry-run.",
    )
    args = parser.parse_args()

    root = args.root.resolve()
    if not root.exists():
        raise FileNotFoundError(f"Target directory not found: {root}")

    tif_paths = sorted(root.rglob("*.tif"))
    print(f"[info] Scan root: {root}")
    print(f"[info] Found {len(tif_paths)} GeoTIFF files")
    print(f"[info] Mode: {'APPLY' if args.apply else 'DRY-RUN'}")

    backbone_path = root / "backbone" / "backbone.tif"
    if not backbone_path.exists():
        raise FileNotFoundError(f"Reference backbone not found: {backbone_path}")

    with rasterio.open(backbone_path) as ref:
        ref_shape = ref.shape
        ref_transform = ref.transform
        ref_crs = ref.crs

    offending = []
    fixed = 0
    errors = 0
    target_crs = CRS.from_epsg(3857)

    for p in tif_paths:
        try:
            with rasterio.open(p) as src:
                crs = src.crs
                if is_aligned_to_reference(src, ref_shape, ref_transform, ref_crs):
                    # Merge won't reproject aligned rasters; skip them.
                    continue
                failed_transform, fail_reason = fails_transform_to_3857(crs, target_crs)

            if not failed_transform:
                continue

            text = crs_text(crs)
            offending.append((p, text, fail_reason))
            print(f"[bad] {p}")
            print(f"      reason: {fail_reason}")
            print(f"      CRS: {text}")

            if args.apply:
                with rasterio.open(p, "r+") as dst:
                    dst.crs = target_crs
                fixed += 1
                print("      -> rewritten CRS to EPSG:3857")
        except Exception as e:
            errors += 1
            print(f"[error] {p}: {e}")

    print("")
    print("[summary]")
    print(f"  Offending files: {len(offending)}")
    print(f"  Fixed files:     {fixed}")
    print(f"  Errors:          {errors}")

    if not args.apply and offending:
        print("")
        print("[hint] Re-run with --apply to fix files in-place.")


if __name__ == "__main__":
    main()

