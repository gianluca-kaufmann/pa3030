#!/usr/bin/env python3
"""
Policy Variables Preprocessing
==============================

Objective:
    Convert raw institutional / political datasets (WGI, V-Dem, DPI) into
    per-variable per-year rasters aligned to the backbone grid.  Each pixel
    receives the policy value of the country it belongs to.  This makes
    policy data consistent with all other preprocessed features — the merge
    script can discover and stack them like any other yearly raster.

Source data (global, in ``data/shared/``):
    - WGI:  ``WGI/wgidataset_with_sourcedata-2025 (1).xlsx`` (sheets ``ge``, ``rl``)
    - V-Dem: ``VDem/V-Dem-CY-Core-v15.csv``  (column ``v2x_libdem``)
    - DPI:   ``DPI/DPI2020.csv``  (column ``execrlc``)

Region-specific inputs:
    - Backbone raster: ``data/south_america/ready/backbone/backbone.tif``
    - Natural Earth admin-0 boundaries (downloaded or built-in)

Outputs (in ``data/south_america/ready/policy/``):
    Per-variable per-year rasters (float32, backbone-aligned):
    - ``wgi_ge_YYYY.tif``            : WGI Government Effectiveness (~-2.5 to +2.5)
    - ``wgi_rl_YYYY.tif``            : WGI Rule of Law (~-2.5 to +2.5)
    - ``vdem_ldi_YYYY.tif``          : V-Dem Liberal Democracy Index (0–1)
    - ``dpi_exec_ideology_YYYY.tif`` : DPI Executive ideology (-1=Left, 0=Center, +1=Right)

    Auxiliary files:
    - ``country_iso3.tif``           : uint8 country-ID raster (for debugging)
    - ``country_iso3_mapping.json``  : JSON {id: iso3} mapping

Country coverage (13 South America countries):
    ARG, BOL, BRA, CHL, COL, ECU, GUF, GUY, PRY, PER, SUR, URY, VEN

Notes:
    - GUF (French Guiana) is a French territory; GUF pixels receive FRA's
      policy values.  GUF has no V-Dem or DPI data — those rasters will
      contain NaN for GUF pixels in affected years.
    - DPI data ends in 2020; later years have NaN for dpi_exec_ideology.
    - Rasters contain the actual (un-lagged) values for each year.
      Any lag (e.g., t-1) should be applied downstream (feature engineering).
"""

from __future__ import annotations

import json
import os
import re
import warnings
from pathlib import Path

import geopandas as gpd
import numpy as np
import pandas as pd
import rasterio
from rasterio.features import rasterize

warnings.filterwarnings("ignore")

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

PROJECT_ROOT = Path(__file__).resolve().parents[4]
DATA_DIR = PROJECT_ROOT / "data"
READY_DIR = DATA_DIR / "south_america" / "ready"

# Input paths (global raw data in shared/)
WGI_PATH = DATA_DIR / "shared" / "WGI" / "wgidataset_with_sourcedata-2025 (1).xlsx"
VDEM_PATH = DATA_DIR / "shared" / "VDem" / "V-Dem-CY-Core-v15.csv"
DPI_PATH = DATA_DIR / "shared" / "DPI" / "DPI2020.csv"
BACKBONE_PATH = READY_DIR / "backbone" / "backbone.tif"

# Output directory
OUTPUT_DIR = READY_DIR / "policy"

# Policy variable definitions: (column_name, output_prefix)
POLICY_VARIABLES = [
    "wgi_ge",
    "wgi_rl",
    "vdem_ldi",
    "dpi_exec_ideology",
]

# The 13 South America territories whose pixels appear in the backbone
SA_TERRITORIES = [
    "ARG", "BOL", "BRA", "CHL", "COL", "ECU",
    "GUF", "GUY", "PRY", "PER", "SUR", "URY", "VEN",
]

# ISO3 codes for which we extract policy data.
# French Guiana (GUF) is a French overseas territory — it has no V-Dem or DPI
# data of its own.  We include FRA so that GUF pixels receive French policy
# values via the country-id mapping below.
SA_POLICY_ISO3 = [
    "ARG", "BOL", "BRA", "CHL", "COL", "ECU",
    "FRA", "GUY", "PRY", "PER", "SUR", "URY", "VEN",
]

# Fixed mapping: uint8 country id -> ISO3 used for the policy lookup.
# GUF pixels (id 7) map to FRA because French Guiana is governed by
# France's institutions (same government effectiveness, rule of law, etc.).
# 0 = no country / outside SA.
SA_COUNTRY_ID = {
     1: "ARG",  2: "BOL",  3: "BRA",  4: "CHL",
     5: "COL",  6: "ECU",  7: "FRA",  8: "GUY",
     9: "PRY", 10: "PER", 11: "SUR", 12: "URY",
    13: "VEN",
}
SA_ISO3_TO_ID = {v: k for k, v in SA_COUNTRY_ID.items()}

# Year range for output rasters.
YEAR_MIN = 2000
YEAR_MAX = 2024

# Natural Earth 10m admin-0 map-units shapefile URL
NE_10M_URL = (
    "https://naciscdn.org/naturalearth/10m/cultural/"
    "ne_10m_admin_0_map_units.zip"
)

# Backbone CRS equivalent
BACKBONE_CRS_EPSG = "EPSG:3857"


# ---------------------------------------------------------------------------
# Policy table construction (internal — not saved as output)
# ---------------------------------------------------------------------------

def load_wgi() -> pd.DataFrame:
    """Read WGI Government Effectiveness (ge) and Rule of Law (rl) sheets."""
    print("Loading WGI data...")
    dfs = []
    for sheet, col_name in [("ge", "wgi_ge"), ("rl", "wgi_rl")]:
        df = pd.read_excel(
            WGI_PATH,
            sheet_name=sheet,
            usecols=["Economy (code)", "Year",
                      "Governance estimate (approx. -2.5 to +2.5)"],
        )
        df = df.rename(columns={
            "Economy (code)": "iso3",
            "Year": "year",
            "Governance estimate (approx. -2.5 to +2.5)": col_name,
        })
        df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
        dfs.append(df)

    merged = dfs[0].merge(dfs[1], on=["iso3", "year"], how="outer")
    merged = merged.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  WGI: {len(merged)} rows, "
          f"years {merged['year'].min()}-{merged['year'].max()}, "
          f"{merged['iso3'].nunique()} countries")
    return merged


def load_vdem() -> pd.DataFrame:
    """Read V-Dem Liberal Democracy Index (v2x_libdem)."""
    print("Loading V-Dem data...")
    df = pd.read_csv(VDEM_PATH, usecols=["country_text_id", "year", "v2x_libdem"])
    df = df.rename(columns={"country_text_id": "iso3", "v2x_libdem": "vdem_ldi"})
    df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
    df = df.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  V-Dem: {len(df)} rows, "
          f"years {df['year'].min()}-{df['year'].max()}, "
          f"{df['iso3'].nunique()} countries")
    return df


def load_dpi() -> pd.DataFrame:
    """Read DPI Chief Executive Party ideology (execrlc)."""
    print("Loading DPI data...")
    df = pd.read_csv(DPI_PATH, usecols=["ifs", "year", "execrlc"], encoding="latin-1")
    df = df.rename(columns={"ifs": "iso3"})
    df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
    ideology_map = {"Left": -1.0, "Center": 0.0, "Right": 1.0}
    df["dpi_exec_ideology"] = df["execrlc"].map(ideology_map)
    df = df.drop(columns=["execrlc"])
    df = df.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  DPI: {len(df)} rows, "
          f"years {df['year'].min()}-{df['year'].max()}, "
          f"{df['iso3'].nunique()} countries")
    return df


def build_policy_table() -> pd.DataFrame:
    """Merge WGI, V-Dem, and DPI into a single (iso3, year) table."""
    print("\nBuilding policy table...")
    wgi = load_wgi()
    vdem = load_vdem()
    dpi = load_dpi()

    policy = wgi.merge(vdem, on=["iso3", "year"], how="outer")
    policy = policy.merge(dpi, on=["iso3", "year"], how="outer")

    policy = policy[policy["iso3"].isin(SA_POLICY_ISO3)].copy()
    policy["year"] = policy["year"].astype(int)
    for col in POLICY_VARIABLES:
        if col in policy.columns:
            policy[col] = policy[col].astype("float32")

    policy = policy.sort_values(["iso3", "year"]).reset_index(drop=True)

    print(f"\nPolicy table: {len(policy)} rows, "
          f"{policy['iso3'].nunique()} countries, "
          f"years {policy['year'].min()}-{policy['year'].max()}")
    for col in POLICY_VARIABLES:
        n_miss = policy[col].isna().sum()
        print(f"  {col}: {n_miss} missing ({100 * n_miss / len(policy):.1f}%)")

    return policy


# ---------------------------------------------------------------------------
# Country-code raster
# ---------------------------------------------------------------------------

def load_natural_earth() -> gpd.GeoDataFrame:
    """Load Natural Earth 10m admin-0 countries, filtered to South America."""
    print("\nLoading Natural Earth 10m admin-0 shapefile...")
    try:
        gdf = gpd.read_file(NE_10M_URL)
        print(f"  Downloaded 10m shapefile: {len(gdf)} features")
    except Exception as e:
        print(f"  Failed to download 10m shapefile: {e}")
        print("  Falling back to geopandas built-in naturalearth_lowres...")
        gdf = gpd.read_file(gpd.datasets.get_path("naturalearth_lowres"))
        print(f"  Loaded low-res shapefile: {len(gdf)} features")

    iso3_col = None
    for candidate in ["GU_A3", "ADM0_A3", "ISO_A3", "iso_a3"]:
        if candidate in gdf.columns:
            iso3_col = candidate
            break
    if iso3_col is None:
        raise ValueError(f"Cannot find ISO3 column. Available: {list(gdf.columns)}")
    print(f"  Using ISO3 column: {iso3_col}")

    gdf_sa = gdf[gdf[iso3_col].isin(SA_TERRITORIES)].copy()

    if "GUF" not in gdf_sa[iso3_col].values:
        print("  Warning: GUF (French Guiana) not found via primary column.")
        for col in ["ADM0_A3", "SU_A3", "GU_A3"]:
            if col in gdf.columns and col != iso3_col:
                guf_rows = gdf[gdf[col] == "GUF"]
                if len(guf_rows) > 0:
                    guf_rows = guf_rows.copy()
                    guf_rows[iso3_col] = "GUF"
                    gdf_sa = pd.concat([gdf_sa, guf_rows], ignore_index=True)
                    print(f"  Found GUF via column {col}")
                    break

    gdf_sa = gdf_sa[[iso3_col, "geometry"]].rename(columns={iso3_col: "iso3"})
    print(f"  SA territories found: {sorted(gdf_sa['iso3'].unique())}")
    missing = set(SA_TERRITORIES) - set(gdf_sa["iso3"].unique())
    if missing:
        print(f"  Warning: Missing territories: {missing}")

    return gdf_sa


def create_country_raster(gdf_sa: gpd.GeoDataFrame) -> tuple[np.ndarray, dict]:
    """Rasterize SA country polygons onto the backbone grid.

    Returns the uint8 country-ID raster and the backbone profile.
    """
    print("\nCreating country-code raster...")

    if not BACKBONE_PATH.exists():
        raise FileNotFoundError(
            f"Backbone raster not found: {BACKBONE_PATH}. "
            "Run backbone_preprocessing first."
        )

    with rasterio.open(BACKBONE_PATH) as src:
        profile = src.profile.copy()
        backbone_transform = src.transform
        backbone_shape = (src.height, src.width)
        backbone_data = src.read(1)

    print(f"  Backbone: {backbone_shape}")

    if gdf_sa.crs is None:
        gdf_sa = gdf_sa.set_crs("EPSG:4326")
    gdf_proj = gdf_sa.to_crs(BACKBONE_CRS_EPSG)
    print(f"  Reprojected {len(gdf_proj)} country polygons to {BACKBONE_CRS_EPSG}")

    territory_to_id = {v: k for k, v in SA_COUNTRY_ID.items()}
    territory_to_id["GUF"] = territory_to_id.pop("FRA")
    shapes = []
    for _, row in gdf_proj.iterrows():
        cid = territory_to_id.get(row["iso3"])
        if cid is not None:
            shapes.append((row.geometry, cid))
    if not shapes:
        raise ValueError("No valid country geometries to rasterize.")

    country_raster = rasterize(
        shapes, out_shape=backbone_shape, transform=backbone_transform,
        fill=0, dtype=np.uint8, all_touched=True,
    )
    country_raster[backbone_data == 0] = 0

    total_land = int((backbone_data == 1).sum())
    assigned = int((country_raster > 0).sum())
    unassigned = total_land - assigned
    print(f"  Land pixels: {total_land:,}")
    print(f"  Assigned to country: {assigned:,} ({100 * assigned / total_land:.1f}%)")
    if unassigned > 0:
        print(f"  Unassigned: {unassigned:,} ({100 * unassigned / total_land:.1f}%)")

    for cid, iso3 in sorted(SA_COUNTRY_ID.items()):
        n = int((country_raster == cid).sum())
        if n > 0:
            print(f"    {iso3} (id={cid:2d}): {n:>10,} pixels")

    return country_raster, profile


def save_country_raster(country_raster: np.ndarray, profile: dict) -> None:
    """Write the country-code raster and JSON mapping as auxiliary files."""
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    raster_path = OUTPUT_DIR / "country_iso3.tif"
    out_profile = profile.copy()
    out_profile.update(dtype="uint8", nodata=0, compress="lzw", count=1)
    with rasterio.open(raster_path, "w", **out_profile) as dst:
        dst.write(country_raster, 1)
    print(f"  Saved auxiliary country raster: {raster_path}")

    mapping_path = OUTPUT_DIR / "country_iso3_mapping.json"
    mapping_dict = {str(k): v for k, v in SA_COUNTRY_ID.items()}
    with open(mapping_path, "w") as f:
        json.dump(mapping_dict, f, indent=2)
    print(f"  Saved auxiliary country mapping: {mapping_path}")


# ---------------------------------------------------------------------------
# Rasterize policy variables
# ---------------------------------------------------------------------------

def rasterize_policy_variables(
    policy_table: pd.DataFrame,
    country_raster: np.ndarray,
    profile: dict,
) -> None:
    """Create per-variable per-year TIF rasters.

    For each variable and each year in [YEAR_MIN, YEAR_MAX], every pixel
    receives the value of the variable for that pixel's country.  Pixels
    with no country (country_raster == 0) or missing data are set to NaN.
    """
    print("\nRasterizing policy variables...")
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    # Build a fast lookup: (iso3, year) -> {var: value}
    # Then map via country_raster (country_id -> iso3 -> value)
    id_to_iso3 = SA_COUNTRY_ID  # {1: "ARG", ...}

    out_profile = profile.copy()
    out_profile.update(
        dtype="float32", nodata=np.nan, compress="lzw",
        count=1, tiled=True, blockxsize=512, blockysize=512,
    )

    total_files = 0
    years = list(range(YEAR_MIN, YEAR_MAX + 1))

    for var in POLICY_VARIABLES:
        print(f"\n  Variable: {var}")
        files_written = 0

        for year in years:
            raster = np.full(country_raster.shape, np.nan, dtype=np.float32)

            for cid, iso3 in id_to_iso3.items():
                # Look up value for this country + year
                mask = country_raster == cid
                if not mask.any():
                    continue

                row = policy_table[
                    (policy_table["iso3"] == iso3) & (policy_table["year"] == year)
                ]
                if not row.empty and var in row.columns:
                    val = row.iloc[0][var]
                    if pd.notna(val):
                        raster[mask] = float(val)
                # If no data, pixels stay NaN

            out_path = OUTPUT_DIR / f"{var}_{year}.tif"
            with rasterio.open(out_path, "w", **out_profile) as dst:
                dst.write(raster, 1)
            files_written += 1
            total_files += 1

        # Report coverage for this variable
        valid_years = policy_table[policy_table[var].notna()]["year"]
        yr_range = f"{int(valid_years.min())}-{int(valid_years.max())}" if len(valid_years) > 0 else "none"
        print(f"    {files_written} rasters written ({YEAR_MIN}-{YEAR_MAX}), "
              f"data available for {yr_range}")

    print(f"\nTotal: {total_files} policy rasters written to {OUTPUT_DIR}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    print("Policy Variables Preprocessing — South America")
    print("=" * 60)
    print(f"Input:  {DATA_DIR / 'shared'} (WGI, VDem, DPI)")
    print(f"Output: {OUTPUT_DIR}")
    print()

    # Step 1: Build policy lookup table (internal, not saved)
    policy = build_policy_table()

    # Step 2: Create country raster (for pixel -> country mapping)
    gdf_sa = load_natural_earth()
    country_raster, profile = create_country_raster(gdf_sa)

    # Step 3: Save auxiliary files (country raster + mapping)
    save_country_raster(country_raster, profile)

    # Step 4: Rasterize all policy variables
    rasterize_policy_variables(policy, country_raster, profile)

    print("\n" + "=" * 60)
    print("Policy preprocessing complete.")
    print(f"Upload {OUTPUT_DIR.name}/ to Euler:")
    print(f"  $SCRATCH/data/south_america/ready/policy/")


if __name__ == "__main__":
    main()
