PROJECT_ROOT = Path(__file__).resolve().parents[4]
DATA_DIR = PROJECT_ROOT / "data"
READY_DIR = DATA_DIR / "south_america" / "ready"

# Input paths (global raw data in shared/)
# WGI: accept both the original name with "(1)" and the plain download name
_wgi_candidates = [
    DATA_DIR / "shared" / "WGI" / "wgidataset_with_sourcedata-2025 (1).xlsx",
    DATA_DIR / "shared" / "WGI" / "wgidataset_with_sourcedata-2025.xlsx",
]
WGI_PATH = next((p for p in _wgi_candidates if p.exists()), _wgi_candidates[0])

VDEM_PATH = DATA_DIR / "shared" / "VDem" / "V-Dem-CY-Core-v15.csv"

# DPI: accept both CSV (original) and XLSX (alternative download format)
_dpi_candidates = [
    DATA_DIR / "shared" / "DPI" / "DPI2020.csv",
    DATA_DIR / "shared" / "DPI" / "DPI2020.xlsx",
]
DPI_PATH = next((p for p in _dpi_candidates if p.exists()), _dpi_candidates[0])
BACKBONE_PATH = READY_DIR / "backbone" / "backbone.tif"

# Output directory
OUTPUT_DIR = READY_DIR / "policy"

# Policy variable definitions: (column_name, output_prefix)
POLICY_VARIABLES = [
    "wgi_ge",
    "wgi_rl",
    "vdem_ldi",
    "dpi_exec_ideology",
]

# The 13 South America territories whose pixels appear in the backbone
SA_TERRITORIES = [
    "ARG", "BOL", "BRA", "CHL", "COL", "ECU",
    "GUF", "GUY", "PRY", "PER", "SUR", "URY", "VEN",
]

# ISO3 codes for which we extract policy data.
# French Guiana (GUF) is a French overseas territory — it has no V-Dem or DPI
# data of its own.  We include FRA so that GUF pixels receive French policy
# values via the country-id mapping below.
SA_POLICY_ISO3 = [
    "ARG", "BOL", "BRA", "CHL", "COL", "ECU",
    "FRA", "GUY", "PRY", "PER", "SUR", "URY", "VEN",
]

# Fixed mapping: uint8 country id -> ISO3 used for the policy lookup.
# GUF pixels (id 7) map to FRA because French Guiana is governed by
# France's institutions (same government effectiveness, rule of law, etc.).
# 0 = no country / outside SA.
SA_COUNTRY_ID = {
     1: "ARG",  2: "BOL",  3: "BRA",  4: "CHL",
     5: "COL",  6: "ECU",  7: "FRA",  8: "GUY",
     9: "PRY", 10: "PER", 11: "SUR", 12: "URY",
    13: "VEN",
}
SA_ISO3_TO_ID = {v: k for k, v in SA_COUNTRY_ID.items()}

# Year range for output rasters.
YEAR_MIN = 2000
YEAR_MAX = 2024

# Natural Earth 10m admin-0 map-units shapefile URL
NE_10M_URL = (
    "https://naciscdn.org/naturalearth/10m/cultural/"
    "ne_10m_admin_0_map_units.zip"
)

# Backbone CRS equivalent
BACKBONE_CRS_EPSG = "EPSG:3857"


# ---------------------------------------------------------------------------
# Policy table construction (internal — not saved as output)
# ---------------------------------------------------------------------------

def load_wgi() -> pd.DataFrame:
    """Read WGI Government Effectiveness (ge) and Rule of Law (rl) sheets."""
    print("Loading WGI data...")

    # The WGI Excel column for the governance estimate can change name across
    # file versions.  Try the canonical name first, then fall back to the first
    # column whose name contains "estimate" (case-insensitive).
    ESTIMATE_COL_CANONICAL = "Governance estimate (approx. -2.5 to +2.5)"

    def _find_estimate_col(df: pd.DataFrame, sheet: str) -> str:
        if ESTIMATE_COL_CANONICAL in df.columns:
            return ESTIMATE_COL_CANONICAL
        candidates = [c for c in df.columns if "estimate" in c.lower()]
        if candidates:
            print(f"  Warning: WGI sheet '{sheet}' — canonical column not found; "
                  f"using '{candidates[0]}' instead.")
            return candidates[0]
        raise KeyError(
            f"Cannot find governance estimate column in WGI sheet '{sheet}'. "
            f"Available columns: {list(df.columns)}"
        )

    dfs = []
    for sheet, col_name in [("ge", "wgi_ge"), ("rl", "wgi_rl")]:
        df_raw = pd.read_excel(WGI_PATH, sheet_name=sheet)
        estimate_col = _find_estimate_col(df_raw, sheet)
        df = df_raw[["Economy (code)", "Year", estimate_col]].copy()
        df = df.rename(columns={
            "Economy (code)": "iso3",
            "Year": "year",
            estimate_col: col_name,
        })
        df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
        dfs.append(df)

    merged = dfs[0].merge(dfs[1], on=["iso3", "year"], how="outer")
    merged = merged.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  WGI: {len(merged)} rows, "
          f"years {merged['year'].min()}-{merged['year'].max()}, "
          f"{merged['iso3'].nunique()} countries")
    return merged


def load_vdem() -> pd.DataFrame:
    """Read V-Dem Liberal Democracy Index (v2x_libdem)."""
    print("Loading V-Dem data...")
    df = pd.read_csv(VDEM_PATH, usecols=["country_text_id", "year", "v2x_libdem"])
    df = df.rename(columns={"country_text_id": "iso3", "v2x_libdem": "vdem_ldi"})
    df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
    df = df.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  V-Dem: {len(df)} rows, "
          f"years {df['year'].min()}-{df['year'].max()}, "
          f"{df['iso3'].nunique()} countries")
    return df


def load_dpi() -> pd.DataFrame:
    """Read DPI Chief Executive Party ideology (execrlc).

    Accepts both CSV (original download) and XLSX (alternative download format).
    When read from XLSX, the year column comes as datetime64 and is converted to int.

    The ``ifs`` column may contain ISO3 strings or ISO-3166 numeric codes; both are
    normalized before filtering to the regional country list.
    """
    print("Loading DPI data...")
    suffix = DPI_PATH.suffix.lower()
    if suffix == ".csv":
        df = pd.read_csv(DPI_PATH, usecols=["ifs", "year", "execrlc"], encoding="latin-1")
    else:
        df = pd.read_excel(DPI_PATH, usecols=["ifs", "year", "execrlc"])
        # Excel stores the year column as datetime; extract the integer year
        if pd.api.types.is_datetime64_any_dtype(df["year"]):
            df["year"] = df["year"].dt.year
    df["year"] = pd.to_numeric(df["year"], errors="coerce").dropna().astype(int)
    df["iso3"] = normalize_dpi_ifs_to_iso3(df["ifs"])
    df = df.drop(columns=["ifs"])
    df = df[df["iso3"].isin(SA_POLICY_ISO3)].copy()
    df["dpi_exec_ideology"] = dpi_execrlc_to_ideology(df["execrlc"])
    df = df.drop(columns=["execrlc"])
    df = df.sort_values(["iso3", "year"]).reset_index(drop=True)
    print(f"  DPI: {len(df)} rows, "
          f"years {df['year'].min()}-{df['year'].max()}, "
          f"{df['iso3'].nunique()} countries")
    return df


def build_policy_table() -> pd.DataFrame:
    """Merge WGI, V-Dem, and DPI into a single (iso3, year) table."""
    print("\nBuilding policy table...")
    wgi = load_wgi()
    vdem = load_vdem()
    dpi = load_dpi()

    policy = wgi.merge(vdem, on=["iso3", "year"], how="outer")
    policy = policy.merge(dpi, on=["iso3", "year"], how="outer")

    policy = policy[policy["iso3"].isin(SA_POLICY_ISO3)].copy()
    policy["year"] = policy["year"].astype(int)
    for col in POLICY_VARIABLES:
        if col in policy.columns:
            policy[col] = policy[col].astype("float32")

    # Expand to a complete (iso3, year) grid for YEAR_MIN..YEAR_MAX so that
    # biennial WGI gaps (e.g. 2001 is absent from WGI) are filled by carry-forward
    # from the most recent available value. DPI is separately forward-filled so
    # 2021+ keeps the last observed executive-ideology value.
    all_iso3 = sorted(policy["iso3"].unique())
    full_idx = pd.MultiIndex.from_product(
        [all_iso3, list(range(YEAR_MIN, YEAR_MAX + 1))],
        names=["iso3", "year"],
    )
    policy = (
        policy
        .set_index(["iso3", "year"])
        .reindex(full_idx)
        .reset_index()
    )
    # Forward/back-fill WGI and V-Dem (biennial gaps, edges).
    wgi_vdem_cols = [c for c in ["wgi_ge", "wgi_rl", "vdem_ldi"] if c in policy.columns]
    if wgi_vdem_cols:
        policy[wgi_vdem_cols] = (
            policy.groupby("iso3")[wgi_vdem_cols]
            .transform(lambda s: s.ffill().bfill())
        )

    apply_dpi_executive_forward_fill(policy)

    policy = policy.sort_values(["iso3", "year"]).reset_index(drop=True)

    print(f"\nPolicy table: {len(policy)} rows, "
          f"{policy['iso3'].nunique()} countries, "
          f"years {policy['year'].min()}-{policy['year'].max()}")
    for col in POLICY_VARIABLES:
        n_miss = policy[col].isna().sum()
        print(f"  {col}: {n_miss} missing ({100 * n_miss / len(policy):.1f}%)")

    # Per-year coverage diagnostic — helps pinpoint data gaps
    print("\n  Per-year missingness (wgi_ge) — years with any NaN indicate WGI gaps:")
    wgi_by_year = policy.groupby("year")["wgi_ge"].apply(lambda s: s.isna().mean())
    for yr, pct in wgi_by_year.items():
        if yr >= YEAR_MIN and pct > 0:
            print(f"    {yr}: {pct * 100:.0f}% missing")

    return policy


