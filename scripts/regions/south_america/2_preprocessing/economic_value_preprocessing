#!/usr/bin/env python3
"""
Economic Value Preprocessing — South America
=============================================

Spatially allocates FAO national gross agricultural production value (GPV)
across cropland and pasture pixels derived from MODIS land cover data.

Inputs:
  - data/shared/FAO/value_agr_prod.csv
  - data/south_america/ready/landcover/  (MODIS IGBP rasters, 1 km, 2000-2024)
  - data/south_america/ready/backbone/backbone.tif
  - data/south_america/ready/policy/country_iso3.tif + country_iso3_mapping.json
    (preferred; fallback: Natural Earth 10 m admin boundaries)

Outputs:
  - data/south_america/ready/economic_value/economic_value_{year}.tif
    float32, LZW-compressed, tiled 512×512, nodata=NaN, 2000-2024
  - data/south_america/ready/economic_value/validation_totals.csv

Algorithm (see scripts/regions/shared/preprocessing/economic_value.py for details)
-----------------------------------------------------------------------
For each agricultural pixel i in country c at year y:

    value_usd_ha_i = FAO_GPV(c, y) * LC_WEIGHT[lc_class_i]
                     / Σ_j (LC_WEIGHT[lc_class_j] * 100 ha)

  Cropland pixels (IGBP 12, 14) → weight 1.0
  Pasture/rangeland pixels (IGBP 8, 9, 10) → weight 0.3
  All other pixels within country boundary → value 0
  Pixels outside all country boundaries → NaN

National totals are preserved exactly (to float32 precision).

French Guiana (GUF) note
------------------------
French Guiana is treated as a separate territory, not as metropolitan France.
It is assigned its own FAO production value (where available) or the mean of
Suriname (SUR) and Guyana (GUY) as a proxy. Any pre-existing policy raster
that labels GUF pixels as "FRA" is transparently remapped at load time.
"""

from __future__ import annotations

import sys
from pathlib import Path

# ── Import shared preprocessing ─────────────────────────────────────────────────

_shared = Path(__file__).resolve().parents[2] / "shared"
if str(_shared) not in sys.path:
    sys.path.insert(0, str(_shared))
from preprocessing.economic_value import (  # noqa: E402
    YEAR_MIN,
    YEAR_MAX,
    build_country_raster_from_natural_earth,
    build_fao_table,
    load_backbone,
    load_country_raster_from_policy,
    write_yearly_rasters,
)

# ── Paths ──────────────────────────────────────────────────────────────────────

PROJECT_ROOT = Path(__file__).resolve().parents[4]
DATA_DIR = PROJECT_ROOT / "data"
READY_DIR = DATA_DIR / "south_america" / "ready"
OUTPUT_DIR = READY_DIR / "economic_value"
LANDCOVER_DIR = READY_DIR / "landcover"
BACKBONE_PATH = READY_DIR / "backbone" / "backbone.tif"
VALUE_PATH = DATA_DIR / "shared" / "FAO" / "value_agr_prod.csv"
POLICY_RASTER = READY_DIR / "policy" / "country_iso3.tif"
POLICY_MAP = READY_DIR / "policy" / "country_iso3_mapping.json"

# ── Region constants ───────────────────────────────────────────────────────────

# Pixel ID 7 maps to GUF (French Guiana), never to metropolitan France.
SA_COUNTRY_ID: dict[int, str] = {
     1: "ARG",  2: "BOL",  3: "BRA",  4: "CHL",
     5: "COL",  6: "ECU",  7: "GUF",  8: "GUY",
     9: "PRY", 10: "PER", 11: "SUR", 12: "URY",
    13: "VEN",
}

SA_TERRITORIES: list[str] = list(SA_COUNTRY_ID.values())
SA_POLICY_ISO3: set[str] = set(SA_COUNTRY_ID.values())

# Natural Earth ISO3 column search order (10 m dataset uses GU_A3 for territories).
SA_NE_ISO3_COL_PREFERENCE: list[str] = ["GU_A3", "ADM0_A3", "ISO_A3", "iso_a3"]

# For GUF: use the mean of its nearest forested-economy neighbours as a proxy
# if FAO holds no direct data for French Guiana.
SA_PROXY_MAP: dict[str, list[str]] = {"GUF": ["SUR", "GUY"]}


# ── Country raster ─────────────────────────────────────────────────────────────


def get_country_raster(backbone, shape, transform, crs):
    """Load or build the country integer raster and id→ISO3 mapping.

    Preferred path: pre-built policy raster + JSON.
    Fallback: rasterise Natural Earth 10 m admin boundaries.

    In both cases, any pixel labelled "FRA" is remapped to "GUF" — the only
    French territory in South America is French Guiana, so no information is
    lost and values derived from metropolitan France are never assigned here.
    """
    result = load_country_raster_from_policy(POLICY_RASTER, POLICY_MAP)
    if result is None:
        return build_country_raster_from_natural_earth(
            backbone=backbone,
            shape=shape,
            transform=transform,
            crs=crs,
            territories=SA_TERRITORIES,
            country_id=SA_COUNTRY_ID,
            iso3_col_preference=SA_NE_ISO3_COL_PREFERENCE,
        )
    country_raster, id_to_iso3 = result
    # Remap FRA → GUF: the policy raster may have been built before this fix.
    id_to_iso3 = {k: ("GUF" if v == "FRA" else v) for k, v in id_to_iso3.items()}
    return country_raster, id_to_iso3


# ── Entry point ────────────────────────────────────────────────────────────────


def main() -> None:
    print("Economic Value Preprocessing — South America")
    print("=" * 60)

    if not VALUE_PATH.exists():
        raise FileNotFoundError(f"Missing FAO production value data: {VALUE_PATH}")
    if not LANDCOVER_DIR.exists():
        raise FileNotFoundError(
            f"Land-cover directory not found: {LANDCOVER_DIR}\n"
            "Run the MODIS land-cover extraction step first."
        )

    profile, backbone, transform, shape, crs = load_backbone(BACKBONE_PATH)
    country_raster, id_to_iso3 = get_country_raster(backbone, shape, transform, crs)
    print(f"Country IDs loaded: {id_to_iso3}")

    fao_df = build_fao_table(
        value_path=VALUE_PATH,
        policy_iso3=SA_POLICY_ISO3,
        year_min=YEAR_MIN,
        year_max=YEAR_MAX,
        proxy_map=SA_PROXY_MAP,
    )

    write_yearly_rasters(
        fao_df=fao_df,
        country_raster=country_raster,
        id_to_iso3=id_to_iso3,
        lc_dir=LANDCOVER_DIR,
        output_dir=OUTPUT_DIR,
        profile=profile,
        year_min=YEAR_MIN,
        year_max=YEAR_MAX,
    )

    print("\nDone.")


if __name__ == "__main__":
    main()
