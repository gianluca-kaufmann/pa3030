#!/usr/bin/env python3

"""ModelC Random Forest Hyperparameter Tuning Script (Colombia Dataset) - OPTIMIZED

Purpose: Perform hyperparameter tuning for a Random Forest model using
         the Colombia-specific tuning dataset (modelC_tuning_colombia.parquet)
         with strict temporal split.

Supports two split configurations:
- 'main': Train <= 2013, Earlystop 2014-2016
- 'robustness': Train <= 2012, Earlystop 2013-2015

Input:   `modelC_tuning_colombia.parquet` (from split-specific directory)
Output:  - rf_best_params_{split_version}.json (saved to training/ directory for use by modelC_RF)

Optimizations:
- Minimal logging overhead
- Aggressive memory management
- Optimized data loading with pyarrow
- Focused hyperparameter grid
- Removed feature importance computation (expensive on large datasets)
- Disabled W&B integration (can be re-enabled if needed)
"""

from __future__ import annotations

import argparse
import gc
import json
import os
import sys
import time
from copy import deepcopy
from datetime import datetime
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd
import wandb
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import RandomizedSearchCV, PredefinedSplit, train_test_split


# =============================================================================
# Configuration
# =============================================================================
RANDOM_STATE = 42

# Split configurations - must match sampling/training scripts
SPLIT_CONFIGS = {
    'main': {
        'train_year_max': 2013,
        'earlystop_year_min': 2014,
        'earlystop_year_max': 2016,
        'description': 'Main split: Train <=2013, Earlystop 2014-2016'
    },
    'robustness': {
        'train_year_max': 2012,
        'earlystop_year_min': 2013,
        'earlystop_year_max': 2015,
        'description': 'Robustness split: Train <=2012, Earlystop 2013-2015'
    }
}

MIN_YEAR = int(os.environ.get("TRANSITION_MIN_YEAR", "2001"))

# Columns to exclude from features
EXCLUDE_COLS = {
    "transition_01", "transition_01_win5", "WDPA_b1", "WDPA_prev",
    "x", "y", "row", "col", "year",
}

# RandomizedSearchCV configuration
N_ITER_RF = int(os.environ.get("N_ITER_RF", "100"))

# Temporal sample weights configuration
USE_TIME_WEIGHTS = (os.environ.get("USE_TIME_WEIGHTS", "0") == "1")

# Optimized Random Forest parameter grid (focused on most impactful parameters)
RF_PARAM_GRID = {
    "n_estimators": [50, 100],  # Reduced for faster tuning
    "max_depth": [10, 20, 30],  # Capped depths (avoid None unless dataset is very clean)
    "min_samples_leaf": [5, 20, 50],  # Reduced combinations
    "min_samples_split": [10, 50],  # Reduced combinations
    "max_features": ["sqrt", 0.3],  # Most effective options only
    "bootstrap": [True],
    "criterion": ["gini"],  # Gini is typically faster than log_loss
}

# Parallelism configuration
TUNING_PARALLEL_MODE = os.environ.get("TUNING_PARALLEL_MODE", "default")

# Random Forest fixed parameters
RF_FIXED_PARAMS_BASE = {
    "random_state": RANDOM_STATE,
    "class_weight": "balanced_subsample",
    "warm_start": False,  # warm_start doesn't help with RandomizedSearchCV
}


# =============================================================================
# Utility Functions
# =============================================================================


def get_n_jobs() -> int:
    """Get number of jobs from SLURM_CPUS_PER_TASK, returning -1 on missing/invalid values."""
    cpus = os.environ.get("SLURM_CPUS_PER_TASK")
    return int(cpus) if cpus else -1


def convert_numpy_types(obj: Any) -> Any:
    """Recursively convert NumPy types to native Python types for JSON serialization."""
    if isinstance(obj, np.integer):
        return int(obj)
    elif isinstance(obj, np.floating):
        return float(obj)
    elif isinstance(obj, np.bool_):
        return bool(obj)
    elif isinstance(obj, np.ndarray):
        return obj.tolist()
    elif isinstance(obj, dict):
        return {key: convert_numpy_types(value) for key, value in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [convert_numpy_types(item) for item in obj]
    elif obj is None or isinstance(obj, (str, int, float, bool)):
        return obj
    else:
        return str(obj) if not hasattr(obj, "item") else obj.item()


def get_feature_columns(df: pd.DataFrame) -> list:
    """Get valid feature columns, excluding identifiers and leakage columns."""
    exclude_lower = {c.lower() for c in EXCLUDE_COLS}
    feature_cols = [
        col for col in df.select_dtypes(include=["number", "bool"]).columns
        if col.lower() not in exclude_lower
    ]
    return feature_cols


def compute_temporal_weights(years: np.ndarray, min_year: int, max_year: int) -> np.ndarray:
    """Compute temporal sample weights linearly scaled from 0.5 at min_year to 1.0 at max_year."""
    if max_year == min_year:
        return np.ones_like(years, dtype=np.float32)
    weights = 0.5 + 0.5 * (years - min_year) / (max_year - min_year)
    return np.clip(weights, 0.5, 1.0).astype(np.float32)


def resolve_tuning_parquet(split_version: str) -> Path:
    """Locate modelC_tuning_colombia.parquet from split-specific directory (prefer $SCRATCH if present)."""
    repo_root = Path(__file__).resolve().parents[4]
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        # Check split-specific subdirectory in data/ml/tuning location on scratch
        candidates.append(scratch_root / f"data/ml/tuning/{split_version}/modelC_tuning_colombia.parquet")
        # Fallback to old location (for backward compatibility)
        candidates.append(scratch_root / "data/ml/tuning/modelC_tuning_colombia.parquet")
        # Also check outputs/south_america/colombia/results/tuning
        candidates.append(scratch_root / f"outputs/south_america/colombia/results/tuning/{split_version}/modelC_tuning_colombia.parquet")
    # Check split-specific subdirectory in repo
    candidates.append(repo_root / f"data/ml/tuning/{split_version}/modelC_tuning_colombia.parquet")
    # Fallback to old location (for backward compatibility)
    candidates.append(repo_root / "data/ml/tuning/modelC_tuning_colombia.parquet")
    candidates.append(repo_root / f"outputs/south_america/colombia/results/tuning/{split_version}/modelC_tuning_colombia.parquet")

    for cand in candidates:
        if cand.exists():
            return cand

    # Provide detailed error message with all checked paths
    error_msg = f"modelC_tuning_colombia.parquet not found for split '{split_version}'.\n"
    error_msg += "\nChecked locations:\n"
    for cand in candidates:
        error_msg += f"  - {cand}\n"
    if scratch_root:
        error_msg += f"\nSCRATCH root: {scratch_root}\n"
    error_msg += f"Repository root: {repo_root}\n"
    error_msg += f"\nHint: Run modelC_sample with --split-version {split_version} first.\n"
    raise FileNotFoundError(error_msg)


# =============================================================================
# Main Pipeline
# =============================================================================


def main(split_version: str = 'main', log_file: Path = None, use_wandb: bool = False) -> None:
    """Main tuning pipeline with optimized performance."""
    start_time = time.time()
    
    # Get split configuration
    if split_version not in SPLIT_CONFIGS:
        raise ValueError(f"Invalid split_version: {split_version}. Must be one of: {list(SPLIT_CONFIGS.keys())}")
    
    config = SPLIT_CONFIGS[split_version]
    TRAIN_YEAR_MAX = config['train_year_max']
    EARLYSTOP_YEAR_MIN = config['earlystop_year_min']
    EARLYSTOP_YEAR_MAX = config['earlystop_year_max']
    
    def log(msg: str) -> None:
        """Minimal logging function."""
        print(msg)
        if log_file:
            with open(log_file, "a") as f:
                f.write(msg + "\n")

    # -------------------------------------------------------------------------
    # Setup paths
    # -------------------------------------------------------------------------
    script_dir = Path(__file__).resolve().parent
    train_path = resolve_tuning_parquet(split_version)

    log("=" * 70)
    log(f"MODELC RF HYPERPARAMETER TUNING - SPLIT: {split_version.upper()}")
    log("=" * 70)
    log(f"Configuration: {config['description']}")
    log(f"Input:  {train_path}")

    # -------------------------------------------------------------------------
    # Step 1: Load data with optimizations
    # -------------------------------------------------------------------------
    log("\n[1/5] Loading data...")
    load_start = time.time()
    
    # Use pyarrow engine for faster loading with memory-mapped I/O
    try:
        df = pd.read_parquet(train_path, engine="pyarrow")
    except Exception:
        df = pd.read_parquet(train_path)
    
    # Immediate downcasting and filtering
    for col in df.select_dtypes(include=["float64"]).columns:
        df[col] = df[col].astype("float32")
    for col in df.select_dtypes(include=["int64"]).columns:
        if col != "year":  # Keep year as int for temporal operations
            df[col] = df[col].astype("int32")
    
    log(f"  Loaded {len(df):,} rows in {time.time() - load_start:.1f}s")

    # Clean data (vectorized operations)
    target_col = "transition_01_win5"
    if target_col not in df.columns:
        raise ValueError(f"Target column '{target_col}' not found")
    
    # Combined filtering in one pass
    df_clean = df[(df[target_col].notna()) & (df["year"] >= MIN_YEAR)].copy()
    log(f"  Cleaned: {len(df_clean):,} rows")
    
    # Get feature columns
    feature_cols = get_feature_columns(df_clean)
    log(f"  Features: {len(feature_cols)}")
    
    # Target distribution (minimal stats)
    pos = (df_clean[target_col] > 0).sum()
    log(f"  Positive class: {pos / len(df_clean) * 100:.3f}%")
    
    del df
    gc.collect()

    # -------------------------------------------------------------------------
    # Step 2: Create temporal split
    # -------------------------------------------------------------------------
    log("\n[2/5] Creating temporal split...")
    
    train_idx = df_clean["year"] <= TRAIN_YEAR_MAX
    earlystop_idx = (df_clean["year"] >= EARLYSTOP_YEAR_MIN) & (df_clean["year"] <= EARLYSTOP_YEAR_MAX)
    
    df_train = df_clean[train_idx].copy()
    df_earlystop = df_clean[earlystop_idx].copy()
    
    if len(df_train) == 0 or len(df_earlystop) == 0:
        raise ValueError(f"Empty split detected: train={len(df_train)}, val={len(df_earlystop)}")
    
    log(f"  Train: {len(df_train):,} rows (year <= {TRAIN_YEAR_MAX})")
    log(f"  Earlystop: {len(df_earlystop):,} rows ({EARLYSTOP_YEAR_MIN}-{EARLYSTOP_YEAR_MAX})")

    # -------------------------------------------------------------------------
    # Step 3: Prepare features and target
    # -------------------------------------------------------------------------
    log("\n[3/5] Preparing features and target...")
    
    # Extract features and target
    y_train = (df_train[target_col] > 0).astype(np.int8)
    X_train = df_train[feature_cols].values  # Convert to numpy for speed
    years_train = df_train["year"].values
    
    y_earlystop = (df_earlystop[target_col] > 0).astype(np.int8)
    X_earlystop = df_earlystop[feature_cols].values
    years_earlystop = df_earlystop["year"].values
    
    # Aggressive eval subsampling (200k max for faster tuning)
    EVAL_SUBSET_MAX_ROWS = 200_000
    n_earlystop_full = len(X_earlystop)
    if n_earlystop_full > EVAL_SUBSET_MAX_ROWS:
        indices_eval, _ = train_test_split(
            np.arange(n_earlystop_full),
            train_size=EVAL_SUBSET_MAX_ROWS,
            stratify=y_earlystop,
            random_state=RANDOM_STATE,
        )
        X_earlystop = X_earlystop[indices_eval]
        y_earlystop = y_earlystop.iloc[indices_eval].reset_index(drop=True)
        years_earlystop = years_earlystop[indices_eval]
        log(f"  Eval subset: {EVAL_SUBSET_MAX_ROWS:,} rows (from {n_earlystop_full:,})")
    
    n_train = len(X_train)
    n_earlystop = len(X_earlystop)
    
    # Free memory early
    del df_clean, df_train, df_earlystop
    gc.collect()

    # Combine datasets for RandomizedSearchCV
    X_combined = np.vstack([X_train, X_earlystop])
    y_combined = np.concatenate([y_train.values, y_earlystop.values])
    years_combined = np.concatenate([years_train, years_earlystop])
    split_indices = np.concatenate([
        np.full(n_train, -1, dtype=np.int32),
        np.zeros(n_earlystop, dtype=np.int32),
    ])
    predefined_split = PredefinedSplit(split_indices)
    
    # Compute temporal sample weights if enabled
    weights_combined = None
    if USE_TIME_WEIGHTS:
        weights_combined = compute_temporal_weights(years_combined, MIN_YEAR, EARLYSTOP_YEAR_MAX)
        log(f"  Temporal weights: ENABLED")
    
    # Calculate total parameter combinations
    total_combinations = np.prod([len(v) for v in RF_PARAM_GRID.values()])
    n_iter = min(N_ITER_RF, total_combinations)
    log(f"\n[4/5] Parameter grid: {total_combinations} combinations, testing {n_iter}")

    # -------------------------------------------------------------------------
    # Step 5: Random Forest hyperparameter tuning
    # -------------------------------------------------------------------------
    log("\n[5/5] Running hyperparameter tuning...")
    
    # Configure parallelism
    if TUNING_PARALLEL_MODE == "search":
        search_n_jobs = get_n_jobs()
        rf_n_jobs = 1
    else:
        search_n_jobs = 1
        rf_n_jobs = get_n_jobs()
    
    log(f"  Parallelism: search_jobs={search_n_jobs}, rf_jobs={rf_n_jobs}")
    
    # Create Random Forest model
    RF_FIXED_PARAMS = {**RF_FIXED_PARAMS_BASE, "n_jobs": rf_n_jobs}
    rf_model = RandomForestClassifier(**RF_FIXED_PARAMS)
    
    # Randomized search with progress logging
    log(f"  Starting {n_iter} iterations...")
    random_search_rf = RandomizedSearchCV(
        estimator=rf_model,
        param_distributions=RF_PARAM_GRID,
        n_iter=n_iter,
        cv=predefined_split,
        scoring="average_precision",
        n_jobs=search_n_jobs,
        verbose=2,  # Show progress for each iteration
        random_state=RANDOM_STATE,
        return_train_score=False,
        error_score="raise",  # Fail fast on errors
    )
    
    tune_start_rf = time.time()
    if USE_TIME_WEIGHTS:
        random_search_rf.fit(X_combined, y_combined, sample_weight=weights_combined)
    else:
        random_search_rf.fit(X_combined, y_combined)
    tune_time_rf = time.time() - tune_start_rf
    log(f"  Completed all {n_iter} iterations")
    
    best_earlystop_score_rf = random_search_rf.best_score_
    
    log(f"\n  Tuning completed in {tune_time_rf:.1f}s ({tune_time_rf/60:.1f} min)")
    log(f"  Best PR-AUC: {best_earlystop_score_rf:.4f}")
    log(f"  Best params: {random_search_rf.best_params_}")
    
    # Log to wandb
    if use_wandb:
        wandb.log(
            {
                "rf/best_earlystop_score": float(best_earlystop_score_rf),
                "rf/tuning_time_seconds": tune_time_rf,
                "rf/best_params": random_search_rf.best_params_,
                "rf/total_param_combinations": int(total_combinations),
                "rf/search_space_coverage_pct": float(n_iter / total_combinations * 100),
            }
        )
    
    # Save RF best parameters (minimal metadata)
    rf_best_params = {
        "split_version": split_version,
        "best_params": random_search_rf.best_params_,
        "best_earlystop_score": float(best_earlystop_score_rf),
        "param_grid": RF_PARAM_GRID,
        "fixed_params": RF_FIXED_PARAMS,
        "n_iter": n_iter,
        "scoring": "average_precision",
        "tuning_time_seconds": tune_time_rf,
        "total_param_combinations": int(total_combinations),
        "search_space_coverage_pct": float(n_iter / total_combinations * 100),
        "split_info": {
            "split_version": split_version,
            "train_years": f"year <= {TRAIN_YEAR_MAX}",
            "earlystop_years": f"{EARLYSTOP_YEAR_MIN} <= year <= {EARLYSTOP_YEAR_MAX}",
            "n_train": int(n_train),
            "n_earlystop": int(n_earlystop),
        },
    }
    rf_best_params = convert_numpy_types(rf_best_params)
    
    # Save to training directory with split-specific filename
    training_dir = script_dir.parent / "training"
    training_dir.mkdir(parents=True, exist_ok=True)
    rf_output_path = training_dir / f"rf_best_params_{split_version}.json"
    with open(rf_output_path, "w") as f:
        json.dump(rf_best_params, f, indent=2)
    log(f"  Saved to: {rf_output_path}")
    
    # Free memory
    del random_search_rf, rf_model, X_combined, y_combined
    gc.collect()
    
    # Summary
    total_time = time.time() - start_time
    log("\n" + "=" * 70)
    log("SUMMARY")
    log("=" * 70)
    log(f"Features: {len(feature_cols)}")
    log(f"Train/Val: {n_train:,} / {n_earlystop:,} rows")
    log(f"Best PR-AUC: {best_earlystop_score_rf:.4f}")
    log(f"Tuning time: {tune_time_rf:.1f}s ({tune_time_rf/60:.1f} min)")
    log(f"Total time: {total_time:.1f}s ({total_time/60:.1f} min)")
    log("=" * 70)
    
    if use_wandb:
        wandb.log(
            {
                "summary/total_time_seconds": total_time,
                "summary/total_time_minutes": total_time / 60,
                "summary/rf_best_earlystop_score": float(best_earlystop_score_rf),
                "summary/total_param_combinations": int(total_combinations),
                "status": "success",
            }
        )
        wandb.finish()


if __name__ == "__main__":
    # Parse command-line arguments
    parser = argparse.ArgumentParser(
        description="ModelC RF hyperparameter tuning"
    )
    parser.add_argument(
        "--split-version",
        type=str,
        choices=list(SPLIT_CONFIGS.keys()),
        default="main",
        help=f"Split configuration to use. Choices: {', '.join(SPLIT_CONFIGS.keys())} (default: main)"
    )
    args = parser.parse_args()
    
    # Get split config for W&B
    config = SPLIT_CONFIGS[args.split_version]
    
    # Set up output file
    repo_root = Path(__file__).resolve().parents[4]
    output_dir = repo_root / "outputs/south_america/colombia/results/ml_models"
    output_dir.mkdir(parents=True, exist_ok=True)
    
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    output_file = output_dir / f"modelC_tuning_rf_{args.split_version}_{timestamp}.txt"
    
    # Initialize W&B
    wandb_api_key = os.environ.get("WANDB_API_KEY")
    wandb_entity = os.environ.get("WANDB_ENTITY")
    if not wandb_api_key:
        print("Warning: WANDB_API_KEY not found in environment")
    if not wandb_entity:
        print("Warning: WANDB_ENTITY not found in environment (will use default)")
    
    use_wandb = False
    try:
        print("Initializing Weights & Biases...")
        wandb.init(
            project="ml-hyperparameter-tuning",
            entity=wandb_entity,
            name=f"modelC_tuning_rf_{args.split_version}_{timestamp}",
            config={
                "random_state": RANDOM_STATE,
                "split_version": args.split_version,
                "temporal_split": {
                    "train_year_max": config['train_year_max'],
                    "earlystop_year_min": config['earlystop_year_min'],
                    "earlystop_year_max": config['earlystop_year_max'],
                },
                "n_iter_rf": N_ITER_RF,
            },
        )
        use_wandb = True
        print("W&B connected\n")
    except Exception as err:
        print(f"W&B initialization failed: {err}\n")
    
    # Initialize log file
    with open(output_file, "w", encoding="utf-8") as f:
        f.write(f"Log started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"Split version: {args.split_version}\n")
        f.write("=" * 70 + "\n\n")
    
    try:
        main(split_version=args.split_version, log_file=output_file, use_wandb=use_wandb)
        print(f"\nOutput saved to: {output_file}")
    except Exception as e:
        print(f"\nERROR: {e}")
        with open(output_file, "a") as f:
            f.write(f"\nERROR: {e}\n")
        if use_wandb:
            wandb.log({"status": "error", "error": str(e)})
            wandb.finish()
        raise

