def check_year_overlap(train_years: tuple[int, int], eval_years: tuple[int, int], eval_name: str) -> bool:
    """
    Check if evaluation years overlap with training years.
    Returns True if there's overlap, False otherwise.
    """
    train_start, train_end = train_years
    eval_start, eval_end = eval_years
    
    # Check for overlap: eval years should be strictly after training years
    if eval_start <= train_end:
        print(f"\n{'!'*70}")
        print(f"WARNING: {eval_name} years ({eval_start}-{eval_end}) OVERLAP with training years ({train_start}-{train_end})!")
        print(f"  Evaluation years must be strictly after training years to avoid data leakage.")
        print(f"{'!'*70}\n")
        return True
    return False


def phase1_training(
    train_path: Path, earlystop_path: Path, params_path: Optional[Path], feature_cols: list, keep_cols_train: list,
    best_params: Dict[str, Any], timestamp: str, model_dir: Path, output_dir: Path, use_wandb: bool, target_col: str,
) -> tuple[Path, Dict[str, Any], Dict[str, Any], float, float, int, int, int, Dict[str, Any], Dict[str, Any], Dict[str, Any]]:
    """
    Phase 1: Training Balanced Random Forest model.
    
    First train on train data only and generate earlystop predictions for calibration.
    Then train final model on full train+earlystop data (2000-2017).
    
    Returns:
        Tuple including model path, stats, timing, and imbalance info
    """
    print("\n" + "="*70 + "\nPHASE 1: TRAINING BALANCED RANDOM FOREST MODEL\n" + "="*70)
    report_memory_usage("start of Phase 1")
    
    # Step 1: Train on train data only and generate earlystop predictions for calibration
    print("\n" + "-"*70)
    print("STEP 1: GENERATE EARLYSTOP PREDICTIONS FOR CALIBRATION")
    print("-"*70)
    print(f"Training intermediate model on train data only ({TRAIN_YEARS[0]}-{TRAIN_YEARS[1]})...")
    
    # Load train data only
    print(f"\nLoading train data ({TRAIN_YEARS[0]}-{TRAIN_YEARS[1]})...")
    X_train_only, y_train_only, train_years_array_only, train_pos_only, train_neg_only, train_years_only = load_numpy_arrays_two_pass(
        train_path, feature_cols, target_col, "train_only", 
        year_range=TRAIN_YEARS
    )
    n_train_only = len(y_train_only)
    
    # Note: No MAX_NEG_TRAIN downsampling for BRF - BalancedRandomForest handles imbalance via sampling_strategy
    
    # Prepare model parameters for train-only model
    model_params_intermediate = best_params.copy()
    model_params_intermediate["random_state"] = RANDOM_STATE
    if "n_jobs" not in model_params_intermediate:
        model_params_intermediate["n_jobs"] = get_n_jobs()
    # Remove any RF/LGBM-specific params that shouldn't be in BRF
    for key in ["class_weight", "scale_pos_weight", "is_unbalance", "num_boost_round", "num_threads", "verbose", "boosting_type", "objective", "metric"]:
        model_params_intermediate.pop(key, None)
    
    print(f"\nTraining intermediate model on {n_train_only:,} samples...")
    print(f"  Model parameters: n_estimators={model_params_intermediate.get('n_estimators', 'default')}, "
          f"max_depth={model_params_intermediate.get('max_depth', 'default')}, "
          f"min_samples_leaf={model_params_intermediate.get('min_samples_leaf', 'default')}, "
          f"sampling_strategy={model_params_intermediate.get('sampling_strategy', 'default')}")
    report_memory_usage("before intermediate training")
    intermediate_train_start = time.time()
    
    # Train intermediate model on train data only
    brf_model_intermediate = BalancedRandomForestClassifier(**model_params_intermediate)
    brf_model_intermediate.fit(X_train_only, y_train_only)
    
    intermediate_train_time = time.time() - intermediate_train_start
    print(f"Intermediate training done in {intermediate_train_time:.1f}s")
    
    del X_train_only, y_train_only, train_years_array_only; gc.collect()
    
    # Load earlystop data and generate predictions
    print(f"\nLoading earlystop data ({EARLYSTOP_YEARS[0]}-{EARLYSTOP_YEARS[1]}) for predictions...")
    earlystop_year_range = (EARLYSTOP_YEARS[0], min(EARLYSTOP_YEARS[1], LAST_LABEL_YEAR))
    X_earlystop, y_earlystop, earlystop_years_array, earlystop_pos, earlystop_neg, earlystop_years = load_numpy_arrays_two_pass(
        earlystop_path, feature_cols, target_col, "earlystop", 
        year_range=earlystop_year_range
    )
    n_earlystop = len(y_earlystop)
    
    print(f"\nGenerating predictions on earlystop set ({n_earlystop:,} samples)...")
    earlystop_pred_start = time.time()
    y_earlystop_proba = brf_model_intermediate.predict_proba(X_earlystop)[:, 1].astype(np.float32)
    earlystop_pred_time = time.time() - earlystop_pred_start
    print(f"Earlystop predictions generated in {earlystop_pred_time:.1f}s")
    
    # Save earlystop scored predictions for calibration
    print(f"\nSaving earlystop scored predictions for calibration...")
    earlystop_scored_path = output_dir / f"modelC_brf_win5_earlystop_scored_{timestamp}.parquet"
    
    # Load earlystop metadata to save with predictions
    parquet_file = pq.ParquetFile(earlystop_path)
    batch_size = BATCH_SIZE
    writer = None
    idx_offset = 0
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=keep_cols_train, use_threads=True):
            batch_table = batch
            null_mask = batch_table[target_col].is_null().to_numpy(zero_copy_only=False)
            valid_mask = ~null_mask
            if not valid_mask.any():
                del batch_table, batch
                continue
            
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            wdpa_prev_array = batch_table['WDPA_prev'].to_numpy(zero_copy_only=False)
            year_mask = (year_array >= earlystop_year_range[0]) & (year_array <= earlystop_year_range[1])
            risk_mask = (wdpa_prev_array == 0)
            final_mask = valid_mask & year_mask & risk_mask
            if not final_mask.any():
                del batch_table, year_array, wdpa_prev_array, batch
                continue
            
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            target_valid = target_array[final_mask]
            y_batch = (target_valid > 0).astype(np.int8)
            
            # Get predictions for this batch
            batch_size_actual = len(y_batch)
            y_proba_batch = y_earlystop_proba[idx_offset:idx_offset + batch_size_actual]
            
            # Extract metadata arrays
            row_array = batch_table['row'].to_numpy(zero_copy_only=False)[final_mask]
            col_array = batch_table['col'].to_numpy(zero_copy_only=False)[final_mask]
            year_array_valid = year_array[final_mask]
            
            result_arrays = {
                'row': row_array.astype(np.int32),
                'col': col_array.astype(np.int32),
                'year': year_array_valid.astype(np.int32),
                'y_true': y_batch,
                'y_pred_proba': y_proba_batch
            }
            
            # Add optional x, y coordinates if present
            for coord_col in ['x', 'y']:
                if coord_col in batch_table.column_names:
                    coord_array = batch_table[coord_col].to_numpy(zero_copy_only=False)[final_mask]
                    result_arrays[coord_col] = coord_array.astype(np.float32)
            
            result_table = pa.table(result_arrays)
            
            if writer is None:
                writer = pq.ParquetWriter(earlystop_scored_path, result_table.schema)
                print(f"Writing earlystop scored predictions to {earlystop_scored_path.name}")
            writer.write_table(result_table)
            
            idx_offset += batch_size_actual
            
            del batch_table, target_array, year_array, wdpa_prev_array, target_valid, y_batch, y_proba_batch
            del row_array, col_array, year_array_valid, result_arrays, result_table, batch
    finally:
        if writer is not None:
            writer.close()
        del parquet_file; gc.collect()
    
    if idx_offset != n_earlystop:
        raise ValueError(f"Mismatch: expected {n_earlystop:,} earlystop samples but processed {idx_offset:,}")
    
    print(f"Earlystop scored predictions saved: {earlystop_scored_path.name}")
    print(f"  {earlystop_neg:,} neg, {earlystop_pos:,} pos, ratio 1:{earlystop_neg/max(earlystop_pos,1):.1f}, years {earlystop_years[0]}-{earlystop_years[-1]}")
    
    del brf_model_intermediate, X_earlystop, y_earlystop, earlystop_years_array, y_earlystop_proba; gc.collect()
    earlystop_time = intermediate_train_time + earlystop_pred_time
    
    # Step 2: Train final model on full train+earlystop data
    print("\n" + "-"*70)
    print("STEP 2: TRAIN FINAL MODEL ON FULL DATASET")
    print("-"*70)
    print(f"Training final model on full dataset: {TRAIN_YEARS[0]}-{EARLYSTOP_YEARS[1]}")
    report_memory_usage("before final model training")
    
    # Load full training data (2000-2017) from both files
    print(f"\nLoading full training data ({TRAIN_YEARS[0]}-{EARLYSTOP_YEARS[1]})...")
    X_train_full, y_train_full, train_years_array_full, train_pos_full, train_neg_full, train_years_full = load_numpy_arrays_from_multiple_files(
        [train_path, earlystop_path], feature_cols, target_col, "full_train", 
        year_range=(TRAIN_YEARS[0], EARLYSTOP_YEARS[1])
    )
    n_train_full = len(y_train_full)
    
    # Note: No MAX_NEG_TRAIN downsampling for BRF - BalancedRandomForest handles imbalance via sampling_strategy
    
    train_stats = {
        "n_train": n_train_full,
        "train_positives": int(train_pos_full),
        "train_negatives": int(train_neg_full),
        "train_positive_pct": float(train_pos_full / max(n_train_full, 1) * 100.0),
        "train_years": f"{train_years_full[0]}-{train_years_full[-1]}",
    }
    report_memory_usage("after loading final data")
    
    print(f"\nFinal model training: train ({TRAIN_YEARS[0]}-{EARLYSTOP_YEARS[1]}): {len(X_train_full):,} rows")
    
    # Prepare model parameters (use best_params directly - already set with fixed BRF hyperparameters)
    model_params = best_params.copy()
    
    # Ensure random_state and n_jobs are set (should already be in best_params, but double-check)
    model_params["random_state"] = RANDOM_STATE
    if "n_jobs" not in model_params:
        model_params["n_jobs"] = get_n_jobs()
    
    # Remove any RF/LGBM-specific params that shouldn't be in BRF
    model_params.pop("class_weight", None)  # BRF doesn't use class_weight
    model_params.pop("scale_pos_weight", None)
    model_params.pop("is_unbalance", None)
    model_params.pop("num_boost_round", None)
    model_params.pop("num_threads", None)
    model_params.pop("verbose", None)
    model_params.pop("boosting_type", None)
    model_params.pop("objective", None)
    model_params.pop("metric", None)
    
    imbalance_info = {
        "neg": int(train_neg_full),
        "pos": int(train_pos_full),
        "sampling_strategy": model_params.get("sampling_strategy", 0.1)
    }
    
    print(f"\nImbalance: {train_neg_full:,} neg, {train_pos_full:,} pos, ratio 1:{train_neg_full/max(train_pos_full,1):.1f}")
    print(f"  Using BalancedRandomForest with sampling_strategy={model_params.get('sampling_strategy', 0.1)}")
    
    if use_wandb:
        # sampling_strategy can be a float or a string like "auto" for BalancedRandomForest;
        # log it as-is to avoid type casting errors.
        wandb.log({
            "final_model/imbalance/sampling_strategy": model_params.get("sampling_strategy", 0.1),
            "final_model/imbalance/neg": int(train_neg_full),
            "final_model/imbalance/pos": int(train_pos_full),
        })
    
    print(f"\nTraining final model on {len(X_train_full):,} samples...")
    print(f"  Model parameters: n_estimators={model_params.get('n_estimators', 'default')}, "
          f"max_depth={model_params.get('max_depth', 'default')}, "
          f"min_samples_leaf={model_params.get('min_samples_leaf', 'default')}, "
          f"sampling_strategy={model_params.get('sampling_strategy', 'default')}")
    report_memory_usage("before final training")
    train_start = time.time()
    
    # Create and train Balanced Random Forest model
    brf_model = BalancedRandomForestClassifier(**model_params)
    brf_model.fit(X_train_full, y_train_full)
    
    train_time = time.time() - train_start
    print(f"\nTraining done in {train_time:.1f}s")
    
    del X_train_full, y_train_full, train_years_array_full; gc.collect()
    
    # earlystop_time already set above (intermediate training + earlystop prediction time)
    
    model_path = model_dir / f"modelC_brf_win5_{timestamp}.joblib"
    joblib.dump(brf_model, model_path)
    print(f"Final model saved: {model_path}")
    gc.collect()
    
    if use_wandb:
        wandb.log({
            "final_model/data/n_features": len(feature_cols),
            "final_model/data/n_train": train_stats["n_train"],
            "final_model/data/train_positives": train_stats["train_positives"],
            "final_model/data/train_negatives": train_stats["train_negatives"],
            "final_model/data/train_positive_pct": train_stats["train_positive_pct"],
            "final_model/training/train_time_seconds": train_time,
            "final_model/training/train_time_minutes": train_time / 60,
        })
    
    print("Phase 1 completed.")
    cv_info = {}  # Empty CV info for RF (no CV needed)
    # Return None for earlystop_metrics - earlystop is not used for evaluation
    return (model_path, None, train_stats, train_time, earlystop_time, train_pos_full, train_neg_full, n_train_full, imbalance_info, cv_info, model_params)


def phase2_testing(
    test_path: Path, model_path: Path, feature_cols: list, keep_cols_test: list, timestamp: str, output_dir: Path,
    use_wandb: bool, target_col: str, earlystop_metrics: Optional[Dict[str, Any]], train_stats: Dict[str, Any],
    train_time: float, earlystop_time: float, train_pos: int, train_neg: int, n_train_full: int,
    best_params: Dict[str, Any], model_params: Dict[str, Any], start_time: float, imbalance_info: Dict[str, Any], cv_info: Dict[str, Any],
) -> None:
    """Phase 2: Testing - loads test in batches, loads model, evaluates."""
    print("\n" + "="*70 + "\nPHASE 2: TESTING\n" + "="*70)
    report_memory_usage("start of Phase 2")
    
    # Check for year overlap between training and test
    final_train_years = (TRAIN_YEARS[0], EARLYSTOP_YEARS[1])  # Full training period: 2000-2017
    test_year_range = (TEST_START, min(TEST_END, LAST_LABEL_YEAR))
    
    if check_year_overlap(final_train_years, test_year_range, "Test"):
        print("\n" + "="*70)
        print("ERROR: Cannot proceed with testing due to year overlap.")
        print("="*70)
        raise ValueError("Test years overlap with training years. Cannot evaluate.")
    
    print(f"\nLoading model from {model_path}")
    brf_model = joblib.load(model_path)
    report_memory_usage("after loading model")
    
    # Use batch size from config (can be overridden via BATCH_SIZE env var)
    batch_size = BATCH_SIZE
    
    print(f"Processing test in batches of {batch_size:,}...")
    print(f"Test year range: {test_year_range[0]}-{test_year_range[1]} (capped at LAST_LABEL_YEAR={LAST_LABEL_YEAR})")
    
    # Pass 1: Count rows (pre-allocate arrays to avoid concatenation memory spike)
    print(f"  Pass 1: Counting test rows (year_range={test_year_range})...")
    parquet_file = pq.ParquetFile(test_path)
    n_test_total = 0
    test_years_set = set()
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=[target_col, 'year', 'WDPA_prev'], use_threads=True):
            batch_table = batch
            # Use PyArrow null handling
            null_mask = batch_table[target_col].is_null().to_numpy(zero_copy_only=False)
            valid_mask = ~null_mask
            if valid_mask.any():
                year_array = batch_table['year'].to_numpy(zero_copy_only=False)
                wdpa_prev_array = batch_table['WDPA_prev'].to_numpy(zero_copy_only=False)
                # Filter by year range to exclude right-censored labels
                year_mask = (year_array >= test_year_range[0]) & (year_array <= test_year_range[1])
                # Apply risk-set filtering: WDPA_prev == 0
                risk_mask = (wdpa_prev_array == 0)
                final_mask = valid_mask & year_mask & risk_mask
                if final_mask.any():
                    n_test_total += int(final_mask.sum())
                    test_years_set.update(year_array[final_mask].tolist())
                del year_array, wdpa_prev_array
            
            del batch_table, batch
    finally:
        del parquet_file
        gc.collect()
    
    print(f"  Found {n_test_total:,} test samples (filtered to year_range={test_year_range[0]}-{test_year_range[1]})")
    
    if n_test_total == 0:
        raise ValueError("No test samples found")
    
    # Pre-allocate arrays
    print(f"  Pre-allocating arrays for {n_test_total:,} samples...")
    y_test = np.empty(n_test_total, dtype=np.int8)
    y_proba = np.empty(n_test_total, dtype=np.float32)
    report_memory_usage("after pre-allocation")
    
    # Pass 2: Process batches and fill pre-allocated arrays
    print(f"  Pass 2: Processing test batches (year_range={test_year_range})...")
    parquet_file = pq.ParquetFile(test_path)
    scored_path = output_dir / f"modelC_brf_win5_scored_{timestamp}.parquet"
    writer = None
    test_pos = test_neg = batch_num = idx_offset = 0
    pred_start = time.time()
    
    try:
        for batch in parquet_file.iter_batches(batch_size=batch_size, columns=keep_cols_test, use_threads=True):
            batch_num += 1
            batch_table = batch
            
            # Use PyArrow null handling
            null_mask = batch_table[target_col].is_null().to_numpy(zero_copy_only=False)
            valid_mask = ~null_mask
            if not valid_mask.any():
                del batch_table, batch
                continue
            
            # Extract target array, year array, and WDPA_prev
            target_array = batch_table[target_col].to_numpy(zero_copy_only=False)
            year_array = batch_table['year'].to_numpy(zero_copy_only=False)
            wdpa_prev_array = batch_table['WDPA_prev'].to_numpy(zero_copy_only=False)
            
            # Filter by year range to exclude right-censored labels
            # year_range=(TEST_START, min(TEST_END, LAST_LABEL_YEAR))
            year_mask = (year_array >= test_year_range[0]) & (year_array <= test_year_range[1])
            # Apply risk-set filtering: WDPA_prev == 0
            risk_mask = (wdpa_prev_array == 0)
            final_mask = valid_mask & year_mask & risk_mask
            if not final_mask.any():
                del batch_table, target_array, year_array, wdpa_prev_array, batch
                continue
            
            # Extract feature columns in bulk using pure PyArrow→NumPy path (no pandas)
            feature_table = batch_table.select(feature_cols)
            X_batch = extract_features_pyarrow_to_numpy(feature_table, final_mask)
            target_valid = target_array[final_mask]
            y_batch = (target_valid > 0).astype(np.int8)
            
            # Get predictions from model
            y_proba_batch = brf_model.predict_proba(X_batch)[:, 1].astype(np.float32)
            
            # Fill pre-allocated arrays directly
            batch_size_actual = len(y_batch)
            y_test[idx_offset:idx_offset + batch_size_actual] = y_batch
            y_proba[idx_offset:idx_offset + batch_size_actual] = y_proba_batch
            idx_offset += batch_size_actual
            
            test_pos += int(y_batch.sum())
            test_neg += int((y_batch == 0).sum())
            
            # Extract metadata arrays for writing results (using final_mask which includes year filtering)
            row_array = batch_table['row'].to_numpy(zero_copy_only=False)[final_mask]
            col_array = batch_table['col'].to_numpy(zero_copy_only=False)[final_mask]
            year_array_valid = year_array[final_mask]
            
            # Build result arrays and create PyArrow table directly
            result_arrays = {
                'row': row_array.astype(np.int32),
                'col': col_array.astype(np.int32),
                'year': year_array_valid.astype(np.int32),
                'y_true': y_batch,
                'y_pred_proba': y_proba_batch
            }
            
            # Add optional x, y coordinates if present
            for coord_col in ['x', 'y']:
                if coord_col in batch_table.column_names:
                    coord_array = batch_table[coord_col].to_numpy(zero_copy_only=False)[final_mask]
                    result_arrays[coord_col] = coord_array.astype(np.float32)
            
            # Create PyArrow table directly from arrays (avoiding pandas)
            result_table = pa.table(result_arrays)
            
            if writer is None:
                writer = pq.ParquetWriter(scored_path, result_table.schema)
                print(f"Writing to {scored_path}")
            writer.write_table(result_table)
            
            del batch_table, target_array, year_array, wdpa_prev_array, target_valid, feature_table, X_batch, y_batch, y_proba_batch
            del row_array, col_array, year_array_valid, result_arrays, result_table, batch
            
            if batch_num % 25 == 0:
                gc.collect()
            
            if batch_num % 10 == 0:
                print(f"  {batch_num} batches, {idx_offset:,}/{n_test_total:,} rows")
                report_memory_usage(f"batch {batch_num}")
    finally:
        if writer is not None:
            writer.close()
        del parquet_file; gc.collect()
    
    if idx_offset != n_test_total:
        raise ValueError(f"Mismatch: expected {n_test_total:,} samples but processed {idx_offset:,}")
    
    pred_time = time.time() - pred_start
    print(f"Completed {batch_num} batches in {pred_time:.1f}s, {n_test_total:,} rows")
    report_memory_usage("after all predictions")
    
    test_years = sorted(test_years_set)
    del test_years_set; gc.collect()
    print(f"\nTest set: {test_neg:,} neg, {test_pos:,} pos, ratio 1:{test_neg/max(test_pos,1):.1f}, years {test_years[0]}-{test_years[-1]}")
    
    if use_wandb:
        wandb.log({
            "data/n_test": int(n_test_total), 
            "data/test_positives": test_pos, 
            "data/test_negatives": test_neg,
            "data/test_positive_pct": test_pos/n_test_total*100
        })
    
    test_metrics = compute_metrics(y_test, y_proba)
    baseline_rate = test_metrics['baseline_rate']
    prec_at_k = {k: test_metrics[f'precision_at_{k}pct'] for k in [1, 5, 10]}
    print(f"\nTest metrics: ROC-AUC {test_metrics['roc_auc']:.4f}, PR-AUC {test_metrics['pr_auc']:.4f}")
    for k in [1, 5, 10]:
        n_top_k = max(1, int(len(y_test) * k / 100))
        n_protected = int(n_top_k * prec_at_k[k])
        print(f"  P@{k}%: {prec_at_k[k]:.4f} ({n_protected:,}/{n_top_k:,}), lift {test_metrics[f'lift_at_{k}pct']:.2f}x")
    
    if use_wandb:
        wandb.log({**{f"test/{k}": v for k, v in test_metrics.items()}})
    
    # Get feature importance from the model
    try:
        feature_importance = pd.DataFrame({
            'feature': feature_cols, 
            'importance': brf_model.feature_importances_
        }).sort_values('importance', ascending=False).head(20)
        print("\nTop 20 features:\n" + feature_importance.to_string(index=False))
    except Exception as e:
        print(f"\nWarning: Could not extract feature importance: {e}")
        feature_importance = pd.DataFrame({'feature': feature_cols, 'importance': [0] * len(feature_cols)}).head(20)
    
    # Free test data after metrics computation
    del y_test, y_proba; gc.collect()
    
    metrics = {
        "metadata": {
            "timestamp": timestamp, 
            "model": "BalancedRandomForest", 
            "task": "transition_01_win5_prediction",
            "target_column": TARGET_COL,
            "lookahead_years": 5,
            "random_state": RANDOM_STATE, 
            "n_features": len(feature_cols), 
            "features": feature_cols,
            "test_probabilities": "uncalibrated"
        },
        "data": {
            "n_train_full": n_train_full, 
            "n_test": int(n_test_total), 
            "train_positives": train_pos,
            "train_negatives": train_neg, 
            "test_positives": test_pos, 
            "test_negatives": test_neg
        },
        "temporal_split": {
            "method": "strict_temporal_split", 
            "train_years": list(TRAIN_YEARS),
            "earlystop_years": list(EARLYSTOP_YEARS), 
            "test_years": list(TEST_YEARS)
        },
        "trained_params": model_params,
        "imbalance_handling": {
            "method": "balanced_random_forest", 
            "sampling_strategy": imbalance_info.get("sampling_strategy", 0.1),
            "neg": imbalance_info.get("neg"), 
            "pos": imbalance_info.get("pos")
        },
        "test_performance": test_metrics, 
        "feature_importance": feature_importance.head(20).to_dict('records'),
        "timing": {
            "train_seconds": train_time,
            "prediction_seconds": pred_time, 
            "total_seconds": time.time() - start_time
        }
    }
    metrics = convert_numpy_types(metrics)
    metrics_path = output_dir / f"modelC_brf_win5_metrics_{timestamp}.json"
    with open(metrics_path, 'w') as f:
        json.dump(metrics, f, indent=2)
    print(f"\nMetrics saved: {metrics_path}")
    del brf_model; gc.collect()
    
    total_time = time.time() - start_time
    print("\n" + "="*70 + "\nSUMMARY\n" + "="*70)
    print(f"Model: BalancedRandomForest, {len(feature_cols)} features")
    print(f"  Sampling strategy: {imbalance_info.get('sampling_strategy', 0.1)}")
    
    print(f"\nTest ({TEST_YEARS[0]}-{TEST_YEARS[1]}, {n_test_total:,} samples, {test_pos/n_test_total*100:.3f}% pos): ROC-AUC {test_metrics['roc_auc']:.4f}, PR-AUC {test_metrics['pr_auc']:.4f}")
    print(f"  P@1%: {prec_at_k[1]:.4f} ({test_metrics['lift_at_1pct']:.1f}x), P@5%: {prec_at_k[5]:.4f} ({test_metrics['lift_at_5pct']:.1f}x), P@10%: {prec_at_k[10]:.4f} ({test_metrics['lift_at_10pct']:.1f}x)")
    print(f"\nTimings: train {train_time:.1f}s, pred {pred_time:.1f}s, total {total_time:.1f}s ({total_time/60:.1f}m)")
    print("="*70 + "\nDone.")
    
    if use_wandb:
        wandb.log({
            "summary/total_time_seconds": total_time, 
            "summary/total_time_minutes": total_time / 60, 
            "status": "success"
        })
        wandb.finish()


def main(timestamp: str) -> None:
    start_time = time.time()
    repo_root = Path(__file__).resolve().parents[4]
    train_path = resolve_parquet_file("train_colombia_win5.parquet")
    earlystop_path = resolve_parquet_file("earlystop_colombia_win5.parquet")
    test_path = resolve_parquet_file("test_colombia_win5.parquet")
    params_path = resolve_best_params_json()
    metadata_path = resolve_metadata_file("train_colombia_win5_metadata.json")
    output_dir = repo_root / "outputs/south_america/colombia/results/ml_models"
    output_dir.mkdir(parents=True, exist_ok=True)
    model_dir = repo_root / "data/ml/models"
    model_dir.mkdir(parents=True, exist_ok=True)
    
    # Load hyperparameters before initializing W&B so we can log them
    best_params, best_cv_score = load_best_params(params_path)
    
    use_wandb = False
    if wandb is not None:
        try:
            # Convert params to native Python types for W&B logging
            wandb_params = convert_numpy_types(best_params.copy())
            wandb.init(
            project="ml-training-colombia", 
            entity=os.environ.get("WANDB_ENTITY"), 
            name=f"modelC_brf_win5_{timestamp}",
            config={
                "model": "BalancedRandomForest", 
                "task": "transition_01_win5_prediction", 
                "target_column": TARGET_COL,
                "lookahead_years": 5,
                "random_state": RANDOM_STATE,
                "hyperparameters": wandb_params,
                "temporal_split": {
                    "train_years": list(TRAIN_YEARS), 
                    "earlystop_years": list(EARLYSTOP_YEARS),
                    "test_years": list(TEST_YEARS)
                }
            }
            )
            use_wandb = True
            print("W&B connected")
        except Exception as err:
            print(f"W&B failed: {err}")
    else:
        print("W&B not available (module not installed)")
    
    print("="*70 + "\nBALANCED RANDOM FOREST TRANSITION MODEL (COLOMBIA DATASET - 5-YEAR LOOKAHEAD)\n" + "="*70)
    params_source = f"Params: {params_path.name}" if params_path else "Params: Using default fallback hyperparameters"
    print(f"Train: {train_path}\nEarlystop: {earlystop_path}\nTest: {test_path}\n{params_source}\nOutput: {output_dir}")
    print(f"\nConfiguration:")
    print(f"  WDPA_LAST_YEAR: {WDPA_LAST_YEAR}")
    print(f"  LOOKAHEAD_YEARS: {LOOKAHEAD_YEARS}")
    print(f"  LAST_LABEL_YEAR: {LAST_LABEL_YEAR} (WDPA_LAST_YEAR - LOOKAHEAD_YEARS)")
    print(f"  Earlystop/Test data filtered to years <= {LAST_LABEL_YEAR} to avoid right-censored labels")
    print(f"  Using BalancedRandomForestClassifier (no MAX_NEG_TRAIN downsampling)")
    if params_path:
        print(f"\nUsing tuned BRF hyperparameters from {params_path.name}:")
    else:
        print(f"\nUsing default fallback BRF hyperparameters:")
    print(f"  n_estimators={best_params.get('n_estimators')}, max_depth={best_params.get('max_depth')}, "
          f"min_samples_leaf={best_params.get('min_samples_leaf')}, sampling_strategy={best_params.get('sampling_strategy')}")
    
    all_cols_train = pq.ParquetFile(train_path).schema_arrow.names
    all_cols_test = pq.ParquetFile(test_path).schema_arrow.names
    target_col = TARGET_COL
    # Build feature columns from PyArrow schema only (avoid loading full parquet into pandas)
    schema = pq.ParquetFile(train_path).schema_arrow
    numeric_cols = [
        name
        for name, field in zip(schema.names, schema)
        if pa.types.is_integer(field.type) or pa.types.is_floating(field.type)
    ]
    # Exclude target and coordinates from features (year is excluded)
    feature_cols = [c for c in numeric_cols if c not in EXCLUDE_COLS]
    required_cols = [target_col, 'year', 'row', 'col', 'WDPA_prev']
    optional_cols = [col for col in ['x', 'y'] if col in all_cols_train]
    keep_cols_train = feature_cols + required_cols + optional_cols
    keep_cols_test = feature_cols + required_cols + [col for col in ['x', 'y'] if col in all_cols_test]
    print(f"Selected {len(feature_cols)} features, loading {len(keep_cols_train)} cols from train, {len(keep_cols_test)} from test")
    print(f"Target column: {target_col}")
    
    (model_path, earlystop_metrics, train_stats, train_time, earlystop_time, train_pos, train_neg, n_train_full, imbalance_info, cv_info, model_params) = phase1_training(
        train_path, earlystop_path, params_path, feature_cols, keep_cols_train, best_params, timestamp, model_dir, output_dir, use_wandb, target_col)
    
    phase2_testing(
        test_path, model_path, feature_cols, keep_cols_test, timestamp, output_dir, use_wandb, target_col,
        earlystop_metrics, train_stats, train_time, earlystop_time, train_pos, train_neg, n_train_full,
        best_params, model_params, start_time, imbalance_info, cv_info)


