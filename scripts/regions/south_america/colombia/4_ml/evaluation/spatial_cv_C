        if label_analysis['is_much_rarer']:
            print(f"  WARNING: Labels are MUCH RARER in some folds (max/min ratio > 2.0)")
        if label_analysis['is_much_noisier']:
            print(f"  WARNING: Labels are MUCH NOISIER across folds (CV > 0.3)")
        if not label_analysis['is_much_rarer'] and not label_analysis['is_much_noisier']:
            print(f"  Labels are relatively consistent across folds")
    
    # Top features across all folds
    top_features_agg = aggregated.get("top_features_aggregated", {})
    if top_features_agg and "top_features_across_folds" in top_features_agg:
        print(f"\nTop Features Across All Folds (sorted by frequency × importance):")
