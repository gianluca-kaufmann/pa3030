            # Concatenate predictions from all folds
            y_true_all = np.concatenate([pred["y_true"] for pred in all_predictions])
            y_pred_proba_all = np.concatenate([pred["y_pred_proba"] for pred in all_predictions])
            fold_idx_all = np.concatenate([pred["fold_idx"] for pred in all_predictions])
            
            # Create DataFrame and save to parquet
            cv_predictions_df = pd.DataFrame({
                "y_true": y_true_all,
                "y_pred_proba": y_pred_proba_all,
                "fold_idx": fold_idx_all
            })
            
            cv_predictions_path = output_dir / f"modelC_{model_type}_win5_spatial_cv_predictions_{timestamp}.parquet"
            # Save to split-specific directory
            cv_predictions_path = split_output_dir / f"modelC_{model_type}_win5_spatial_cv_predictions_{timestamp}.parquet"
            cv_predictions_df.to_parquet(cv_predictions_path, index=False, engine="pyarrow")
            print(f"\nCV predictions saved: {cv_predictions_path.name}")
            print(f"  Total samples: {len(cv_predictions_df):,}")
            print(f"  Columns: {list(cv_predictions_df.columns)}")
            
            # Clean up
            del cv_predictions_df, y_true_all, y_pred_proba_all, fold_idx_all, all_predictions
            gc.collect()
        except Exception as e:
            print(f"\nWARNING: Failed to save CV predictions: {e}")
            import traceback
            traceback.print_exc()
            # Don't exit - continue with metrics saving
    
    # Step 6: Aggregate results
    print("\n" + "=" * 70)
    print("STEP 6: AGGREGATE RESULTS")
    print("=" * 70)
    aggregated = aggregate_spatial_cv_metrics(cv_results)
    
