def analyze_label_rarity_noise(cv_results: list[Dict[str, Any]]) -> Dict[str, Any]:
    """Analyze if labels are rarer/noisier across folds.
    
    Compares positive rates across folds to detect high variance.
    """
    pos_rates = [fold["test_pos_rate"] for fold in cv_results]
    pos_rates_mean = float(np.mean(pos_rates))
    pos_rates_std = float(np.std(pos_rates))
    pos_rates_cv = pos_rates_std / pos_rates_mean if pos_rates_mean > 0 else 0.0  # Coefficient of variation
    
    # Check if any fold has significantly different positive rate
    # Consider "much rarer" if >2x difference, "much noisier" if CV > 0.3
    min_pos_rate = float(np.min(pos_rates))
    max_pos_rate = float(np.max(pos_rates))
    ratio_max_min = max_pos_rate / min_pos_rate if min_pos_rate > 0 else float('inf')
    
    is_rare = ratio_max_min > 2.0
    is_noisy = pos_rates_cv > 0.3
    
    return {
        "pos_rates": pos_rates,
        "pos_rate_mean": pos_rates_mean,
        "pos_rate_std": pos_rates_std,
        "pos_rate_cv": pos_rates_cv,
        "pos_rate_min": min_pos_rate,
        "pos_rate_max": max_pos_rate,
        "pos_rate_ratio_max_min": ratio_max_min,
        "is_much_rarer": is_rare,
        "is_much_noisier": is_noisy
    }


def aggregate_top_features(cv_results: list[Dict[str, Any]], top_n: int = 20) -> Dict[str, Any]:
    """Aggregate top features across all folds.
    
    Returns:
        Dictionary with feature frequency and average importance across folds
    """
    # Collect all features with their importance from each fold
    feature_importance_dict = {}
    feature_frequency = {}
    
    for fold in cv_results:
        top_features = fold.get("top_features", [])
        for feat_info in top_features:
            feat_name = feat_info["feature"]
            importance = feat_info["importance"]
            
            if feat_name not in feature_importance_dict:
                feature_importance_dict[feat_name] = []
                feature_frequency[feat_name] = 0
            
            feature_importance_dict[feat_name].append(importance)
            feature_frequency[feat_name] += 1
    
    # Compute average importance per feature
    feature_avg_importance = {
        name: float(np.mean(importances))
        for name, importances in feature_importance_dict.items()
    }
    
    # Sort by (frequency, average importance) - features appearing in more folds and with higher importance rank higher
    feature_scores = [
        {
            "feature": name,
            "frequency": feature_frequency[name],
            "avg_importance": feature_avg_importance[name],
            "score": feature_frequency[name] * feature_avg_importance[name]  # Combined score
        }
        for name in feature_importance_dict.keys()
    ]
    feature_scores.sort(key=lambda x: (x["frequency"], x["avg_importance"]), reverse=True)
    
    return {
        "top_features_across_folds": feature_scores[:top_n],
        "feature_frequency": feature_frequency,
        "feature_avg_importance": feature_avg_importance
    }


def assign_coordinates_to_folds(x_coords: np.ndarray, y_coords: np.ndarray, 
                                  scaler: StandardScaler, kmeans: KMeans,
                                  batch_size: int = KMEANS_BATCH_SIZE) -> np.ndarray:
    """Assign coordinates to existing spatial folds using a fitted KMeans model.
    
    Args:
        x_coords: X coordinates to assign
        y_coords: Y coordinates to assign
        scaler: StandardScaler fitted on training coordinates
        kmeans: KMeans model fitted on standardized training coordinates
        batch_size: Batch size for processing
    
    Returns:
        Array of fold assignments (0 to n_folds-1) for each coordinate
    """
    n_total = len(x_coords)
    coords = np.column_stack([x_coords, y_coords])
    fold_assignments = np.empty(n_total, dtype=np.int32)
    
    # Process in batches: standardize and predict
    for start_idx in range(0, n_total, batch_size):
        end_idx = min(start_idx + batch_size, n_total)
        batch_coords = coords[start_idx:end_idx]
        batch_coords_scaled = scaler.transform(batch_coords)
        fold_assignments[start_idx:end_idx] = kmeans.predict(batch_coords_scaled)
    
    return fold_assignments


def aggregate_spatial_cv_metrics(cv_results: list[Dict[str, Any]]) -> Dict[str, Any]:
    """Aggregate metrics across spatial CV folds."""
    metrics_keys = ["pr_auc", "precision_at_1pct", "lift_at_1pct", "roc_auc"]
    
    aggregated = {}
    for key in metrics_keys:
        values = [fold["metrics"][key] for fold in cv_results]
        aggregated[f"{key}_mean"] = float(np.mean(values))
        aggregated[f"{key}_std"] = float(np.std(values))
        aggregated[f"{key}_values"] = values
    
    aggregated["n_train_mean"] = float(np.mean([fold["n_train"] for fold in cv_results]))
    aggregated["n_test_mean"] = float(np.mean([fold["n_test"] for fold in cv_results]))
    
    # Add label rarity/noise analysis
    label_analysis = analyze_label_rarity_noise(cv_results)
    aggregated["label_analysis"] = label_analysis
    
    # Add top features aggregation
    top_features_agg = aggregate_top_features(cv_results, top_n=20)
    aggregated["top_features_aggregated"] = top_features_agg
    
    return aggregated


