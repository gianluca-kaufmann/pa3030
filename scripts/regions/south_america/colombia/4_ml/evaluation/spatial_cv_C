    for fold_idx in range(N_SPATIAL_FOLDS):
        # Split training data: train on 3 folds, heldout fold for spatial split
        test_mask = fold_assignments == fold_idx
        train_mask = ~test_mask
        
        # Use views where possible, but copy for safety (LightGBM may modify)
        # For memory efficiency, we'll create copies but clean up immediately after use
        X_train = X[train_mask].copy()
        y_train = y[train_mask].copy()
        years_train = years[train_mask].copy()
        
        # Handle test data based on protocol
        if protocol == "pooled_years":
            # Test on the heldout spatial fold from the same year range
            X_test = X[test_mask].copy()
            y_test = y[test_mask].copy()
        else:  # deployment_like
            # Test on the heldout spatial fold from test year range (2018-2019)
            test_fold_mask = test_fold_assignments == fold_idx
            X_test = X_test_full[test_fold_mask].copy()
            y_test = y_test_full[test_fold_mask].copy()
        
        # Free up memory by deleting the masks
        del test_mask, train_mask
        if protocol == "deployment_like":
            del test_fold_mask
        gc.collect()
        
        fold_result = train_spatial_fold(
            X_train, y_train, years_train,
            X_test, y_test,
            fold_idx, hyperparameters, num_boost_round, feature_cols, model_type, use_wandb
        )
        
        # Collect predictions before cleanup
        if "predictions" in fold_result:
            all_predictions.append(fold_result["predictions"])
            # Remove predictions from fold_result to avoid bloating JSON
            fold_result_clean = {k: v for k, v in fold_result.items() if k != "predictions"}
        else:
            fold_result_clean = fold_result
        
        cv_results.append(fold_result_clean)
        
        # Clean up immediately after each fold
        del X_train, y_train, years_train, X_test, y_test
        gc.collect()
    
