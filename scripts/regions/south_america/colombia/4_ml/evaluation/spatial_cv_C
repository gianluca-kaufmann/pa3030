                  f"avg_imp: {feat_info['avg_importance']:.2f})")
    
    if use_wandb:
        wandb.log({
            "spatial_cv_aggregated/pr_auc_mean": aggregated['pr_auc_mean'],
            "spatial_cv_aggregated/pr_auc_std": aggregated['pr_auc_std'],
            "spatial_cv_aggregated/precision_at_1pct_mean": aggregated['precision_at_1pct_mean'],
            "spatial_cv_aggregated/precision_at_1pct_std": aggregated['precision_at_1pct_std'],
            "spatial_cv_aggregated/lift_at_1pct_mean": aggregated['lift_at_1pct_mean'],
            "spatial_cv_aggregated/lift_at_1pct_std": aggregated['lift_at_1pct_std'],
            "spatial_cv_aggregated/n_train_mean": aggregated['n_train_mean'],
            "spatial_cv_aggregated/n_test_mean": aggregated['n_test_mean'],
        })
    
    # Step 7: Save results
    print("\n" + "=" * 70)
    print("STEP 7: SAVE RESULTS")
    print("=" * 70)
