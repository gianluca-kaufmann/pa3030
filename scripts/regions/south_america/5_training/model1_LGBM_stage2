#!/usr/bin/env python3
"""Stage 2 LambdaRank geographic selection model — South America (model1)."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parents[4]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from scripts.regions.shared.training.stage2_lgbm_core import Stage2Config, run_stage2_training


def main() -> None:
    parser = argparse.ArgumentParser(description="Stage 2 LambdaRank — South America")
    parser.add_argument("--cv-mode", default="fold3", choices=["full", "fold3", "none"])
    parser.add_argument("--naive", action="store_true", help="dist_wdpa-only baseline")
    parser.add_argument(
        "--ablation-drop",
        type=str,
        default=None,
        help="Drop feature group (terrain, biodiversity, deforestation, pa_momentum, infrastructure, policy)",
    )
    args = parser.parse_args()
    use_eco = bool(int(os.environ.get("STAGE2_ECO_GROUPS", "0")))
    cfg = Stage2Config(
        region="south_america",
        model_prefix="model1",
        feature_subset=["dist_wdpa"] if args.naive else None,
        ablation_drop=args.ablation_drop,
        variant="naive" if args.naive else "full",
        use_ecoregion_groups=use_eco,
    )
    run_stage2_training(cfg, cv_mode=args.cv_mode)


if __name__ == "__main__":
    main()
