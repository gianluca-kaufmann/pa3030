def resolve_parquet_file(filename: str) -> Path:
    """Locate parquet file (prefer $SCRATCH if present). Checks main/ subdirectory first."""
    repo_root = get_repo_root()
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        # Check main/ subdirectory first (standard location from preprocessing script with split_version='main')
        candidates.append(scratch_root / f"outputs/south_america/results/main/{filename}")
        candidates.append(scratch_root / f"data/south_america/ml/main/{filename}")
        # Also check outputs/south_america/results and data/south_america/ml locations (for backward compatibility)
        candidates.append(scratch_root / f"outputs/south_america/results/{filename}")
        candidates.append(scratch_root / f"data/south_america/ml/{filename}")
    # Check main/ subdirectory first in repo
    candidates.append(repo_root / f"outputs/south_america/results/main/{filename}")
    candidates.append(repo_root / f"data/south_america/ml/main/{filename}")
    # Also check outputs/south_america/results and data/south_america/ml locations (for backward compatibility)
    candidates.append(repo_root / f"outputs/south_america/results/{filename}")
    candidates.append(repo_root / f"data/south_america/ml/{filename}")

    for cand in candidates:
        if cand.exists():
            return cand

    # Provide detailed error message with all checked paths
    error_msg = f"{filename} not found in expected locations.\n"
    error_msg += "\nChecked locations:\n"
    for cand in candidates:
