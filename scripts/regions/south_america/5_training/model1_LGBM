def get_num_threads() -> int:
    """Get thread count from SLURM (fallback to os.cpu_count())."""
    slurm_cpus = os.environ.get("SLURM_CPUS_PER_TASK")
    if slurm_cpus:
        try:
            n = int(slurm_cpus)
            if n > 0:
                return n
        except ValueError:
            pass
    return max(1, os.cpu_count() or 1)


def configure_threading_env(num_threads: int) -> None:
    """Set BLAS/OMP thread env vars (must be called before importing LightGBM)."""
    n = str(max(1, int(num_threads)))
    for k in ("OMP_NUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
        os.environ[k] = n


# Configure threading from SLURM before importing LightGBM
