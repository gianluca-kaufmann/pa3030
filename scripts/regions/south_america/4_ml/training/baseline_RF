def get_n_jobs() -> int:
    """Number of CPUs for DuckDB/parallel work: SLURM_CPUS_PER_TASK or os.cpu_count()."""
    n = os.environ.get("SLURM_CPUS_PER_TASK")
    if n is not None:
        try:
            return max(1, int(n))
        except ValueError:
            pass
    try:
        return max(1, os.cpu_count() or 4)
    except Exception:
        return 4


def list_digest(names: list[str]) -> str:
    """Stable hash digest of a list of strings (for W&B / metrics, avoid logging full lists)."""
    return hashlib.sha256("|".join(sorted(names)).encode("utf-8")).hexdigest()[:16]


