def _get_south_america_boundary(repo_root: Path) -> Optional[object]:
    """Get South America boundary. Returns None if geopandas unavailable or boundary not found."""
    if not GEOPANDAS_AVAILABLE:
        return None
    south_america_iso_codes = ['ARG', 'BOL', 'BRA', 'CHL', 'COL', 'ECU', 'GUF', 'GUY', 'PRY', 'PER', 'SUR', 'URY', 'VEN']
    for cand in [repo_root / "data" / "boundaries" / "south_america.geojson", repo_root / "data" / "boundaries" / "south_america.gpkg"]:
        if cand.exists():
            try:
                gdf = gpd.read_file(cand)
                if gdf.crs is None:
                    gdf.set_crs('EPSG:4326', inplace=True)
                if 'iso_a3' in gdf.columns:
                    return gdf[gdf['iso_a3'].isin(south_america_iso_codes)].dissolve().explode(index_parts=False)
                elif 'ISO_A3' in gdf.columns:
                    return gdf[gdf['ISO_A3'].isin(south_america_iso_codes)].dissolve().explode(index_parts=False)
                return gdf
            except Exception:
                continue
    return None


def _points_to_raster(x: np.ndarray, y: np.ndarray, values: np.ndarray, target_resolution: float = 1000.0,
                      agg_func: str = 'mean', extent_hint: Optional[Tuple[float, float, float, float]] = None
                      ) -> Tuple[np.ndarray, Tuple[float, float, float, float]]:
    """Convert point data to raster grid. Coordinates in meters (EPSG:3857)."""
    if extent_hint is not None:
        x_min, x_max, y_min, y_max = extent_hint
    else:
        x_min, x_max = float(x.min()), float(x.max())
        y_min, y_max = float(y.min()), float(y.max())
    x_res = y_res = target_resolution
    padding = max(x_res, y_res) * 0.1
    x_edges = np.arange(x_min - padding, x_max + padding + x_res, x_res)
    y_edges = np.arange(y_min - padding, y_max + padding + y_res, y_res)
    ncols, nrows = len(x_edges) - 1, len(y_edges) - 1
    x_idx = np.clip(np.digitize(x, x_edges) - 1, 0, ncols - 1).astype(np.intp)
    y_idx = np.clip(np.digitize(y, y_edges) - 1, 0, nrows - 1).astype(np.intp)
    flat_idx = y_idx * ncols + x_idx
    values = np.asarray(values, dtype=np.float64)
    if agg_func == 'mean':
        sum_arr = np.zeros(nrows * ncols, dtype=np.float64)
        count_arr = np.zeros(nrows * ncols, dtype=np.float64)
        np.add.at(sum_arr, flat_idx, values)
        np.add.at(count_arr, flat_idx, 1.0)
        raster_flat = np.where(count_arr > 0, sum_arr / count_arr, np.nan)
    else:
        raster_flat = np.full(nrows * ncols, -np.inf, dtype=np.float64)
        np.maximum.at(raster_flat, flat_idx, values)
        raster_flat = np.where(np.isfinite(raster_flat), raster_flat, np.nan)
    raster = np.flipud(raster_flat.reshape(nrows, ncols).astype(np.float32))
    return raster, (float(x_edges[0]), float(x_edges[-1]), float(y_edges[0]), float(y_edges[-1]))


def _load_protected_areas_until_2024(parquet_path: Path, year_max: int = 2024) -> Optional[pd.DataFrame]:
    """Load all pixels protected in any year through year_max from merged panel."""
    if duckdb is None:
        return None
    escaped = str(parquet_path).replace("'", "''")
    con = duckdb.connect()
    try:
        con.execute("SET threads TO 4")
        return con.execute(f"""
            SELECT row, col, MAX(x) AS x, MAX(y) AS y
            FROM read_parquet('{escaped}')
            WHERE year <= {year_max} AND WDPA_b1 = 1
            GROUP BY row, col
        """).fetchdf()
    finally:
        con.close()


def _create_high_res_suitability_map(outcome_df: pd.DataFrame, output_dir: Path, input_path: Path,
