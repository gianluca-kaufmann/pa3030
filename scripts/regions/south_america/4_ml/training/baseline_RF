def convert_numpy_types(obj):
    """Recursively convert NumPy types to native Python types for JSON serialization.
    
    Handles:
    - NumPy scalars (int64, float64, etc.) -> int, float
    - NumPy arrays -> lists
    - Dicts and lists (recursively)
    - None, bool, str pass through unchanged
    
    Args:
        obj: Object that may contain NumPy types
        
    Returns:
        Object with all NumPy types converted to native Python types
    """
    if isinstance(obj, (np.integer, np.intc, np.intp, np.int8,
                        np.int16, np.int32, np.int64, np.uint8, np.uint16,
                        np.uint32, np.uint64)):
        return int(obj)
    elif isinstance(obj, (np.floating, np.float16, np.float32, np.float64)):
        return float(obj)
    elif isinstance(obj, np.bool_):
        return bool(obj)
    elif isinstance(obj, np.ndarray):
        return obj.tolist()
    elif isinstance(obj, dict):
        return {key: convert_numpy_types(value) for key, value in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [convert_numpy_types(item) for item in obj]
    elif obj is None or isinstance(obj, (str, int, float, bool)):
        return obj
    else:
        # Fallback: try to convert to native type
        try:
            if hasattr(obj, 'item'):  # NumPy scalar
                return obj.item()
            else:
                return obj
        except (ValueError, TypeError, AttributeError):
            return str(obj)  # Last resort: convert to string


def compute_precision_at_k(
    y_true: np.ndarray,
    y_proba: np.ndarray,
    k: float,
    tie_break_order: Optional[np.ndarray] = None,
) -> float:
    """Compute precision at top k% of predictions (deterministic under ties).

    Tie-breaking: when scores are tied, order by tie_break_order (ascending)
    so that the same subset is chosen every run. If tie_break_order is None,
    uses np.arange(len(y_true)) so that earlier indices win.
    """
    n_samples = len(y_true)
    n_top_k = max(1, int(n_samples * k / 100))
    if tie_break_order is None:
        tie_break_order = np.arange(n_samples, dtype=np.int64)
    lex_order = np.lexsort((tie_break_order, -y_proba))
    top_k_idx = lex_order[:n_top_k]
    return float(y_true[top_k_idx].sum() / n_top_k)


def tie_diagnostics(y_proba: np.ndarray, name: str = "score") -> dict:
    """Compute tie diagnostics for suitability/probability scores."""
    uniq, counts = np.unique(y_proba, return_counts=True)
    n_unique = len(uniq)
    tied = counts > 1
    n_tied_groups = int(tied.sum())
    max_tie_size = int(counts.max()) if len(counts) else 0
    n_in_largest = int(counts.max()) if len(counts) else 0
    pct_largest = (n_in_largest / len(y_proba) * 100) if len(y_proba) else 0.0
    return {
        f"{name}_n_unique": n_unique,
        f"{name}_n_tied_groups": n_tied_groups,
        f"{name}_max_tie_size": max_tie_size,
        f"{name}_pct_in_largest_tie": round(pct_largest, 4),
    }


def load_year_data(parquet_path: Path, year: int, columns: Optional[list] = None) -> pd.DataFrame:
    """Load data for a specific year from parquet (row-group filter + multi-threaded read)."""
    print(f"Loading data for year {year} from {parquet_path} ...")
    filters = [('year', '==', year)]
    load_start = time.time()
    df = pd.read_parquet(parquet_path, filters=filters, columns=columns)
    print(f"  Loaded {len(df):,} rows in {time.time() - load_start:.1f}s")
    return df


def load_future_protection_status_duckdb(
    parquet_path: Path, year_min: int, year_max: int, num_threads: Optional[int] = None
) -> pd.DataFrame:
    """Compute ever_protected_after_2000 via DuckDB parquet aggregation (no full load).
    num_threads: from get_n_jobs() if None.
    """
    if duckdb is None:
        raise RuntimeError("duckdb is required for load_future_protection_status_duckdb; install duckdb")
    threads = num_threads if num_threads is not None else get_n_jobs()
    print(f"\nComputing future protection status (years {year_min}-{year_max}) via DuckDB ({threads} threads) ...")
    escaped = str(parquet_path).replace("'", "''")
    load_start = time.time()
    con = duckdb.connect()
    try:
        con.execute(f"SET threads TO {threads}")
        q = f"""
        SELECT row, col, MAX(WDPA_b1) AS max_wdpa
        FROM read_parquet('{escaped}')
        WHERE year >= {year_min} AND year <= {year_max}
        GROUP BY row, col
        """
        protection_max = con.execute(q).fetchdf()
    finally:
        con.close()
    protection_max = protection_max.rename(columns={"max_wdpa": "ever_protected_after_2000"})
    protection_max["ever_protected_after_2000"] = (
        (protection_max["ever_protected_after_2000"] > 0).astype(np.int8)
    )
    load_time = time.time() - load_start
    print(f"  Computed for {len(protection_max):,} unique pixels in {load_time:.1f}s")
    return protection_max


def load_future_protection_status_pandas(parquet_path: Path, year_min: int, year_max: int) -> pd.DataFrame:
    """Fallback: compute ever_protected via pandas (loads filtered rows). Use when DuckDB unavailable."""
    print(f"\nComputing future protection status (years {year_min}-{year_max}) via PANDAS FALLBACK ...")
    load_start = time.time()
    cols = ['row', 'col', 'year', 'WDPA_b1']
    df = pd.read_parquet(
        parquet_path,
        filters=[('year', '>=', year_min), ('year', '<=', year_max)],
        columns=cols,
    )
    protection_max = df.groupby(['row', 'col'])['WDPA_b1'].max().reset_index()
    protection_max.columns = ['row', 'col', 'ever_protected_after_2000']
    protection_max['ever_protected_after_2000'] = (
        (protection_max['ever_protected_after_2000'] > 0).astype(np.int8)
    )
    del df
    gc.collect()
    print(f"  Computed for {len(protection_max):,} unique pixels in {time.time() - load_start:.1f}s (pandas fallback)")
    return protection_max


def get_feature_columns(
    df: pd.DataFrame,
    target_col: str = TARGET_COL_NAME,
    denylist_regex: re.Pattern = FEATURE_DENYLIST_REGEX,
) -> tuple[list[str], list[str]]:
    """Build feature list by excluding denylist matches and target. Hard-fail only if a denylist/target column survives in the final list.

    Returns:
        (final_feature_cols, excluded_cols)
    """
    numeric_cols = df.select_dtypes(include=['number']).columns.tolist()
    excluded_cols = [
        c for c in numeric_cols
        if denylist_regex.search(c) or c == target_col
    ]
    final_feature_cols = [c for c in numeric_cols if c not in set(excluded_cols)]
    # Sanity: raise only if something forbidden is still in the feature list
    survivors = [
        c for c in final_feature_cols
        if denylist_regex.search(c) or c == target_col
    ]
    if survivors:
        raise ValueError(
            f"Leakage prevention: these columns must be excluded but appear in final feature list: {survivors}. "
            "Check denylist regex and target_col."
        )
    return final_feature_cols, excluded_cols


def leakage_audit(
    df: pd.DataFrame,
    feature_cols: list,
    target_series: pd.Series,
    top_n: int = 20,
    max_rows: int = 0,
    seed: int = 42,
    use_full_data: bool = False,
) -> dict:
    """Leakage audit: top absolute correlations of features with target.

    By default runs on a stratified subsample (cap max_rows) for speed; record
    audit_sample_size and audit_seed in returned dict. Set use_full_data=True
    or max_rows=0 with use_full_data=True to run on full data.
    """
    n_total = len(df)
    if use_full_data or max_rows <= 0 or n_total <= max_rows:
        sample_df = df
        sample_target = target_series
        audit_sample_size = n_total
        audit_seed = None  # full data, no subsample seed
    else:
        # Stratified subsample: sample from each class proportionally (cap at max_rows)
        pos_idx = np.where(target_series.values > 0)[0]
        neg_idx = np.where(target_series.values == 0)[0]
        n_pos, n_neg = len(pos_idx), len(neg_idx)
        rng = np.random.RandomState(seed)
        n_pos_sample = min(n_pos, max(1, int(max_rows * n_pos / n_total)))
        n_neg_sample = min(n_neg, max(0, max_rows - n_pos_sample))
        n_pos_sample = min(n_pos_sample, n_pos)
        n_neg_sample = min(n_neg_sample, n_neg)
        idx_pos = rng.choice(pos_idx, size=n_pos_sample, replace=False)
        idx_neg = rng.choice(neg_idx, size=n_neg_sample, replace=False)
        idx = np.concatenate([idx_pos, idx_neg])
        rng.shuffle(idx)
        sample_df = df.iloc[idx]
        sample_target = target_series.iloc[idx]
        audit_sample_size = len(idx)
        audit_seed = seed
    X = sample_df[feature_cols]
    corrs = X.corrwith(sample_target).abs().sort_values(ascending=False)
    top = corrs.head(top_n)
    out = {
        "top_correlations": {str(k): float(v) for k, v in top.items()},
        "max_correlation": float(corrs.max()) if len(corrs) else 0.0,
        "audit_sample_size": audit_sample_size,
        "audit_n_total": n_total,
    }
    if audit_seed is not None:
        out["audit_seed"] = audit_seed
    return out


def spatial_blocked_split(
    row: np.ndarray,
    col: np.ndarray,
    n_tiles_per_axis: int = 8,
    train_frac: float = 0.7,
    val_frac: float = 0.15,
    test_frac: float = 0.15,
    random_state: int = 42,
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Assign each sample to train/val/test by spatial blocks (tile grid on row,col). Fully vectorized. Returns is_train, is_val, is_test."""
    r_min, r_max = row.min(), row.max()
    c_min, c_max = col.min(), col.max()
    r_span = max(1, r_max - r_min + 1)
    c_span = max(1, c_max - c_min + 1)
    r_step = max(1, r_span // n_tiles_per_axis)
    c_step = max(1, c_span // n_tiles_per_axis)
    row_bin = (row - r_min) // r_step
    col_bin = (col - c_min) // c_step
    row_bin = np.clip(row_bin, 0, n_tiles_per_axis - 1)
    col_bin = np.clip(col_bin, 0, n_tiles_per_axis - 1)
    tile_id = row_bin.astype(np.int64) * n_tiles_per_axis + col_bin.astype(np.int64)
    unique_tiles = np.unique(tile_id)
    rng = np.random.RandomState(random_state)
    rng.shuffle(unique_tiles)
    n_tiles = len(unique_tiles)
    n_train = max(1, int(n_tiles * train_frac))
    n_val = max(0, int(n_tiles * val_frac))
    n_test = max(0, n_tiles - n_train - n_val)
    # Vectorized: map tile_id -> rank in shuffled order, then rank -> split
    max_tile = int(tile_id.max())
    tile_id_to_rank = np.full(max_tile + 1, -1, dtype=np.int32)
    tile_id_to_rank[unique_tiles] = np.arange(n_tiles, dtype=np.int32)
    split_rank = tile_id_to_rank[tile_id]
    is_train = (split_rank < n_train)
    is_val = (split_rank >= n_train) & (split_rank < n_train + n_val)
    is_test = (split_rank >= n_train + n_val)
    return is_train, is_val, is_test


def compute_dataset_schema_hash(parquet_path: Path, num_sample_row_groups: int = 3) -> str:
    """Content-stable hash from parquet schema + row count + sampled row-group metadata."""
    try:
        import pyarrow.parquet as pq
        pf = pq.ParquetFile(parquet_path)
        meta = pf.metadata
        schema = pf.schema_arrow
        parts = [
            "columns=" + ",".join(sorted(f.name for f in schema)),
            f"total_rows={meta.num_rows}",
            f"num_row_groups={meta.num_row_groups}",
        ]
        for i in range(min(num_sample_row_groups, meta.num_row_groups)):
            rg = meta.row_group(i)
            parts.append(f"rg{i}:rows={rg.num_rows}:cols={rg.num_columns}")
        return hashlib.sha256("|".join(parts).encode("utf-8")).hexdigest()
    except Exception as e:
        return f"hash_error:{type(e).__name__}"


def write_metrics_latex_table(metrics: dict, output_dir: Path, prefix: str = "baseline_rf") -> None:
    """Write LaTeX table of key metrics (thesis artifact)."""
    def fmt(v):
        if isinstance(v, (int, float)):
            return f"{v:.4f}" if isinstance(v, float) and abs(v) < 100 else f"{v:.2f}"
        return str(v) if v is not None else ""
    m2000 = metrics.get("model_performance_2000", {})
    m_future = metrics.get("future_prediction_2001_2024", {})
    m_spatial = metrics.get("model_performance_2000_spatial", {})
    rows = [
        ("ROC-AUC (2000, random)", fmt(m2000.get("roc_auc"))),
        ("PR-AUC (2000, random)", fmt(m2000.get("pr_auc"))),
        ("ROC-AUC (2000, spatial)", fmt(m_spatial.get("roc_auc"))),
        ("PR-AUC (2000, spatial)", fmt(m_spatial.get("pr_auc"))),
        ("ROC-AUC (future 2001-2024)", fmt(m_future.get("roc_auc"))),
        ("PR-AUC (future 2001-2024)", fmt(m_future.get("pr_auc"))),
        ("Precision @ 1\\% (future)", fmt(m_future.get("precision_at_1pct"))),
        ("Precision @ 5\\% (future)", fmt(m_future.get("precision_at_5pct"))),
        ("Precision @ 10\\% (future)", fmt(m_future.get("precision_at_10pct"))),
    ]
    latex_lines = [
        "\\begin{table}[h]", "\\centering", "\\begin{tabular}{lr}", "\\toprule",
        "Metric & Value \\\\", "\\midrule",
    ]
    for label, val in rows:
        label_tex = label.replace("_", "\\_")
        latex_lines.append(f"{label_tex} & {val} \\\\")
    latex_lines.extend(["\\bottomrule", "\\end{tabular}", "\\caption{Baseline RF Suitability Metrics}", "\\label{tab:baseline_rf_metrics}", "\\end{table}"])
    path = output_dir / f"{prefix}_metrics_table.tex"
    path.write_text("\n".join(latex_lines) + "\n", encoding="utf-8")
    print(f"LaTeX table saved: {path}")


def create_pr_roc_plots(
    y_true: np.ndarray,
    y_proba: np.ndarray,
    output_dir: Path,
    prefix: str = "baseline_rf",
) -> None:
    """Create PR and ROC curves (thesis artifacts)."""
    if not MATPLOTLIB_AVAILABLE:
        print("Skipping PR/ROC plots (matplotlib not available)")
        return
    figsize = (8, 6)
    precision, recall, _ = precision_recall_curve(y_true, y_proba)
    pr_auc = average_precision_score(y_true, y_proba)
    fig, ax = plt.subplots(figsize=figsize)
    ax.plot(recall, precision, lw=2, label=f"AP = {pr_auc:.4f}")
    ax.axhline(y=y_true.mean(), color="r", linestyle="--", lw=2, label=f"Baseline = {y_true.mean():.4f}")
    ax.set_xlabel("Recall")
    ax.set_ylabel("Precision")
    ax.set_title(f"{prefix} Precision-Recall Curve")
    ax.legend()
    ax.grid(True, alpha=0.3)
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    plt.tight_layout()
    for ext in ("png", "pdf"):
        p = output_dir / f"{prefix}_pr_curve.{ext}"
        plt.savefig(p, dpi=300 if ext == "png" else 150, bbox_inches="tight")
        print(f"Saved {p}")
    plt.close()
    fpr, tpr, _ = roc_curve(y_true, y_proba)
    roc_auc = roc_auc_score(y_true, y_proba)
    fig, ax = plt.subplots(figsize=figsize)
    ax.plot(fpr, tpr, lw=2, label=f"AUC = {roc_auc:.4f}")
    ax.plot([0, 1], [0, 1], "k--", lw=1, label="Random")
    ax.set_xlabel("False Positive Rate")
    ax.set_ylabel("True Positive Rate")
    ax.set_title(f"{prefix} ROC Curve")
    ax.legend()
    ax.grid(True, alpha=0.3)
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    plt.tight_layout()
    for ext in ("png", "pdf"):
        p = output_dir / f"{prefix}_roc_curve.{ext}"
        plt.savefig(p, dpi=300 if ext == "png" else 150, bbox_inches="tight")
        print(f"Saved {p}")
    plt.close()


