    dataset_hash = compute_dataset_schema_hash(input_path)
    config_snapshot = {
        "random_state": RANDOM_STATE,
        "test_size": TEST_SIZE,
        "val_size": VAL_SIZE,
        "feature_denylist_regex": FEATURE_DENYLIST_REGEX.pattern,
        "rf_params": {k: (int(v) if isinstance(v, (np.integer, np.int64)) else float(v) if isinstance(v, (np.floating, np.float64)) else v) for k, v in RF_PARAMS.items()},
    }
    
    # Fallback flags (record loudly in metrics)
    metrics_fallbacks = {
        "future_protection_backend": future_protection_backend,
        "duckdb_available": duckdb is not None,
        "matplotlib_available": MATPLOTLIB_AVAILABLE,
    }
    if future_protection_backend != "duckdb":
        print(f"\n  WARNING: future_protection_backend = {future_protection_backend} (recorded in metrics)")
    if not MATPLOTLIB_AVAILABLE:
        print("  WARNING: matplotlib not available — PR/ROC/suitability map skipped (recorded in metrics)")
    
    # Compile metrics (random + spatial + future + tie diagnostics + hashes + excluded/final features)
    metrics = {
        "metadata": {
            "timestamp": timestamp,
            "model": "RandomForest",
            "random_state": RANDOM_STATE,
            "test_size": TEST_SIZE,
            "n_features": len(feature_cols),
            "n_estimators": RF_PARAMS['n_estimators'],
        },
        "dataset": {
            "schema_hash": dataset_hash,
            "input_path": str(input_path),
        },
        "config_snapshot": config_snapshot,
        "fallbacks": metrics_fallbacks,
        "feature_selection": {
            "excluded_cols": excluded_cols,
            "final_feature_cols": feature_cols,
        },
        "year_2000_data": {
            "n_total_pixels": n_protected + n_unprotected,
            "n_protected": int(n_protected),
            "n_unprotected": int(n_unprotected),
            "pct_protected": float(pct_protected),
        },
        "leakage_audit": audit,
        "model_performance_2000": {
            "roc_auc": float(roc_auc),
