    _create_suitability_map_with_pa(outcome_df, output_dir, input_path, "baseline_rf", repo_root)
    _create_suitability_risk_map(outcome_df, output_dir, input_path, "baseline_rf", repo_root)
    
    # -------------------------------------------------------------------------
    # Summary
    # -------------------------------------------------------------------------
    total_time = time.time() - start_time
    
    print("\n" + "=" * 70)
    print("SUMMARY")
    print("=" * 70)
    print(f"Model:                       Random Forest ({RF_PARAMS['n_estimators']} estimators)")
    print(f"Features used:               {len(feature_cols)}")
    print(f"\n2000 Classification — random split:")
    print(f"  ROC-AUC:                   {roc_auc:.4f}")
    print(f"  PR-AUC:                    {pr_auc:.4f}")
    print(f"\n2000 Classification — spatial split:")
    print(f"  ROC-AUC:                   {roc_auc_spatial:.4f}")
    print(f"  PR-AUC:                    {pr_auc_spatial:.4f}")
    print(f"\nFuture Protection Prediction (unprotected 2000 → protected by 2024):")
