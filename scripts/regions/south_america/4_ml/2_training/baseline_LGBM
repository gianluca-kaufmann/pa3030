    # -------------------------------------------------------------------------
    repo_root = Path(__file__).resolve().parents[5]
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None
    
    # Input path: merged_panel_final.parquet (same locations as model1_preprocessing)
