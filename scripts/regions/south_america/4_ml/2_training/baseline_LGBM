def _create_suitability_risk_map(outcome_df: pd.DataFrame, output_dir: Path, input_path: Path,
                                 prefix: str, repo_root: Path) -> None:
    """Create risk map: top 10% suitability + protected areas until 2024 overlay."""
    if not MATPLOTLIB_AVAILABLE or not GEOPANDAS_AVAILABLE or "x" not in outcome_df.columns or "score" not in outcome_df.columns:
        print("Skipping risk map (matplotlib/geopandas not available or missing columns)")
        return
    sa_gdf = _get_south_america_boundary(repo_root)
    proj_bounds = sa_gdf.to_crs('EPSG:3857').total_bounds if sa_gdf is not None else None
    if proj_bounds is None:
        print("Skipping risk map (South America boundary not found)")
        return
    geometry = [Point(xy) for xy in zip(outcome_df['x'], outcome_df['y'])]
    gdf = gpd.GeoDataFrame(outcome_df.copy(), geometry=geometry, crs='EPSG:3857')
    if proj_bounds is not None:
        gdf = gdf[(gdf.geometry.x >= proj_bounds[0]) & (gdf.geometry.x <= proj_bounds[2]) &
                  (gdf.geometry.y >= proj_bounds[1]) & (gdf.geometry.y <= proj_bounds[3])].copy()
    top_threshold = np.percentile(gdf['score'].values, 100 - _SUITABILITY_RISK_THRESHOLD_PCT)
    gdf['is_predicted'] = (gdf['score'] >= top_threshold).astype(int)
    predicted_count = int(gdf['is_predicted'].sum())
    category_raster, extent = _points_to_raster(gdf.geometry.x.values, gdf.geometry.y.values, gdf['is_predicted'].values.astype(np.float32), _TARGET_RESOLUTION_M, agg_func='max')
    background_mask, _ = _points_to_raster(gdf.geometry.x.values, gdf.geometry.y.values, np.ones(len(gdf), dtype=np.float32), _TARGET_RESOLUTION_M, agg_func='max')
    pa_raster, pa_extent, n_pa_pixels = None, None, 0
    if input_path.exists() and duckdb is not None:
        pa_df = _load_protected_areas_until_2024(input_path, 2024)
        if pa_df is not None and len(pa_df) > 0 and 'x' in pa_df.columns and 'y' in pa_df.columns:
            pa_geom = [Point(xy) for xy in zip(pa_df['x'], pa_df['y'])]
            pa_gdf = gpd.GeoDataFrame(pa_df, geometry=pa_geom, crs='EPSG:3857')
            if proj_bounds is not None:
                pa_gdf = pa_gdf[(pa_gdf.geometry.x >= proj_bounds[0]) & (pa_gdf.geometry.x <= proj_bounds[2]) &
                                (pa_gdf.geometry.y >= proj_bounds[1]) & (pa_gdf.geometry.y <= proj_bounds[3])]
            if len(pa_gdf) > 0:
                n_pa_pixels = len(pa_gdf)
                pa_raster, pa_extent = _points_to_raster(pa_gdf.geometry.x.values, pa_gdf.geometry.y.values,
                                                         np.ones(len(pa_gdf), dtype=np.float32), _TARGET_RESOLUTION_M,
                                                         agg_func='max', extent_hint=(extent[0], extent[1], extent[2], extent[3]))
    fig_width = 14
    fig_height = fig_width * (proj_bounds[3] - proj_bounds[1]) / (proj_bounds[2] - proj_bounds[0]) if proj_bounds is not None else 11
    fig, ax = plt.subplots(figsize=(fig_width, fig_height))
    background_masked = np.ma.masked_where(np.isnan(background_mask), background_mask)
    ax.imshow(background_masked, extent=extent, cmap=ListedColormap(['#F5F5F5']), vmin=0, vmax=1, origin='upper', interpolation='nearest', aspect='equal', zorder=1)
    COLOR_PREDICTED = '#5B9BD5'
    cat_no_bg = np.where((category_raster >= 1) & (category_raster <= 1), category_raster, np.nan)
    ax.imshow(np.ma.masked_where(np.isnan(cat_no_bg), cat_no_bg), extent=extent, cmap=ListedColormap([COLOR_PREDICTED]), vmin=0.5, vmax=1.5, origin='upper', interpolation='nearest', aspect='equal', zorder=2)
    if pa_raster is not None and pa_extent is not None:
        pa_masked = np.ma.masked_where(np.isnan(pa_raster) | (pa_raster < 0.5), pa_raster)
        ax.imshow(pa_masked, extent=pa_extent, cmap=ListedColormap([_COLOR_PROTECTED]), vmin=0, vmax=1, origin='upper', interpolation='nearest', aspect='equal', alpha=0.6, zorder=3)
    if proj_bounds is not None:
        ax.set_xlim(proj_bounds[0], proj_bounds[2])
        ax.set_ylim(proj_bounds[1], proj_bounds[3])
    ax.set_aspect('equal', adjustable='box')
    ax.set_xlabel('Easting (m, EPSG:3857)', fontsize=12)
    ax.set_ylabel('Northing (m, EPSG:3857)', fontsize=12)
    ax.set_title(f'{prefix} Suitability Risk Map: Top {int(_SUITABILITY_RISK_THRESHOLD_PCT)}% + Protected Areas (through 2024)', fontsize=15, fontweight='bold', pad=15)
    legend_elements = [Line2D([0], [0], marker='s', color='w', markerfacecolor=COLOR_PREDICTED, markersize=10, alpha=0.9, label=f'Top {int(_SUITABILITY_RISK_THRESHOLD_PCT)}% suitability (n={predicted_count:,})')]
    if n_pa_pixels > 0:
        legend_elements.append(Line2D([0], [0], marker='s', color='w', markerfacecolor=_COLOR_PROTECTED, markersize=10, alpha=0.9, label=f'Protected areas until 2024 (n={n_pa_pixels:,})'))
    ax.legend(handles=legend_elements, loc='upper left', fontsize=10, framealpha=0.95)
    ax.text(0.02, 0.02, f"Pixels: {len(gdf):,}\nTop {int(_SUITABILITY_RISK_THRESHOLD_PCT)}% threshold: {top_threshold:.4f}", transform=ax.transAxes, fontsize=9, verticalalignment='bottom', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.9, edgecolor='black', linewidth=1), zorder=10)
    ax.grid(True, alpha=0.2, linestyle='--', linewidth=0.5, zorder=4)
    plt.tight_layout(pad=0.5)
    for ext in ("png", "pdf"):
        try:
            plt.savefig(output_dir / f"{prefix}_risk_map_top{int(_SUITABILITY_RISK_THRESHOLD_PCT)}pct.{ext}", dpi=_MAP_DPI if ext == "png" else 150, bbox_inches='tight')
            print(f"Saved {output_dir / f'{prefix}_risk_map_top{int(_SUITABILITY_RISK_THRESHOLD_PCT)}pct.{ext}'}")
        except Exception as e:
            print(f"Warning: Could not save {ext}: {e}")
    plt.close()


