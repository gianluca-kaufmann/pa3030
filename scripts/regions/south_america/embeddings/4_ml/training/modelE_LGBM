class Tee:
    """Write to both stdout and a file."""
    def __init__(self, file_path: Path):
        self.file = open(file_path, 'w', encoding='utf-8')
        self.stdout = sys.stdout
    def write(self, text: str) -> None:
        self.stdout.write(text)
        self.file.write(text)
        self.stdout.flush()
        self.file.flush()
    def flush(self) -> None:
        self.stdout.flush()
        self.file.flush()
    def close(self) -> None:
        self.file.close()


class FilteredStderr:
    """Filter stderr to suppress wandb malloc stack logging warnings."""
    def __init__(self, original_stderr):
        self.original_stderr = original_stderr
        self.buffer = ''
    
    def _should_filter(self, text: str) -> bool:
        """Check if text contains malloc stack logging warning (any variation)."""
        text_lower = text.lower()
        # Match various forms of the message:
        # - "MallocStackLogging: can't turn off malloc stack logging because it was not enabled"
        # - "MallocStackLogging" + "can't turn off" or "cannot turn off"
        # - "malloc stack logging" + "not enabled" or "was not enabled"
        # Be more permissive: if it contains MallocStackLogging and mentions turning off or not enabled, filter it
        if 'mallocstacklogging' in text_lower:
            if ('turn off' in text_lower or 
                'not enabled' in text_lower or
                'was not enabled' in text_lower or
                'can\'t turn off' in text_lower or
                'cannot turn off' in text_lower):
                return True
        return False
    
    def write(self, text: str) -> None:
        """Write to stderr, filtering out malloc stack logging warnings."""
        # Buffer text to handle multi-line messages
        self.buffer += text
        if '\n' not in self.buffer:
            return  # Wait for newline
        
        lines = self.buffer.split('\n')
        # Keep the last incomplete line in buffer
        self.buffer = lines[-1]
        # Process complete lines
        for line in lines[:-1]:
            # Filter out malloc stack logging warnings
            if not self._should_filter(line):
                self.original_stderr.write(line + '\n')
    
    def flush(self) -> None:
        """Flush remaining buffer and original stderr."""
        if self.buffer:
            # Filter out malloc stack logging warnings
            if not self._should_filter(self.buffer):
                self.original_stderr.write(self.buffer)
            self.buffer = ''
        self.original_stderr.flush()
    
    def __getattr__(self, name: str):
        """Delegate other attributes to original stderr."""
        return getattr(self.original_stderr, name)

