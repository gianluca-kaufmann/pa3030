"""
Dataset: FAO GAUL 2015 level-0 (ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level0")).
Purpose: Create a 1 km binary land mask (USA) as a backbone GeoTIFF.
Overview: Authenticates with Google Earth Engine, extracts the USA boundary
          polygon, burns it into a 1 km raster in EPSG:3857,
          and exports a float GeoTIFF with on-land pixels set to 1 and off-land
          pixels set to 0.
Usage: export EE_PROJECT_ID=<your-project-id> && python "scripts/regions/usa/1_extraction/backbone_export"
"""

import os
from typing import Optional

import ee

PROJECT_ID = os.environ.get("EE_PROJECT_ID")
EXPORT_FOLDER = "GEE_exports"
EXPORT_FILENAME = "backbone_GEE"
EXPORT_DESCRIPTION = "USA_backbone_1km"
CRS = "EPSG:3857"
KM = 1000
MAX_PIXELS = 1e13
GAUL_COLLECTION = "FAO/GAUL_SIMPLIFIED_500m/2015/level0"

USA_COUNTRIES = [
    "United States of America",
]

# Contiguous US (CONUS) bounding box in WGS84 (lon/lat)
# Excludes Alaska, Hawaii, and US territories to match the extent of
# data rasters (WDPA, WorldClim, etc.) that only cover the mainland.
CONUS_BBOX = {
    "west": -125.0,
    "east": -66.0,
    "south": 24.0,
    "north": 50.0,
}


def initialize_earth_engine(project_id: Optional[str] = None) -> None:
    """Authenticate and initialize Earth Engine with an optional project."""
    try:
        if project_id:
            ee.Initialize(project=project_id)
        else:
            ee.Initialize()
        print("Earth Engine initialized.")
    except Exception as exc:
        print(f"Initialization failed: {exc}")
        print("Attempting interactive authentication...")
        ee.Authenticate()
        if project_id:
            ee.Initialize(project=project_id)
        else:
            ee.Initialize()
        print("Earth Engine initialized after authentication.")


def get_usa_geometry() -> ee.Geometry:
    """Return a dissolved CONUS geometry using GAUL level-0 boundaries.
    
    The full USA geometry from GAUL includes Alaska, Hawaii, and territories,
    which creates a very large bounding box. Most data rasters (WDPA, WorldClim,
    etc.) only cover the contiguous US. This function clips the USA boundary to
    the CONUS bounding box to match the data extent and avoid wasting pixels.
    """
    countries = ee.FeatureCollection(GAUL_COLLECTION)
    region_fc = countries.filter(ee.Filter.inList("ADM0_NAME", USA_COUNTRIES))
    usa_full = region_fc.geometry().dissolve()
    
    # Clip to CONUS bounding box (excludes Alaska, Hawaii, territories)
    conus_bbox = ee.Geometry.BBox(
        CONUS_BBOX["west"], CONUS_BBOX["south"],
        CONUS_BBOX["east"], CONUS_BBOX["north"],
    )
    region = usa_full.intersection(conus_bbox, ee.ErrorMargin(100, "meters"))
    print("CONUS geometry assembled from GAUL (Alaska, Hawaii, territories excluded).")
    return region


def build_backbone_image(region: ee.Geometry) -> ee.Image:
    """Create a float image with USA pixels set to 1 and others to 0.
    
    Note: No .reproject() here — the export task specifies crs and scale,
    which is sufficient. Calling .reproject() mid-pipeline forces GEE to
    materialize the image eagerly, breaking lazy evaluation and making
    exports orders of magnitude slower.
    """
    backbone = (
        ee.Image.constant(1)
        .toFloat()
        .clip(region)
        .unmask(0)
        .rename("backbone")
    )

    print("Backbone image prepared (1 for land, 0 outside).")
    return backbone


def export_backbone_image(image: ee.Image, region: ee.Geometry) -> None:
    """Export the backbone land mask to Google Drive."""
    export_region = region.bounds()

    task = ee.batch.Export.image.toDrive(
        image=image,
        description=EXPORT_DESCRIPTION,
        folder=EXPORT_FOLDER,
        fileNamePrefix=EXPORT_FILENAME,
        region=export_region,
        crs=CRS,
        scale=KM,
        maxPixels=MAX_PIXELS,
        fileFormat="GeoTIFF",
        formatOptions={"cloudOptimized": True, "noData": -9999},
    )

    task.start()
    print("Export task started:", task.id)


def main() -> None:
    initialize_earth_engine(PROJECT_ID)
    region = get_usa_geometry()
    backbone_image = build_backbone_image(region)
    export_backbone_image(backbone_image, region)
    print(
        "Backbone export script completed. Monitor the Tasks tab in the EE Code Editor "
        "or ee.batch.Task.list()."
    )
    print("\nNote: This version exports CONUS only (Alaska, Hawaii, territories excluded).")
    print("This matches the extent of data rasters (WDPA, WorldClim, etc.).")


if __name__ == "__main__":
    main()

