#!/usr/bin/env python3
"""Leave-One-Biome-Out (LOBO) Spatial CV — USA (Layer 1)

Trains LightGBM on all biomes except one, then evaluates on the held-out
biome's test-year pixels.  Run once per biome fold (as a SLURM array job).

Usage:
    python scripts/regions/usa/6_evaluation/spatial_CV_1 --list-biomes
    python scripts/regions/usa/6_evaluation/spatial_CV_1 --biome-idx 0

SLURM:
    sbatch slurm/usa/spatial_cv_lobo.slurm

Output:
    outputs/usa/results/spatial_cv/
        fold_<N>_<biome_slug>_<timestamp>.json
        fold_<N>_<biome_slug>_<timestamp>.txt
        spatial_cv1_scored_<biome_slug>_<timestamp>.parquet

Prerequisite:
    data/usa/ready/GSN/gsn_terrestrial_ecoregions_mask_1km.tif must exist.
    Run scripts/regions/usa/2_preprocessing/gsn_preprocessing if missing.

See scripts/regions/shared/evaluation/spatial_cv_core.py for full implementation.
"""

from scripts.regions.shared.evaluation.spatial_cv_core import run_lobo_main

if __name__ == "__main__":
    run_lobo_main(region="usa", model_id="model2")
