#!/usr/bin/env python3

"""
Temporal split script for model2 training/earlystop/test splits (USA dataset)
with 5-year lookahead target.

Supports two split configurations:
- 'main': TRAIN (2001–2016), EARLYSTOP (2014–2016), TEST (2017–2019)
- 'robustness': TRAIN (2001–2015), EARLYSTOP (2013–2015), TEST (2016–2019)

Rules
-----
TRAIN:
  - Full risk set (no sampling)
  - Used for final model training

EARLYSTOP:
  - Full risk set (no sampling)
  - Used only for early stopping during CV, not for evaluation
  - Note: EARLYSTOP is a subset of TRAIN, but kept as separate file for CV folds

TEST:
  - Full risk set (no sampling)
  - Right-censored at max_year - 5 to ensure 5-year lookahead window
  - Used for final model evaluation

5-Year Lookahead Target:
  - Compute first_transition_year per (row, col) as min(year) where transition_01==1
  - Add transition_01_win5: for each row at year t, set to 1 if first_transition_year exists 
    AND t < first_transition_year <= t+5, else 0
  - Filter to year <= max_year-5 to handle right-censoring

Notes
-----
- Simple temporal split with no sampling
- TRAIN contains all training data for final model training
- EARLYSTOP is a subset of TRAIN, kept as separate file for CV early stopping only
- TEST is used for final model evaluation
- Right-censoring: max_year is computed from data and rows with year > max_year-5 are excluded
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

import duckdb
import wandb

# Configuration
RANDOM_STATE = 42

# Split configurations - supports both main and robustness splits
# Matches modelC configuration exactly (scale-up only)
# Note: train and earlystop are non-overlapping; training scripts combine them for final model
SPLIT_CONFIGS = {
    'main': {
        'train_years': (2001, 2016),
        'earlystop_years': (2014, 2016),
        'test_years': (2017, 2019),
        'description': 'Main split: Train 2001-2013, Earlystop 2014-2016, Test 2017-2019 (matches modelC)'
    },
    'robustness': {
        'train_years': (2001, 2015),
        'earlystop_years': (2013, 2015),
        'test_years': (2016, 2019),
        'description': 'Robustness split: Train 2001-2012, Earlystop 2013-2015, Test 2016-2019'
    }
}

LOOKAHEAD_YEARS = 5          # Number of years to look ahead for target
WANDB_PROJECT = "ml-preprocessing"


def get_repo_root() -> Path:
    """Get repository root directory.

    Checks environment variables first, then searches upward for README.md.
    """
    env_root = os.environ.get("PROJECT_ROOT") or os.environ.get("REPO_ROOT")
    if env_root:
        return Path(env_root).resolve()
    script_dir = Path(__file__).resolve().parent
    current = script_dir
    for _ in range(10):
        if (current / "README.md").exists():
            return current
        parent = current.parent
        if parent == current:
            break
        current = parent
    raise RuntimeError(
        f"Repository root not found. Searched upward from {script_dir} for README.md.\n"
        "Set PROJECT_ROOT or REPO_ROOT environment variable, or ensure README.md exists in repo root."
    )


def resolve_input() -> Path:
    """Locate merged_panel_final.parquet (prefer $SCRATCH if present)."""
    repo_root = get_repo_root()
    scratch_root = Path(os.environ["SCRATCH"]) if os.environ.get("SCRATCH") else None

    candidates = []
    if scratch_root is not None:
        # Check outputs/usa/results first (standard Euler location from features script)
        candidates.append(scratch_root / "outputs/usa/results/merged_panel_final.parquet")
        # Also check data/usa/ml location
        candidates.append(scratch_root / "data/usa/ml/merged_panel_final.parquet")
    candidates.append(repo_root / "outputs/usa/results/merged_panel_final.parquet")
    candidates.append(repo_root / "data/usa/ml/merged_panel_final.parquet")

    for cand in candidates:
        if cand.exists():
            return cand

    # Provide detailed error message with all checked paths
    error_msg = "merged_panel_final.parquet not found in expected locations.\n"
    error_msg += "\nChecked locations:\n"
    for cand in candidates:
        error_msg += f"  - {cand}\n"
    if scratch_root:
        error_msg += f"\nSCRATCH root: {scratch_root}\n"
    error_msg += f"Repository root: {repo_root}\n"
    raise FileNotFoundError(error_msg)


def configure_duckdb(con: duckdb.DuckDBPyConnection) -> None:
    """Apply sensible local/Euler defaults."""
    is_euler = bool(os.environ.get("SCRATCH"))
    slurm_cpus = int(os.environ.get("SLURM_CPUS_PER_TASK", "0"))
    num_threads = slurm_cpus if slurm_cpus > 0 else (48 if is_euler else 4)

    # Match DuckDB memory to Slurm allocation when present
    slurm_mem_per_cpu_mb = os.environ.get("SLURM_MEM_PER_CPU")
    if slurm_mem_per_cpu_mb and slurm_cpus:
        total_mem_mb = int(slurm_mem_per_cpu_mb) * slurm_cpus
        memory_limit_gb = max(1, total_mem_mb // 1024)
    else:
        memory_limit_gb = 128 if is_euler else 16

    con.execute(f"SET threads={num_threads}")
    con.execute("SET preserve_insertion_order=false")
    con.execute(f"SET memory_limit='{memory_limit_gb}GB'")

    temp_dir = os.environ.get("SCRATCH") or (Path(__file__).parent / "temp")
    # Ensure temp directory exists (DuckDB won't create parent directories)
    if isinstance(temp_dir, str):
        temp_dir = Path(temp_dir)
    temp_dir.mkdir(parents=True, exist_ok=True)
    # Create duckdb_temp subdirectory
    duckdb_temp_dir = temp_dir / "duckdb_temp"
    duckdb_temp_dir.mkdir(parents=True, exist_ok=True)
    temp_dir_sql = str(temp_dir).replace("'", "''")
    con.execute(f"SET temp_directory='{temp_dir_sql}/duckdb_temp'")

    if is_euler:
        con.execute("PRAGMA max_temp_directory_size='200GB'")

    print(f"DuckDB configured: {num_threads} threads, {memory_limit_gb}GB memory")
    print(f"Running on: {'Euler cluster' if is_euler else 'local machine'}")


def log_year_counts(con: duckdb.DuckDBPyConnection, parquet_path: Path, label: str, target_col: str = "transition_01", use_wandb: bool = False) -> None:
    escaped = str(parquet_path).replace("'", "''")
    rows = con.execute(
        f"""
        SELECT
            year,
            SUM({target_col}) AS positives,
            SUM(CASE WHEN {target_col} = 0 THEN 1 ELSE 0 END) AS negatives,
            COUNT(*) AS total,
            CASE WHEN COUNT(*) > 0 THEN SUM({target_col})::DOUBLE / COUNT(*) ELSE 0 END AS pos_ratio,
            CASE WHEN SUM({target_col}) > 0 
                 THEN SUM(CASE WHEN {target_col} = 0 THEN 1 ELSE 0 END)::DOUBLE / SUM({target_col})
                 ELSE 0 END AS neg_pos_ratio
        FROM read_parquet('{escaped}')
        GROUP BY year
        ORDER BY year
        """
    ).fetchall()

    print(f"\n{label} per-year counts (target: {target_col}):")
    for year, pos, neg, total, pos_ratio, neg_pos_ratio in rows:
        print(f"  {year}: total={total:,} pos={pos:,} neg={neg:,} | pos_ratio={pos_ratio:.5f} neg/pos={neg_pos_ratio:.1f}")

    if use_wandb:
        wandb.log({f"{label.lower().replace(' ', '_')}/per_year_{target_col}": [
            dict(year=y, positives=p, negatives=n, total=t, pos_ratio=r, neg_pos_ratio=npr) 
            for y, p, n, t, r, npr in rows
        ]})


def main(split_version: str = 'main') -> None:
    start_time = time.time()

    # Get split configuration
    if split_version not in SPLIT_CONFIGS:
        raise ValueError(f"Invalid split_version: {split_version}. Must be one of: {list(SPLIT_CONFIGS.keys())}")
    
    config = SPLIT_CONFIGS[split_version]
    TRAIN_YEARS = config['train_years']
    EARLYSTOP_YEARS = config['earlystop_years']
    TEST_YEARS = config['test_years']
    
    print(f"\n{'='*70}")
    print(f"SPLIT VERSION: {split_version.upper()}")
    print(f"{'='*70}")
    print(f"Configuration: {config['description']}")
    print(f"  TRAIN: {TRAIN_YEARS[0]}-{TRAIN_YEARS[1]} ({TRAIN_YEARS[1]-TRAIN_YEARS[0]+1} years)")
    print(f"  EARLYSTOP: {EARLYSTOP_YEARS[0]}-{EARLYSTOP_YEARS[1]} ({EARLYSTOP_YEARS[1]-EARLYSTOP_YEARS[0]+1} years)")
    print(f"  TEST: {TEST_YEARS[0]}-{TEST_YEARS[1]} ({TEST_YEARS[1]-TEST_YEARS[0]+1} years)")
    print(f"{'='*70}\n")

    wandb_api_key = os.environ.get("WANDB_API_KEY")
    wandb_entity = os.environ.get("WANDB_ENTITY")
    if not wandb_api_key:
        print("Warning: WANDB_API_KEY not found in environment")
    if not wandb_entity:
        print("Warning: WANDB_ENTITY not found in environment (will use default)")
    
    use_wandb = False
    try:
        print("Initializing Weights & Biases...")
        wandb.init(
            project=WANDB_PROJECT,
            entity=wandb_entity,
            name=f"model2_preprocessing_win5_{split_version}_{time.strftime('%Y%m%d_%H%M%S')}",
            config={
                "random_state": RANDOM_STATE,
                "split_version": split_version,
                "train_years": TRAIN_YEARS,
                "earlystop_years": EARLYSTOP_YEARS,
                "test_years": TEST_YEARS,
                "lookahead_years": LOOKAHEAD_YEARS,
                "sampling_method": "temporal_split_full_win5",
            },
        )
        use_wandb = True
        print("W&B connected\n")
    except Exception as err:
        print(f"W&B initialization failed: {err}\n")

    input_path = resolve_input()
    base_dir = input_path.parent
    
    # Create split-specific subdirectory
    split_dir = base_dir / split_version
    split_dir.mkdir(parents=True, exist_ok=True)
    
    # Output paths for win5 files (in split-specific subdirectory)
    merged_win5_out = split_dir / "merged_panel_final_win5.parquet"
    train_out = split_dir / "train_win5.parquet"
    earlystop_out = split_dir / "earlystop_win5.parquet"
    test_out = split_dir / "test_win5.parquet"

    print(f"\nInput: {input_path}")
    print(f"Output directory: {split_dir}")
    print(f"Merged WIN5 output: {merged_win5_out}")
    print(f"TRAIN output: {train_out}")
    print(f"EARLYSTOP output: {earlystop_out}")
    print(f"TEST output: {test_out}")

    con = duckdb.connect()
    configure_duckdb(con)

    escaped_in = str(input_path).replace("'", "''")
    escaped_merged_win5 = str(merged_win5_out).replace("'", "''")
    escaped_train = str(train_out).replace("'", "''")
    escaped_earlystop = str(earlystop_out).replace("'", "''")
    escaped_test = str(test_out).replace("'", "''")

    try:
        print("\n" + "="*70)
        print("STEP 1: Computing year range")
        print("="*70)

        # Step 1: Get min_year and max_year from data.
        # min_year is used to exclude the first data year from both first_transitions and the
        # observation panel. In feature_engineering, WDPA_prev is forced to 0 for every pixel
        # in the very first year of the panel (no prior-year WDPA data is available). For the
        # USA, which has an extensive pre-existing PA network, this causes every pixel already
        # protected at data-start to appear as transition_01=1 in year min_year — producing
        # thousands of "phantom" first-year transitions. Because their first_transition_year
        # equals min_year, the win5 lookback window (year < min_year) falls entirely before the
        # data starts, so win5=0 for all of them. These phantom rows inflate transition_01 while
        # contributing nothing to win5, which is why win5 < transition_01 in the raw panel.
        # Excluding year min_year from first_transitions and from the observation panel removes
        # this artifact. This is safe because all temporal splits start at min_year+1 at the
        # earliest, so no split output is affected.
        step1_start = time.time()
        max_year_result = con.execute(f"SELECT MAX(year) FROM read_parquet('{escaped_in}')").fetchone()
        max_year = max_year_result[0] if max_year_result else 2024
        min_year_result = con.execute(f"SELECT MIN(year) FROM read_parquet('{escaped_in}')").fetchone()
        min_year = min_year_result[0] if min_year_result else 2001
        cutoff_year = max_year - LOOKAHEAD_YEARS
        first_obs_year = min_year + 1

        print(f"  Min year in data: {min_year}")
        print(f"  Max year in data: {max_year}")
        print(f"  First observation year: {first_obs_year} (year {min_year} excluded: WDPA_prev forced to 0 for first data year)")
        print(f"  Cutoff year (max_year - {LOOKAHEAD_YEARS}): {cutoff_year}")
        print(f"  Observation window: {first_obs_year} <= year <= {cutoff_year}")
        print(f"  Completed in {time.time() - step1_start:.1f}s")

        print("\n" + "="*70)
        print("STEP 2: Computing first_transition_year per (row, col)")
        print("="*70)

        # Step 2: Compute first_transition_year per (row, col).
        # Restricted to year > min_year to exclude phantom transitions that arise because
        # WDPA_prev is forced to 0 in the first data year (see Step 1 comment above).
        # Note: this filter does NOT change any win5 label — pixels whose only transition_01=1
        # row is in year min_year would have first_transition_year=min_year and win5=0
        # everywhere regardless (their lookback window falls before the data start). The filter
        # simply removes them from the lookup table so the comparison stats are meaningful.
        first_transition_sql = f"""
        CREATE OR REPLACE TEMP TABLE first_transitions AS
        SELECT
            row,
            col,
            MIN(year) AS first_transition_year
        FROM read_parquet('{escaped_in}')
        WHERE transition_01 = 1 AND year > {min_year}
        GROUP BY row, col
        """

        step2_start = time.time()
        con.execute(first_transition_sql)
        n_transitions = con.execute("SELECT COUNT(*) FROM first_transitions").fetchone()[0]
        print(f"  Found {n_transitions:,} (row, col) pairs with transitions (year > {min_year})")
        print(f"  Completed in {time.time() - step2_start:.1f}s")

        print("\n" + "="*70)
        print("STEP 3: Creating merged panel with transition_01_win5")
        print("="*70)

        # Step 3: Create merged panel with transition_01_win5.
        # For each row at year t, set transition_01_win5 = 1 if first_transition_year exists
        # AND t < first_transition_year <= t+5, else 0.
        # Panel is restricted to first_obs_year <= year <= cutoff_year: the lower bound drops
        # the first data year (phantom transitions, see Step 1); the upper bound is the
        # right-censoring cutoff so every included row has a full 5-year lookahead window.
        merged_win5_sql = f"""
        COPY (
            SELECT
                d.*,
                CASE 
                    WHEN ft.first_transition_year IS NOT NULL 
                         AND d.year < ft.first_transition_year 
                         AND ft.first_transition_year <= d.year + {LOOKAHEAD_YEARS}
                    THEN 1
                    ELSE 0
                END AS transition_01_win5
            FROM read_parquet('{escaped_in}') d
            LEFT JOIN first_transitions ft
                ON d.row = ft.row AND d.col = ft.col
            WHERE d.year >= {first_obs_year} AND d.year <= {cutoff_year}
        )
        TO '{escaped_merged_win5}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """
        
        step3_start = time.time()
        con.execute(merged_win5_sql)
        print(f"  Merged panel with win5 target written in {time.time() - step3_start:.1f}s")
        
        # Log counts for merged win5
        log_year_counts(con, merged_win5_out, "MERGED_WIN5", "transition_01_win5", use_wandb)
        
        print("\n" + "="*70)
        print("COMPARISON: transition_01 vs transition_01_win5")
        print("="*70)
        
        # Compare total positives
        comparison_stats = con.execute(
            f"""
            SELECT
                SUM(transition_01) AS total_pos_original,
                SUM(transition_01_win5) AS total_pos_win5,
                COUNT(DISTINCT CASE WHEN transition_01 = 1 THEN (row::BIGINT<<32) + col END) AS distinct_rc_original,
                COUNT(DISTINCT CASE WHEN transition_01_win5 = 1 THEN (row::BIGINT<<32) + col END) AS distinct_rc_win5
            FROM read_parquet('{escaped_merged_win5}')
            """
        ).fetchone()
        
        total_pos_original, total_pos_win5, distinct_rc_original, distinct_rc_win5 = comparison_stats
        
        print(f"\nTotal positives:")
        print(f"  transition_01:        {total_pos_original:,}")
        print(f"  transition_01_win5:   {total_pos_win5:,}")
        if total_pos_original > 0:
            ratio = total_pos_win5 / total_pos_original
            print(f"  Ratio (win5/original): {ratio:.3f}x")
            if total_pos_win5 <= total_pos_original:
                print(f"  WARNING: win5 positives ({total_pos_win5:,}) <= original ({total_pos_original:,})")
            else:
                print(f"  win5 has more positives (expected)")
        
        print(f"\nDistinct (row,col) with positives:")
        print(f"  transition_01:        {distinct_rc_original:,}")
        print(f"  transition_01_win5:   {distinct_rc_win5:,}")
        if distinct_rc_original > 0:
            ratio_rc = distinct_rc_win5 / distinct_rc_original
            print(f"  Ratio (win5/original): {ratio_rc:.3f}x")
            if distinct_rc_win5 <= distinct_rc_original:
                print(f"  WARNING: win5 distinct (row,col) ({distinct_rc_win5:,}) <= original ({distinct_rc_original:,})")
            else:
                print(f"  win5 has more distinct (row,col) with positives (expected)")
        
        if use_wandb:
            wandb.log({
                "comparison/total_pos_original": int(total_pos_original),
                "comparison/total_pos_win5": int(total_pos_win5),
                "comparison/total_pos_ratio": float(total_pos_win5 / total_pos_original) if total_pos_original > 0 else 0.0,
                "comparison/distinct_rc_original": int(distinct_rc_original),
                "comparison/distinct_rc_win5": int(distinct_rc_win5),
                "comparison/distinct_rc_ratio": float(distinct_rc_win5 / distinct_rc_original) if distinct_rc_original > 0 else 0.0,
            })
        
        print("\n" + "="*70)
        print("STEP 4: Creating temporal splits")
        print("="*70)
        
        # TRAIN: full risk set
        train_sql = f"""
        COPY (
            SELECT
                *
            FROM read_parquet('{escaped_merged_win5}')
            WHERE year BETWEEN {TRAIN_YEARS[0]} AND {TRAIN_YEARS[1]}
        )
        TO '{escaped_train}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating TRAIN split ({TRAIN_YEARS[0]}–{TRAIN_YEARS[1]}, full risk set)...")
        train_start = time.time()
        con.execute(train_sql)
        print(f"TRAIN written in {time.time() - train_start:.1f}s")

        # EARLYSTOP: full risk set (for early stopping during CV only, not evaluation)
        earlystop_sql = f"""
        COPY (
            SELECT
                *
            FROM read_parquet('{escaped_merged_win5}')
            WHERE year BETWEEN {EARLYSTOP_YEARS[0]} AND {EARLYSTOP_YEARS[1]}
        )
        TO '{escaped_earlystop}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating EARLYSTOP split ({EARLYSTOP_YEARS[0]}–{EARLYSTOP_YEARS[1]}, for early stopping during CV only)...")
        earlystop_start = time.time()
        con.execute(earlystop_sql)
        print(f"EARLYSTOP written in {time.time() - earlystop_start:.1f}s")

        # TEST: full risk set (right-censored)
        test_sql = f"""
        COPY (
            SELECT
                *
            FROM read_parquet('{escaped_merged_win5}')
            WHERE year BETWEEN {TEST_YEARS[0]} AND {TEST_YEARS[1]}
        )
        TO '{escaped_test}' (FORMAT PARQUET, COMPRESSION ZSTD)
        """

        print(f"\nCreating TEST split ({TEST_YEARS[0]}–{TEST_YEARS[1]}, full risk set, right-censored)...")
        test_start = time.time()
        con.execute(test_sql)
        print(f"TEST written in {time.time() - test_start:.1f}s")

        # Log counts for both original and win5 targets
        print("\n" + "="*70)
        print("PER-YEAR STATISTICS")
        print("="*70)
        log_year_counts(con, train_out, "TRAIN", "transition_01", use_wandb)
        log_year_counts(con, train_out, "TRAIN", "transition_01_win5", use_wandb)
        # EARLYSTOP stats logged for information, but EARLYSTOP is only used for early stopping during CV, not evaluation
        log_year_counts(con, earlystop_out, "EARLYSTOP", "transition_01", use_wandb)
        log_year_counts(con, earlystop_out, "EARLYSTOP", "transition_01_win5", use_wandb)
        log_year_counts(con, test_out, "TEST", "transition_01", use_wandb)
        log_year_counts(con, test_out, "TEST", "transition_01_win5", use_wandb)

        # Check total rows
        total_train_rows = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_train}')"
        ).fetchone()[0]
        
        total_earlystop_rows = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_earlystop}')"
        ).fetchone()[0]
        
        total_test_rows = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{escaped_test}')"
        ).fetchone()[0]
        
        print(f"\nTotal rows:")
        print(f"  TRAIN: {total_train_rows:,}")
        print(f"  EARLYSTOP: {total_earlystop_rows:,}")
        print(f"  TEST: {total_test_rows:,}")

        if use_wandb:
            wandb.log(
                {
                    "train/rows": total_train_rows,
                    "earlystop/rows": total_earlystop_rows,
                    "test/rows": total_test_rows,
                    "lookahead_years": LOOKAHEAD_YEARS,
                    "cutoff_year": cutoff_year,
                    "max_year": max_year,
                    "timing/total_seconds": time.time() - start_time,
                }
            )

        print("\nDone.")

    except Exception as e:
        error_msg = f"{type(e).__name__}: {e}"
        print(f"\nERROR: {error_msg}")
        if use_wandb:
            wandb.log({"status": "failed", "error": error_msg})
        raise
    finally:
        if use_wandb:
            wandb.finish()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Model2 preprocessing: temporal split with 5-year lookahead target"
    )
    parser.add_argument(
        "--split-version",
        type=str,
        choices=list(SPLIT_CONFIGS.keys()),
        default="main",
        help=f"Split configuration to use. Choices: {', '.join(SPLIT_CONFIGS.keys())} (default: main)"
    )
    args = parser.parse_args()
    
    try:
        main(split_version=args.split_version)
    except Exception as e:
        print(f"\nScript failed: {e}", file=sys.stderr)
        sys.exit(1)

