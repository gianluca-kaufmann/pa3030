#!/usr/bin/env python3
"""
Economic Value Preprocessing — USA
====================================

Spatially allocates FAO national gross agricultural production value (GPV)
across cropland and pasture pixels derived from MODIS land cover data.

Inputs:
  - data/shared/FAO/value_agr.prod.csv
  - data/usa/ready/landcover/  (MODIS IGBP rasters, 1 km, 2000-2024)
  - data/usa/ready/backbone/backbone.tif
  - data/usa/ready/policy/country_iso3.tif + country_iso3_mapping.json
    (preferred; fallback: Natural Earth 10 m admin boundaries)

Outputs:
  - data/usa/ready/economic_value/economic_value_{year}.tif
    float32, LZW-compressed, tiled 512×512, nodata=NaN, 2000-2024
  - data/usa/ready/economic_value/validation_totals.csv

Algorithm (see scripts/utils/economic_value_utils.py for full details)
-----------------------------------------------------------------------
For each agricultural pixel i in country c at year y:

    value_usd_ha_i = FAO_GPV(c, y) * LC_WEIGHT[lc_class_i]
                     / Σ_j (LC_WEIGHT[lc_class_j] * 100 ha)

  Cropland pixels (IGBP 12, 14) → weight 1.0
  Pasture/rangeland pixels (IGBP 8, 9, 10) → weight 0.3
  All other pixels within country boundary → value 0
  Pixels outside all country boundaries → NaN

National totals are preserved exactly (to float32 precision).
"""

from __future__ import annotations

import sys
from pathlib import Path

# ── Import shared utilities ────────────────────────────────────────────────────

PROJECT_ROOT = Path(__file__).resolve().parents[4]
_utils_dir = str(PROJECT_ROOT / "scripts" / "utils")
if _utils_dir not in sys.path:
    sys.path.insert(0, _utils_dir)

from economic_value_utils import (  # noqa: E402  # pyright: ignore[reportMissingImports]
    YEAR_MIN,
    YEAR_MAX,
    build_country_raster_from_natural_earth,
    build_fao_table,
    load_backbone,
    load_country_raster_from_policy,
    write_yearly_rasters,
)

# ── Paths ──────────────────────────────────────────────────────────────────────

DATA_DIR = PROJECT_ROOT / "data"
READY_DIR = DATA_DIR / "usa" / "ready"
OUTPUT_DIR = READY_DIR / "economic_value"
LANDCOVER_DIR = READY_DIR / "landcover"
BACKBONE_PATH = READY_DIR / "backbone" / "backbone.tif"
VALUE_PATH = DATA_DIR / "shared" / "FAO" / "value_agr.prod.csv"
POLICY_RASTER = READY_DIR / "policy" / "country_iso3.tif"
POLICY_MAP = READY_DIR / "policy" / "country_iso3_mapping.json"

# ── Region constants ───────────────────────────────────────────────────────────

USA_COUNTRY_ID: dict[int, str] = {1: "USA"}
USA_TERRITORIES: list[str] = ["USA"]
USA_POLICY_ISO3: set[str] = {"USA"}

USA_NE_ISO3_COL_PREFERENCE: list[str] = ["ADM0_A3", "ISO_A3", "GU_A3", "iso_a3"]


# ── Country raster ─────────────────────────────────────────────────────────────


def get_country_raster(backbone, shape, transform, crs):
    """Load or build the country integer raster and id→ISO3 mapping."""
    result = load_country_raster_from_policy(POLICY_RASTER, POLICY_MAP)
    if result is not None:
        return result
    return build_country_raster_from_natural_earth(
        backbone=backbone,
        shape=shape,
        transform=transform,
        crs=crs,
        territories=USA_TERRITORIES,
        country_id=USA_COUNTRY_ID,
        iso3_col_preference=USA_NE_ISO3_COL_PREFERENCE,
    )


# ── Entry point ────────────────────────────────────────────────────────────────


def main() -> None:
    print("Economic Value Preprocessing — USA")
    print("=" * 60)

    if not VALUE_PATH.exists():
        raise FileNotFoundError(f"Missing FAO production value data: {VALUE_PATH}")
    if not LANDCOVER_DIR.exists():
        raise FileNotFoundError(
            f"Land-cover directory not found: {LANDCOVER_DIR}\n"
            "Run the MODIS land-cover extraction step first."
        )

    profile, backbone, transform, shape, crs = load_backbone(BACKBONE_PATH)
    country_raster, id_to_iso3 = get_country_raster(backbone, shape, transform, crs)

    fao_df = build_fao_table(
        value_path=VALUE_PATH,
        policy_iso3=USA_POLICY_ISO3,
        year_min=YEAR_MIN,
        year_max=YEAR_MAX,
    )

    write_yearly_rasters(
        fao_df=fao_df,
        country_raster=country_raster,
        id_to_iso3=id_to_iso3,
        lc_dir=LANDCOVER_DIR,
        output_dir=OUTPUT_DIR,
        profile=profile,
        year_min=YEAR_MIN,
        year_max=YEAR_MAX,
    )

    print("\nDone.")


if __name__ == "__main__":
    main()
