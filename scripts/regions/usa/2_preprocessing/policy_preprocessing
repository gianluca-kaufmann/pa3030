#!/usr/bin/env python3
"""
Policy Variables Preprocessing
==============================

Objective:
    Convert raw institutional / political datasets (WGI, V-Dem, DPI) into
    per-variable per-year rasters aligned to the backbone grid.  Each pixel
    receives the policy value of the country it belongs to.  This makes
    policy data consistent with all other preprocessed features — the merge
    script can discover and stack them like any other yearly raster.

Source data (global, in ``data/shared/``):
    - WGI:  ``WGI/wgidataset_with_sourcedata-2025 (1).xlsx`` (sheets ``ge``, ``rl``)
    - V-Dem: ``VDem/V-Dem-CY-Core-v15.csv``  (column ``v2x_libdem``)
    - DPI:   ``DPI/DPI2020.csv``  (column ``execrlc``)

Region-specific inputs:
    - Backbone raster: ``data/usa/ready/backbone/backbone.tif``
    - Natural Earth admin-0 boundaries (downloaded or built-in)

Outputs (in ``data/usa/ready/policy/``):
    Per-variable per-year rasters (float32, backbone-aligned):
    - ``wgi_ge_YYYY.tif``            : WGI Government Effectiveness (~-2.5 to +2.5)
    - ``wgi_rl_YYYY.tif``            : WGI Rule of Law (~-2.5 to +2.5)
    - ``vdem_ldi_YYYY.tif``          : V-Dem Liberal Democracy Index (0–1)
    - ``dpi_exec_ideology_YYYY.tif`` : DPI Executive ideology (-1=Left, 0=Center, +1=Right)

    Auxiliary files:
    - ``country_iso3.tif``           : uint8 country-ID raster (for debugging)
    - ``country_iso3_mapping.json``  : JSON {id: iso3} mapping

Country coverage:
    USA

Notes:
    - DPI data ends in 2020; later years have NaN for dpi_exec_ideology.
    - Rasters contain the actual (un-lagged) values for each year.
      Any lag (e.g., t-1) should be applied downstream (feature engineering).
"""

from __future__ import annotations

import json
import os
import re
import warnings
from pathlib import Path

import geopandas as gpd
import numpy as np
import pandas as pd
import rasterio
from rasterio.features import rasterize
from scipy.ndimage import distance_transform_edt

warnings.filterwarnings("ignore")

# DPI ``ifs`` may be ISO3 strings or ISO-3166 numeric codes (same for all regions).
ISO3166_NUMERIC_TO_ALPHA3: dict[int, str] = {
    96: "BRN",
    116: "KHM",
    360: "IDN",
    418: "LAO",
    458: "MYS",
    104: "MMR",
    608: "PHL",
    702: "SGP",
    764: "THA",
    626: "TLS",
    704: "VNM",
    32: "ARG",
    68: "BOL",
    76: "BRA",
    152: "CHL",
    170: "COL",
    218: "ECU",
    250: "FRA",
    328: "GUY",
    600: "PRY",
    604: "PER",
    740: "SUR",
    858: "URY",
    862: "VEN",
    840: "USA",
}


def normalize_dpi_ifs_to_iso3(ifs: pd.Series) -> pd.Series:
    """Map DPI ``ifs`` to ISO3 (alpha or numeric). Unrecognized → NaN."""
    out: list = []
    unmapped_numeric: set[int] = set()
    for v in ifs:
        if pd.isna(v):
            out.append(np.nan)
            continue
        if isinstance(v, str):
            s = v.strip()
            if len(s) == 3 and s.isalpha():
                out.append(s.upper())
                continue
            try:
                num = int(float(s))
            except ValueError:
                out.append(np.nan)
                continue
        else:
            try:
                num = int(v)
            except (TypeError, ValueError):
                out.append(np.nan)
                continue
        iso = ISO3166_NUMERIC_TO_ALPHA3.get(num)
        if iso is None:
            unmapped_numeric.add(num)
            out.append(np.nan)
        else:
            out.append(iso)
    if unmapped_numeric:
        sample = sorted(unmapped_numeric)[:15]
        print(
            f"  Warning: DPI `ifs` numeric codes without ISO3 mapping (dropped): "
            f"{sample}{'...' if len(unmapped_numeric) > 15 else ''}"
        )
    return pd.Series(out, index=ifs.index, dtype=object)


def dpi_execrlc_to_ideology(execrlc: pd.Series) -> pd.Series:
    """Map DPI ``execrlc`` to {-1, 0, 1} or NaN."""
    ideology_map = {"Left": -1.0, "Center": 0.0, "Right": 1.0}
    result = np.full(len(execrlc), np.nan, dtype=np.float64)
    for i, raw in enumerate(execrlc):
        if pd.isna(raw):
            continue
        if isinstance(raw, (int, float)) and not isinstance(raw, bool):
            if raw in (-1, 0, 1):
                result[i] = float(raw)
            continue
        s = str(raw).strip()
        if s in ideology_map:
            result[i] = ideology_map[s]
            continue
        try:
            n = float(s)
            if n in (-1.0, 0.0, 1.0):
                result[i] = n
        except ValueError:
            pass
    return pd.Series(result, index=execrlc.index, dtype="float64")


def apply_dpi_executive_forward_fill(policy: pd.DataFrame) -> None:
    """Forward-fill ``dpi_exec_ideology`` within each ``iso3`` (sticky institutions after last DPI year)."""
    if "dpi_exec_ideology" not in policy.columns or "iso3" not in policy.columns:
        return
    policy["dpi_exec_ideology"] = (
        policy.groupby("iso3", sort=False)["dpi_exec_ideology"]
        .transform(lambda s: s.ffill())
    )


