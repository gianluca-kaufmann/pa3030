# Country-code raster
# ---------------------------------------------------------------------------

def load_natural_earth() -> gpd.GeoDataFrame:
    """Load Natural Earth 10m admin-0 countries, filtered to USA."""
    print("\nLoading Natural Earth 10m admin-0 shapefile...")
    try:
        gdf = gpd.read_file(NE_10M_URL)
        print(f"  Downloaded 10m shapefile: {len(gdf)} features")
    except Exception as e:
        print(f"  Failed to download 10m shapefile: {e}")
        print("  Falling back to geopandas built-in naturalearth_lowres...")
        gdf = gpd.read_file(gpd.datasets.get_path("naturalearth_lowres"))
        print(f"  Loaded low-res shapefile: {len(gdf)} features")

    # IMPORTANT: Use ADM0_A3 (country-level) before GU_A3 (map-unit level).
    # In ne_10m_admin_0_map_units, GU_A3 uses sub-national codes ("US1", "USG",
    # "HWI", etc.) while ADM0_A3 always uses the 3-letter country code ("USA").
    # Checking GU_A3 first caused the USA filter to return empty, producing
    # all-NaN policy rasters.
    iso3_col = None
    for candidate in ["ADM0_A3", "ISO_A3", "GU_A3", "iso_a3"]:
        if candidate in gdf.columns:
            iso3_col = candidate
            break
    if iso3_col is None:
        raise ValueError(f"Cannot find ISO3 column. Available: {list(gdf.columns)}")
    print(f"  Using ISO3 column: {iso3_col}")

    gdf_usa = gdf[gdf[iso3_col].isin(USA_TERRITORIES)].copy()
    if gdf_usa.empty:
        raise ValueError(
            f"No features found for USA_TERRITORIES={USA_TERRITORIES} "
            f"in column '{iso3_col}'.\n"
            f"  Unique values (sample): {sorted(gdf[iso3_col].unique())[:20]}\n"
            f"  Try a different ISO3 column or update USA_TERRITORIES."
        )
    gdf_usa = gdf_usa[[iso3_col, "geometry"]].rename(columns={iso3_col: "iso3"})
    print(f"  USA territories found: {sorted(gdf_usa['iso3'].unique())}")

    return gdf_usa


def create_country_raster(gdf_usa: gpd.GeoDataFrame) -> tuple[np.ndarray, dict]:
    """Rasterize USA country polygon onto the backbone grid."""
    print("\nCreating country-code raster...")

    if not BACKBONE_PATH.exists():
        raise FileNotFoundError(
            f"Backbone raster not found: {BACKBONE_PATH}. "
            "Run backbone_preprocessing first."
        )

    with rasterio.open(BACKBONE_PATH) as src:
        profile = src.profile.copy()
        backbone_transform = src.transform
        backbone_shape = (src.height, src.width)
        backbone_data = src.read(1)

    print(f"  Backbone: {backbone_shape}")

    if gdf_usa.crs is None:
        gdf_usa = gdf_usa.set_crs("EPSG:4326")
    gdf_proj = gdf_usa.to_crs(BACKBONE_CRS_EPSG)
    print(f"  Reprojected {len(gdf_proj)} country polygons to {BACKBONE_CRS_EPSG}")

    territory_to_id = {v: k for k, v in USA_COUNTRY_ID.items()}
    shapes = []
    for _, row in gdf_proj.iterrows():
        cid = territory_to_id.get(row["iso3"])
        if cid is not None:
            shapes.append((row.geometry, cid))
    if not shapes:
        raise ValueError("No valid country geometries to rasterize.")

    country_raster = rasterize(
        shapes, out_shape=backbone_shape, transform=backbone_transform,
        fill=0, dtype=np.uint8, all_touched=True,
    )
    country_raster[backbone_data == 0] = 0

    total_land = int((backbone_data == 1).sum())
    assigned = int((country_raster > 0).sum())
    unassigned = total_land - assigned
    print(f"  Land pixels: {total_land:,}")
    print(f"  Assigned to country: {assigned:,} ({100 * assigned / total_land:.1f}%)")
    if unassigned > 0:
        print(f"  Unassigned: {unassigned:,} ({100 * unassigned / total_land:.1f}%)")
        print(f"  Applying nearest-neighbour fill to {unassigned:,} unassigned land pixels...")
        # Land pixels with country_id=0 arise from sub-pixel polygon boundary gaps.
        # Fill each such pixel with the country_id of its nearest assigned neighbour
        # so that no land pixel is silently excluded from policy rasters.
        need_fill = (backbone_data == 1) & (country_raster == 0)
        assigned_mask = (country_raster > 0)
        _, nearest_idx = distance_transform_edt(~assigned_mask, return_indices=True)
        country_raster[need_fill] = country_raster[
            nearest_idx[0][need_fill],
            nearest_idx[1][need_fill],
        ]
        assigned_after = int((country_raster > 0).sum())
        print(f"  After fill: {assigned_after:,} land pixels assigned "
              f"({100 * assigned_after / total_land:.1f}%)")

    for cid, iso3 in sorted(USA_COUNTRY_ID.items()):
        n = int((country_raster == cid).sum())
        if n > 0:
            print(f"    {iso3} (id={cid:2d}): {n:>10,} pixels")

    return country_raster, profile


def save_country_raster(country_raster: np.ndarray, profile: dict) -> None:
    """Write the country-code raster and JSON mapping as auxiliary files."""
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    raster_path = OUTPUT_DIR / "country_iso3.tif"
    out_profile = profile.copy()
    out_profile.update(dtype="uint8", nodata=0, compress="lzw", count=1)
    with rasterio.open(raster_path, "w", **out_profile) as dst:
        dst.write(country_raster, 1)
    print(f"  Saved auxiliary country raster: {raster_path}")

    mapping_path = OUTPUT_DIR / "country_iso3_mapping.json"
    mapping_dict = {str(k): v for k, v in USA_COUNTRY_ID.items()}
    with open(mapping_path, "w") as f:
        json.dump(mapping_dict, f, indent=2)
    print(f"  Saved auxiliary country mapping: {mapping_path}")


# ---------------------------------------------------------------------------
# Rasterize policy variables
# ---------------------------------------------------------------------------

def rasterize_policy_variables(
    policy_table: pd.DataFrame,
    country_raster: np.ndarray,
    profile: dict,
) -> None:
    """Create per-variable per-year TIF rasters.

    For each variable and each year in [YEAR_MIN, YEAR_MAX], every pixel
    receives the value of the variable for that pixel's country.  Pixels
    with no country (country_raster == 0) or missing data are set to NaN.
    """
    print("\nRasterizing policy variables...")
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    id_to_iso3 = USA_COUNTRY_ID

    out_profile = profile.copy()
    out_profile.update(
        dtype="float32", nodata=np.nan, compress="lzw",
        count=1, tiled=True, blockxsize=512, blockysize=512,
    )

    total_files = 0
    years = list(range(YEAR_MIN, YEAR_MAX + 1))

    for var in POLICY_VARIABLES:
        print(f"\n  Variable: {var}")
        files_written = 0

        for year in years:
            raster = np.full(country_raster.shape, np.nan, dtype=np.float32)

            for cid, iso3 in id_to_iso3.items():
                mask = country_raster == cid
                if not mask.any():
                    continue

                row = policy_table[
                    (policy_table["iso3"] == iso3) & (policy_table["year"] == year)
                ]
                if not row.empty and var in row.columns:
                    val = row.iloc[0][var]
                    if pd.notna(val):
                        raster[mask] = float(val)

            out_path = OUTPUT_DIR / f"{var}_{year}.tif"
            with rasterio.open(out_path, "w", **out_profile) as dst:
                dst.write(raster, 1)
            files_written += 1
            total_files += 1

        valid_years = policy_table[policy_table[var].notna()]["year"]
        yr_range = f"{int(valid_years.min())}-{int(valid_years.max())}" if len(valid_years) > 0 else "none"
        print(f"    {files_written} rasters written ({YEAR_MIN}-{YEAR_MAX}), "
              f"data available for {yr_range}")

    print(f"\nTotal: {total_files} policy rasters written to {OUTPUT_DIR}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    print("Policy Variables Preprocessing — USA")
    print("=" * 60)
    print(f"Input:  {DATA_DIR / 'shared'} (WGI, VDem, DPI)")
    print(f"Output: {OUTPUT_DIR}")
    print()

    # Step 1: Build policy lookup table (internal, not saved)
    policy = build_policy_table()

    # Step 2: Create country raster (for pixel -> country mapping)
    gdf_usa = load_natural_earth()
    country_raster, profile = create_country_raster(gdf_usa)

    # Step 3: Save auxiliary files (country raster + mapping)
    save_country_raster(country_raster, profile)

