#!/usr/bin/env python3
"""
Entry script to tune South East Asia Model 3 with LightGBM.

Why needed:
- Provides a region-specific launcher that calls the shared tuning pipeline and
  writes a run log for batch/SLURM execution traceability.

Input:
- Environment tuning settings plus South East Asia training parquet resolved by
  the shared runner.

Output:
- LightGBM best-parameter JSON artifacts and a timestamped text log file.
"""

from __future__ import annotations

import sys
from datetime import datetime
from pathlib import Path

REPO_ROOT = next(
    (
        parent
        for parent in Path(__file__).resolve().parents
        if (parent / "scripts").is_dir() and (parent / "outputs").is_dir()
    ),
    Path(__file__).resolve().parents[5],
)
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from scripts.regions.shared.tuning.runner import run_tuning


class Tee:
    def __init__(self, file_path: Path):
        self.file = open(file_path, "w", encoding="utf-8")
        self.stdout = sys.stdout

    def write(self, text: str) -> None:
        self.stdout.write(text)
        self.stdout.flush()
        if not self.file.closed:
            self.file.write(text)
            self.file.flush()

    def flush(self) -> None:
        self.stdout.flush()
        if not self.file.closed:
            self.file.flush()

    def close(self) -> None:
        self.file.close()


if __name__ == "__main__":
    script_dir = Path(__file__).resolve().parent
    repo_root = REPO_ROOT
    output_dir = repo_root / "outputs/se_asia/results/ml_models"
    output_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    output_file = output_dir / f"model3_tuning_lgbm_{timestamp}.txt"
    tee = Tee(output_file)
    original_stdout = sys.stdout
    sys.stdout = tee
    try:
        run_tuning(region="se_asia", model="lgbm", script_dir=script_dir, output_dir=output_dir)
    finally:
        sys.stdout = original_stdout
        tee.close()
