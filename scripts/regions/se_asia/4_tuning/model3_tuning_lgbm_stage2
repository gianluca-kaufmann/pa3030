#!/usr/bin/env python3
"""Stage 2 LambdaRank hyperparameter tuning — SE Asia."""

from __future__ import annotations

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parents[4]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

import os

from scripts.regions.shared.tuning.stage2_runner import run_stage2_tuning

if __name__ == "__main__":
    run_stage2_tuning(
        "se_asia",
        "model3",
        n_trials=int(os.environ.get("STAGE2_TUNING_TRIALS", "100")),
        variant=os.environ.get("STAGE2_VARIANT", "lambdarank"),
        use_ecoregion_groups=bool(int(os.environ.get("STAGE2_ECO_GROUPS", "0"))),
    )
