#!/usr/bin/env python3
"""Stage 2 LambdaRank geographic selection model — SE Asia (model3)."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parents[4]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from scripts.regions.shared.training.stage2_lgbm_core import Stage2Config, run_stage2_training


def main() -> None:
    parser = argparse.ArgumentParser(description="Stage 2 LambdaRank — SE Asia")
    parser.add_argument("--cv-mode", default="fold3", choices=["full", "fold3", "none"])
    parser.add_argument("--naive", action="store_true", help="dist_wdpa-only baseline")
    args = parser.parse_args()
    cfg = Stage2Config(
        region="se_asia",
        model_prefix="model3",
        feature_subset=["dist_wdpa"] if args.naive else None,
        variant="naive" if args.naive else "full",
    )
    run_stage2_training(cfg, cv_mode=args.cv_mode)


if __name__ == "__main__":
    main()
