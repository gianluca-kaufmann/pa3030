#!/usr/bin/env python3
"""Cross-Continental Transfer — SA ↔ USA (Layer 3)

Loads the production models from step-5 training (no retraining) and evaluates
them on the other continent's test set.  Runs 4 combinations sequentially:
    SA-LGBM → USA,  USA-LGBM → SA,  SA-RF → USA,  USA-RF → SA

SA and USA share identical 73-feature sets, so feature columns are read directly
from the loaded model (LGBM: model.feature_name(), RF: model.feature_names_in_).

Usage:
    python scripts/regions/se_asia/6_evaluation/spatial_CV_3

SLURM:
    sbatch slurm/se_asia/spatial_CV_3.slurm

Prerequisites:
    data/{region}/ml/models/model{1,2}_lgbm_*.pkl
    data/{region}/ml/models/model{1,2}_rf_win5_*.joblib
    (missing model files are skipped gracefully)

Output:
    outputs/se_asia/results/spatial_cv/transfer/
        transfer_results_<timestamp>.json
        transfer_results_<timestamp>.txt

See scripts/regions/shared/evaluation/spatial_cv_core.py for full implementation.
"""

from scripts.regions.shared.evaluation.spatial_cv_core import run_transfer_main

if __name__ == "__main__":
    run_transfer_main()
