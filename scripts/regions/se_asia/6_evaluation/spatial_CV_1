#!/usr/bin/env python3
"""Leave-One-Biome-Out (LOBO) Spatial CV — South East Asia (Layer 1)

Trains LightGBM on all biomes except one, then evaluates on the held-out
biome's test-year pixels.  Run once per biome fold (as a SLURM array job).

Usage:
    python scripts/regions/se_asia/6_evaluation/spatial_CV_1 --list-biomes
    python scripts/regions/se_asia/6_evaluation/spatial_CV_1 --biome-idx 0

SLURM:
    sbatch slurm/se_asia/spatial_cv_lobo.slurm

Output:
    outputs/se_asia/results/spatial_cv/
        fold_<N>_<biome_slug>_<timestamp>.json
        fold_<N>_<biome_slug>_<timestamp>.txt
        spatial_cv1_scored_<biome_slug>_<timestamp>.parquet

See scripts/regions/shared/evaluation/spatial_cv_core.py for full implementation.
"""

from scripts.regions.shared.evaluation.spatial_cv_core import run_lobo_main

if __name__ == "__main__":
    run_lobo_main(region="se_asia", model_id="model3")
