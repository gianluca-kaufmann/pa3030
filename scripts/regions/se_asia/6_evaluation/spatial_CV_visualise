#!/usr/bin/env python3
"""Spatial CV visualisation — South East Asia.

Produces three publication-ready figures from LOBO (Layer 1) and biome-
stratified (Layer 2) spatial cross-validation results:

  bar_lobo_performance_<ts>.pdf   — LOBO vs in-distribution per-biome bar chart
  scatter_lobo_performance_<ts>.pdf — Prevalence vs LOBO performance scatter
  map_lobo_performance_<ts>.pdf   — Choropleth map coloured by LOBO metrics

Output: outputs/se_asia/results/spatial_cv_visualisation/

Usage:
    python scripts/regions/se_asia/6_evaluation/spatial_CV_visualise
    python scripts/regions/se_asia/6_evaluation/spatial_CV_visualise --model-type rf

See scripts/regions/shared/evaluation/spatial_cv_visualise.py for implementation.
"""

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[4]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from scripts.regions.shared.evaluation.spatial_cv_visualise import run_spatial_cv_visualise

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Spatial CV visualisation — South East Asia"
    )
    parser.add_argument(
        "--model-type", choices=["lgbm", "rf"], default="lgbm",
        help="Model type whose LOBO folds to visualise (default: lgbm)",
    )
    args = parser.parse_args()
    run_spatial_cv_visualise(region="se_asia", model_type=args.model_type)
